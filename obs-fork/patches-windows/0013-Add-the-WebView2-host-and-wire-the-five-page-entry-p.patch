+DWORD WindowStyle(const Chrome &chrome)
+{
+	/* The Swift's style masks, button for button:
+	 * login  [.titled, .closable, .miniaturizable]  (WebLoginWindow.swift:48)
+	 * pages  [.titled, .closable, .resizable]       (BilibiliPageWindow.swift:89) */
+	DWORD style = WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN;
+	if (chrome.resizable)
+		style |= WS_THICKFRAME;
+	if (chrome.minimize)
+		style |= WS_MINIMIZEBOX;
+	return style;
+}
+
+void RegisterWindowClass()
+{
+	static const bool once = []() {
+		WNDCLASSEXW definition = {};
+		definition.cbSize = sizeof(definition);
+		definition.lpfnWndProc = WindowProc;
+		definition.hInstance = GetModuleHandleW(nullptr);
+		definition.hCursor = LoadCursorW(nullptr, IDC_ARROW);
+		definition.hbrBackground = reinterpret_cast<HBRUSH>(static_cast<INT_PTR>(COLOR_BTNFACE + 1));
+		definition.lpszClassName = kWindowClass;
+		return RegisterClassExW(&definition) != 0;
+	}();
+	(void)once;
+}
