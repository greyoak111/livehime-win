+
+void HostWindow::Start()
+{
+	RegisterWindowClass();
+
+	const DWORD style = WindowStyle(chrome_);
+	RECT rect{0, 0, chrome_.width, chrome_.height};
+	AdjustWindowRectEx(&rect, style, FALSE, 0);
+	hwnd_ = CreateWindowExW(0, kWindowClass, chrome_.title.c_str(), style, CW_USEDEFAULT, CW_USEDEFAULT,
+				rect.right - rect.left, rect.bottom - rect.top, nullptr, nullptr, GetModuleHandleW(nullptr),
+				this);
+	if (!hwnd_) {
+		HostUnavailable("the window could not be created");
+		return;
+	}
+	CenterWindow();
+
+	if (!chrome_.status.empty()) {
+		status_ = CreateWindowExW(0, L"STATIC", chrome_.status.c_str(),
+					  WS_CHILD | WS_VISIBLE | SS_LEFT | SS_CENTERIMAGE, 0, 0, 10, 10, hwnd_, nullptr,
+					  GetModuleHandleW(nullptr), nullptr);
+		if (status_)
+			SendMessageW(status_, WM_SETFONT, reinterpret_cast<WPARAM>(GetStockObject(DEFAULT_GUI_FONT)), TRUE);
+		if (!chrome_.confirm.empty()) {
+			confirm_ = CreateWindowExW(0, L"BUTTON", chrome_.confirm.c_str(),
+						   WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON, 0, 0, 10, 10, hwnd_,
+						   reinterpret_cast<HMENU>(static_cast<INT_PTR>(kConfirmControlId)),
+						   GetModuleHandleW(nullptr), nullptr);
+			if (confirm_)
+				SendMessageW(confirm_, WM_SETFONT,
+					     reinterpret_cast<WPARAM>(GetStockObject(DEFAULT_GUI_FONT)), TRUE);
+		}
+	}
+
+	profile_ = ProfileFolder();
+	if (profile_.empty()) {
+		HostUnavailable("the temporary WebView2 profile folder could not be created");
+		return;
+	}
+
+	/* CreateCoreWebView2EnvironmentWithOptions is asynchronous and reports
+	 * through the handler below, which runs on this thread once its message
+	 * loop pumps; waiting for it here would deadlock the UI thread
+	 * (session-and-login.md §7.3 row 11). A machine that has the loader but not
+	 * the Evergreen Runtime fails this call, and that failure is exactly what
+	 * the caller has to hear. */
+	const HRESULT started = CreateCoreWebView2EnvironmentWithOptions(
+		nullptr, profile_.c_str(), nullptr,
+		Callback<ICoreWebView2CreateCoreWebView2EnvironmentCompletedHandler>(
+			[self = Shared()](HRESULT status, ICoreWebView2Environment *environment) -> HRESULT {
+				self->EnvironmentReady(status, environment);
+				return S_OK;
+			})
+			.Get());
+	if (FAILED(started))
+		HostUnavailable("CreateCoreWebView2EnvironmentWithOptions failed (" + FormatHresult(started) + ")");
+}
+
+void HostWindow::EnvironmentReady(HRESULT status, ICoreWebView2Environment *environment)
+{
+	if (destroyed_)
+		return;
+	if (FAILED(status) || !environment) {
+		HostUnavailable("WebView2 environment creation failed (" + FormatHresult(status) + ")");
+		return;
+	}
+	environment_ = environment;
+
+	const HRESULT started = environment_->CreateCoreWebView2Controller(
+		hwnd_, Callback<ICoreWebView2CreateCoreWebView2ControllerCompletedHandler>(
+			       [self = Shared()](HRESULT result, ICoreWebView2Controller *controller) -> HRESULT {
+				       self->ControllerReady(result, controller);
+				       return S_OK;
+			       })
+			       .Get());
+	if (FAILED(started))
+		HostUnavailable("WebView2 controller creation failed (" + FormatHresult(started) + ")");
+}
+
+void HostWindow::ControllerReady(HRESULT status, ICoreWebView2Controller *controller)
+{
+	if (destroyed_)
+		return;
+	if (FAILED(status) || !controller) {
+		HostUnavailable("WebView2 controller creation failed (" + FormatHresult(status) + ")");
+		return;
+	}
+	controller_ = controller;
+	if (FAILED(controller_->get_CoreWebView2(&webview_)) || !webview_) {
+		HostUnavailable("WebView2 reported no web view for its controller");
+		return;
+	}
+
+	ComPtr<ICoreWebView2Settings> settings;
+	if (SUCCEEDED(webview_->get_Settings(&settings)) && settings) {
+		/* The host shows the script dialogs itself (WebLoginWindow.swift:
+		 * 220-234), which is what the default dialogs have to step aside for. */
+		settings->put_AreDefaultScriptDialogsEnabled(FALSE);
+		/* WKWebView was inspectable only in a ".dev" build
+		 * (BilibiliPageWindow.swift:84-86); a debug build is the closest
+		 * Windows equivalent of that switch. */
+#if defined(_DEBUG)
+		settings->put_AreDevToolsEnabled(TRUE);
+#else
+		settings->put_AreDevToolsEnabled(FALSE);
+#endif
+	}
+
+	/* The cookie manager arrived with ICoreWebView2_2, not with the first
+	 * interface the controller hands out. */
+	ComPtr<ICoreWebView2_2> later;
+	if (SUCCEEDED(webview_.As(&later)) && later)
+		later->get_CookieManager(&cookies_);
+
+	EventRegistrationToken token = {};
+	webview_->add_WebMessageReceived(
+		Callback<ICoreWebView2WebMessageReceivedEventHandler>(
+			[self = Shared()](ICoreWebView2 *, ICoreWebView2WebMessageReceivedEventArgs *args) -> HRESULT {
+				self->OnMessage(args);
+				return S_OK;
+			})
+			.Get(),
+		&token);
+	webview_->add_NavigationCompleted(
+		Callback<ICoreWebView2NavigationCompletedEventHandler>(
+			[self = Shared()](ICoreWebView2 *, ICoreWebView2NavigationCompletedEventArgs *args) -> HRESULT {
+				self->OnNavigationCompleted(args);
+				return S_OK;
+			})
+			.Get(),
+		&token);
+	webview_->add_ScriptDialogOpening(
+		Callback<ICoreWebView2ScriptDialogOpeningEventHandler>(
+			[self = Shared()](ICoreWebView2 *, ICoreWebView2ScriptDialogOpeningEventArgs *args) -> HRESULT {
+				self->OnScriptDialog(args);
+				return S_OK;
+			})
+			.Get(),
+		&token);
+	webview_->add_NewWindowRequested(
+		Callback<ICoreWebView2NewWindowRequestedEventHandler>(
+			[self = Shared()](ICoreWebView2 *, ICoreWebView2NewWindowRequestedEventArgs *args) -> HRESULT {
+				self->OnNewWindowRequested(args);
+				return S_OK;
+			})
+			.Get(),
+		&token);
+	webview_->add_WindowCloseRequested(
+		Callback<ICoreWebView2WindowCloseRequestedEventHandler>(
+			[self = Shared()](ICoreWebView2 *, IUnknown *) -> HRESULT {
+				self->CloseRequested();
+				return S_OK;
+			})
+			.Get(),
+		&token);
+
+	for (const std::string &script : DocumentScripts()) {
+		webview_->AddScriptToExecuteOnDocumentCreated(
+			Widen(script).c_str(),
+			Callback<ICoreWebView2AddScriptToExecuteOnDocumentCreatedCompletedHandler>(
+				[](HRESULT, LPCWSTR) -> HRESULT { return S_OK; })
+				.Get());
+	}
+
+	Layout();
+	/* The page decides whether this window has anything to show: a page window
+	 * with no stored login closes itself here (BilibiliPageWindow.swift:
+	 * 449-454 returns before a window exists), and a window that is already
+	 * closing is never shown at all. */
+	Ready();
+	if (!hwnd_ || closing_ || destroyed_)
+		return;
+	ShowWindow(hwnd_, SW_SHOWNORMAL);
+	UpdateWindow(hwnd_);
+	SetForegroundWindow(hwnd_);
+	shown_ = true;
+	controller_->MoveFocus(COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC);
+}
+
+void HostWindow::Layout()
+{
+	if (!hwnd_)
+		return;
+	RECT client = {};
+	if (!GetClientRect(hwnd_, &client))
+		return;
+	const int status = status_ ? kStatusHeight : 0;
+	RECT bounds{0, 0, client.right, client.bottom - status};
+	if (bounds.bottom < 0)
+		bounds.bottom = 0;
+	if (controller_)
+		controller_->put_Bounds(bounds);
+	if (status_) {
+		int width = client.right - (confirm_ ? kConfirmWidth + 8 : 0);
+		if (width < 0)
+			width = 0;
+		MoveWindow(status_, 0, client.bottom - status, width, status, TRUE);
+		if (confirm_)
+			MoveWindow(confirm_, client.right - kConfirmWidth - 4, client.bottom - status + 2, kConfirmWidth,
+				   status - 4, TRUE);
+	}
+}
+
+void HostWindow::CenterWindow()
+{
+	/* The Swift centered every window (NSWindow.center()); Windows' cascade
+	 * would put each page somewhere else on the desktop. */
+	RECT window = {};
+	if (!GetWindowRect(hwnd_, &window))
+		return;
+	MONITORINFO info = {};
+	info.cbSize = sizeof(info);
+	const HMONITOR monitor = MonitorFromWindow(hwnd_, MONITOR_DEFAULTTOPRIMARY);
+	if (!monitor || !GetMonitorInfoW(monitor, &info))
+		return;
+	const int width = window.right - window.left;
+	const int height = window.bottom - window.top;
+	const int x = info.rcWork.left + ((info.rcWork.right - info.rcWork.left) - width) / 2;
+	const int y = info.rcWork.top + ((info.rcWork.bottom - info.rcWork.top) - height) / 2;
+	SetWindowPos(hwnd_, nullptr, x, y, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+void HostWindow::BringToFront()
+{
+	if (!hwnd_)
+		return;
+	ShowWindow(hwnd_, SW_SHOWNORMAL);
+	SetForegroundWindow(hwnd_);
+}
+
+void HostWindow::Close()
+{
+	/* The Swift's window.close() → windowWillClose. WebView2 does not support
+	 * tearing its objects down from inside one of its own callbacks (its
+	 * threading model: callbacks run serially and must not be re-entered), so
+	 * the teardown is posted and runs after that callback returns. */
+	if (closing_ || destroyed_)
+		return;
+	closing_ = true;
+	if (!dispatch::Post([self = Shared()]() { self->Teardown(); }))
+		Teardown();
+}
+
+void HostWindow::Confirm()
+{
+	if (closing_ || destroyed_)
+		return;
+	Close();
+	if (chrome_.on_confirm)
+		chrome_.on_confirm();
+}
+
+void HostWindow::HostUnavailable(const std::string &reason)
+{
+	if (destroyed_)
+		return;
+	HostFailed(reason);
+	Close();
+}
+
+void HostWindow::Teardown()
+{
+	if (destroyed_)
+		return;
+	destroyed_ = true;
+
+	/* Release COM before the HWND: closing the controller stops the page, and
+	 * dropping the web view releases the handlers that hold a shared_ptr to
+	 * this object. */
+	if (controller_)
+		controller_->Close();
+	webview_.Reset();
+	cookies_.Reset();
+	controller_.Reset();
+	environment_.Reset();
+
+	if (hwnd_) {
+		DestroyWindow(hwnd_);
+		hwnd_ = nullptr;
+	}
+	status_ = nullptr;
+	confirm_ = nullptr;
+
+	UnregisterWindow(this);
+	DeleteFolder(profile_);
+
+	/* A test hook that is still waiting gets an answer rather than a hang. The
+	 * key is already free, so a caller that opens the page again from here gets
+	 * a new window. */
+	for (auto &pending : eval_) {
+		if (pending.second)
+			pending.second("{\"error\":\"the page closed\"}");
+	}
+	eval_.clear();
+
+	/* Exactly like BilibiliPageWindow.windowWillClose (:145-150). A window that
+	 * never appeared was never closed by anyone, so it reports nothing. */
+	if (shown_ && chrome_.on_close)
+		chrome_.on_close();
+}
