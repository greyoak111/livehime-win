+
+LRESULT HostWindow::HandleMessage(HWND hwnd, UINT message, WPARAM wparam, LPARAM lparam)
+{
+	switch (message) {
+	case WM_SIZE:
+		Layout();
+		return 0;
+	case WM_WINDOWPOSCHANGED:
+		if (controller_)
+			controller_->NotifyParentWindowPositionChanged();
+		break;
+	case WM_SETFOCUS:
+		if (controller_)
+			controller_->MoveFocus(COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC);
+		return 0;
+	case WM_GETMINMAXINFO:
+		/* The login window's contentMinSize (WebLoginWindow.swift:64). */
+		if (chrome_.fixed_size) {
+			auto *info = reinterpret_cast<MINMAXINFO *>(lparam);
+			RECT smallest{0, 0, chrome_.width, chrome_.height};
+			AdjustWindowRectEx(&smallest, WindowStyle(chrome_), FALSE, 0);
+			info->ptMinTrackSize.x = smallest.right - smallest.left;
+			info->ptMinTrackSize.y = smallest.bottom - smallest.top;
+			return 0;
+		}
+		break;
+	case WM_COMMAND:
+		if (LOWORD(wparam) == kConfirmControlId && HIWORD(wparam) == BN_CLICKED) {
+			Confirm();
+			return 0;
+		}
+		break;
+	case WM_CLOSE:
+		Close();
+		return 0; /* the teardown destroys the window */
+	case WM_DESTROY:
+		hwnd_ = nullptr;
+		status_ = nullptr;
+		confirm_ = nullptr;
+		return 0;
+	default:
+		break;
+	}
+	return DefWindowProcW(hwnd, message, wparam, lparam);
+}
+
+LRESULT CALLBACK WindowProc(HWND hwnd, UINT message, WPARAM wparam, LPARAM lparam)
+{
+	if (message == WM_NCCREATE) {
+		auto *create = reinterpret_cast<CREATESTRUCTW *>(lparam);
+		SetWindowLongPtrW(hwnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(create->lpCreateParams));
+	}
+	auto *window = reinterpret_cast<HostWindow *>(GetWindowLongPtrW(hwnd, GWLP_USERDATA));
+	/* Messages that arrive before WM_NCCREATE (and after the window is gone)
+	 * have no host yet. */
+	if (!window)
+		return DefWindowProcW(hwnd, message, wparam, lparam);
+	return window->HandleMessage(hwnd, message, wparam, lparam);
+}
+
+void HostWindow::OnMessage(ICoreWebView2WebMessageReceivedEventArgs *args)
+{
+	LPWSTR source_text = nullptr;
+	if (FAILED(args->get_Source(&source_text)) || !source_text)
+		return;
+	const std::string source = Narrow(source_text);
+	CoTaskMemFree(source_text);
+	const Origin origin = ParseOrigin(source);
+
+	/* Privileged callbacks are accepted only from our own official page; a
+	 * document-created shim also lives in third-party frames (geetest, the
+	 * passport redirect), so this is the gate that keeps them unprivileged
+	 * (AuthBridgeContract.swift:3-9, session-and-login.md §7.3 row 16).
+	 *
+	 * A rejected message gets no reply, and cannot: PostWebMessageAsJson
+	 * addresses the top-level document, never the frame that called, so the
+	 * Swift's `replyHandler(nil, untrusted_origin)` has no WebView2 counterpart.
+	 * The rejection is reported instead, because a silent drop is exactly the
+	 * behaviour the Windows build has to be able to show in its log. */
+	if (!Accepts(origin)) {
+		EmitEvent("pageLog", json{{"page", key_},
+					  {"message", "rejected a bridge message from " + OriginText(origin) +
+							      " (untrusted_origin)"}});
+		return;
+	}
+
+	LPWSTR json_text = nullptr;
+	if (FAILED(args->get_WebMessageAsJson(&json_text)) || !json_text)
+		return;
+	const std::string payload = Narrow(json_text);
+	CoTaskMemFree(json_text);
+
+	const json body = json::parse(payload, nullptr, false);
+	if (body.is_discarded() || !body.is_object())
+		return;
+
+	/* The eval reply is the host's own channel, so it is routed before the
+	 * page's messages. */
+	const auto eval = body.find("livehimeEval");
+	if (eval != body.end() && eval->is_string()) {
+		const std::string id = eval->get<std::string>();
+		const auto result = body.find("json");
+		const auto reported_ok = body.find("ok");
+		const bool ok = reported_ok != body.end() && reported_ok->is_boolean() && reported_ok->get<bool>();
+		if (ok && result != body.end() && result->is_string()) {
+			FinishEval(id, result->get<std::string>());
+		} else {
+			std::string error = "the script did not report a result";
+			const auto reported = body.find("error");
+			if (reported != body.end() && reported->is_string())
+				error = reported->get<std::string>();
+			FinishEval(id, std::string("{\"error\":") + json(error).dump() + "}");
+		}
+		return;
+	}
+
+	Message(body, origin);
+}
+
+void HostWindow::OnNavigationCompleted(ICoreWebView2NavigationCompletedEventArgs *args)
+{
+	BOOL success = FALSE;
+	if (FAILED(args->get_IsSuccess(&success)))
+		success = FALSE;
+	NavigationFinished(success != FALSE);
+}
+
+void HostWindow::OnScriptDialog(ICoreWebView2ScriptDialogOpeningEventArgs *args)
+{
+	COREWEBVIEW2_SCRIPT_DIALOG_KIND kind = COREWEBVIEW2_SCRIPT_DIALOG_KIND_ALERT;
+	args->get_Kind(&kind);
+	std::wstring text;
+	LPWSTR message = nullptr;
+	if (SUCCEEDED(args->get_Message(&message)) && message) {
+		text = message;
+		CoTaskMemFree(message);
+	}
+
+	/* The Swift showed a sheet from its delegate callback; WebView2 forbids
+	 * running a modal loop inside one of its event handlers, so the dialog is
+	 * deferred: the handler returns, the box is shown from the message queue,
+	 * and the deferral is completed with the answer. */
+	ComPtr<ICoreWebView2Deferral> deferral;
+	if (FAILED(args->GetDeferral(&deferral)) || !deferral) {
+		args->Accept(); /* nothing can be shown; dismissing is the honest answer */
+		return;
+	}
+	ComPtr<ICoreWebView2ScriptDialogOpeningEventArgs> dialog = args;
+	const bool confirm = kind == COREWEBVIEW2_SCRIPT_DIALOG_KIND_CONFIRM;
+	const bool unhandled = kind == COREWEBVIEW2_SCRIPT_DIALOG_KIND_PROMPT ||
+			       kind == COREWEBVIEW2_SCRIPT_DIALOG_KIND_BEFOREUNLOAD;
+	ScheduleAfter(0, [dialog, deferral, confirm, unhandled, text, self = Shared()]() {
+		if (unhandled) {
+			/* The Swift had no panel for a prompt and no beforeunload
+			 * delegate; accepting dismisses the dialog so the page is never
+			 * left waiting on it. */
+			dialog->Accept();
+			deferral->Complete();
+			return;
+		}
+		/* WebLoginWindow.swift:220-234. The confirm buttons are the system's
+		 * 确定 / 取消 on a Chinese Windows, which is where the Swift's fixed
+		 * titles came from. */
+		const UINT flags = confirm ? MB_OKCANCEL | MB_ICONQUESTION | MB_SETFOREGROUND
+					   : MB_OK | MB_ICONINFORMATION | MB_SETFOREGROUND;
+		const int answer = MessageBoxW(self->hwnd_, text.c_str(), confirm ? L"确定" : L"提示", flags);
+		if (!confirm || answer == IDOK)
+			dialog->Accept();
+		deferral->Complete();
+	});
+}
+
+void HostWindow::OnNewWindowRequested(ICoreWebView2NewWindowRequestedEventArgs *args)
+{
+	std::string url;
+	LPWSTR uri = nullptr;
+	if (SUCCEEDED(args->get_Uri(&uri)) && uri) {
+		url = Narrow(uri);
+		CoTaskMemFree(uri);
+	}
+	/* WebView2 must never open a window of its own for these pages. */
+	args->put_Handled(TRUE);
+	if (url.empty())
+		return;
+	if (NavigatesHere(url)) {
+		Navigate(url);
+		return;
+	}
+	const Origin origin = ParseOrigin(url);
+	if (origin.scheme != "https" && origin.scheme != "http")
+		return;
+	/* "Forgot password", the user agreement and the privacy policy belong in
+	 * the user's browser (WebLoginWindow.swift:210-218). */
+	ShellExecuteW(nullptr, L"open", Widen(url).c_str(), nullptr, nullptr, SW_SHOWNORMAL);
+}
+
+void HostWindow::FinishEval(const std::string &id, const std::string &json_text)
+{
+	const auto found = eval_.find(id);
+	if (found == eval_.end())
+		return; /* already answered, or the reply raced the teardown */
+	const PageResultFn done = std::move(found->second);
+	eval_.erase(found);
+	done(json_text);
+}
+
+void HostWindow::Evaluate(const std::string &script, const PageResultFn &done)
+{
+	if (!done)
+		return;
+	if (!webview_) {
+		done("{\"error\":\"the page is not ready\"}");
+		return;
+	}
+
+	const std::string id = std::to_string(++next_eval_);
+	/* BilibiliPageWindow.evaluate (BilibiliPageWindow.swift:241-251) runs the
+	 * script as an async function body and answers with JSON.stringify of its
+	 * value. ExecuteScript cannot await a Promise, so the body reports its
+	 * result over the web-message channel instead, keyed by the id above. */
+	const std::string wrapped = "(async () => {\n"
+				    "  let payload;\n"
+				    "  try {\n"
+				    "    const value = await (async () => { " +
+				    script +
+				    " })();\n"
+				    "    payload = {livehimeEval: " +
+				    JsString(id) +
+				    ", ok: true, json: JSON.stringify(value === undefined ? null : value)};\n"
+				    "  } catch (e) {\n"
+				    "    payload = {livehimeEval: " +
+				    JsString(id) +
+				    ", ok: false, error: String((e && (e.message || e)) || e)};\n"
+				    "  }\n"
+				    "  try { window.chrome.webview.postMessage(payload); } catch (e) {}\n"
+				    "})();";
+
+	eval_[id] = done;
+	webview_->ExecuteScript(
+		Widen(wrapped).c_str(),
+		Callback<ICoreWebView2ExecuteScriptCompletedHandler>(
+			[self = Shared(), id](HRESULT status, LPCWSTR result) -> HRESULT {
+				(void)result;
+				if (FAILED(status)) {
+					/* The script never ran — a syntax error in the
+					 * caller's body, for instance. The async wrapper above
+					 * cannot report that case, so it is reported here. */
+					self->FinishEval(id, std::string("{\"error\":") +
+								  JsString("the script did not run (" +
+									   FormatHresult(status) + ")") +
+								  "}");
+				}
+				return S_OK;
+			})
+			.Get());
+}
+
+bool HostWindow::Click(double x, double y)
+{
+	if (!Live() || !webview_)
+		return false;
+	if (!std::isfinite(x) || !std::isfinite(y))
+		return false;
+
+	/* BilibiliPageWindow.click (BilibiliPageWindow.swift:255-267) sends a real
+	 * mouse click at page coordinates "so the page sees a user gesture". The
+	 * Windows counterpart of a real click is OS input: Chromium accepts input
+	 * that arrived through the input queue as trusted, and gives a synthetic
+	 * DOM event no user activation. */
+	SetForegroundWindow(hwnd_);
+	SetFocus(hwnd_);
+	POINT point{static_cast<LONG>(x), static_cast<LONG>(y)};
+	if (!ClientToScreen(hwnd_, &point))
+		return false;
+	if (!SetCursorPos(point.x, point.y))
+		return false;
+
+	INPUT input[2] = {};
+	input[0].type = INPUT_MOUSE;
+	input[0].mi.dwFlags = MOUSEEVENTF_LEFTDOWN;
+	input[1].type = INPUT_MOUSE;
+	input[1].mi.dwFlags = MOUSEEVENTF_LEFTUP;
+	return SendInput(2, input, static_cast<int>(sizeof(INPUT))) == 2;
+}
+
+/* ── the login window ───────────────────────────────────────────────────── */
+
+/* WebLoginWindow.swift:47-48: 820 x 460, titled, closable, miniaturizable,
+ * not resizable. */
+Chrome LoginChrome()
+{
+	Chrome chrome;
+	chrome.title = L"哔哩哔哩登录";
+	chrome.width = 820;
+	chrome.height = 460;
+	chrome.minimize = true;
+	chrome.fixed_size = true;
+	return chrome;
+}
+
+class LoginWindow final : public HostWindow {
+public:
+	explicit LoginWindow(FailureFn failed) : HostWindow("login", LoginChrome()), failed_(std::move(failed)) {}
+
+protected:
+	std::vector<std::string> DocumentScripts() const override
+	{
+		/* The two document-start scripts of WebLoginWindow.swift:53-56. The
+		 * frame guard each of them carries is WebView2's price for having no
+		 * main-frame-only injection (session-and-login.md §7.3 row 12). */
+		return {BrowserScript(), kLoginShim};
+	}
+
+	void Ready() override { Navigate(kLoginUrl); }
+
+	bool Accepts(const Origin &origin) const override { return LoginOrigin(origin); }
+
+	void Message(const json &body, const Origin &origin) override;
+
+	void NavigationFinished(bool success) override
+	{
+		if (!success)
+			return;
+		/* WebLoginWindow.swift:199-206: after every finished navigation the
+		 * (idempotent) native bridge goes in, then one cookie probe — a
+		 * third-party (QQ / WeChat / Weibo) login or a verification step comes
+		 * back to the page already signed in without calling LoginSuccess. */
+		Run(kNativeBridgeShim);
+		CollectCookies(0, 1);
+	}
+
+	void HostFailed(const std::string &reason) override
+	{
+		if (failed_)
+			failed_(reason);
+	}
+
+private:
+	/* The livehime_login channel (WebLoginWindow.swift:98-108). */
+	void LoginSuccess(const json &payload);
+	void SeedCookies(const std::string &token, const std::string &timestamp);
+	/* The biliBridgePc channel (WebLoginWindow.swift:110-135). */
+	void CallNative(const json &body, long long id);
+	void ApplyCookieBatch(const json &payload, long long id);
+	void ReplyWithId(long long id, const std::string &error);
+
+	void CollectCookies(int attempt, int attempts);
+	void CookiesRead(HRESULT status, ICoreWebView2CookieList *list, int attempt, int attempts);
+	void Finish(const CookieMap &cookies);
+	void Resize(const json &body);
+
+	FailureFn failed_;
+	std::string refresh_token_;
+	bool completed_ = false;
+};
+
+void LoginWindow::Message(const json &body, const Origin &origin)
+{
+	(void)origin; /* the caller already checked it */
+	const auto call = body.find("livehimeCall");
+	if (call != body.end()) {
+		/* The shim always numbers its calls; a call without an id has no
+		 * answer to send and nothing to do. */
+		if (!call->is_number())
+			return;
+		CallNative(body, static_cast<long long>(call->get<double>()));
+		return;
+	}
+
+	const auto method = body.find("method");
+	if (method == body.end() || !method->is_string())
+		return;
+	const std::string name = method->get<std::string>();
+	if (name == "LoginSuccess") {
+		const auto data = body.find("data");
+		LoginSuccess(data == body.end() ? json::object() : *data);
+	} else if (name == "Cancel") {
+		Close();
+	} else if (name == "SecondaryValidationResult") {
+		/* The page redirected back after verification; the cookie jar is
+		 * already authenticated at this point (WebLoginWindow.swift:153-156). */
+		CollectCookies(0, 20);
+	} else if (name == "SwitchLogin") {
+		Resize(body);
+	}
+	/* Anything else is ignored (WebLoginWindow.swift:106). */
+}
+
+void LoginWindow::LoginSuccess(const json &payload)
+{
+	/* WebLoginWindow.dictionary (:137-143): the payload may be an object or a
+	 * JSON string; anything else is empty. */
+	json fields = json::object();
+	if (payload.is_object()) {
+		fields = payload;
+	} else if (payload.is_string()) {
+		const json parsed = json::parse(payload.get<std::string>(), nullptr, false);
+		if (parsed.is_object())
+			fields = parsed;
+	}
+
+	/* LoginResult field mapping (AuthWebViewBridge.swift:51-61). */
+	std::string token;
+	for (const char *name : {"refresh_token", "refreshToken", "token"}) {
+		const auto found = fields.find(name);
+		if (found != fields.end() && found->is_string()) {
+			token = found->get<std::string>();
+			break;
+		}
+	}
+	if (!token.empty()) {
+		refresh_token_ = token;
+		/* AuthWebViewBridge.swift:57 maps the timestamp through
+		 * String(describing:) whenever the key is there, and only then does
+		 * WebLoginWindow.swift:150 seed correspond/0. */
+		const auto timestamp = fields.find("timestamp");
+		if (timestamp != fields.end())
+			SeedCookies(token, SwiftDescribe(*timestamp));
+	}
+	CollectCookies(0, 20);
+}
+
+void LoginWindow::SeedCookies(const std::string &token, const std::string &timestamp)
+{
+	/* WebLoginWindow.swift:166-174. The double encoding is deliberate and
+	 * load-bearing: the marker's Unicode scalars become unpadded lowercase hex
+	 * text, and SHA-256 runs over that ASCII hex, not over the marker. */
+	const std::string marker = "set_" + timestamp + "_" + token;
+	const std::string digest = crypto::Sha256Hex(ScalarHex(marker));
+	const std::string url = "https://www.bilibili.com/correspond/0/" + digest;
+	Run("(() => { const f=document.createElement('iframe'); f.style.display='none'; f.src=" + JsString(url) +
+	    "; document.body.appendChild(f); })();");
+}
+
+/* NativeAuthRequest.parse (AuthBridgeContract.swift:18-37) on the WebView2
+ * channel. A call that cannot be taken is answered with the contract's own
+ * error literal, never with a fabricated acceptance. */
+void LoginWindow::CallNative(const json &body, long long id)
+{
+	std::string action;
+	const auto named = body.find("action");
+	if (named != body.end() && named->is_string())
+		action = named->get<std::string>();
+	const auto given = body.find("payload");
+	const json payload = given == body.end() ? json() : *given;
+
+	if (action == "auth/setRefreshToken") {
+		json fields = json::object();
+		if (payload.is_object()) {
+			fields = payload;
+		} else if (payload.is_string()) {
+			const json parsed = json::parse(payload.get<std::string>(), nullptr, false);
+			if (parsed.is_object())
+				fields = parsed;
+		}
+		if (fields.empty()) {
+			ReplyWithId(id, "malformed_payload");
+			return;
+		}
+		/* .login(object) → bridge.loginSuccess(object) (WebLoginWindow.swift:
+		 * 117-120), then the acknowledgement. */
+		LoginSuccess(fields);
+		ReplyWithId(id, "");
+		return;
+	}
+
+	if (action == "auth/setCookies") {
+		ApplyCookieBatch(payload, id);
+		return;
+	}
+	ReplyWithId(id, "unsupported_action");
+}
+
+void LoginWindow::ApplyCookieBatch(const json &payload, long long id)
+{
+	std::vector<CookieOperation> operations;
+	if (!ParseCookieBatch(payload, operations)) {
+		ReplyWithId(id, "malformed_payload");
+		return;
+	}
+
+	ICoreWebView2CookieManager *manager = CookieManager();
+	if (!manager) {
+		/* Unreachable while the page is running: a page implies a controller
+		 * and its cookie manager. No reply is the honest answer — the three
+		 * literals the contract has are about the payload and the action, and
+		 * neither is the trouble here. */
+		return;
+	}
+	for (const CookieOperation &operation : operations) {
+		ComPtr<ICoreWebView2Cookie> cookie;
+		if (FAILED(manager->CreateCookie(Widen(operation.name).c_str(), Widen(operation.value).c_str(),
+						 L".bilibili.com", L"/", &cookie)) ||
+		    !cookie)
+			continue;
+		cookie->put_IsSecure(TRUE);
+		if (operation.remove)
+			manager->DeleteCookie(cookie.Get());
+		else
+			manager->AddOrUpdateCookie(cookie.Get());
+	}
+
+	/* WebLoginWindow.swift:121-128 acknowledges only after every write. The
+	 * read-back is the one round trip that puts the reply behind those writes
+	 * in the browser process's queue. */
+	manager->GetCookies(nullptr, Callback<ICoreWebView2GetCookiesCompletedHandler>(
+					     [self = std::static_pointer_cast<LoginWindow>(Shared()), id](
+						     HRESULT, ICoreWebView2CookieList *) -> HRESULT {
+						     self->ReplyWithId(id, "");
+						     return S_OK;
+					     })
+					     .Get());
+}
+
+void LoginWindow::ReplyWithId(long long id, const std::string &error)
+{
+	json message{{"livehimeReply", id}};
+	if (error.empty())
+		message["accepted"] = true; /* {"accepted": true} (WebLoginWindow.swift:120) */
+	else
+		message["error"] = error;
+	ToPage(message);
+}
+
+void LoginWindow::CollectCookies(int attempt, int attempts)
+{
+	if (completed_ || closing_ || destroyed_)
+		return;
+	ICoreWebView2CookieManager *manager = CookieManager();
+	if (!manager)
+		return;
+	manager->GetCookies(nullptr, Callback<ICoreWebView2GetCookiesCompletedHandler>(
+					     [self = std::static_pointer_cast<LoginWindow>(Shared()), attempt, attempts](
+						     HRESULT status, ICoreWebView2CookieList *list) -> HRESULT {
+						     self->CookiesRead(status, list, attempt, attempts);
+						     return S_OK;
+					     })
+					     .Get());
+}
+
+void LoginWindow::CookiesRead(HRESULT status, ICoreWebView2CookieList *list, int attempt, int attempts)
+{
+	if (completed_ || closing_ || destroyed_)
+		return;
+
+	/* WebLoginWindow.swift:180-184: every cookie whose domain ends in
+	 * bilibili.com, keyed by name, then put through SessionCredentials' filter
+	 * (QRLogin.swift:14-20). */
+	CookieMap cookies;
+	if (SUCCEEDED(status) && list) {
+		UINT32 count = 0;
+		list->get_Count(&count);
+		for (UINT32 index = 0; index < count; ++index) {
+			ComPtr<ICoreWebView2Cookie> cookie;
+			if (FAILED(list->GetValueAtIndex(index, &cookie)) || !cookie)
+				continue;
+			std::string name;
+			std::string domain;
+			std::string value;
+			LPWSTR text = nullptr;
+			if (SUCCEEDED(cookie->get_Name(&text)) && text) {
+				name = Narrow(text);
+				CoTaskMemFree(text);
+				text = nullptr;
+			}
+			if (SUCCEEDED(cookie->get_Domain(&text)) && text) {
+				domain = Narrow(text);
+				CoTaskMemFree(text);
+				text = nullptr;
+			}
+			if (SUCCEEDED(cookie->get_Value(&text)) && text) {
+				value = Narrow(text);
+				CoTaskMemFree(text);
+			}
+			if (!EndsWith(domain, "bilibili.com"))
+				continue;
+			if (KeptCookie(name) && !value.empty())
+				cookies[name] = value;
+		}
+	}
+
+	if (IsComplete(cookies)) {
+		Finish(cookies);
+		return;
+	}
+	/* Cookies can arrive shortly after the success callback: 20 attempts,
+	 * 0.3 s apart (WebLoginWindow.swift:189-192). Out of attempts the window
+	 * simply stays open — the Swift gave up the same silent way. */
+	if (attempt + 1 < attempts) {
+		ScheduleAfter(300, [self = std::static_pointer_cast<LoginWindow>(Shared()), attempt, attempts]() {
+			self->CollectCookies(attempt + 1, attempts);
+		});
+	}
+}
+
+void LoginWindow::Finish(const CookieMap &cookies)
+{
+	completed_ = true;
+
+	/* The core's HTTP layer reads its cookies from the jar, so the login's
+	 * cookies go there first (CONTRACT §7). session.cpp's Verify then applies
+	 * the same credentials from the stored envelope, which sets the same
+	 * values. */
+	net::CookieJar &jar = net::CookieJar::Instance();
+	jar.Clear();
+	for (const auto &cookie : cookies)
+		jar.Set(kCookieDomain, cookie.first, cookie.second);
+
+	/* SessionCoordinator.swift:110-111 persists before it verifies, and a
+	 * refused save is failed(keychain) rather than a login. session.cpp's
+	 * persist hook is private to that file, so the failure object is built
+	 * here in the shape that file publishes. */
+	const bool saved = auth::CredentialStore::Instance().Save(CredentialBlob(cookies, refresh_token_));
+
+	/* The Swift closed the window after handing the credentials over
+	 * (WebLoginWindow.swift:186-188). */
+	Close();
+
+	if (!saved) {
+		Emit(json{{"state", "failed"},
+			  {"notice", auth::NoticeRaw(auth::Notice::Keychain)},
+			  {"detail", "the Windows credential store refused to save the login"}});
+		return;
+	}
+
+	/* Then the session verifies it: cookies into the jar, `verifying`,
+	 * Bilibili's nav check, the room lookup, and only then `ready`
+	 * (session-and-login.md §8.2 steps 6-11). Nothing here reports success on
+	 * the page's word. */
+	auth::Session::Instance().Retry();
+}
+
+void LoginWindow::Resize(const json &body)
+{
+	/* AuthWebViewBridge.switchLogin (:71-74) drops non-finite and non-positive
+	 * sizes; WebLoginWindow.swift:160 clamps the rest. */
+	double width = 0;
+	double height = 0;
+	const auto requested_width = body.find("width");
+	if (requested_width != body.end() && requested_width->is_number())
+		width = requested_width->get<double>();
+	const auto requested_height = body.find("height");
+	if (requested_height != body.end() && requested_height->is_number())
+		height = requested_height->get<double>();
+	if (!std::isfinite(width) || !std::isfinite(height) || width <= 0 || height <= 0)
+		return;
+	SetClientSize(std::max(820.0, std::min(width, 1200.0)), std::max(460.0, std::min(height, 900.0)));
+}
