+/* ── the pages, on the main thread and only where they can be hosted ────── */
+
+FailureFn Defaulted(FailureFn failed)
+{
+	if (!failed)
+		failed = [](const std::string &reason) { (void)reason; };
+	return failed;
+}
+
+void ReportFailure(const FailureFn &failed, const std::string &reason)
+{
+	if (failed)
+		failed(reason);
+}
+
+void OpenLoginWindow(const FailureFn &failed)
+{
+	std::string reason;
+	if (!Available(&reason)) {
+		ReportFailure(failed, reason);
+		return;
+	}
+	if (FocusOpenWindow("login"))
+		return;
+	const std::shared_ptr<HostWindow> window = std::make_shared<LoginWindow>(failed);
+	RegisterWindow("login", window);
+	window->Start();
+}
+
+void OpenCoverWindow(const FailureFn &failed)
+{
+	std::string reason;
+	if (!Available(&reason)) {
+		ReportFailure(failed, reason);
+		return;
+	}
+	if (FocusOpenWindow("cover"))
+		return;
+
+	/* BilibiliPages.cover (BilibiliPageWindow.swift:421-426). */
+	PageOptions options;
+	options.key = "cover";
+	options.url = kCoverUrl;
+	options.title = L"直播间封面";
+	options.loading = L"正在载入哔哩哔哩封面管理…";
+	options.ready = L"封面修改后可能需要哔哩哔哩审核";
+	options.width = 1080;
+	options.height = 680;
+	options.cover_host = true;
+	options.on_close = []() { EmitEvent("coverWindowClosed"); };
+
+	const std::shared_ptr<HostWindow> window = std::make_shared<PageWindow>(std::move(options));
+	RegisterWindow("cover", window);
+	window->Start();
+}
+
+void OpenFaceAuthWindow(const std::string &voucher, const FailureFn &failed)
+{
+	std::string reason;
+	if (!Available(&reason)) {
+		ReportFailure(failed, reason);
+		return;
+	}
+	if (FocusOpenWindow("faceAuth"))
+		return;
+
+	/* BilibiliPages.faceAuth (:401-417). */
+	PageOptions options;
+	options.key = "faceAuth";
+	options.url = FaceAuthUrl(voucher);
+	options.title = L"哔哩哔哩开播身份验证";
+	options.loading = L"正在载入哔哩哔哩官方验证页面…";
+	options.ready = L"请按页面提示完成验证，然后点击「验证完成，重试开播」";
+	options.confirm = L"验证完成，重试开播";
+	options.width = 560;
+	options.height = 640;
+	options.close_confirms = true;
+	options.on_confirm = []() { EmitEvent("faceAuthRetry"); };
+	/* The page closes itself when verification ends, and that means "retry
+	 * Go live" (pageClose: .confirm, :415-417). */
+
+	const std::shared_ptr<HostWindow> window = std::make_shared<PageWindow>(std::move(options));
+	RegisterWindow("faceAuth", window);
+	window->Start();
+}
+
+/* Runs `task` on the main thread; `failed` hears when there is no main thread
+ * to run it on. */
+void OnMain(const std::function<void()> &task, const FailureFn &failed)
+{
+	if (dispatch::OnMainThread()) {
+		task();
+		return;
+	}
+	if (!dispatch::Post(task))
+		ReportFailure(failed, "the main thread is not available");
+}
