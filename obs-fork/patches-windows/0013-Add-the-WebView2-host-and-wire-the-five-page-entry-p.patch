+}
+
+/* AuthWebViewBridge.wkWebViewShim (AuthWebViewBridge.swift:33-42), verbatim
+ * except that webkit.messageHandlers becomes the WebView2 message channel and
+ * the frame guard is added: document-created scripts run in every frame, and
+ * the Swift asked for the main frame only (WebLoginWindow.swift:55-56). The
+ * four method names and the `method` / `data` / `width` / `height` keys are
+ * the page's own (session-and-login.md §4.4). */
+constexpr const char *kLoginShim = R"JS((() => {
+  if (window.top !== window || window.livehime_login) return;
+  const post = message => { try { window.chrome.webview.postMessage(message); } catch (e) {} };
+  window.livehime_login = {
+    LoginSuccess: data => post({method: 'LoginSuccess', data}),
+    Cancel: () => post({method: 'Cancel'}),
+    SecondaryValidationResult: () => post({method: 'SecondaryValidationResult'}),
+    SwitchLogin: (width, height) => post({method: 'SwitchLogin', width, height})
+  };
+})();
+)JS";
+
+/* AuthBridgeContract.nativeAuthBridgeScript (AuthBridgeContract.swift:83-96).
+ * WKWebView supplied the Promise through WKScriptMessageHandlerWithReply;
+ * WebView2 has no with-reply handler, so every call carries a correlation id
+ * and the shim resolves or rejects from the reply the host posts back
+ * (session-and-login.md §7.3 row 15). A pending Promise means "host handling
+ * finished", never "login is valid" (AuthBridgeContract.swift:81-82). */
+constexpr const char *kNativeBridgeShim = R"JS((() => {
+  if (window.top !== window || window.biliBridgePc) return;
+  const pending = new Map();
+  let next = 0;
+  window.chrome.webview.addEventListener('message', event => {
+    const data = event.data;
+    if (!data || typeof data !== 'object' || data.livehimeReply === undefined) return;
+    const entry = pending.get(data.livehimeReply);
+    if (!entry) return;
+    pending.delete(data.livehimeReply);
+    if (data.error) entry.reject(new Error(String(data.error)));
+    else entry.resolve({accepted: true});
+  });
+  window.biliBridgePc = {
+    callNative: (action, payload) => {
+      if (!['auth/setRefreshToken', 'auth/setCookies'].includes(action)) {
+        return Promise.reject(new Error('unsupported_action'));
+      }
+      if (window.top !== window) return Promise.reject(new Error('untrusted_origin'));
+      const id = ++next;
+      return new Promise((resolve, reject) => {
+        pending.set(id, {resolve, reject});
+        try {
+          window.chrome.webview.postMessage({livehimeCall: id, action, payload});
+        } catch (e) {
+          pending.delete(id);
+          reject(e);
+        }
+      });
+    }
+  };
+})();
+)JS";
+
+/* BilibiliPageWindow.coverHostScript (BilibiliPageWindow.swift:279-289): the
+ * cover manager reports Cancel and Confirm to the page that embeds it, and
+ * opened on its own it has no parent, so the host stands in for one. */
+constexpr const char *kCoverHostShim = R"JS((() => {
+  if (window.top !== window) return;
+  const host = {
+    postMessage(data) {
+      if (!data || data.type !== 'himeLiveCover') return;
+      window.chrome.webview.postMessage({kind: 'host', action: String(data.action || '')});
+    }
+  };
+  try { window.parent = host; } catch (e) {}
+})();
+)JS";
+
+/* BilibiliPageWindow.diagnosticsScript (BilibiliPageWindow.swift:330-381),
+ * with the WebKit handler replaced by the WebView2 channel and the frame guard
+ * the Swift got from forMainFrameOnly. Failed requests, page errors and toasts
+ * are reported; only a URL's host and path are kept, and a response body is
+ * read no further than the API code and message. */
+constexpr const char *kPageDiagnostics = R"JS((() => {
+  if (window.top !== window) return;
+  const send = message => {
+    try { window.chrome.webview.postMessage({kind: 'log', message: String(message).slice(0, 300)}); } catch (e) {}
+  };
+  const where = url => { try { const u = new URL(url, location.href); return u.host + u.pathname; } catch (e) { return String(url).split('?')[0]; } };
+  const important = url => /upload|\/Cover\/|UpdatePreLiveInfo/.test(url);
+  const result = body => (body && typeof body === 'object' && 'code' in body)
+    ? { ok: body.code === 0, text: ' code=' + body.code + (body.code !== 0 && (body.message || body.msg) ? ' ' + (body.message || body.msg) : '') }
+    : { ok: true, text: '' };
+  const open = XMLHttpRequest.prototype.open, sendXHR = XMLHttpRequest.prototype.send;
+  XMLHttpRequest.prototype.open = function (method, url) { this.__livehime = [method, String(url)]; return open.apply(this, arguments); };
+  XMLHttpRequest.prototype.send = function () {
+    this.addEventListener('loadend', () => {
+      const [method, url] = this.__livehime || ['?', ''];
+      let api = { ok: true, text: '' };
+      try { api = result(this.responseType === 'json' ? this.response : (this.responseType === '' || this.responseType === 'text') ? JSON.parse(this.responseText) : null); } catch (e) {}
+      if (this.status < 200 || this.status >= 300 || !api.ok || important(url)) send(`xhr ${method} ${where(url)} -> ${this.status}${api.text}`);
+    });
+    return sendXHR.apply(this, arguments);
+  };
+  const originalFetch = window.fetch;
+  window.fetch = function (input, init) {
+    const url = typeof input === 'string' ? input : (input && input.url) || '';
+    const method = (init && init.method) || (input && input.method) || 'GET';
+    return originalFetch.apply(this, arguments).then(response => {
+      if (!response.ok || important(url)) {
+        response.clone().json().then(body => send(`fetch ${method} ${where(url)} -> ${response.status}${result(body).text}`),
+                                     () => send(`fetch ${method} ${where(url)} -> ${response.status}`));
+      }
+      return response;
+    }, error => { send(`fetch ${method} ${where(url)} failed: ${error && error.message}`); throw error; });
+  };
+  window.addEventListener('error', event => {
+    const target = event.target;
+    if (target && target !== window && (target.src || target.href)) send('load failed ' + where(target.src || target.href));
+    else send('error ' + event.message);
+  }, true);
+  window.addEventListener('unhandledrejection', event => {
+    const reason = event.reason;
+    send('rejection ' + ((reason && (reason.message || reason.msg)) || reason));
+  });
+  let lastToast = '';
+  new MutationObserver(records => {
+    for (const record of records) for (const node of record.addedNodes) {
+      if (node.nodeType !== 1 || !/toast/i.test(node.className || '')) continue;
+      const text = (node.textContent || '').trim();
+      if (text && text !== lastToast) { lastToast = text; send('toast ' + text); }
+    }
+  }).observe(document, {childList: true, subtree: true});
+})();
+)JS";
