+LRESULT CALLBACK WindowProc(HWND hwnd, UINT message, WPARAM wparam, LPARAM lparam);
+
+/* Everything that differs between the three windows. An empty `status` means
+ * the window has no status line (the login window: WebLoginWindow.swift:47-66
+ * has no label); an empty `confirm` means no confirm button. */
+struct Chrome {
+	std::wstring title;
+	std::wstring status;
+	std::wstring ready;
+	std::wstring confirm;
+	int width = 0;
+	int height = 0;
+	bool resizable = false;
+	bool minimize = false;
+	bool fixed_size = false;
