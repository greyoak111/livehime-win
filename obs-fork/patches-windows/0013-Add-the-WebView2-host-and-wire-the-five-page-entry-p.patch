+/* WebView2 host for the three Bilibili pages the core shows.
+ *
+ * Replaces the three WKWebView hosts of the macOS core:
+ *   WebLoginWindow.swift    the official password / SMS login page
+ *   BilibiliPageWindow.swift the cover manager and the pre-live face
+ *                           verification page
+ *
+ * The pages are Bilibili's own; this module supplies what a browser host has
+ * to supply: the two JS shims the mini-login page expects, the cookie store,
+ * the window/COM plumbing, and the diagnostics the Windows build is verified
+ * through (CONTRACT §9).
+ *
+ * Threading. WebView2 is COM and apartment-threaded ("must run on a Single
+ * Threaded Apartments thread ... All callbacks occur on that thread", Edge's
+ * threading model). Every function here marshals to the OBS main thread — the
+ * UI thread, which libobs already put in an STA before plugins load
+ * (libobs/obs-windows.c:1232-1240) and the thread the C interface promises its
+ * callbacks on (CONTRACT §2) — with dispatch::Post, and creates the
+ * environment, the controller and every other COM object there. Nothing here
+ * touches COM from a worker thread.
+ *
+ * The Evergreen Runtime is a machine-wide component, not something the plugin
+ * bundles (core/win/web/sdk/README.md); Available() answers whether this
+ * machine has it before an entry point promises anything. */
+
+#pragma once
+
+#include <functional>
+#include <string>
+
+namespace livehime {
+namespace web {
+
+/* Reports why a page host could not be created. The entry point appends the
+ * reason to its own honest failure message; `reason` is diagnostic text (the
+ * missing runtime, an HRESULT), never anything the page supplied. */
+using FailureFn = std::function<void(const std::string &reason)>;
+
+/* True when this machine has the WebView2 Evergreen Runtime; the answer is
+ * cached for the process lifetime, because it is a machine component and not
+ * something a running OBS can acquire.
+ *
+ * The probe is the loader's own synchronous runtime check
+ * (GetAvailableCoreWebView2BrowserVersionString). CreateCoreWebView2EnvironmentWithOptions
+ * cannot be used for this test: it is asynchronous and its completion only runs
+ * from this thread's message loop, so waiting for it inside an entry point
+ * would deadlock the UI thread. A runtime that is present but fails to produce
+ * an environment is reported by the Open*() functions through their failure
+ * callback, with the HRESULT, so no window is ever pretended open. When this
+ * returns false, `reason` (when given) says why. */
+bool Available(std::string *reason = nullptr);
+
+/* livehime_core_start_web_login: the official password / SMS page. On success
+ * the login is persisted and verified exactly like a QR login. */
+void OpenLogin(FailureFn failed);
+
+/* livehime_core_open_cover_page / livehime_core_open_face_auth. Both need a
+ * signed-in account: like the Swift's `guard let credentials` they do nothing
+ * at all when there is no login to seed the page with. The face-auth page
+ * emits {"event":"faceAuthRetry"} when the user confirms; the cover manager
+ * emits {"event":"coverWindowClosed"} when it closes. */
+void OpenCoverPage(FailureFn failed);
+void OpenFaceAuth(const std::string &voucher, FailureFn failed);
+
+/* livehime_core_page_eval / livehime_core_page_click, the automation hooks.
+ * The keys are the Swift's: "cover", "faceAuth". `done` runs on the main
+ * thread with the JSON of the script's return value, or {"error":...}. */
+using PageResultFn = std::function<void(const std::string &json)>;
+void EvaluatePage(const std::string &key, const std::string &script, PageResultFn done);
+bool ClickPage(const std::string &key, double x, double y);
+
+} // namespace web
+} // namespace livehime
