+namespace web {
+namespace {
+
+/* ── text ───────────────────────────────────────────────────────────────── */
+
+std::wstring Widen(const std::string &utf8)
+{
+	if (utf8.empty())
+		return {};
+	int length = MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), nullptr, 0);
+	std::wstring wide(static_cast<size_t>(length), L'\0');
+	MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), &wide[0], length);
+	return wide;
+}
+
+std::string Narrow(const std::wstring &wide)
+{
+	if (wide.empty())
+		return {};
+	int length =
+		WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), static_cast<int>(wide.size()), nullptr, 0, nullptr, nullptr);
+	std::string utf8(static_cast<size_t>(length), '\0');
+	WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), static_cast<int>(wide.size()), &utf8[0], length, nullptr, nullptr);
+	return utf8;
+}
+
+std::string LowerAscii(std::string value)
+{
+	for (char &character : value) {
+		if (character >= 'A' && character <= 'Z')
+			character = static_cast<char>(character - 'A' + 'a');
+	}
+	return value;
+}
+
+bool EndsWith(const std::string &value, const std::string &suffix)
+{
+	return value.size() >= suffix.size() &&
+	       value.compare(value.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+/* A JavaScript / JSON string literal for `value`: nlohmann's dumper escapes
+ * what JSON requires and leaves UTF-8 alone, which is also valid JavaScript.
+ * The Swift embedded literals the same way, through JSONSerialization with
+ * .fragmentsAllowed (WebLoginWindow.swift:170-171). */
+std::string JsString(const std::string &value)
+{
+	return json(value).dump();
+}
+
+std::string FormatHresult(HRESULT status)
+{
+	char text[16] = {};
+	std::snprintf(text, sizeof(text), "0x%08lX", static_cast<unsigned long>(status));
+	return text;
+}
+
+/* At most `limit` bytes of `value`, never cutting a UTF-8 sequence in half:
+ * nlohmann's dumper rejects invalid UTF-8. The Swift's `prefix(300)` counted
+ * characters; this is the closest byte-safe equivalent. */
+std::string TruncateUtf8(const std::string &value, size_t limit)
+{
+	if (value.size() <= limit)
+		return value;
+	size_t end = limit;
+	while (end > 0 && (static_cast<unsigned char>(value[end]) & 0xC0) == 0x80)
+		--end;
+	return value.substr(0, end);
+}
+
+/* String(describing:) for the payload values the auth bridge maps
+ * (AuthWebViewBridge.swift:57). Only the timestamp goes through this, but the
+ * mapping is the Swift's for every JSON type. */
+std::string SwiftDescribe(const json &value)
+{
+	if (value.is_string())
+		return value.get<std::string>();
+	if (value.is_null())
+		return "<null>";
+	if (value.is_boolean())
+		return value.get<bool>() ? "true" : "false";
+	return value.dump();
+}
+
+/* String($0.value, radix: 16) for every Unicode scalar of `text`, concatenated
+ * (WebLoginWindow.swift:168): lowercase and unpadded, so a scalar below 16 is
+ * one hex digit. Iterating code points rather than bytes is what makes the
+ * digest the Swift computes (session-and-login.md §4.8). */
+std::string ScalarHex(const std::string &text)
+{
+	std::string out;
+	size_t index = 0;
+	while (index < text.size()) {
+		const unsigned char lead = static_cast<unsigned char>(text[index]);
+		uint32_t scalar = lead;
+		size_t length = 1;
+		if (lead >= 0xF0) {
+			scalar = static_cast<uint32_t>(lead & 0x07);
+			length = 4;
+		} else if (lead >= 0xE0) {
+			scalar = static_cast<uint32_t>(lead & 0x0F);
+			length = 3;
+		} else if (lead >= 0xC0) {
+			scalar = static_cast<uint32_t>(lead & 0x1F);
+			length = 2;
+		}
+		if (index + length > text.size()) {
+			scalar = lead;
+			length = 1;
+		} else {
+			for (size_t extra = 1; extra < length; ++extra)
+				scalar = (scalar << 6) | (static_cast<unsigned char>(text[index + extra]) & 0x3Fu);
+		}
+		char digits[16] = {};
+		std::snprintf(digits, sizeof(digits), "%x", static_cast<unsigned int>(scalar));
+		out += digits;
+		index += length;
+	}
+	return out;
+}
+
+/* ── origin policy ──────────────────────────────────────────────────────── */
+
+/* The two policies the Swift kept separate, kept separate here: the login page
+ * accepts privileged callbacks only from the top-level official page
+ * (AuthBridgeContract.swift:3-9), while the hosted Bilibili pages accept their
+ * own diagnostics from any bilibili.com document
+ * (BilibiliPageWindow.swift:154-158). */
+struct Origin {
+	std::string scheme;
+	std::string host;
+	int port = 0;
+	bool valid = false;
+};
+
+Origin ParseOrigin(const std::string &uri)
+{
+	Origin origin;
+	const size_t scheme_end = uri.find("://");
+	if (scheme_end == std::string::npos)
+		return origin;
+	origin.scheme = LowerAscii(uri.substr(0, scheme_end));
+
+	const size_t begin = scheme_end + 3;
+	const size_t end = uri.find_first_of("/?#", begin);
+	std::string authority = uri.substr(begin, end == std::string::npos ? std::string::npos : end - begin);
+	const size_t userinfo = authority.rfind('@');
+	if (userinfo != std::string::npos)
+		authority.erase(0, userinfo + 1);
+
+	if (!authority.empty() && authority.front() == '[') {
+		const size_t close = authority.find(']');
+		if (close == std::string::npos)
+			return origin;
+		origin.host = LowerAscii(authority.substr(1, close - 1));
+		if (close + 1 < authority.size() && authority[close + 1] == ':')
+			origin.port = std::atoi(authority.c_str() + close + 2);
+	} else {
+		const size_t colon = authority.rfind(':');
+		if (colon == std::string::npos) {
+			origin.host = LowerAscii(authority);
+		} else {
+			origin.host = LowerAscii(authority.substr(0, colon));
+			origin.port = std::atoi(authority.c_str() + colon + 1);
+		}
+	}
+	origin.valid = !origin.host.empty();
+	return origin;
+}
+
+/* AuthBridgeContract.swift:6-9. */
+bool LoginOrigin(const Origin &origin)
+{
+	return origin.valid && origin.scheme == "https" && origin.host == "live.bilibili.com" &&
+	       (origin.port == 0 || origin.port == 443);
+}
+
+/* BilibiliPageWindow.swift:155-158 and isBilibili (:269-272). */
+bool PageOrigin(const Origin &origin)
+{
+	return origin.valid && origin.scheme == "https" &&
+	       (origin.host == "bilibili.com" || EndsWith(origin.host, ".bilibili.com"));
+}
+
+/* Scheme, host and port only. A document URI can carry tokens in its query
+ * string, and this text goes into the UI's log, which keeps host and path and
+ * never a query (BilibiliPageWindow.swift:13-14). */
+std::string OriginText(const Origin &origin)
+{
+	if (!origin.valid)
+		return "(unparsable source)";
+	std::string text = origin.scheme + "://" + origin.host;
+	if (origin.port != 0)
+		text += ":" + std::to_string(origin.port);
+	return text;
+}
+
+/* ── the login session's cookies ────────────────────────────────────────── */
+
+/* QRLogin.swift:7-8 SessionCredentials: the names that survive the filter, of
+ * which the first three are `requiredCookies` — what `isComplete` tests. The
+ * constructor drops empty values (:14-18), so a present-but-empty cookie does
+ * not count as present. */
+constexpr const char *kKeptCookies[] = {"SESSDATA", "bili_jct", "DedeUserID", "DedeUserID__ckMd5", "sid", "buvid3"};
+constexpr const char *kRequiredCookies[] = {"SESSDATA", "bili_jct", "DedeUserID"};
+constexpr const char *kCookieDomain = ".bilibili.com";
+
+using CookieMap = std::map<std::string, std::string>;
+
+bool KeptCookie(const std::string &name)
+{
+	for (const char *kept : kKeptCookies) {
+		if (name == kept)
+			return true;
+	}
+	return false;
+}
+
+bool IsComplete(const CookieMap &cookies)
+{
+	for (const char *required : kRequiredCookies) {
+		const auto found = cookies.find(required);
+		if (found == cookies.end() || found->second.empty())
+			return false;
+	}
+	return true;
+}
+
+/* AuthCookieBatch (AuthBridgeContract.swift:39-77). Control characters are
+ * the ASCII range here; Foundation's set also covers the Unicode Cf code
+ * points, which a cookie name or value cannot realistically carry. */
+bool HasControl(const std::string &value)
+{
+	for (const char raw : value) {
+		const unsigned char byte = static_cast<unsigned char>(raw);
+		if (byte < 0x20 || byte == 0x7F)
+			return true;
+	}
+	return false;
+}
+
+struct CookieOperation {
+	std::string name;
+	std::string value;
+	bool remove = false;
+};
+
+/* The whole batch is validated before anything is written
+ * (AuthBridgeContract.swift:39-40), and one bad item is one malformed_payload
+ * for the batch. Domain, path and secure are forced by the caller. */
+bool ParseCookieBatch(const json &payload, std::vector<CookieOperation> &operations)
+{
+	if (!payload.is_array() || payload.size() > 128)
+		return false;
+	const double now = static_cast<double>(std::time(nullptr));
+	for (const json &item : payload) {
+		if (!item.is_object())
+			return false;
+		const auto name = item.find("name");
+		const auto value = item.find("value");
+		if (name == item.end() || !name->is_string() || value == item.end() || !value->is_string())
+			return false;
+
+		CookieOperation operation;
+		operation.name = name->get<std::string>();
+		operation.value = value->get<std::string>();
+		if (operation.name.empty() || operation.name.size() > 256 || operation.value.size() > 16384)
+			return false;
+		if (HasControl(operation.name) || HasControl(operation.value))
+			return false;
+		if (operation.name.find(';') != std::string::npos || operation.name.find('=') != std::string::npos)
+			return false;
+
+		/* An expirationDate that is not a number is ignored, exactly as the
+		 * Swift's `as? NSNumber` ignores it; `remove` needs the expiry to be
+		 * past AND isExpiredRemove to be true (:65-70). */
+		const auto expiry = item.find("expirationDate");
+		if (expiry != item.end() && expiry->is_number()) {
+			const auto remove = item.find("isExpiredRemove");
+			operation.remove = expiry->get<double>() <= now && remove != item.end() &&
+					   remove->is_boolean() && remove->get<bool>();
+		}
+		operations.push_back(std::move(operation));
+	}
+	return true;
+}
+
+/* ── the credential blob ────────────────────────────────────────────────── */
+
+/* session.cpp's EncodeBlob is private to that file, and the web login has to
+ * persist before the session can verify the login (Swift SC:110-111 saves
+ * first, then emits verifying). The envelope therefore repeats that file's
+ * shape: CredentialStore.swift:26 version 2, SessionCredentials' Codable field
+ * names, and `savedAt` in seconds since 2001-01-01 (session-and-login.md
+ * §5.1). The blob is a secret: it goes to the vault and is never logged. */
+constexpr int kEnvelopeVersion = 2;
+constexpr long long kReferenceDateUnix = 978307200;
+
+std::string CredentialBlob(const CookieMap &cookies, const std::string &refresh_token)
+{
+	const json stored{{"cookies", cookies},
+			  {"refreshToken", refresh_token},
+			  {"savedAt", static_cast<long long>(std::time(nullptr)) - kReferenceDateUnix}};
+	return json{{"schemaVersion", kEnvelopeVersion}, {"credentials", stored}}.dump();
+}
+
+/* ── the device id the login page copies into a cookie ──────────────────── */
+
+/* WebLoginWindow.swift:74-87: a 32-hex-character id generated once per install
+ * and then reused, because the page writes it into a cookie the backend checks
+ * after verification. Windows has no UserDefaults; the registry is the
+ * platform's per-user, per-install store (session-and-login.md §7.4 row 27).
+ * Sign-out does not clear it (WebLoginWindow.swift:830). */
+constexpr const wchar_t *kSettingsKey = L"Software\\LiveHime";
+constexpr const wchar_t *kBuvidValue = L"buvid3";
+
+std::string DeviceBuvid3()
+{
+	std::wstring stored(64, L'\0');
+	DWORD size = static_cast<DWORD>(stored.size() * sizeof(wchar_t));
+	DWORD type = 0;
+	HKEY key = nullptr;
+	if (RegOpenKeyExW(HKEY_CURRENT_USER, kSettingsKey, 0, KEY_QUERY_VALUE, &key) == ERROR_SUCCESS) {
+		const LONG status =
+			RegQueryValueExW(key, kBuvidValue, nullptr, &type, reinterpret_cast<LPBYTE>(&stored[0]), &size);
+		RegCloseKey(key);
+		if (status == ERROR_SUCCESS && type == REG_SZ && size > sizeof(wchar_t)) {
+			stored.resize(size / sizeof(wchar_t));
+			while (!stored.empty() && stored.back() == L'\0')
+				stored.pop_back();
+			if (!stored.empty())
+				return Narrow(stored);
+		}
+	}
+
+	const std::vector<uint8_t> random = crypto::RandomBytes(16);
+	const std::string fresh = crypto::ToHex(random.data(), random.size());
+	if (RegCreateKeyExW(HKEY_CURRENT_USER, kSettingsKey, 0, nullptr, 0, KEY_SET_VALUE, nullptr, &key, nullptr) ==
+	    ERROR_SUCCESS) {
+		const std::wstring wide = Widen(fresh);
+		RegSetValueExW(key, kBuvidValue, 0, REG_SZ, reinterpret_cast<const BYTE *>(wide.c_str()),
+			       static_cast<DWORD>((wide.size() + 1) * sizeof(wchar_t)));
+		RegCloseKey(key);
+	}
+	return fresh;
+}
+
+/* ── a delay that lands back on the main thread ─────────────────────────── */
+
+/* The Swift used DispatchQueue.main.asyncAfter for the cookie read-back retry
+ * (WebLoginWindow.swift:190) and the cover toast (BilibiliPageWindow.swift:
+ * 171). Same shape as session.cpp's poll tick: a one-shot timer-queue timer
+ * whose callback only posts the continuation to the dispatch window. */
+HANDLE TimerQueue()
+{
+	static HANDLE queue = CreateTimerQueue();
+	return queue;
+}
+
+void CALLBACK DelayFired(PVOID parameter, BOOLEAN)
+{
+	std::unique_ptr<std::function<void()>> task(static_cast<std::function<void()> *>(parameter));
+	dispatch::Post([copy = *task]() { copy(); });
+}
+
+void ScheduleAfter(unsigned milliseconds, std::function<void()> task)
+{
+	auto *holder = new std::function<void()>(std::move(task));
+	HANDLE timer = nullptr;
+	if (!CreateTimerQueueTimer(&timer, TimerQueue(), &DelayFired, holder, milliseconds, 0, WT_EXECUTEONLYONCE)) {
+		delete holder;
+		return;
+	}
+}
+
+/* ── the throwaway profile a page lives in ──────────────────────────────── */
+
+/* WebLoginWindow.swift:43 and BilibiliPageWindow.swift:72 both use a
+ * .nonPersistent() store: nothing the page writes outlives its window. This
+ * SDK has no in-private switch, so the counterpart is a dedicated user-data
+ * folder under %TEMP% that is deleted when the window closes
+ * (session-and-login.md §7.3 row 11). The empty string means "could not be
+ * created": the host then fails honestly rather than letting WebView2 fall
+ * back to a folder next to obs64.exe. */
+std::wstring ProfileFolder()
+{
+	std::wstring temp(MAX_PATH, L'\0');
+	const DWORD length = GetTempPathW(static_cast<DWORD>(temp.size()), &temp[0]);
+	if (length == 0 || static_cast<size_t>(length) >= temp.size())
+		return {};
+	temp.resize(length);
+
+	std::wstring base = temp + L"LiveHime";
+	CreateDirectoryW(base.c_str(), nullptr);
+	base += L"\\webview";
+	CreateDirectoryW(base.c_str(), nullptr);
+
+	const std::vector<uint8_t> random = crypto::RandomBytes(8);
+	const std::wstring folder = base + L"\\" + Widen(crypto::ToHex(random.data(), random.size()));
+	CreateDirectoryW(folder.c_str(), nullptr);
+	return folder;
+}
+
+bool FolderExists(const std::wstring &folder)
+{
+	const DWORD attributes = GetFileAttributesW(folder.c_str());
+	return attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+}
+
+bool DeleteTree(const std::wstring &folder)
+{
+	const std::wstring pattern = folder + L"\\*";
+	WIN32_FIND_DATAW data = {};
+	HANDLE find = FindFirstFileW(pattern.c_str(), &data);
+	if (find != INVALID_HANDLE_VALUE) {
+		do {
+			const std::wstring name = data.cFileName;
+			if (name == L"." || name == L"..")
+				continue;
+			const std::wstring child = folder + L"\\" + name;
+			if ((data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0)
+				DeleteTree(child);
+			else
+				DeleteFileW(child.c_str());
+		} while (FindNextFileW(find, &data));
+		FindClose(find);
+	}
+	return RemoveDirectoryW(folder.c_str()) != FALSE;
+}
+
+/* The browser process releases the profile asynchronously after the controller
+ * closes, so the removal retries for a few seconds on its own thread. A folder
+ * that stays behind is %TEMP%'s to clean up, not a failure the UI should hear
+ * about. */
+void DeleteFolder(const std::wstring &folder)
+{
+	if (folder.empty())
+		return;
+	std::thread([folder]() {
+		for (int attempt = 0; attempt < 25; ++attempt) {
+			if (DeleteTree(folder) || !FolderExists(folder))
+				return;
+			Sleep(200);
+		}
+	}).detach();
+}
