+
+/* ── the interface webview.h declares ───────────────────────────────────── */
+
+bool Available(std::string *reason)
+{
+	static const std::string missing = "the WebView2 Evergreen Runtime is not installed on this machine";
+	static const bool present = []() {
+		LPWSTR version = nullptr;
+		const HRESULT status = GetAvailableCoreWebView2BrowserVersionString(nullptr, &version);
+		const bool found = SUCCEEDED(status) && version != nullptr && *version != L'\0';
+		if (version)
+			CoTaskMemFree(version);
+		return found;
+	}();
+	if (!present && reason)
+		*reason = missing;
+	return present;
+}
+
+void OpenLogin(FailureFn failed)
+{
+	FailureFn report = Defaulted(std::move(failed));
+	OnMain([report]() { OpenLoginWindow(report); }, report);
+}
+
+void OpenCoverPage(FailureFn failed)
+{
+	FailureFn report = Defaulted(std::move(failed));
+	OnMain([report]() { OpenCoverWindow(report); }, report);
+}
+
+void OpenFaceAuth(const std::string &voucher, FailureFn failed)
+{
+	FailureFn report = Defaulted(std::move(failed));
+	OnMain([voucher, report]() { OpenFaceAuthWindow(voucher, report); }, report);
+}
+
+void EvaluatePage(const std::string &key, const std::string &script, PageResultFn done)
+{
+	if (!done)
+		return;
+	if (!dispatch::OnMainThread()) {
+		/* The automation vendor waits for `done` on its own thread
+		 * (automation.cpp:371-385), so posting is how a caller that is not on
+		 * the main thread still gets its answer there. */
+		if (!dispatch::Post([key, script, done]() { EvaluatePage(key, script, done); }))
+			done("{\"error\":\"the main thread is not available\"}");
+		return;
+	}
+	const std::shared_ptr<HostWindow> window = FindWindow(key);
+	if (!window) {
+		/* BilibiliPageWindow.page_eval (BilibiliPageWindow.swift:559-566). */
+		done("{\"error\":\"page not open\"}");
+		return;
+	}
+	window->Evaluate(script, done);
+}
+
+bool ClickPage(const std::string &key, double x, double y)
+{
+	/* This hook answers synchronously and injects OS input rather than
+	 * touching COM, so a call from anywhere but the main thread reports "not
+	 * clicked" instead of queueing a click the caller can no longer see. */
+	if (!dispatch::OnMainThread())
+		return false;
+	const std::shared_ptr<HostWindow> window = FindWindow(key);
+	if (!window)
+		return false; /* BilibiliPageWindow.swift:573 */
+	return window->Click(x, y);
+}
