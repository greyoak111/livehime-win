+/* ── the Bilibili pages ─────────────────────────────────────────────────── */
+
+struct PageOptions {
+	std::string key;
+	std::string url;
+	std::wstring title;
+	std::wstring loading;
+	std::wstring ready;
+	std::wstring confirm;
+	int width = 0;
+	int height = 0;
+	bool cover_host = false;
+	bool close_confirms = false;
+	std::function<void()> on_close;
+	std::function<void()> on_confirm;
+};
+
+Chrome PageChrome(const PageOptions &options)
+{
+	Chrome chrome;
+	chrome.title = options.title;
+	chrome.status = options.loading;
+	chrome.ready = options.ready;
+	chrome.confirm = options.confirm;
+	chrome.width = options.width;
+	chrome.height = options.height;
+	chrome.resizable = true;
+	chrome.on_close = options.on_close;
+	chrome.on_confirm = options.on_confirm;
+	return chrome;
+}
+
+class PageWindow final : public HostWindow {
+public:
+	explicit PageWindow(PageOptions options)
+		: HostWindow(options.key, PageChrome(options)), options_(std::move(options))
+	{
+	}
+
+protected:
+	std::vector<std::string> DocumentScripts() const override
+	{
+		/* BilibiliPageWindow.swift:74-81. The WebKit compatibility script of
+		 * :300-325 does not come along: it works around two WebKit bugs (a
+		 * garbage-collected file input, a query on a blob: URL) that the
+		 * Windows client's Chromium never had, and these pages were written for
+		 * Chromium. */
+		std::vector<std::string> scripts{kPageDiagnostics};
+		if (options_.cover_host)
+			scripts.push_back(kCoverHostShim);
+		return scripts;
+	}
+
+	void Ready() override { SeedCookies(); }
+
+	bool Accepts(const Origin &origin) const override { return PageOrigin(origin); }
+
+	bool NavigatesHere(const std::string &url) override { return PageOrigin(ParseOrigin(url)); }
+
+	void Message(const json &body, const Origin &origin) override;
+
+	void NavigationFinished(bool success) override
+	{
+		/* BilibiliPageWindow.swift:182-192. */
+		SetStatus(success ? options_.ready : L"页面加载失败，请关闭后重试");
+	}
+
+	void CloseRequested() override
+	{
+		/* The page's own window.close() (BilibiliPageWindow.swift:215-220). */
+		if (options_.close_confirms)
+			Confirm();
+		else
+			Close();
+	}
+
+private:
+	void SeedCookies();
+	void Log(const std::string &message);
+
+	PageOptions options_;
+};
+
+void PageWindow::Message(const json &body, const Origin &origin)
+{
+	(void)origin; /* the caller already checked it */
+	/* BilibiliPageWindow.userContentController (:154-178). */
+	const auto kind = body.find("kind");
+	if (kind == body.end() || !kind->is_string())
+		return;
+	const std::string what = kind->get<std::string>();
+	if (what == "log") {
+		std::string message;
+		const auto text = body.find("message");
+		if (text != body.end() && text->is_string())
+			message = text->get<std::string>();
+		Log(TruncateUtf8(message, 300));
+	} else if (what == "host" && options_.cover_host) {
+		std::string action;
+		const auto value = body.find("action");
+		if (value != body.end() && value->is_string())
+			action = value->get<std::string>();
+		Log("host " + action);
+		if (action == "cancel") {
+			Close();
+		} else if (action == "confirm") {
+			/* Leave the page's "uploaded, awaiting review" toast readable
+			 * (BilibiliPageWindow.swift:169-171). */
+			SetStatus(L"封面已提交，等待哔哩哔哩审核");
+			ScheduleAfter(1500, [self = Shared()]() { self->Confirm(); });
+		}
+	}
+}
+
+void PageWindow::Log(const std::string &message)
+{
+	EmitEvent("pageLog", json{{"page", options_.key}, {"message", message}});
+}
+
+void PageWindow::SeedCookies()
+{
+	/* BilibiliPageWindow.load (:122-133): the session's cookies are copied
+	 * into the page's own store, then the page loads. The jar is the C++
+	 * counterpart of `coordinator.credentials` — session.cpp fills it before it
+	 * publishes `verifying` and clears it wherever a login goes away. */
+	const auto cookies = net::CookieJar::Instance().All();
+	if (cookies.empty()) {
+		/* The Swift's `guard let credentials … else { return }`: there is no
+		 * account to show this page for. The window was never shown, so it also
+		 * reports no close (Teardown checks shown_). */
+		Close();
+		return;
+	}
+
+	ICoreWebView2CookieManager *manager = CookieManager();
+	if (!manager) {
+		Navigate(options_.url);
+		return;
+	}
+	for (const auto &cookie : cookies) {
+		ComPtr<ICoreWebView2Cookie> created;
+		if (FAILED(manager->CreateCookie(Widen(cookie.first).c_str(), Widen(cookie.second).c_str(),
+						 L".bilibili.com", L"/", &created)) ||
+		    !created)
+			continue;
+		created->put_IsSecure(TRUE);
+		manager->AddOrUpdateCookie(created.Get());
+	}
+
+	/* AddOrUpdateCookie has no completion handler, so the read-back is the only
+	 * round trip that proves the writes reached the browser process; the page
+	 * is loaded from that answer and never before it
+	 * (session-and-login.md §7.3 row 17). An answer that failed still loads the
+	 * page: the cookies were issued, and a page that ends up signed out is
+	 * visible to the user, which beats a window that never loads. */
+	const std::string url = options_.url;
+	manager->GetCookies(nullptr, Callback<ICoreWebView2GetCookiesCompletedHandler>(
+					     [self = std::static_pointer_cast<PageWindow>(Shared()), url](
+						     HRESULT, ICoreWebView2CookieList *) -> HRESULT {
+						     self->Navigate(url);
+						     return S_OK;
+					     })
+					     .Get());
+}
+
+/* ── the open windows ───────────────────────────────────────────────────── */
+
+std::map<std::string, std::shared_ptr<HostWindow>> g_windows;
+
+void RegisterWindow(const std::string &key, const std::shared_ptr<HostWindow> &window)
+{
+	g_windows[key] = window;
+}
+
+void UnregisterWindow(const HostWindow *window)
+{
+	for (auto entry = g_windows.begin(); entry != g_windows.end(); ++entry) {
+		if (entry->second.get() == window) {
+			g_windows.erase(entry);
+			return;
+		}
+	}
+}
+
+std::shared_ptr<HostWindow> FindWindow(const std::string &key)
+{
+	const auto found = g_windows.find(key);
+	return found == g_windows.end() ? nullptr : found->second;
+}
+
+bool FocusOpenWindow(const std::string &key)
+{
+	const std::shared_ptr<HostWindow> window = FindWindow(key);
+	if (!window || !window->Live())
+		return false;
+	window->BringToFront();
+	return true;
+}
