+/* The vendored WebView2.h is MIDL-generated (core/win/web/sdk/README.md); a
+ * generated header should not decide whether the presets' /WX build fails. */
+#pragma warning(disable : 4061 4062 4191 4265 4365 4471 4514 4710 4820)
