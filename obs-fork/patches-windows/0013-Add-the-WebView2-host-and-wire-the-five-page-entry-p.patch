+/* WebView2 host — the C++ counterpart of WebLoginWindow.swift and
+ * BilibiliPageWindow.swift. The interface and the threading rules are in
+ * webview.h; this file is the COM and window plumbing.
+ *
+ * What each page needs, and where it comes from:
+ *
+ *   mini-login page  window.browser before it loads (WebLoginWindow.swift:75-87),
+ *                    the livehime_login shim (AuthWebViewBridge.swift:33-42),
+ *                    the biliBridgePc shim after every navigation
+ *                    (AuthBridgeContract.swift:83-96), the cookie read-back
+ *                    (:178-195) and correspond/0 seeding (:166-174).
+ *   cover manager    a stand-in parent for its Cancel/Confirm messages
+ *                    (BilibiliPageWindow.swift:279-289) and the page log
+ *                    (:330-381).
+ *   face-auth page   the same log, a confirm button, and window.close()
+ *                    meaning "confirmed" (:215-220).
+ *
+ * Three WebView2 differences from WKWebView shape the code below, all of them
+ * from session-and-login.md §7.3:
+ *
+ *  12. Document-created scripts run in every frame; there is no
+ *      main-frame-only flag. Every injected script starts with a
+ *      `window.top === window` guard, and the host checks the origin of every
+ *      message it receives.
+ *  15. There is no with-reply message handler, so biliBridgePc.callNative gets
+ *      a correlation id and a Promise the shim resolves from the reply the
+ *      host posts back.
+ *  16. A web message carries no per-message main-frame flag, so the frame gate
+ *      lives in the shim and the origin gate lives here. */
+
+#include "webview.h"
+
+#include "auth/credentials.h"
+#include "auth/session.h"
+#include "core/emit.h"
+#include "net/cookies.h"
