-			done(ServerFailure("invalidResponse"));
+			done(ServerFailure("fingerprintHasNoBuvid3"));
 			return;
 		}
 		/* The Swift sends the rest of this request chain with a temporary
@@ -1705,7 +1705,13 @@ void FetchDanmakuInfo(long long room_id, long long uid, DanmakuInfoFn done)
 				const json *hosts = ObjectArrayField(data, "host_list");
 				auto token = FieldString(data, {"token"});
 				if (!data.is_object() || !hosts || !token) {
-					Deliver(done, Fail<DanmakuConnectInfo>(ServerFailure("invalidResponse")));
+					/* Named rather than a bare invalidResponse: this
+					 * chain has four places that can say that, and a
+					 * live run has to be able to tell them apart. */
+					Deliver(done, Fail<DanmakuConnectInfo>(ServerFailure(
+						!data.is_object() ? "danmuInfoDataMissing"
+								  : (!hosts ? "danmuInfoHostListMissing"
+									    : "danmuInfoTokenMissing"))));
 					return;
 				}
 				/* The Swift keeps every host (DanmakuConnectInfo.servers,
@@ -1733,7 +1739,7 @@ void FetchDanmakuInfo(long long room_id, long long uid, DanmakuInfoFn done)
 					break;
 				}
 				if (!found) {
-					Deliver(done, Fail<DanmakuConnectInfo>(ServerFailure("invalidResponse")));
+					Deliver(done, Fail<DanmakuConnectInfo>(ServerFailure("danmuInfoNoNamedHost")));
 					return;
 				}
 				Deliver(done, Ok(info));
