+/* ── the picture re-encode (Emoticons.swift:203-214) ────────────────────── */
+
+/* :208: kCGImageSourceThumbnailMaxPixelSize — the longest side of the box. */
+constexpr UINT kMaxImageSide = 160;
+
+/* WIC is COM and COM belongs to a thread. This one is constructed on the
+ * encode thread below and never on the main thread: libobs already owns an
+ * apartment there, and OBS's UI must not sit through a decode anyway.
+ * S_FALSE ("already initialised on this thread") is a successful call like
+ * S_OK and is balanced in the destructor; RPC_E_CHANGED_MODE is a failure and
+ * must not be, because COM is initialised in somebody else's apartment and
+ * WIC works from that one too. */
+class ComApartment {
+public:
+	ComApartment() { initialized_ = SUCCEEDED(CoInitializeEx(nullptr, COINIT_MULTITHREADED)); }
+	~ComApartment()
+	{
+		if (initialized_)
+			CoUninitialize();
+	}
+	ComApartment(const ComApartment &) = delete;
+	ComApartment &operator=(const ComApartment &) = delete;
+
+private:
+	bool initialized_ = false;
+};
+
+/* :203-214 with WIC where ImageIO was: the first frame, scaled into a 160 px
+ * box with the aspect ratio kept, encoded as PNG. False means WIC could not
+ * decode or encode this container — an animated WebP is the likely one — and
+ * the caller caches the downloaded bytes instead. */
+bool SmallPng(const std::string &bytes, std::string &png)
+{
+	Microsoft::WRL::ComPtr<IWICImagingFactory> factory;
+	if (FAILED(CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER, IID_IWICImagingFactory,
+	                            reinterpret_cast<void **>(factory.GetAddressOf()))) ||
+	    factory.Get() == nullptr)
+		return false;
+
+	/* SHCreateMemStream hands its own reference to the caller, which is what
+	 * Attach takes; the AddRef'ing constructor would leak it. The bytes stay
+	 * alive in `bytes` for as long as the decoder can read them. */
+	Microsoft::WRL::ComPtr<IStream> source;
+	source.Attach(SHCreateMemStream(reinterpret_cast<const BYTE *>(bytes.data()), static_cast<UINT>(bytes.size())));
+	if (source.Get() == nullptr)
+		return false;
+
+	Microsoft::WRL::ComPtr<IWICBitmapDecoder> decoder;
+	if (FAILED(factory->CreateDecoderFromStream(source.Get(), nullptr, WICDecodeMetadataCacheOnDemand,
+	                                            decoder.GetAddressOf())))
+		return false;
+
+	/* :204-209 reads index 0 only, so an animation keeps its first frame and
+	 * loses the rest. */
+	Microsoft::WRL::ComPtr<IWICBitmapFrameDecode> frame;
+	if (FAILED(decoder->GetFrame(0, frame.GetAddressOf())))
+		return false;
+
+	Microsoft::WRL::ComPtr<IWICFormatConverter> converted;
+	if (FAILED(factory->CreateFormatConverter(converted.GetAddressOf())))
+		return false;
+	if (FAILED(converted->Initialize(frame.Get(), GUID_WICPixelFormat32bppBGRA, WICBitmapDitherTypeNone, nullptr, 0.0,
+	                                 WICBitmapPaletteTypeCustom)))
+		return false;
+
+	UINT width = 0;
+	UINT height = 0;
+	if (FAILED(converted->GetSize(&width, &height)) || width == 0 || height == 0)
+		return false;
+
+	/* What the encoder reads: the converted frame, or the scaler when the
+	 * picture is larger than the box. One already inside it is not scaled up
+	 * but still goes through the encoder, so the cached file is a real PNG. */
+	IWICBitmapSource *pixels = converted.Get();
+	Microsoft::WRL::ComPtr<IWICBitmapScaler> scaler;
+	if (width > kMaxImageSide || height > kMaxImageSide) {
+		const double factor = static_cast<double>(kMaxImageSide) / static_cast<double>(std::max(width, height));
+		width = std::max<UINT>(1, static_cast<UINT>(static_cast<double>(width) * factor + 0.5));
+		height = std::max<UINT>(1, static_cast<UINT>(static_cast<double>(height) * factor + 0.5));
+		if (FAILED(factory->CreateBitmapScaler(scaler.GetAddressOf())))
+			return false;
+		if (FAILED(scaler->Initialize(converted.Get(), width, height, WICBitmapInterpolationModeFant)))
+			return false;
+		pixels = scaler.Get();
+	}
+
+	/* :210-213: CGImageDestination into an NSMutableData. Here the encoder
+	 * writes through an IWICStream into a memory stream that is read back
+	 * afterwards. */
+	Microsoft::WRL::ComPtr<IStream> output;
+	output.Attach(SHCreateMemStream(nullptr, 0));
+	if (output.Get() == nullptr)
+		return false;
+
+	Microsoft::WRL::ComPtr<IWICStream> stream;
+	if (FAILED(factory->CreateStream(stream.GetAddressOf())))
+		return false;
+	if (FAILED(stream->InitializeFromIStream(output.Get())))
+		return false;
+
+	Microsoft::WRL::ComPtr<IWICBitmapEncoder> encoder;
+	if (FAILED(factory->CreateEncoder(GUID_ContainerFormatPng, nullptr, encoder.GetAddressOf())))
+		return false;
+	if (FAILED(encoder->Initialize(stream.Get(), WICBitmapEncoderNoCache)))
+		return false;
+
+	Microsoft::WRL::ComPtr<IWICBitmapFrameEncode> target;
+	Microsoft::WRL::ComPtr<IPropertyBag2> options;
+	if (FAILED(encoder->CreateNewFrame(target.GetAddressOf(), options.GetAddressOf())))
+		return false;
+	if (FAILED(target->Initialize(options.Get())))
+		return false;
+	if (FAILED(target->SetSize(width, height)))
+		return false;
+	WICPixelFormatGUID format = GUID_WICPixelFormat32bppBGRA;
+	if (FAILED(target->SetPixelFormat(&format)))
+		return false;
+	if (FAILED(target->WriteSource(pixels, nullptr)))
+		return false;
+	if (FAILED(target->Commit()))
+		return false;
+	if (FAILED(encoder->Commit()))
+		return false;
+
+	/* Read the PNG back out of the stream the encoder wrote through. An empty
+	 * result is a failure like any other, so the caller keeps the original. */
+	png.clear();
+	LARGE_INTEGER beginning = {};
+	if (FAILED(output->Seek(beginning, STREAM_SEEK_SET, nullptr)))
+		return false;
+	char chunk[64 * 1024];
+	for (;;) {
+		ULONG read = 0;
+		if (FAILED(output->Read(chunk, static_cast<ULONG>(sizeof(chunk)), &read)))
+			return false;
+		if (read == 0)
+			break;
+		png.append(chunk, read);
+	}
+	return !png.empty();
+}
+
+/* One picture waiting for the encode thread. */
+struct ImageJob {
+	std::filesystem::path target;
+	std::string source;
+	std::string url;
+};
+
+/* The net callback below runs on the main thread (net/http.h) and a decode is
+ * tens of milliseconds for a large picture, so the work moves to one thread of
+ * this file's own: the frozen net/ layer cannot be asked to carry a COM
+ * apartment on its workers. */
+std::mutex g_encode_mutex;
+std::condition_variable g_encode_cv;
+std::deque<ImageJob> g_encode_queue;
+bool g_encode_stopping = false;
+std::thread g_encode_thread;
+
+void EncodeLoop()
+{
+	/* This thread's apartment, alive for as long as the thread is. */
+	ComApartment apartment;
+	for (;;) {
+		ImageJob job;
+		{
+			std::unique_lock<std::mutex> lock(g_encode_mutex);
+			g_encode_cv.wait(lock, [] { return g_encode_stopping || !g_encode_queue.empty(); });
+			if (g_encode_queue.empty()) {
+				if (g_encode_stopping)
+					return;
+				continue;
+			}
+			job = std::move(g_encode_queue.front());
+			g_encode_queue.pop_front();
+		}
+
+		/* :203-214. A container WIC cannot handle keeps the downloaded bytes
+		 * exactly as they arrived, so a codec never loses the picture: the
+		 * file is then whatever the host served, as it was before the
+		 * re-encode existed. The name stays the hash of the downloaded bytes
+		 * either way (CacheFile), so a picture is not re-downloaded when this
+		 * path changes. */
+		std::string png;
+		const bool encoded = SmallPng(job.source, png);
+		const bool wrote = WriteCacheFile(job.target, encoded ? png : job.source);
+		const std::string url = job.url;
+		const std::string path = wrote ? job.target.u8string() : std::string();
+		const ApiError error = wrote ? ApiError{} : ServerFailure("cacheWriteFailed");
+		/* g_image_waiters is main-thread-only, so the answer goes back there;
+		 * the file is already on disk by the time it arrives. */
+		dispatch::Post([url, path, error]() { DeliverImage(url, path, error); });
+	}
+}
+
+/* Starts the encode thread on first use. False when it could not be started at
+ * all, which leaves the caller to cache the bytes as they are. */
+bool EnqueueImageEncode(ImageJob job)
+{
+	{
+		std::lock_guard<std::mutex> lock(g_encode_mutex);
+		if (g_encode_stopping)
+			return false;
+		if (!g_encode_thread.joinable()) {
+			try {
+				g_encode_thread = std::thread(EncodeLoop);
+			} catch (const std::system_error &) {
+				return false;
+			}
+		}
+		g_encode_queue.push_back(std::move(job));
+	}
+	g_encode_cv.notify_one();
+	return true;
+}
+
+/* Joins the encode thread when the DLL unloads: a worker still inside the
+ * plugin's code after DllMain(DETACH) would run unmapped memory. Declared
+ * after the state it touches, so it is destroyed while that state is alive. */
+struct EncodeThreadShutdown {
+	~EncodeThreadShutdown()
+	{
+		/* The handle is taken under the lock, but the join happens after it:
+		 * the thread has to re-enter the wait to see the flag, so holding the
+		 * mutex through the join would deadlock. */
+		std::thread worker;
+		{
+			std::lock_guard<std::mutex> lock(g_encode_mutex);
+			g_encode_stopping = true;
+			worker = std::move(g_encode_thread);
+		}
+		g_encode_cv.notify_all();
+		if (worker.joinable())
+			worker.join();
+	}
+};
+EncodeThreadShutdown g_encode_thread_shutdown;
+
