+/* ── the state the Updates tab sees (main thread only) ──────────────────── */
+
+std::optional<Release> g_release; /* what the last check found */
+std::filesystem::path g_staged;   /* the verified staged tree, empty when none */
+std::string g_staged_version;     /* the version that tree holds */
+bool g_busy = false;              /* a check or a download is running */
+bool g_cleaned = false;           /* leftovers of earlier updates were removed */
+
+/* AppUpdateBridge.swift:22-27: the release fields, plus the OBS version of the
+ * staged tree so the tab can say an OBS upgrade is coming. */
+nlohmann::json ReleaseFields(const Release &release)
+{
+	nlohmann::json fields{{"version", release.version},
+			      {"notes", release.notes},
+			      {"page", release.page},
+			      {"size", release.size},
+			      {"prerelease", release.prerelease}};
+	if (!g_staged.empty()) {
+		const AppInfo staged = ReadApp(ExeIn(g_staged));
+		if (!staged.obs.empty())
+			fields["obsNew"] = staged.obs;
+	}
+	return fields;
+}
+
+/* Which directory inside the unpacked archive is the tree: its top level, or
+ * the single folder wrapping everything, which is how AppUpdater.swift:258-261
+ * found the one .app in the unpacked folder. */
+bool StagedRoot(const std::filesystem::path &unpacked, std::filesystem::path &root, Failure &failure)
+{
+	std::error_code ec;
+	if (std::filesystem::exists(ExeIn(unpacked), ec) && !ec) {
+		root = unpacked;
+		return true;
+	}
+
+	std::filesystem::path found;
+	int matches = 0;
+	/* Stepped with the error_code overload rather than a range-for, so a
+	 * directory that cannot be read reports a failure instead of throwing out
+	 * of the worker thread. */
+	std::filesystem::directory_iterator it(unpacked, ec), end;
+	for (; !ec && it != end; it.increment(ec)) {
+		const std::filesystem::directory_entry &entry = *it;
+		std::error_code inner;
+		if (!entry.is_directory(inner) || inner)
+			continue;
+		if (std::filesystem::exists(ExeIn(entry.path()), inner) && !inner) {
+			found = entry.path();
+			++matches;
+		}
+	}
+	if (ec || matches != 1) {
+		failure = InvalidApp("the archive does not hold bin\\64bit\\obs64.exe");
+		return false;
+	}
+	root = found;
+	return true;
+}
+
+/* AppUpdater.swift:276-296 without the code signature it cannot check here
+ * (update/updater.h): the same app (the product name is Windows' nearest
+ * equivalent of the bundle identifier), at the version the release names, built
+ * for the machine this process runs on. */
+bool VerifyTree(const std::filesystem::path &root, const std::string &version, Failure &failure)
+{
+	const AppInfo &app = ThisApp();
+	const AppInfo staged = ReadApp(ExeIn(root));
+
+	if (staged.product.empty()) {
+		failure = InvalidApp("the new version has no readable version resource");
+		return false;
+	}
+	if (app.name.empty() || staged.name != app.name) {
+		failure = InvalidApp("the new version is \"" + staged.name + "\", not \"" + app.name + "\"");
+		return false;
+	}
+	if (staged.product != version) {
+		failure = InvalidApp("the new version says " + staged.product + ", not " + version);
+		return false;
+	}
+	if (app.machine == 0 || staged.machine != app.machine) {
+		char machine[8] = {};
+		sprintf_s(machine, "%04x", staged.machine);
+		failure = InvalidApp(std::string("the new version is built for machine type 0x") + machine +
+				     ", not for this one");
+		return false;
+	}
+	return true;
+}
+
+/* ── the worker ─────────────────────────────────────────────────────────── */
+
+/* One job: the release to fetch and the two paths it works with. */
+struct Job {
+	Release release;
+	std::filesystem::path archive;
+	std::filesystem::path staged;
+};
+
+std::mutex g_job_mutex;
+std::condition_variable g_job_cv;
+std::optional<Job> g_job;
+bool g_job_stopping = false;
+std::thread g_job_thread;
+std::atomic<bool> g_cancel{false};
+
+/* The end of a download, on the main thread. */
+void FinishDownload(const Job &job, const Failure &failure)
+{
+	g_busy = false;
+	if (!failure.Ok()) {
+		EmitFailure(failure);
+		return;
+	}
+	g_staged = job.staged;
+	g_staged_version = job.release.version;
+	nlohmann::json fields = ReleaseFields(job.release);
+	fields["status"] = "ready";
+	EmitUpdate(fields);
+}
+
+/* Download, verify, unpack and verify again. AppUpdater.swift:243-264 did the
+ * same four steps on a background task; this thread is the counterpart, and
+ * every answer goes back through dispatch::Post. */
+void RunJob(const Job &job)
+{
+	/* Nothing a failed job leaves behind is worth keeping: a partial archive
+	 * or a half-unpacked tree would only be something a later run has to
+	 * wonder about. */
+	const auto report = [&job](const Failure &failure) {
+		std::error_code cleanup;
+		std::filesystem::remove(job.archive, cleanup);
+		std::filesystem::remove_all(job.staged, cleanup);
+		const Job copy = job;
+		dispatch::Post([copy, failure] { FinishDownload(copy, failure); });
+	};
+
+	std::error_code ec;
+	std::filesystem::create_directories(job.archive.parent_path(), ec);
+	if (ec) {
+		report(Location("cannot create " + Utf8(job.archive.parent_path())));
+		return;
+	}
+	/* A stale archive or tree from an interrupted run is in the way, not
+	 * useful: the digest decides what is installed, and re-downloading is
+	 * cheaper than trusting a file that was never finished. */
+	std::filesystem::remove(job.archive, ec);
+	std::filesystem::remove_all(job.staged, ec);
+
+	Sha256 hasher;
+	if (!hasher.Ready()) {
+		report(Network("SHA-256 could not be started"));
+		return;
+	}
+	const std::string version = job.release.version;
+	const auto progress = [&version](double fraction) {
+		dispatch::Post([version, fraction] {
+			EmitUpdate(nlohmann::json{{"status", "downloading"},
+						  {"progress", fraction},
+						  {"version", version}});
+		});
+	};
+
+	long long received = 0;
+	Failure failure;
+	if (!DownloadAsset(job.release.archive, job.archive, job.release.size, g_cancel, hasher, progress, received,
+			   failure)) {
+		report(failure);
+		return;
+	}
+
+	/* AppUpdater.swift:244-254: a release that publishes no digest, or whose
+	 * archive does not match it, is not installed at all. */
+	if (job.release.sha256.empty()) {
+		report(Checksum("the release publishes no SHA-256 for its archive"));
+		return;
+	}
+	const std::string actual = hasher.Finish();
+	if (actual.empty() || actual != job.release.sha256) {
+		report(Checksum("the archive is " + (actual.empty() ? std::string("unreadable") : actual) + ", not " +
+				job.release.sha256));
+		return;
+	}
+
+	if (!ExtractZip(job.archive, job.staged, failure)) {
+		report(failure);
+		return;
+	}
+	/* The Swift removed the archive once it was unpacked (:257); keeping it
+	 * would leave a few hundred megabytes in the user's profile. */
+	std::filesystem::remove(job.archive, ec);
+
+	std::filesystem::path root;
+	if (!StagedRoot(job.staged, root, failure)) {
+		report(failure);
+		return;
+	}
+	if (!VerifyTree(root, version, failure)) {
+		report(failure);
+		return;
+	}
+
+	Job finished = job;
+	finished.staged = root;
+	dispatch::Post([finished] { FinishDownload(finished, Failure{}); });
+}
+
+void JobLoop()
+{
+	for (;;) {
+		Job job;
+		{
+			std::unique_lock<std::mutex> lock(g_job_mutex);
+			g_job_cv.wait(lock, [] { return g_job_stopping || g_job.has_value(); });
+			/* Stopping is checked before the job, and under the same lock the
+			 * shutdown takes: a job still queued when the DLL unloads is
+			 * dropped rather than started, because the shutdown is waiting to
+			 * join this thread. */
+			if (g_job_stopping)
+				return;
+			if (!g_job)
+				continue;
+			job = std::move(*g_job);
+			g_job.reset();
+		}
+		RunJob(job);
+	}
+}
+
+/* Starts the worker on first use. False when it could not be started at all,
+ * which the caller reports as a failure rather than leaving a busy state that
+ * never ends. */
+bool EnqueueJob(Job job)
+{
+	{
+		std::lock_guard<std::mutex> lock(g_job_mutex);
+		if (g_job_stopping)
+			return false;
+		if (!g_job_thread.joinable()) {
+			try {
+				g_job_thread = std::thread(JobLoop);
+			} catch (const std::system_error &) {
+				return false;
+			}
+		}
+		/* One job runs at a time (g_busy), and from here on only a shutdown
+		 * sets this, so a cancel that arrives now is one that means it. */
+		g_cancel = false;
+		g_job = std::move(job);
+	}
+	g_job_cv.notify_one();
+	return true;
+}
+
+/* Joins the worker when the DLL unloads, the way live/liveclient.cpp's encode
+ * thread does: a worker still inside this plugin's code after DllMain(DETACH)
+ * would run unmapped memory. The cancel flag stops a transfer in flight instead
+ * of waiting out the rest of the archive. Declared after the state it touches,
+ * so it is destroyed while that state is still alive. */
+struct WorkerShutdown {
+	~WorkerShutdown()
+	{
+		std::thread worker;
+		{
+			std::lock_guard<std::mutex> lock(g_job_mutex);
+			g_job_stopping = true;
+			g_cancel = true;
+			worker = std::move(g_job_thread);
+		}
+		g_job_cv.notify_all();
+		if (worker.joinable())
+			worker.join();
+	}
+};
+WorkerShutdown g_worker_shutdown;
+
+/* ── leftovers and settings backups ─────────────────────────────────────── */
+
+/* AppUpdater.swift:167-173 removed everything earlier updates left behind but
+ * the previous app. Here the previous tree is a sibling of the install tree, so
+ * the downloads folder holds nothing worth keeping except the version being
+ * staged, and a staged tree this process is not using is a leftover of an
+ * interrupted run. */
+void CleanStagedTrees(const std::filesystem::path &root)
+{
+	std::error_code ec;
+	const std::wstring prefix = root.filename().wstring() + kStagedSuffix;
+	std::filesystem::directory_iterator it(root.parent_path(), ec), end;
+	for (; !ec && it != end; it.increment(ec)) {
+		const std::filesystem::directory_entry &entry = *it;
+		std::error_code inner;
+		if (!entry.is_directory(inner) || inner)
+			continue;
+		if (entry.path().filename().wstring().rfind(prefix, 0) != 0)
+			continue;
+		if (!g_staged.empty() && entry.path() == g_staged)
+			continue;
+		std::filesystem::remove_all(entry.path(), ec);
+	}
+}
+
+void CleanUp()
+{
+	std::error_code ec;
+	const std::filesystem::path updates = UpdatesFolder();
+	if (!updates.empty()) {
+		std::filesystem::directory_iterator it(updates, ec), end;
+		for (; !ec && it != end; it.increment(ec)) {
+			const std::filesystem::directory_entry &entry = *it;
+			if (!g_staged_version.empty() &&
+			    entry.path().filename().wstring() == PathVersion(g_staged_version))
+				continue;
+			std::filesystem::remove_all(entry.path(), ec);
+		}
+	}
+	const AppInfo &app = ThisApp();
+	if (!app.root.empty())
+		CleanStagedTrees(app.root);
+}
+
+std::string BackupStamp()
+{
+	SYSTEMTIME now = {};
+	GetLocalTime(&now);
+	char text[32] = {};
+	sprintf_s(text, "%04d-%02d-%02d %02d%02d%02d", now.wYear, now.wMonth, now.wDay, now.wHour, now.wMinute,
+		  now.wSecond);
+	return text;
+}
+
+/* AppUpdater.swift:220-223: "<yyyy-MM-dd HHmmss> v<app> OBS <obs>". */
+std::string BackupLabel()
+{
+	const AppInfo &app = ThisApp();
+	return "v" + CurrentVersion() + " OBS " + (app.obs.empty() ? std::string("?") : app.obs);
+}
+
+/* AppUpdater.swift:233-240: keep the newest backups, leaving room for one
+ * more. The name starts with the timestamp, so the newest is the largest. */
+void PruneBackups()
+{
+	const std::filesystem::path folder = BackupsFolder();
+	if (folder.empty())
+		return;
+	std::error_code ec;
+	std::vector<std::wstring> names;
+	std::filesystem::directory_iterator it(folder, ec), end;
+	for (; !ec && it != end; it.increment(ec)) {
+		const std::wstring name = it->path().filename().wstring();
+		if (!name.empty() && name[0] != L'.')
+			names.push_back(name);
+	}
+	std::sort(names.begin(), names.end(), std::greater<std::wstring>());
+	for (size_t i = kKeptBackups - 1; i < names.size(); ++i)
+		std::filesystem::remove_all(folder / names[i], ec);
+}
+
+/* AppUpdater.swift:226-231: the newest backup taken while `version` was
+ * installed, which a rollback across OBS major versions restores. */
+std::filesystem::path NewestBackup(const std::string &version)
+{
+	const std::filesystem::path folder = BackupsFolder();
+	if (folder.empty())
+		return {};
+	const std::string needle = " v" + version + " OBS ";
+	std::error_code ec;
+	std::wstring best;
+	std::filesystem::directory_iterator it(folder, ec), end;
+	for (; !ec && it != end; it.increment(ec)) {
+		const std::filesystem::path name = it->path().filename();
+		if (Utf8(name).find(needle) == std::string::npos)
+			continue;
+		const std::wstring wide = name.wstring();
+		if (best.empty() || wide > best)
+			best = wide;
+	}
+	return best.empty() ? std::filesystem::path() : folder / best;
+}
+
+/* The Swift asked whether the app's directory was writable
+ * (AppUpdater.swift:320-322) and failed with "location" when it was not. The
+ * Windows install renames that directory and renames the staged one into its
+ * place, so its parent has to be writable too — and the only question that
+ * settles it is whether a file can be created. */
+bool WritableFolder(const std::filesystem::path &folder, std::string &why)
+{
+	if (folder.empty()) {
+		why = "the folder is unknown";
+		return false;
+	}
+	const std::filesystem::path probe =
+		folder / (L".livehime-write-test-" + std::to_wstring(GetCurrentProcessId()) + L".tmp");
+	HANDLE file = CreateFileW(probe.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS,
+				  FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE, nullptr);
+	if (file == INVALID_HANDLE_VALUE) {
+		why = "no permission to write in " + Utf8(folder);
+		return false;
+	}
+	CloseHandle(file);
+	return true;
+}
+
+/* ── the helper that does the swap ──────────────────────────────────────── */
+
+/* install.cmd. AppUpdater.swift:314-376 wrote install.sh and started it with
+ * `nohup /bin/sh` for exactly this reason: Windows will not let a running
+ * obs64.exe be replaced, so something that outlives the process has to do it.
+ * What differs from the shell script is only the vocabulary — tasklist for the
+ * process check, move for mv, xcopy for ditto.
+ *
+ * The script is plain ASCII and takes every value as an argument, because they
+ * arrive on cmd.exe's UTF-16 command line: a user name or an install path
+ * outside the console's code page survives, where a batch file with the paths
+ * written into it could lose them. cmd.exe reads a batch file line by line, so
+ * the file is written with CRLF.
+ *
+ * The two renames are inside one directory and therefore same-volume by
+ * construction. The retry loop covers the moment Windows still holds a handle
+ * on the executable that just exited; `ping -n 2` is the portable one-second
+ * sleep (timeout.exe refuses to run with redirected input). tasklist's CSV form
+ * is matched on the quoted pid field, so a process whose *name* contains those
+ * digits is not mistaken for it. */
+constexpr const char *kInstallScript = R"BAT(@echo off
+rem LiveHime update: wait for LiveHime to exit, back up the settings, swap the
+rem install tree (keeping the old one on failure), restore the settings a
+rem rollback across an OBS major version needs, then reopen.
+rem
+rem Written by livehime.dll before it starts this script. Output goes to
+rem install.log beside it.
+rem
+rem 1 pid  2 install tree  3 staged tree  4 previous tree  5 relaunch
+rem 6 config folder  7 backup folder  8 settings to restore  9 items to back up
+rem 10 items to restore  11 executable to start
+setlocal
+set "PID=%~1"
+shift
+set "ROOT=%~1"
+shift
+set "STAGED=%~1"
+shift
+set "PREVIOUS=%~1"
+shift
+set "RELAUNCH=%~1"
+shift
+set "CONFIG=%~1"
+shift
+set "SAVED=%~1"
+shift
+set "RESTORE=%~1"
+shift
+set "ITEMS=%~1"
+shift
+set "RESTORED=%~1"
+shift
+set "EXE=%~1"
+
+rem 1. Wait for the process being replaced to exit for good.
+:wait
+tasklist /FI "PID eq %PID%" /FO CSV /NH 2>nul | find ",\"%PID%\"," >nul
+if not errorlevel 1 (
+	ping -n 2 127.0.0.1 >nul
+	goto wait
+)
+
+rem 2. Back up what OBS migrates forward, after the exit, so the ini files are
+rem    in their final state. A backup that cannot be written stops the update
+rem    before anything has been moved.
+if not exist "%SAVED%" mkdir "%SAVED%"
+for %%I in (%ITEMS%) do call :save "%%I" || goto :failed
+
+rem 3. Swap the tree. What is replaced becomes the version a rollback returns
+rem    to; the older previous tree is dropped, as AppUpdater.swift:337 does.
+set "TRIES=0"
+:swap
+set /a TRIES+=1
+if exist "%PREVIOUS%" rmdir /S /Q "%PREVIOUS%"
+move "%ROOT%" "%PREVIOUS%" >nul 2>&1
+if errorlevel 1 (
+	if %TRIES% LSS 20 (
+		ping -n 2 127.0.0.1 >nul
+		goto swap
+	)
+	echo could not move "%ROOT%" aside
+	goto :failed
+)
+move "%STAGED%" "%ROOT%" >nul 2>&1
+if errorlevel 1 (
+	echo could not move the new version into "%ROOT%"
+	move "%PREVIOUS%" "%ROOT%" >nul 2>&1
+	goto :failed
+)
+
+rem 4. A rollback across an OBS major version brings the older settings back:
+rem    OBS migrates scenes forward only, never back.
+if not "%RESTORE%"=="" if exist "%RESTORE%" (
+	for %%I in (%RESTORED%) do call :restore "%%I"
+)
+
+rem 5. Reopen. The environment is inherited, so LIVEHIME_* variables (a test
+rem    feed, for instance) reach the new process without being passed on.
+echo update installed
+if "%RELAUNCH%"=="1" start "" "%EXE%"
+endlocal
+exit /b 0
+
+rem One config item, folder or file, whichever it is. `exit /b` without a code
+rem hands back the errorlevel of the copy; xcopy answers 1 when there was
+rem nothing to copy (an empty folder), which is not a failure, so only 2 and up
+rem are.
+:save
+if exist "%CONFIG%\%~1\" (
+	xcopy /E /I /Y /Q "%CONFIG%\%~1" "%SAVED%\%~1" >nul
+	if errorlevel 2 exit /b
+	exit /b 0
+)
+if exist "%CONFIG%\%~1" (
+	copy /Y "%CONFIG%\%~1" "%SAVED%\%~1" >nul
+	exit /b
+)
+exit /b 0
+
+:restore
+if exist "%CONFIG%\%~1\" rmdir /S /Q "%CONFIG%\%~1"
+if exist "%RESTORE%\%~1\" xcopy /E /I /Y /Q "%RESTORE%\%~1" "%CONFIG%\%~1" >nul
+if exist "%RESTORE%\%~1" copy /Y "%RESTORE%\%~1" "%CONFIG%\%~1" >nul
+exit /b 0
+
+:failed
+echo the update failed; the install tree was left as it was
+endlocal
+exit /b 1
+)BAT";
+
+bool WriteInstallScript(const std::filesystem::path &script, std::string &why)
+{
+	std::ofstream out(script, std::ios::binary | std::ios::trunc);
+	if (!out) {
+		why = "cannot write " + Utf8(script);
+		return false;
+	}
+	for (const char *at = kInstallScript; *at;) {
+		if (*at == '\n') {
+			out.write("\r\n", 2);
+			++at;
+			continue;
+		}
+		out.put(*at++);
+	}
+	out.close();
+	if (!out) {
+		why = "cannot write " + Utf8(script);
+		return false;
+	}
+	return true;
+}
+
+/* Starts the helper: cmd.exe with the script, every value as an argument, and
+ * the script's own output redirected into install.log. CREATE_NO_WINDOW keeps
+ * the console off the user's screen, and the working directory is the download
+ * folder rather than the install tree, so nothing this process leaves behind
+ * holds a handle on what is about to be renamed.
+ *
+ * A job object around OBS that kills its children when it closes would take the
+ * helper with it. CREATE_BREAKAWAY_FROM_JOB is deliberately not used: when the
+ * job does not allow breaking away, CreateProcess fails outright and there
+ * would be no update at all instead of a working one in the common case. */
+bool StartHelper(const std::filesystem::path &script, const std::filesystem::path &log,
+		 const std::vector<std::string> &arguments, const std::filesystem::path &working_directory,
+		 std::string &why)
+{
+	wchar_t system_directory[MAX_PATH] = {};
+	if (!GetSystemDirectoryW(system_directory, MAX_PATH)) {
+		why = "the system directory could not be read";
+		return false;
+	}
+
+	/* The /s form is the one that survives a path with spaces: cmd strips the
+	 * first and last quote of what follows /c and runs the rest verbatim. */
+	std::wstring line = L"\"" + script.wstring() + L"\"";
+	for (const std::string &argument : arguments)
+		line += L" \"" + Widen(argument) + L"\"";
+	line += L" 1>\"" + log.wstring() + L"\" 2>&1";
+
+	const std::wstring command = L"\"" + (std::filesystem::path(system_directory) / L"cmd.exe").wstring() +
+				     L"\" /d /s /c \"" + line + L"\"";
+	std::vector<wchar_t> mutable_command(command.begin(), command.end());
+	mutable_command.push_back(L'\0');
+
+	STARTUPINFOW startup = {};
+	startup.cb = sizeof(startup);
+	PROCESS_INFORMATION process = {};
+	if (!CreateProcessW(nullptr, mutable_command.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW, nullptr,
+			    working_directory.c_str(), &startup, &process)) {
+		why = "the installer could not be started (win32 " + std::to_string(GetLastError()) + ")";
+		return false;
+	}
+	CloseHandle(process.hThread);
+	CloseHandle(process.hProcess);
+	return true;
+}
+
+/* AppUpdater.swift:310-376 in Windows terms: `staged` becomes the install tree
+ * once this process is gone, and the tree it replaces becomes …livehime-
+ * previous, which a rollback returns to. Nothing is emitted on success — the
+ * caller quits, exactly as the Swift's install does. */
+bool ScheduleInstall(const std::string &version, const std::filesystem::path &staged, bool relaunch,
+		     const std::filesystem::path &restore, Failure &failure)
+{
+	const AppInfo &app = ThisApp();
+	if (!UsableRoot(app.root)) {
+		failure = Location("LiveHime does not run from an install tree that can be replaced");
+		return false;
+	}
+	if (PortableTree(app.root)) {
+		failure = Location(kPortableReason);
+		return false;
+	}
+	std::error_code ec;
+	if (!std::filesystem::exists(ExeIn(staged), ec) || ec) {
+		failure = InvalidApp("the staged version is gone");
+		return false;
+	}
+
+	const std::filesystem::path updates = UpdatesFolder();
+	const std::filesystem::path backups = BackupsFolder();
+	if (updates.empty() || backups.empty()) {
+		failure = Location("the local application folder could not be found");
+		return false;
+	}
+	const std::filesystem::path folder = updates / PathVersion(version);
+	std::filesystem::create_directories(folder, ec);
+	if (ec) {
+		failure = Location("cannot create " + Utf8(folder));
+		return false;
+	}
+
+	/* The settings backup beside the config it copies, newest kept
+	 * (AppUpdater.swift:354-359). */
+	std::filesystem::create_directories(backups, ec);
+	if (ec) {
+		failure = Location("cannot create " + Utf8(backups));
+		return false;
+	}
+	PruneBackups();
+	const std::filesystem::path saved = backups / Widen(BackupStamp() + " " + BackupLabel());
+
+	const std::filesystem::path script = folder / L"install.cmd";
+	const std::filesystem::path log = folder / L"install.log";
+	std::string why;
+	if (!WriteInstallScript(script, why)) {
+		failure = Location(why);
+		return false;
+	}
+
+	std::vector<std::string> arguments;
+	arguments.push_back(std::to_string(GetCurrentProcessId()));
+	arguments.push_back(Utf8(app.root));
+	arguments.push_back(Utf8(staged));
+	arguments.push_back(Utf8(PreviousTree(app.root)));
+	arguments.push_back(relaunch ? "1" : "0");
+	arguments.push_back(Utf8(ConfigFolder()));
+	arguments.push_back(Utf8(saved));
+	arguments.push_back(restore.empty() ? std::string() : Utf8(restore));
+	arguments.push_back(kConfigItems);
+	arguments.push_back(kRestoredItems);
+	arguments.push_back(Utf8(ExeIn(app.root)));
+
+	if (!StartHelper(script, log, arguments, folder, why)) {
+		failure = Location(why);
+		return false;
+	}
+	return true;
+}
+
+/* ── the entry points ───────────────────────────────────────────────────── */
+
+/* The C interface promises the main thread (livehime-core.h); the Swift hopped
+ * to it when it was called from anywhere else (AppUpdateBridge.swift:36-42),
+ * and so does this. Everything below that touches g_* runs on the main thread. */
+void OnMain(std::function<void()> body)
+{
+	if (dispatch::OnMainThread()) {
+		body();
+		return;
+	}
+	dispatch::Post(std::move(body));
+}
+
+/* AppUpdateBridge.swift:59-81: what the last check found decides the event. */
+void ReportRelease(const Release &release)
+{
+	if (!g_staged.empty() && g_staged_version == release.version) {
+		nlohmann::json fields = ReleaseFields(release);
+		fields["status"] = "ready";
+		EmitUpdate(fields);
+		return;
+	}
+	if (IsNewer(release.version, CurrentVersion())) {
+		nlohmann::json fields = ReleaseFields(release);
+		fields["status"] = "available";
+		EmitUpdate(fields);
+		return;
+	}
+	EmitUpdate(nlohmann::json{{"status", "upToDate"}, {"version", release.version}});
+}
+
+void FinishCheck(const std::string &body, bool beta)
+{
+	g_busy = false;
+	Release release;
+	Failure failure;
+	if (!ReleaseFromFeed(body, beta, release, failure)) {
+		EmitFailure(failure);
+		return;
+	}
+	g_release = release;
+	ReportRelease(release);
+}
+
+/* A test feed on disk: the Swift pointed LIVEHIME_UPDATE_FEED at a file URL,
+ * so both a plain Windows path and file:///C:/… are accepted. */
+std::filesystem::path TestFeedPath(const std::string &feed)
+{
+	std::string text = feed;
+	if (StartsWith(text, "file://")) {
+		text = text.substr(std::strlen("file://"));
+		/* file:///C:/x leaves three separators before the drive letter. */
+		if (text.size() >= 3 && text[0] == '/' && text[2] == ':')
+			text = text.substr(1);
+	}
+	std::replace(text.begin(), text.end(), '/', '\\');
+	return Widen(text);
+}
+
+void CheckLocalFeed(const std::string &feed, bool beta)
+{
+	const std::filesystem::path path = TestFeedPath(feed);
+	std::ifstream in(path, std::ios::binary);
+	if (!in) {
+		g_busy = false;
+		EmitFailure(Network("cannot read the test feed " + Utf8(path)));
+		return;
+	}
+	in.seekg(0, std::ios::end);
+	const std::streamoff size = in.tellg();
+	in.seekg(0);
+	if (size <= 0) {
+		g_busy = false;
+		EmitFailure(Network("the test feed " + Utf8(path) + " is empty"));
+		return;
+	}
+	std::string body(static_cast<size_t>(size), '\0');
+	in.read(&body[0], static_cast<std::streamsize>(size));
+	body.resize(static_cast<size_t>(in.gcount()));
+	FinishCheck(body, beta);
+}
+
+void CheckOnMain(bool beta)
+{
+	if (g_busy)
+		return;
+	if (!g_cleaned && g_staged.empty()) {
+		/* Leftovers of the last update (AppUpdateBridge.swift:52-56). */
+		CleanUp();
+		g_cleaned = true;
+	}
+	g_busy = true;
+	EmitUpdate(nlohmann::json{{"status", "checking"}});
+
+	const std::optional<std::string> override = FeedOverride();
+	if (override && !StartsWith(*override, "http://") && !StartsWith(*override, "https://")) {
+		CheckLocalFeed(*override, beta);
+		return;
+	}
+
+	/* The feed is small, so it goes through net::Send, which answers on the
+	 * main thread. The API needs no authentication for a public repository,
+	 * and nothing here carries a token. */
+	net::Request request;
+	request.url = override ? *override : (beta ? kListFeed : kLatestFeed);
+	request.timeout_ms = kFeedTimeoutMs;
+	request.headers["Accept"] = "application/vnd.github+json";
+	request.headers["User-Agent"] = "LiveHime/" + CurrentVersion();
+	net::Send(request, [beta](net::Response response) {
+		if (response.status == 0) {
+			g_busy = false;
+			EmitFailure(Network(response.error.empty() ? std::string("no response") : response.error));
+			return;
+		}
+		if (response.status != 200) {
+			g_busy = false;
+			EmitFailure(Network("HTTP " + std::to_string(response.status)));
+			return;
+		}
+		FinishCheck(response.body, beta);
+	});
+}
+
+void DownloadOnMain()
+{
+	if (g_busy || !g_release)
+		return;
+	const Release release = *g_release;
+	if (!IsNewer(release.version, CurrentVersion()))
+		return;
+	if (!InstallSupported(ThisApp())) {
+		EmitFailure(Unsupported("development build"));
+		return;
+	}
+	if (!g_staged.empty() && g_staged_version == release.version) {
+		nlohmann::json fields = ReleaseFields(release);
+		fields["status"] = "ready";
+		EmitUpdate(fields);
+		return;
+	}
+
+	/* Everything that decides whether an install can happen at all is asked
+	 * before a few hundred megabytes are fetched, not after: the download is
+	 * useless if the tree cannot be replaced, and the user should hear that in
+	 * a second rather than in ten minutes. */
+	const AppInfo &app = ThisApp();
+	std::string why;
+	if (!UsableRoot(app.root) || !WritableFolder(app.root, why) || !WritableFolder(app.root.parent_path(), why)) {
+		EmitFailure(Location(why.empty() ? std::string("LiveHime cannot replace this install tree") : why));
+		return;
+	}
+	if (PortableTree(app.root)) {
+		EmitFailure(Location(kPortableReason));
+		return;
+	}
+	const std::filesystem::path updates = UpdatesFolder();
+	if (updates.empty()) {
+		EmitFailure(Location("the local application folder could not be found"));
+		return;
+	}
+
+	Job job;
+	job.release = release;
+	job.archive = updates / PathVersion(release.version) / L"app.zip";
+	job.staged = StagedTree(app.root, release.version);
+
+	g_busy = true;
+	EmitUpdate(nlohmann::json{{"status", "downloading"}, {"progress", 0.0}, {"version", release.version}});
+	if (!EnqueueJob(std::move(job))) {
+		g_busy = false;
+		EmitFailure(Location("the update worker could not be started"));
+	}
+}
+
+bool InstallOnMain(bool relaunch)
+{
+	if (g_busy || g_staged.empty())
+		return false;
+
+	/* Verified again: the tree has been on disk since the download, and this
+	 * is the last moment it can be refused. */
+	Failure failure;
+	if (!VerifyTree(g_staged, g_staged_version, failure)) {
+		EmitFailure(failure);
+		return false;
+	}
+	if (!ScheduleInstall(g_staged_version, g_staged, relaunch, std::filesystem::path(), failure)) {
+		EmitFailure(failure);
+		return false;
+	}
+	g_staged.clear();
+	g_staged_version.clear();
+	return true;
+}
+
+bool RollbackOnMain()
+{
+	if (g_busy)
+		return false;
+
+	const AppInfo &app = ThisApp();
+	const std::string version = PreviousVersion();
+	if (version.empty()) {
+		EmitFailure(InvalidApp("no previous version"));
+		return false;
+	}
+
+	Failure failure;
+	const std::filesystem::path previous = PreviousTree(app.root);
+	if (!VerifyTree(previous, version, failure)) {
+		EmitFailure(failure);
+		return false;
+	}
+
+	/* AppUpdater.swift:383-399: the kept tree moves to where an install expects
+	 * its staged tree, and the settings of that version come back when the OBS
+	 * major version differs, because OBS migrates scenes forward only. */
+	const std::filesystem::path staged = StagedTree(app.root, version);
+	std::error_code ec;
+	std::filesystem::remove_all(staged, ec);
+	std::filesystem::rename(previous, staged, ec);
+	if (ec) {
+		EmitFailure(Location("the previous version could not be staged"));
+		return false;
+	}
+
+	std::filesystem::path restore;
+	const AppInfo kept = ReadApp(ExeIn(staged));
+	if (ObsMajor(kept.obs) != ObsMajor(app.obs))
+		restore = NewestBackup(version);
+
+	if (!ScheduleInstall(version, staged, true, restore, failure)) {
+		std::filesystem::rename(staged, previous, ec);
+		EmitFailure(failure);
+		return false;
+	}
+	g_staged.clear();
+	g_staged_version.clear();
+	return true;
+}
+
+} // namespace
+
+void Check(bool beta)
+{
+	OnMain([beta] { CheckOnMain(beta); });
+}
+
+void Download()
+{
+	OnMain(DownloadOnMain);
+}
+
+bool Install(bool relaunch)
+{
+	if (dispatch::OnMainThread())
+		return InstallOnMain(relaunch);
+	/* The answer has to be synchronous, so an off-thread call installs
+	 * nothing, exactly as the Swift's `guard Thread.isMainThread` does. */
+	return false;
+}
+
+bool Rollback()
+{
+	if (dispatch::OnMainThread())
+		return RollbackOnMain();
+	return false;
+}
+
+void EmitState()
+{
+	OnMain([] { EmitUpdate(nlohmann::json{{"status", "idle"}}); });
+}
+
+} // namespace update
+} // namespace livehime
diff --git a/plugins/livehime/core/win/update/updater.h b/plugins/livehime/core/win/update/updater.h
new file mode 100644
index 0000000..5d712ad
--- /dev/null
+++ b/plugins/livehime/core/win/update/updater.h
@@ -0,0 +1,123 @@
+/* App updates from GitHub Releases — the Windows counterpart of
+ * AppUpdater.swift and AppUpdateBridge.swift (the five livehime_core_update_*
+ * entry points).
+ *
+ * The feed is the **Windows** releases repository, not the macOS one:
+ *
+ *   page    https://github.com/greyoak111/livehime-win/releases
+ *   latest  https://api.github.com/repos/greyoak111/livehime-win/releases/latest
+ *   list    https://api.github.com/repos/greyoak111/livehime-win/releases?per_page=20
+ *
+ * LIVEHIME_UPDATE_FEED overrides the feed the way it does in the Swift: an
+ * http(s) value is fetched, anything else (a plain path, or file:///…) is read
+ * as a local file holding one release object or a list of them, which is what
+ * the tests point at.
+ *
+ * The asset. A macOS update replaces a signed .app that Sparkle relaunches.
+ * There is no Sparkle here and no installer yet, so the Windows asset is the
+ * zipped install tree:
+ *
+ *   LiveHimeWinRundir-v<version>-x64.zip
+ *   LiveHimeWinRundir-v<version>-arm64.zip
+ *
+ * Entries are relative to the tree's root, so the archive starts with
+ * bin/64bit/obs64.exe, obs-plugins/64bit/livehime.dll, data/… — the shape both
+ * build_<target>/rundir/<config> and build_<target>/install/LiveHime (the
+ * `--install` tree of build-aux/livehime-win/build-win.ps1) already have. A
+ * single wrapping top-level folder is accepted too, mirroring the Swift's "find
+ * the .app in the unpacked folder".
+ *
+ * What install does, concretely. Windows will not let a running obs64.exe be
+ * overwritten, so the swap goes through a helper, exactly as the Swift's
+ * install.sh does:
+ *
+ *   1. the archive is downloaded to %LOCALAPPDATA%\LiveHime\Updates\<version>\
+ *      app.zip and unpacked, while LiveHime runs, into a staged tree beside the
+ *      install tree: <parent>\<name>.livehime-staged-<version>;
+ *   2. livehime_core_update_install() writes install.cmd next to the download
+ *      and starts it with cmd.exe /d /s /c (no console window). The caller
+ *      then quits LiveHime, as it does on macOS;
+ *   3. install.cmd waits for that process to exit, backs up the settings OBS
+ *      migrates forward (%APPDATA%\LiveHime\obs-studio -> %APPDATA%\LiveHime\
+ *      backups\<stamp> v<version> OBS <obs>), renames the install tree aside to
+ *      <parent>\<name>.livehime-previous, renames the staged tree into place,
+ *      restores the older settings when a rollback crossed an OBS major
+ *      version, and starts obs64.exe again when asked to. Its output is
+ *      install.log beside it;
+ *   4. the tree it replaced stays as …livehime-previous, which is what
+ *      livehime_core_update_rollback() puts back (and what "previous" in every
+ *      update event names).
+ *
+ * Both renames are inside the same directory, so they are same-volume by
+ * construction and effectively atomic: an install directory whose parent is
+ * not writable (C:\Program Files without elevation) is reported as a `location`
+ * failure *before* anything is downloaded, rather than half-applied. A tree in
+ * OBS's portable mode is refused the same way, because its settings live in
+ * <root>\config and an update would replace them.
+ *
+ * What is verified, and what is not. The Swift checks the archive's SHA-256,
+ * the bundle identifier, the version and the signing certificate. Here:
+ *
+ *   - the SHA-256 the release publishes (GitHub's asset digest) is computed
+ *     while the archive is written, and a mismatch fails the download;
+ *   - the staged bin/64bit/obs64.exe must carry the release's version as
+ *     ProductVersion, the running build's ProductName, and the running build's
+ *     machine type — the ProductVersion check is the same single source of
+ *     truth update-page.cpp reads for the running version, and ProductName is
+ *     the closest Windows has to "the same bundle identifier";
+ *   - PUBLISHER VERIFICATION IS ABSENT. Nothing on Windows is code-signed yet
+ *     and a zip has no Authenticode signature to verify, so nothing here
+ *     proves who built the archive beyond TLS to github.com. The macOS build
+ *     checks a certificate; this one cannot, and does not pretend to.
+ *
+ * "supported" (the UI's development-build check) is the Windows reading of the
+ * Swift's ".dev" bundle identifier: a build whose ProductVersion equals its
+ * FileVersion was configured without LIVEHIME_APP_VERSION — upstream OBS
+ * Studio, or this source built without the branding — and a LiveHime release
+ * must not replace it. A test feed makes it supported anyway, as on macOS.
+ *
+ * Threading. Every function here is called from the C entry points, which are
+ * on the main thread by contract; they re-post when they are not. The feed is
+ * small and goes through net::Send, which answers on the main thread. The
+ * download is hundreds of megabytes, so it runs on one worker thread of this
+ * file's own — net/http.h's Send() buffers a whole body in memory — and reports
+ * progress back with dispatch::Post; the file's shutdown guard joins that
+ * thread when the DLL unloads, the way live/liveclient.cpp's encode thread
+ * does. No URL that carries anything secret is ever logged or emitted: the
+ * GitHub API needs no authentication for public releases. */
+
+#pragma once
+
+namespace livehime {
+namespace update {
+
+/* livehime_core_update_check: looks for a newer release; with `beta`,
+ * pre-releases count too. Emits "checking", then "upToDate", "available" (with
+ * version, notes, page, size, prerelease) or "failed". */
+void Check(bool beta);
+
+/* livehime_core_update_download: fetches, verifies and unpacks the release the
+ * last check found. Emits "downloading" with "progress" (0-1), then "ready" or
+ * "failed". */
+void Download();
+
+/* livehime_core_update_install: arranges for the staged tree to replace this
+ * install once LiveHime quits. Returns true when the installer is waiting — the
+ * caller then quits, and with `relaunch` LiveHime reopens afterwards. Returns
+ * false when there is nothing to install or it could not be started, having
+ * emitted "failed". */
+bool Install(bool relaunch);
+
+/* livehime_core_update_rollback: arranges for the previous tree to come back
+ * once LiveHime quits and to reopen afterwards (the caller then quits).
+ * Returns false, having emitted "failed", when there is nothing to roll back
+ * to. */
+bool Rollback();
+
+/* livehime_core_update_state: the idle event with current, obsCurrent,
+ * supported and, when there is one, previous (the version a rollback would
+ * return to). */
+void EmitState();
+
+} // namespace update
+} // namespace livehime
