@@ -0,0 +1,2459 @@
+/* LiveHime app updates on Windows — the C++ counterpart of AppUpdater.swift
+ * and AppUpdateBridge.swift. What it does and why is in update/updater.h; this
+ * file is laid out in the order the work happens:
+ *
+ *   feed      the GitHub release JSON of greyoak111/livehime-win (net::Send)
+ *   app       what this build is: version resource, machine type, install tree
+ *   download  the streaming worker: archive -> SHA-256 -> zip -> staged tree
+ *   install   install.cmd, the helper that swaps the tree after the app quits
+ *   state     the events the Updates tab reads
+ *
+ * Nothing here leaves a success it did not earn: every path that cannot finish
+ * emits {"event":"update","status":"failed","reason":…,"message":…} with the
+ * real reason, and `supported` is false whenever this build must not replace
+ * itself. */
+
+#include "updater.h"
+
+#include <windows.h>
+#include <winhttp.h> /* INTERNET_PORT, URL_COMPONENTS, WinHttpCrackUrl, HINTERNET */
+#include <bcrypt.h>
+/* The order libobs/util/platform-windows.c uses for shlobj.h, which wants the
+ * shell and COM declarations in front of it; objbase.h is also where
+ * CoTaskMemFree lives (WIN32_LEAN_AND_MEAN keeps windows.h from pulling it
+ * in). */
+#include <shellapi.h>
+#include <objbase.h>
+#include <shlobj.h>
+#include <zlib.h>
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cwchar>
+#include <fstream>
+#include <functional>
+#include <limits>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "../core/emit.h"
+#include "../net/crypto.h"
+#include "../net/http.h"
+#include "../platform/dispatch.h"
+
+/* bcrypt.h does not bring this along on its own (net/crypto.cpp defines it the
+ * same way). */
+#ifndef NT_SUCCESS
+#define NT_SUCCESS(Status) (((NTSTATUS)(Status)) >= 0)
+#endif
+
+namespace livehime {
+namespace update {
+namespace {
+
+/* ── the feed ───────────────────────────────────────────────────────────── */
+
+/* AppUpdater.swift:55-57 pointed these at livehime-macos; this is the Windows
+ * repository. The API needs no authentication for public releases, and the
+ * archive URL the feed carries is used but never emitted or logged. */
+constexpr const char *kReleasesPage = "https://github.com/greyoak111/livehime-win/releases";
+constexpr const char *kLatestFeed = "https://api.github.com/repos/greyoak111/livehime-win/releases/latest";
+constexpr const char *kListFeed = "https://api.github.com/repos/greyoak111/livehime-win/releases?per_page=20";
+
+/* AppUpdater.swift:92-100: each release carries one archive per architecture,
+ * "LiveHimeMacApp-v<version>-arm64.zip" there; the Windows release publishes
+ * the zipped install tree under the same shape (update/updater.h). */
+constexpr const char *kAssetPrefix = "LiveHimeWinRundir-";
+#if defined(_M_ARM64)
+constexpr const char *kArchitecture = "arm64";
+#else
+/* OBS on Windows is 64-bit only: x64, or arm64 above. */
+constexpr const char *kArchitecture = "x64";
+#endif
+
+/* The Swift's timeoutInterval: 20 (AppUpdater.swift:139). */
+constexpr int kFeedTimeoutMs = 20000;
+
+/* The transfer: 64 KiB reads, into the archive file and out of it again, and
+ * the same redirect ceiling net/http.h uses for the hop from github.com to its
+ * object store. */
+constexpr size_t kDownloadChunk = 64 * 1024;
+constexpr int kMaxRedirects = 5;
+
+/* ── the install tree ───────────────────────────────────────────────────── */
+
+/* Where the executable sits inside the tree, and therefore what the tree is.
+ * Both build_<target>/rundir/<config> and the `cmake --install` tree of
+ * build-aux/livehime-win/build-win.ps1 use OBS's own destinations
+ * (cmake/windows/defaults.cmake: bin/64bit, obs-plugins/64bit, data). */
+constexpr const wchar_t *kExeFolderName = L"64bit";
+constexpr const wchar_t *kBinFolderName = L"bin";
+constexpr const wchar_t *kExeName = L"obs64.exe";
+
+/* The staged and previous trees are siblings of the install tree: the helper's
+ * swap is a rename, and a rename cannot cross volumes. */
+constexpr const wchar_t *kStagedSuffix = L".livehime-staged-";
+constexpr const wchar_t *kPreviousSuffix = L".livehime-previous";
+
+/* AppUpdater.swift:213-218 — what a settings backup holds, what a rollback
+ * across OBS major versions restores, and how many backups are kept. The two
+ * lists are comma-separated on one argument to install.cmd, which splits them
+ * with `for`. */
+constexpr const char *kConfigItems = "basic,plugin_config,plugin_manager,user.ini,global.ini";
+constexpr const char *kRestoredItems = "basic,user.ini,global.ini";
+constexpr size_t kKeptBackups = 8;
+
+/* ── failures ───────────────────────────────────────────────────────────── */
+
+/* AppUpdater.swift:18-45. `reason` is what the UI looks up in the two locale
+ * files (data/locale/en-US.ini, zh-CN.ini) as LiveHime.Update.Failed.<reason>;
+ * `message` is the detail that goes to the OBS log. An empty reason means no
+ * failure. */
+struct Failure {
+	std::string reason;
+	std::string message;
+
+	bool Ok() const { return reason.empty(); }
+};
+
+Failure Network(const std::string &message)
+{
+	return Failure{"network", message};
+}
+Failure NoArchive(const std::string &message)
+{
+	return Failure{"noArchive", message};
+}
+Failure Checksum(const std::string &message)
+{
+	return Failure{"checksum", message};
+}
+Failure InvalidApp(const std::string &message)
+{
+	return Failure{"invalidApp", message};
+}
+Failure Location(const std::string &message)
+{
+	return Failure{"location", message};
+}
+Failure Unsupported(const std::string &message)
+{
+	return Failure{"unsupported", message};
+}
+
+/* ── text and paths ─────────────────────────────────────────────────────── */
+
+std::wstring Widen(const std::string &utf8)
+{
+	if (utf8.empty())
+		return {};
+	int len = MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), nullptr, 0);
+	std::wstring out(static_cast<size_t>(len), L'\0');
+	MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), &out[0], len);
+	return out;
+}
+
+std::string Narrow(const std::wstring &wide)
+{
+	if (wide.empty())
+		return {};
+	int bytes = WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), static_cast<int>(wide.size()), nullptr, 0, nullptr,
+					nullptr);
+	std::string out(static_cast<size_t>(bytes), '\0');
+	WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), static_cast<int>(wide.size()), &out[0], bytes, nullptr, nullptr);
+	return out;
+}
+
+std::string Utf8(const std::filesystem::path &path)
+{
+	return path.u8string();
+}
+
+/* The same trimming SessionCoordinator.swift:271 needed for a title: version
+ * resource strings and test input can carry ASCII whitespace around them. */
+std::string Trim(const std::string &text)
+{
+	size_t begin = text.find_first_not_of(" \t\r\n\f\v");
+	if (begin == std::string::npos)
+		return {};
+	size_t end = text.find_last_not_of(" \t\r\n\f\v");
+	return text.substr(begin, end - begin + 1);
+}
+
+bool SameName(const std::filesystem::path &path, const wchar_t *name)
+{
+	const std::wstring leaf = path.filename().wstring();
+	return _wcsicmp(leaf.c_str(), name) == 0;
+}
+
+bool EndsWith(const std::string &text, const std::string &suffix)
+{
+	return text.size() >= suffix.size() && text.compare(text.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+bool StartsWith(const std::string &text, const std::string &prefix)
+{
+	return text.size() >= prefix.size() && text.compare(0, prefix.size(), prefix) == 0;
+}
+
+/* The macOS code wrote the tag straight into a directory name
+ * (AppUpdater.swift:245). A tag is arbitrary text from the feed, so the path
+ * form keeps only what cannot mean a directory of its own. */
+std::wstring PathVersion(const std::string &version)
+{
+	std::wstring out;
+	for (unsigned char c : version) {
+		const bool safe = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+				  c == '.' || c == '_' || c == '-';
+		out += safe ? static_cast<wchar_t>(c) : L'_';
+	}
+	return out.empty() ? std::wstring(L"unknown") : out;
+}
+
+std::filesystem::path ExeIn(const std::filesystem::path &root)
+{
+	return root / kBinFolderName / kExeFolderName / kExeName;
+}
+
+std::filesystem::path StagedTree(const std::filesystem::path &root, const std::string &version)
+{
+	return root.parent_path() / (root.filename().wstring() + kStagedSuffix + PathVersion(version));
+}
+
+std::filesystem::path PreviousTree(const std::filesystem::path &root)
+{
+	return root.parent_path() / (root.filename().wstring() + kPreviousSuffix);
+}
+
+/* ── versions ───────────────────────────────────────────────────────────── */
+
+/* AppUpdater.swift:80-90: dotted versions compare numerically, a missing part
+ * counts as zero ("0.2.7" is not older than "0.2.7.0"), and every run of
+ * digits is one part ("0.2.10-beta1" -> 0,2,10,1). Swift's `Int($0) ?? 0`
+ * turns a part that does not fit an Int into zero, which is exactly what the
+ * accumulation below does at the same 64-bit boundary; leading zeros are not an
+ * overflow, here or there. Only ASCII digits count, where Swift also accepted
+ * non-ASCII ones, which cannot appear in a version we publish. */
+std::vector<long long> VersionParts(const std::string &version)
+{
+	std::vector<long long> parts;
+	size_t i = 0;
+	while (i < version.size()) {
+		if (version[i] < '0' || version[i] > '9') {
+			++i;
+			continue;
+		}
+		const size_t begin = i;
+		while (i < version.size() && version[i] >= '0' && version[i] <= '9')
+			++i;
+
+		long long value = 0;
+		bool overflow = false;
+		for (size_t at = begin; at < i; ++at) {
+			const int digit = version[at] - '0';
+			if (value > (std::numeric_limits<long long>::max() - digit) / 10) {
+				overflow = true;
+				break;
+			}
+			value = value * 10 + digit;
+		}
+		parts.push_back(overflow ? 0 : value);
+	}
+	return parts;
+}
+
+bool IsNewer(const std::string &candidate, const std::string &current)
+{
+	const std::vector<long long> a = VersionParts(candidate);
+	const std::vector<long long> b = VersionParts(current);
+	const size_t count = std::max(a.size(), b.size());
+	for (size_t i = 0; i < count; ++i) {
+		const long long x = i < a.size() ? a[i] : 0;
+		const long long y = i < b.size() ? b[i] : 0;
+		if (x != y)
+			return x > y;
+	}
+	return false;
+}
+
+/* AppUpdater.swift:187-189: the OBS major version an app is built on. */
+std::string ObsMajor(const std::string &version)
+{
+	const size_t dot = version.find('.');
+	return dot == std::string::npos ? version : version.substr(0, dot);
+}
+
+/* ── reading a release out of the feed ──────────────────────────────────── */
+
+struct Release {
+	std::string version;
+	std::string notes;
+	std::string page;
+	std::string archive;
+	std::string sha256;
+	long long size = 0;
+	bool prerelease = false;
+};
+
+/* The Swift read every field with `as? T` and fell back, so a feed with a
+ * wrong type in one field is tolerated rather than fatal. */
+std::string StringField(const nlohmann::json &object, const char *key)
+{
+	auto it = object.find(key);
+	return it != object.end() && it->is_string() ? it->get<std::string>() : std::string();
+}
+
+bool BoolField(const nlohmann::json &object, const char *key, bool fallback = false)
+{
+	auto it = object.find(key);
+	return it != object.end() && it->is_boolean() ? it->get<bool>() : fallback;
+}
+
+long long IntegerField(const nlohmann::json &object, const char *key)
+{
+	auto it = object.find(key);
+	return it != object.end() && it->is_number_integer() ? it->get<long long>() : 0;
+}
+
+/* AppUpdater.swift:118-136: one release object becomes the app archive for
+ * this architecture, its published digest and what the UI shows. */
+bool ReleaseFromObject(const nlohmann::json &root, Release &release, Failure &failure)
+{
+	if (!root.is_object() || !root.contains("tag_name") || !root["tag_name"].is_string()) {
+		failure = Network("invalid release feed");
+		return false;
+	}
+
+	const std::string tag = root["tag_name"].get<std::string>();
+	release.version = StartsWith(tag, "v") ? tag.substr(1) : tag;
+
+	if (release.version.empty()) {
+		failure = Network("the release has no version");
+		return false;
+	}
+
+	const std::string suffix = std::string("-") + kArchitecture + ".zip";
+	const nlohmann::json *asset = nullptr;
+	if (root.contains("assets") && root["assets"].is_array()) {
+		for (const nlohmann::json &candidate : root["assets"]) {
+			if (!candidate.is_object())
+				continue;
+			const std::string name = StringField(candidate, "name");
+			if (StartsWith(name, kAssetPrefix) && EndsWith(name, suffix)) {
+				asset = &candidate;
+				break;
+			}
+		}
+	}
+	if (!asset) {
+		failure = NoArchive(std::string("the release has no ") + kArchitecture + " archive");
+		return false;
+	}
+	release.archive = StringField(*asset, "browser_download_url");
+	if (release.archive.empty()) {
+		failure = NoArchive("the release's archive has no download address");
+		return false;
+	}
+
+	/* "digest" is GitHub's own "sha256:<hex>" for an uploaded asset. It is the
+	 * only integrity statement this release makes; AppUpdater.swift:128-131
+	 * read the same field. */
+	const std::string digest = StringField(*asset, "digest");
+	if (StartsWith(digest, "sha256:")) {
+		release.sha256 = digest.substr(std::strlen("sha256:"));
+		std::transform(release.sha256.begin(), release.sha256.end(), release.sha256.begin(),
+			       [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+	}
+
+	release.notes = StringField(root, "body");
+	release.page = StringField(root, "html_url");
+	if (release.page.empty())
+		release.page = kReleasesPage;
+	release.size = IntegerField(*asset, "size");
+	release.prerelease = BoolField(root, "prerelease");
+	return true;
+}
+
+/* AppUpdater.swift:104-116: an object is one release; a list is filtered
+ * (drafts always out, pre-releases unless `beta`) and the newest entry wins.
+ * Entries without an archive for this architecture drop out rather than
+ * failing the feed. */
+bool ReleaseFromFeed(const std::string &body, bool beta, Release &release, Failure &failure)
+{
+	const nlohmann::json parsed = nlohmann::json::parse(body, nullptr, false);
+	if (parsed.is_discarded()) {
+		failure = Network("the release feed is not JSON");
+		return false;
+	}
+	if (parsed.is_object())
+		return ReleaseFromObject(parsed, release, failure);
+	if (!parsed.is_array()) {
+		failure = Network("invalid release feed");
+		return false;
+	}
+
+	bool found = false;
+	Release newest;
+	for (const nlohmann::json &entry : parsed) {
+		if (!entry.is_object() || BoolField(entry, "draft"))
+			continue;
+		if (!beta && BoolField(entry, "prerelease"))
+			continue;
+		Release candidate;
+		Failure ignored;
+		if (!ReleaseFromObject(entry, candidate, ignored))
+			continue;
+		if (!found || IsNewer(candidate.version, newest.version)) {
+			newest = candidate;
+			found = true;
+		}
+	}
+	if (!found) {
+		failure = NoArchive("no usable release in the feed");
+		return false;
+	}
+	release = newest;
+	return true;
+}
+
+/* ── what this build is ─────────────────────────────────────────────────── */
+
+struct AppInfo {
+	std::filesystem::path exe;
+	/* The directory that is replaced by an update: the one holding
+	 * bin\64bit\obs64.exe. Empty when the executable is not in that layout, in
+	 * which case nothing is installed over it. */
+	std::filesystem::path root;
+	std::string product; /* ProductVersion: LIVEHIME_APP_VERSION */
+	std::string obs;     /* FileVersion: the OBS version this build is based on */
+	std::string name;    /* ProductName: "the same app" */
+	uint16_t machine = 0;
+};
+
+/* The shell folders every path below is built from: %LOCALAPPDATA% for the
+ * downloads (the macOS code used ~/Library/Caches) and %APPDATA% for the
+ * settings (the config root libobs already uses with
+ * OBS_USER_CONFIG_SUBDIR=LiveHime). SHGetKnownFolderPath answers in UTF-16, so
+ * a user name outside the current code page still resolves; an empty result
+ * fails the operation that needed it instead of writing somewhere relative. */
+std::filesystem::path KnownFolder(REFKNOWNFOLDERID id)
+{
+	PWSTR raw = nullptr;
+	if (FAILED(SHGetKnownFolderPath(id, 0, nullptr, &raw)) || !raw)
+		return {};
+	std::filesystem::path path(raw);
+	CoTaskMemFree(raw);
+	return path;
+}
+
+const std::filesystem::path &LocalAppData()
+{
+	static const std::filesystem::path path = KnownFolder(FOLDERID_LocalAppData);
+	return path;
+}
+
+const std::filesystem::path &RoamingAppData()
+{
+	static const std::filesystem::path path = KnownFolder(FOLDERID_RoamingAppData);
+	return path;
+}
+
+std::filesystem::path UpdatesFolder()
+{
+	const std::filesystem::path &base = LocalAppData();
+	return base.empty() ? base : base / L"LiveHime" / L"Updates";
+}
+
+std::filesystem::path BackupsFolder()
+{
+	const std::filesystem::path &base = RoamingAppData();
+	return base.empty() ? base : base / L"LiveHime" / L"backups";
+}
+
+std::filesystem::path ConfigFolder()
+{
+	const std::filesystem::path &base = RoamingAppData();
+	return base.empty() ? base : base / L"LiveHime" / L"obs-studio";
+}
+
+/* One string out of an executable's version resource, read the way
+ * update-page.cpp:45-85 reads the running version. An empty result means the
+ * file has no such string, which every caller treats as "cannot verify". */
+std::wstring ModuleField(const std::filesystem::path &module, const wchar_t *field)
+{
+	DWORD ignored = 0;
+	const DWORD size = GetFileVersionInfoSizeW(module.c_str(), &ignored);
+	if (!size)
+		return {};
+
+	std::vector<char> block(size);
+	if (!GetFileVersionInfoW(module.c_str(), 0, size, block.data()))
+		return {};
+
+	struct LangCodePage {
+		WORD language;
+		WORD codePage;
+	};
+	LangCodePage *translations = nullptr;
+	UINT translations_size = 0;
+	if (!VerQueryValueW(block.data(), L"\\VarFileInfo\\Translation", reinterpret_cast<LPVOID *>(&translations),
+			    &translations_size) ||
+	    !translations || translations_size < sizeof(LangCodePage))
+		return {};
+
+	wchar_t query[64] = {};
+	swprintf_s(query, L"\\StringFileInfo\\%04x%04x\\%s", translations[0].language, translations[0].codePage, field);
+
+	wchar_t *value = nullptr;
+	UINT value_size = 0;
+	if (!VerQueryValueW(block.data(), query, reinterpret_cast<LPVOID *>(&value), &value_size) || !value ||
+	    !value_size)
+		return {};
+	return std::wstring(value, wcsnlen(value, static_cast<size_t>(value_size)));
+}
+
+/* The COFF machine type of a PE file (IMAGE_FILE_HEADER.Machine). The staged
+ * tree has to be the same architecture as the running app; the asset name
+ * already selects one, and this is the check that the asset really is it. */
+uint16_t ModuleMachine(const std::filesystem::path &module)
+{
+	std::ifstream file(module, std::ios::binary);
+	if (!file)
+		return 0;
+
+	unsigned char dos[64] = {};
+	if (!file.read(reinterpret_cast<char *>(dos), sizeof(dos)))
+		return 0;
+	if (dos[0] != 'M' || dos[1] != 'Z')
+		return 0;
+
+	const uint32_t pe = static_cast<uint32_t>(dos[0x3C]) | (static_cast<uint32_t>(dos[0x3D]) << 8) |
+			    (static_cast<uint32_t>(dos[0x3E]) << 16) | (static_cast<uint32_t>(dos[0x3F]) << 24);
+
+	file.seekg(static_cast<std::streamoff>(pe));
+	unsigned char header[6] = {};
+	if (!file.read(reinterpret_cast<char *>(header), sizeof(header)))
+		return 0;
+	if (header[0] != 'P' || header[1] != 'E' || header[2] != 0 || header[3] != 0)
+		return 0;
+	return static_cast<uint16_t>(header[4] | (header[5] << 8));
+}
+
+/* The tree has to be a directory with a name and a parent of its own: an
+ * install is a rename in that parent, and a drive's root can be neither renamed
+ * nor staged beside. Anything else has no install tree to replace. */
+bool UsableRoot(const std::filesystem::path &root)
+{
+	return !root.empty() && !root.filename().empty() && root.parent_path() != root;
+}
+
+/* OBS's portable mode keeps the whole config root inside the install tree:
+ * frontend/obs-main.cpp enables it from one of these marker files in the tree's
+ * root, and frontend/OBSApp.cpp:1726 then reads and writes <root>\config. A
+ * user's scenes, profiles and plugin settings would be replaced along with the
+ * tree — the new archive has none of them — so an update is refused rather than
+ * performed as a silent settings reset. */
+bool PortableTree(const std::filesystem::path &root)
+{
+	static const wchar_t *kMarkers[] = {L"portable_mode", L"obs_portable_mode", L"portable_mode.txt",
+					    L"obs_portable_mode.txt"};
+	std::error_code ec;
+	if (std::filesystem::exists(root / L"config", ec) && !ec)
+		return true;
+	for (const wchar_t *marker : kMarkers) {
+		std::error_code inner;
+		if (std::filesystem::exists(root / marker, inner) && !inner)
+			return true;
+	}
+	return false;
+}
+
+/* What to tell the user when the tree cannot be replaced at all. */
+constexpr const char *kPortableReason =
+	"LiveHime keeps its settings inside the install tree (portable mode); an update would replace them";
+
+AppInfo ReadApp(const std::filesystem::path &exe)
+{
+	AppInfo app;
+	app.exe = exe;
+	app.product = Trim(Narrow(ModuleField(exe, L"ProductVersion")));
+	app.obs = Trim(Narrow(ModuleField(exe, L"FileVersion")));
+	app.name = Trim(Narrow(ModuleField(exe, L"ProductName")));
+	app.machine = ModuleMachine(exe);
+
+	/* The tree is the directory holding bin\64bit\obs64.exe. Anything else is
+	 * refused rather than guessed at: an install renames this directory, and a
+	 * wrong guess would move the wrong files. */
+	const std::filesystem::path folder = exe.parent_path();
+	if (!SameName(folder, kExeFolderName) || !SameName(folder.parent_path(), kBinFolderName) ||
+	    !SameName(exe, kExeName))
+		return app;
+	const std::filesystem::path root = folder.parent_path().parent_path();
+	if (!UsableRoot(root))
+		return app;
+	app.root = root;
+	return app;
+}
+
+/* The running executable, read once. GetModuleFileNameW(nullptr) from inside
+ * this DLL answers the host process's own path, which is what "the running
+ * app" means for every check here. */
+const AppInfo &ThisApp()
+{
+	static const AppInfo app = [] {
+		std::vector<wchar_t> buffer(32768, L'\0');
+		const DWORD length = GetModuleFileNameW(nullptr, buffer.data(), static_cast<DWORD>(buffer.size()));
+		if (length == 0 || length >= buffer.size())
+			return AppInfo{};
+		return ReadApp(std::filesystem::path(std::wstring(buffer.data(), length)));
+	}();
+	return app;
+}
+
+/* AppUpdater.swift:66-68: the running app's version, "0" when the version
+ * resource cannot be read at all. Same source as UpdatePage::currentVersion,
+ * so the two can never disagree. */
+std::string CurrentVersion()
+{
+	const AppInfo &app = ThisApp();
+	return app.product.empty() ? std::string("0") : app.product;
+}
+
+/* AppUpdater.swift:72-75: a development build does not replace itself, unless
+ * a test feed is set. The Windows reading of "development build" is in
+ * update/updater.h: a version resource whose ProductVersion is its FileVersion
+ * was configured without LIVEHIME_APP_VERSION — upstream OBS Studio, or this
+ * source built without the LiveHime branding. */
+std::optional<std::string> FeedOverride()
+{
+	const char *value = std::getenv("LIVEHIME_UPDATE_FEED");
+	if (!value || !*value)
+		return std::nullopt;
+	return std::string(value);
+}
+
+bool InstallSupported(const AppInfo &app)
+{
+	if (FeedOverride())
+		return true;
+	return !app.product.empty() && app.product != app.obs;
+}
+
+/* AppUpdater.swift:193-198: the version a rollback would return to — the kept
+ * previous tree, when it is this app at an older version. Read once: it cannot
+ * change while this process runs, because installing requires quitting. */
+const std::string &PreviousVersion()
+{
+	static const std::string version = [] {
+		const AppInfo &app = ThisApp();
+		if (app.root.empty())
+			return std::string();
+		const AppInfo previous = ReadApp(ExeIn(PreviousTree(app.root)));
+		if (previous.product.empty() || previous.name != app.name)
+			return std::string();
+		return IsNewer(CurrentVersion(), previous.product) ? previous.product : std::string();
+	}();
+	return version;
+}
+
+/* ── the archive: digest, download, unpack ──────────────────────────────── */
+
+/* Incremental SHA-256 over BCrypt, like net/crypto.cpp — but Sha256Hex() there
+ * is one-shot, and an archive is hundreds of megabytes: the digest is fed the
+ * bytes as they are written instead of reading the file back afterwards. */
+class Sha256 {
+public:
+	Sha256()
+	{
+		if (!NT_SUCCESS(BCryptOpenAlgorithmProvider(&alg_, BCRYPT_SHA256_ALGORITHM, nullptr, 0)))
+			return;
+		DWORD object_size = 0, produced = 0;
+		if (!NT_SUCCESS(BCryptGetProperty(alg_, BCRYPT_OBJECT_LENGTH, reinterpret_cast<PUCHAR>(&object_size),
+						  sizeof(object_size), &produced, 0)) ||
+		    !NT_SUCCESS(BCryptGetProperty(alg_, BCRYPT_HASH_LENGTH, reinterpret_cast<PUCHAR>(&digest_size_),
+						  sizeof(digest_size_), &produced, 0))) {
+			BCryptCloseAlgorithmProvider(alg_, 0);
+			alg_ = nullptr;
+			return;
+		}
+		object_.resize(object_size);
+		if (!NT_SUCCESS(BCryptCreateHash(alg_, &hash_, object_.data(), object_size, nullptr, 0, 0))) {
+			BCryptCloseAlgorithmProvider(alg_, 0);
+			alg_ = nullptr;
+			hash_ = nullptr;
+		}
+	}
+
+	~Sha256()
+	{
+		if (hash_)
+			BCryptDestroyHash(hash_);
+		if (alg_)
+			BCryptCloseAlgorithmProvider(alg_, 0);
+	}
+
+	Sha256(const Sha256 &) = delete;
+	Sha256 &operator=(const Sha256 &) = delete;
+
+	bool Ready() const { return hash_ != nullptr; }
+
+	void Update(const char *data, size_t size)
+	{
+		if (hash_ && size)
+			BCryptHashData(hash_, reinterpret_cast<PUCHAR>(const_cast<char *>(data)),
+				       static_cast<ULONG>(size), 0);
+	}
+
+	/* Lowercase hex of everything fed so far; empty when the hash never
+	 * started or could not finish, which the caller reports as a checksum
+	 * failure rather than installing anything. */
+	std::string Finish()
+	{
+		if (!hash_)
+			return {};
+		std::vector<uint8_t> digest(digest_size_);
+		if (!NT_SUCCESS(BCryptFinishHash(hash_, digest.data(), digest_size_, 0)))
+			return {};
+		return crypto::ToHex(digest.data(), digest.size());
+	}
+
+private:
+	BCRYPT_ALG_HANDLE alg_ = nullptr;
+	BCRYPT_HASH_HANDLE hash_ = nullptr;
+	std::vector<uint8_t> object_;
+	DWORD digest_size_ = 0;
+};
+
+/* ── the streaming download ─────────────────────────────────────────────── */
+
+/* net/http.h's Send() buffers a whole response in a std::string and answers on
+ * the main thread. That is right for the feed and wrong for a few hundred
+ * megabytes, so the asset is streamed here instead, on the worker thread: one
+ * GET, 64 KiB reads, straight to disk and through the digest. The plumbing
+ * below (URL crack, redirect by hand, status and header queries) is http.cpp's,
+ * which is file-local there and cannot be reached from here. */
+
+struct UrlParts {
+	std::wstring host;
+	std::wstring path; /* path + query */
+	INTERNET_PORT port = 0;
+	bool secure = false;
+	bool valid = false;
+};
+
+UrlParts ParseUrl(const std::string &url)
+{
+	UrlParts out;
+	const std::wstring wide = Widen(url);
+	if (wide.empty())
+		return out;
+
+	URL_COMPONENTS components = {};
+	components.dwStructSize = sizeof(components);
+	components.dwSchemeLength = static_cast<DWORD>(-1);
+	components.dwHostNameLength = static_cast<DWORD>(-1);
+	components.dwUrlPathLength = static_cast<DWORD>(-1);
+	components.dwExtraInfoLength = static_cast<DWORD>(-1);
+	if (!WinHttpCrackUrl(wide.c_str(), 0, 0, &components))
+		return out;
+
+	out.host.assign(components.lpszHostName, components.dwHostNameLength);
+	out.path.assign(components.lpszUrlPath, components.dwUrlPathLength);
+	if (components.dwExtraInfoLength)
+		out.path.append(components.lpszExtraInfo, components.dwExtraInfoLength);
+	out.port = components.nPort;
+	out.secure = components.nScheme == INTERNET_SCHEME_HTTPS;
+	out.valid = true;
+	return out;
+}
+
+/* The download's own WinHTTP session, closed however the function leaves. */
+struct SessionHandle {
+	explicit SessionHandle(HINTERNET handle) : handle(handle) {}
+	~SessionHandle()
+	{
+		if (handle)
+			WinHttpCloseHandle(handle);
+	}
+	SessionHandle(const SessionHandle &) = delete;
+	SessionHandle &operator=(const SessionHandle &) = delete;
+
+	HINTERNET handle = nullptr;
+};
+
+/* One open request; closes both handles on the way out, which is also what a
+ * redirect hop does before it tries the next address. */
+struct Connection {
+	~Connection()
+	{
+		if (request)
+			WinHttpCloseHandle(request);
+		if (connect)
+			WinHttpCloseHandle(connect);
+	}
+	Connection() = default;
+	Connection(const Connection &) = delete;
+	Connection &operator=(const Connection &) = delete;
+
+	HINTERNET request = nullptr;
+	HINTERNET connect = nullptr;
+};
+
+bool HeaderNumber(HINTERNET request, DWORD query, DWORD &value)
+{
+	DWORD size = sizeof(value);
+	return WinHttpQueryHeaders(request, query | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX, &value,
+				   &size, WINHTTP_NO_HEADER_INDEX) != FALSE;
+}
+
+std::wstring HeaderString(HINTERNET request, DWORD query)
+{
+	DWORD size = 0;
+	WinHttpQueryHeaders(request, query, WINHTTP_HEADER_NAME_BY_INDEX, nullptr, &size, WINHTTP_NO_HEADER_INDEX);
+	if (!size)
+		return {};
+
+	std::wstring value(size / sizeof(wchar_t), L'\0');
+	if (!WinHttpQueryHeaders(request, query, WINHTTP_HEADER_NAME_BY_INDEX, &value[0], &size,
+				 WINHTTP_NO_HEADER_INDEX))
+		return {};
+	value.resize(wcsnlen(value.c_str(), value.size()));
+	return value;
+}
+
+/* A redirect target: absolute, or a path on the host that sent it. */
+std::string ResolveRedirect(const std::string &base, const std::wstring &location)
+{
+	std::string target = Narrow(location);
+	if (!target.empty() && target[0] == '/') {
+		const size_t scheme = base.find("://");
+		const size_t host_end = base.find('/', scheme == std::string::npos ? 0 : scheme + 3);
+		target = base.substr(0, host_end) + target;
+	}
+	return target;
+}
+
+/* Streams `url` into `target`, feeding every byte to `hasher` as it is written.
+ * `progress` is called at each whole percent when `total` is known (zero when
+ * the release did not say how large the archive is). */
+bool DownloadAsset(const std::string &url, const std::filesystem::path &target, long long total,
+		   const std::atomic<bool> &cancel, Sha256 &hasher, const std::function<void(double)> &progress,
+		   long long &received, Failure &failure)
+{
+	const std::wstring agent = L"LiveHime/" + Widen(CurrentVersion()) + L" (Windows; OBS)";
+	SessionHandle session(WinHttpOpen(agent.c_str(), WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, WINHTTP_NO_PROXY_NAME,
+					  WINHTTP_NO_PROXY_BYPASS, 0));
+	if (!session.handle) {
+		failure = Network("WinHTTP could not be started");
+		return false;
+	}
+	/* Connect 10 s, send 15 s, receive 15 s: a stalled transfer is noticed
+	 * while there is still a caller left to tell about it. */
+	WinHttpSetTimeouts(session.handle, 10000, 10000, 15000, 15000);
+
+	std::ofstream file(target, std::ios::binary | std::ios::trunc);
+	if (!file) {
+		failure = Location("cannot write the download to " + Utf8(target));
+		return false;
+	}
+
+	std::string current = url;
+	const bool started_secure = StartsWith(current, "https://");
+	int last_percent = -1;
+
+	for (int hop = 0; hop <= kMaxRedirects; ++hop) {
+		const UrlParts parts = ParseUrl(current);
+		if (!parts.valid) {
+			failure = Network("the release gives an invalid download address");
+			return false;
+		}
+
+		Connection connection;
+		connection.connect = WinHttpConnect(session.handle, parts.host.c_str(), parts.port, 0);
+		if (!connection.connect) {
+			failure = Network("cannot reach the release host");
+			return false;
+		}
+		connection.request = WinHttpOpenRequest(connection.connect, L"GET", parts.path.c_str(), nullptr,
+							WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES,
+							parts.secure ? WINHTTP_FLAG_SECURE : 0);
+		if (!connection.request) {
+			failure = Network("cannot open the download request");
+			return false;
+		}
+
+		/* Redirects are followed here rather than by WinHTTP, so the one that
+		 * leaves github.com for its object store can be looked at. */
+		DWORD policy = WINHTTP_OPTION_REDIRECT_POLICY_NEVER;
+		WinHttpSetOption(connection.request, WINHTTP_OPTION_REDIRECT_POLICY, &policy, sizeof(policy));
+
+		/* Identity, always: the published SHA-256 is over the bytes as they
+		 * were uploaded, so nothing may transparently decompress them. */
+		const std::wstring headers = L"Accept: application/octet-stream\r\nAccept-Encoding: identity\r\n";
+		if (!WinHttpSendRequest(connection.request, headers.c_str(), static_cast<DWORD>(headers.size()),
+					WINHTTP_NO_REQUEST_DATA, 0, 0, 0) ||
+		    !WinHttpReceiveResponse(connection.request, nullptr)) {
+			failure = Network("the download could not be started (winhttp " +
+					  std::to_string(GetLastError()) + ")");
+			return false;
+		}
+
+		DWORD status = 0;
+		if (!HeaderNumber(connection.request, WINHTTP_QUERY_STATUS_CODE, status)) {
+			failure = Network("the release host answered nothing readable");
+			return false;
+		}
+		if (status >= 300 && status < 400) {
+			const std::wstring location = HeaderString(connection.request, WINHTTP_QUERY_LOCATION);
+			if (location.empty()) {
+				failure = Network("the release host redirected without a target");
+				return false;
+			}
+			current = ResolveRedirect(current, location);
+			if (started_secure && !StartsWith(current, "https://")) {
+				failure = Network("the release host redirected to an insecure address");
+				return false;
+			}
+			continue;
+		}
+		if (status != 200) {
+			failure = Network("the release host answered HTTP " + std::to_string(status));
+			return false;
+		}
+
+		DWORD length = 0;
+		if (HeaderNumber(connection.request, WINHTTP_QUERY_CONTENT_LENGTH, length) && length > 0 && total > 0 &&
+		    static_cast<long long>(length) != total) {
+			failure = Checksum("the download is " + std::to_string(length) + " bytes, not " +
+					   std::to_string(total));
+			return false;
+		}
+
+		std::vector<char> buffer(kDownloadChunk);
+		for (;;) {
+			if (cancel.load()) {
+				failure = Network("the update was cancelled");
+				return false;
+			}
+			DWORD available = 0;
+			if (!WinHttpQueryDataAvailable(connection.request, &available) || available == 0)
+				break;
+			const DWORD want = static_cast<DWORD>(std::min<size_t>(available, buffer.size()));
+			DWORD read = 0;
+			if (!WinHttpReadData(connection.request, buffer.data(), want, &read) || read == 0)
+				break;
+
+			file.write(buffer.data(), static_cast<std::streamsize>(read));
+			if (!file) {
+				failure = Location("cannot write the download to " + Utf8(target));
+				return false;
+			}
+			hasher.Update(buffer.data(), static_cast<size_t>(read));
+			received += static_cast<long long>(read);
+
+			if (total > 0 && progress) {
+				const int percent = static_cast<int>(received * 100 / total);
+				if (percent != last_percent) {
+					last_percent = percent;
+					progress(std::min(1.0,
+							  static_cast<double>(received) / static_cast<double>(total)));
+				}
+			}
+		}
+
+		file.flush();
+		if (!file) {
+			failure = Location("cannot write the download to " + Utf8(target));
+			return false;
+		}
+		/* A connection dropped mid-body is a short file; so is a proxy that
+		 * cut the answer off. The digest below would catch both, but the size
+		 * says so more precisely. */
+		if (total > 0 && received != total) {
+			failure = Checksum("the download ended after " + std::to_string(received) + " of " +
+					   std::to_string(total) + " bytes");
+			return false;
+		}
+		return true;
+	}
+
+	failure = Network("the download redirected too many times");
+	return false;
+}
+
+/* ══ zip reader (BEGIN ZIP READER — everything down to END ZIP READER is free
+ * of Windows headers on purpose, so it can be compiled and exercised on any
+ * platform with zlib; the one place a zip name becomes a path is EntryPath) ══
+ *
+ * The macOS code unpacks with /usr/bin/ditto -x -k. Windows has no equivalent
+ * that is always there — tar.exe arrived in Windows 10 1803, Expand-Archive
+ * needs PowerShell and an execution policy that allows it — and both would be a
+ * second process to supervise for a job that is a loop over a central
+ * directory. zlib is already linked (the danmaku protocol's version-2 bodies),
+ * so the archive is read here: the central directory, then stored or deflated
+ * entries, each checked against the CRC-32 and the size the archive declares.
+ * Zip64 is understood (the locator and the extra field) because a large release
+ * may well need it. */
+
+struct ZipEntry {
+	std::string name;
+	uint16_t method = 0;
+	uint32_t crc = 0;
+	uint64_t compressed = 0;
+	uint64_t uncompressed = 0;
+	uint64_t offset = 0;
+	/* The language-encoding flag: the name is UTF-8 rather than the machine's
+	 * own code page. */
+	bool utf8 = false;
+};
+
+uint16_t ReadU16(const unsigned char *bytes)
+{
+	return static_cast<uint16_t>(bytes[0] | (bytes[1] << 8));
+}
+
+uint32_t ReadU32(const unsigned char *bytes)
+{
+	return static_cast<uint32_t>(bytes[0]) | (static_cast<uint32_t>(bytes[1]) << 8) |
+	       (static_cast<uint32_t>(bytes[2]) << 16) | (static_cast<uint32_t>(bytes[3]) << 24);
+}
+
+uint64_t ReadU64(const unsigned char *bytes)
+{
+	return static_cast<uint64_t>(ReadU32(bytes)) | (static_cast<uint64_t>(ReadU32(bytes + 4)) << 32);
+}
+
+/* The archive's central directory: the one place that says where every entry
+ * is. Returns false with the reason in `failure`, which is invalidApp because
+ * at that point the bytes have already passed their digest and still do not
+ * describe an install tree. */
+bool ReadCentralDirectory(std::ifstream &file, uint64_t file_size, std::vector<ZipEntry> &entries, Failure &failure)
+{
+	if (file_size < 22) {
+		failure = InvalidApp("the archive is too small to be a zip");
+		return false;
+	}
+
+	/* The end-of-central-directory record is the last 22 bytes plus a comment
+	 * of up to 64 KiB. */
+	const uint64_t tail_size = std::min<uint64_t>(file_size, 22 + 0xFFFF);
+	std::vector<unsigned char> tail(static_cast<size_t>(tail_size));
+	file.seekg(static_cast<std::streamoff>(file_size - tail_size));
+	if (!file.read(reinterpret_cast<char *>(tail.data()), static_cast<std::streamsize>(tail.size()))) {
+		failure = InvalidApp("the archive could not be read");
+		return false;
+	}
+
+	int64_t eocd = -1;
+	for (int64_t i = static_cast<int64_t>(tail.size()) - 22; i >= 0; --i) {
+		if (ReadU32(&tail[static_cast<size_t>(i)]) == 0x06054b50u) {
+			eocd = i;
+			break;
+		}
+	}
+	if (eocd < 0) {
+		failure = InvalidApp("the archive has no end-of-central-directory record");
+		return false;
+	}
+
+	uint64_t count = ReadU16(&tail[static_cast<size_t>(eocd) + 10]);
+	uint64_t directory_size = ReadU32(&tail[static_cast<size_t>(eocd) + 12]);
+	uint64_t directory_offset = ReadU32(&tail[static_cast<size_t>(eocd) + 16]);
+
+	/* Zip64: every one of those fields saturates to its all-ones value and the
+	 * real numbers are in the zip64 record the locator points at. */
+	if (count == 0xFFFFu || directory_size == 0xFFFFFFFFu || directory_offset == 0xFFFFFFFFu) {
+		const int64_t locator = eocd - 20;
+		if (locator < 0 || ReadU32(&tail[static_cast<size_t>(locator)]) != 0x07064b50u) {
+			failure = InvalidApp("the archive is zip64 without a locator");
+			return false;
+		}
+		const uint64_t zip64 = ReadU64(&tail[static_cast<size_t>(locator) + 8]);
+		if (zip64 + 56 > file_size) {
+			failure = InvalidApp("the archive's zip64 record is outside the file");
+			return false;
+		}
+		unsigned char head[56] = {};
+		file.seekg(static_cast<std::streamoff>(zip64));
+		if (!file.read(reinterpret_cast<char *>(head), sizeof(head)) || ReadU32(head) != 0x06064b50u) {
+			failure = InvalidApp("the archive's zip64 record could not be read");
+			return false;
+		}
+		count = ReadU64(head + 32);
+		directory_size = ReadU64(head + 40);
+		directory_offset = ReadU64(head + 48);
+	}
+
+	if (directory_offset + directory_size > file_size || directory_size > SIZE_MAX) {
+		failure = InvalidApp("the archive's central directory is outside the file");
+		return false;
+	}
+
+	std::vector<unsigned char> directory(static_cast<size_t>(directory_size));
+	file.seekg(static_cast<std::streamoff>(directory_offset));
+	if (!file.read(reinterpret_cast<char *>(directory.data()), static_cast<std::streamsize>(directory.size()))) {
+		failure = InvalidApp("the archive's central directory could not be read");
+		return false;
+	}
+
+	size_t at = 0;
+	for (uint64_t index = 0; index < count; ++index) {
+		if (at + 46 > directory.size() || ReadU32(&directory[at]) != 0x02014b50u) {
+			failure = InvalidApp("the archive's central directory is damaged");
+			return false;
+		}
+
+		ZipEntry entry;
+		const uint16_t flags = ReadU16(&directory[at + 8]);
+		if (flags & 0x0001u) {
+			failure = InvalidApp("the archive is encrypted");
+			return false;
+		}
+		entry.utf8 = (flags & 0x0800u) != 0;
+		entry.method = ReadU16(&directory[at + 10]);
+		entry.crc = ReadU32(&directory[at + 16]);
+		entry.compressed = ReadU32(&directory[at + 20]);
+		entry.uncompressed = ReadU32(&directory[at + 24]);
+		const uint16_t name_length = ReadU16(&directory[at + 28]);
+		const uint16_t extra_length = ReadU16(&directory[at + 30]);
+		const uint16_t comment_length = ReadU16(&directory[at + 32]);
+		entry.offset = ReadU32(&directory[at + 42]);
+		if (at + 46 + name_length + extra_length + comment_length > directory.size()) {
+			failure = InvalidApp("the archive's central directory is truncated");
+			return false;
+		}
+		entry.name.assign(reinterpret_cast<const char *>(&directory[at + 46]), name_length);
+
+		if (entry.uncompressed == 0xFFFFFFFFu || entry.compressed == 0xFFFFFFFFu ||
+		    entry.offset == 0xFFFFFFFFu) {
+			const unsigned char *extra = &directory[at + 46 + name_length];
+			bool found = false;
+			for (size_t field = 0; field + 4 <= extra_length;) {
+				const uint16_t id = ReadU16(extra + field);
+				const uint16_t size = ReadU16(extra + field + 2);
+				field += 4;
+				if (field + size > extra_length) {
+					failure = InvalidApp("the archive's zip64 extra field is damaged");
+					return false;
+				}
+				if (id == 0x0001u) {
+					/* The three values appear in this order, each only
+					 * when its 32-bit field saturated. */
+					const unsigned char *values = extra + field;
+					size_t left = size;
+					if (entry.uncompressed == 0xFFFFFFFFu) {
+						if (left < 8) {
+							failure =
+								InvalidApp("the archive's zip64 extra field is short");
+							return false;
+						}
+						entry.uncompressed = ReadU64(values);
+						values += 8;
+						left -= 8;
+					}
+					if (entry.compressed == 0xFFFFFFFFu) {
+						if (left < 8) {
+							failure =
+								InvalidApp("the archive's zip64 extra field is short");
+							return false;
+						}
+						entry.compressed = ReadU64(values);
+						values += 8;
+						left -= 8;
+					}
+					if (entry.offset == 0xFFFFFFFFu) {
+						if (left < 8) {
+							failure =
+								InvalidApp("the archive's zip64 extra field is short");
+							return false;
+						}
+						entry.offset = ReadU64(values);
+					}
+					found = true;
+					break;
+				}
+				field += size;
+			}
+			if (!found) {
+				failure = InvalidApp("a zip64 entry has no zip64 extra field");
+				return false;
+			}
+		}
+
+		entries.push_back(std::move(entry));
+		at += 46 + name_length + extra_length + comment_length;
+	}
+	return true;
+}
+
+/* A Windows device name as a path component would address the device, not a
+ * file, however it is spelled (CON, CON.txt, con). Nothing in a release archive
+ * should ever be one. */
+bool IsDeviceName(const std::string &component)
+{
+	static const char *kNames[] = {"con",  "prn",  "aux",  "nul",  "com1", "com2", "com3", "com4",
+				       "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3",
+				       "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"};
+	const size_t dot = component.find('.');
+	std::string stem = dot == std::string::npos ? component : component.substr(0, dot);
+	std::transform(stem.begin(), stem.end(), stem.begin(),
+		       [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+	for (const char *name : kNames) {
+		if (stem == name)
+			return true;
+	}
+	return false;
+}
+
+/* Turns one entry name into a relative path, or refuses it. A zip may use
+ * either separator (Windows tools write '\'), and nothing in it is trusted: an
+ * absolute name, a drive letter, a colon (an NTFS alternate data stream), a
+ * device name or a ".." component would otherwise write outside the
+ * destination. A name that is absolute is refused rather than reinterpreted,
+ * because no archive this project publishes has one and a release that does is
+ * not the release it claims to be. */
+bool EntryRelativePath(const std::string &name, std::string &relative, Failure &failure)
+{
+	if (name.empty()) {
+		failure = InvalidApp("the archive holds an entry with no name");
+		return false;
+	}
+	if (name[0] == '/' || name[0] == '\\') {
+		failure = InvalidApp("the archive holds an absolute entry name (" + name + ")");
+		return false;
+	}
+
+	std::string out;
+	size_t at = 0;
+	while (at < name.size()) {
+		size_t end = name.find_first_of("/\\", at);
+		if (end == std::string::npos)
+			end = name.size();
+		const std::string component = name.substr(at, end - at);
+		at = end + 1;
+		if (component.empty() || component == ".")
+			continue;
+		if (component == "..") {
+			failure = InvalidApp("the archive holds an entry that escapes the install tree (" + name + ")");
+			return false;
+		}
+		if (component.find(':') != std::string::npos) {
+			failure = InvalidApp("the archive holds an entry with a colon in its name (" + name + ")");
+			return false;
+		}
+		if (IsDeviceName(component)) {
+			failure = InvalidApp("the archive holds an entry named after a device (" + name + ")");
+			return false;
+		}
+		if (!out.empty())
+			out += '/';
+		out += component;
+	}
+	if (out.empty()) {
+		failure = InvalidApp("the archive holds an entry with no name");
+		return false;
+	}
+	relative = out;
+	return true;
+}
+
+#ifdef _WIN32
+/* One of the two code pages a zip name can be in, decided by the archive's own
+ * encoding flag. */
+std::wstring FromCodePage(const std::string &text, UINT code_page)
+{
+	if (text.empty())
+		return {};
+	const int size = MultiByteToWideChar(code_page, 0, text.c_str(), static_cast<int>(text.size()), nullptr, 0);
+	if (size <= 0)
+		return Widen(text);
+	std::wstring out(static_cast<size_t>(size), L'\0');
+	MultiByteToWideChar(code_page, 0, text.c_str(), static_cast<int>(text.size()), &out[0], size);
+	return out;
+}
+
+/* Windows paths are UTF-16, so a name from the archive is converted rather than
+ * reinterpreted. A name in neither code page cannot turn into an empty path:
+ * FromCodePage falls back to the UTF-8 reading, which substitutes U+FFFD for
+ * bytes it cannot use and can therefore never escape the destination. */
+std::filesystem::path EntryPath(const std::string &name, bool utf8)
+{
+	return std::filesystem::path(FromCodePage(name, utf8 ? CP_UTF8 : CP_ACP));
+}
+#else
+/* Off Windows the name is already a path; this branch is what lets the zip
+ * reader be compiled and exercised elsewhere. */
+std::filesystem::path EntryPath(const std::string &name, bool)
+{
+	return std::filesystem::path(name);
+}
+#endif
+
+/* One file entry: its local header says how long the two variable-length fields
+ * in front of the data are, and then comes the data itself. Copied when stored,
+ * inflated when deflated, and in both cases checked against the CRC-32 and the
+ * size the central directory declared. */
+bool ExtractEntry(std::ifstream &file, const ZipEntry &entry, const std::filesystem::path &target, Failure &failure)
+{
+	unsigned char header[30] = {};
+	file.clear();
+	file.seekg(static_cast<std::streamoff>(entry.offset));
+	if (!file.read(reinterpret_cast<char *>(header), sizeof(header)) || ReadU32(header) != 0x04034b50u) {
+		failure = InvalidApp("the archive's entry " + entry.name + " has no local header");
+		return false;
+	}
+	const uint16_t name_length = ReadU16(header + 26);
+	const uint16_t extra_length = ReadU16(header + 28);
+	file.seekg(static_cast<std::streamoff>(entry.offset) + 30 + name_length + extra_length);
+
+	std::ofstream out(target, std::ios::binary | std::ios::trunc);
+	if (!out) {
+		failure = Location("cannot write " + Utf8(target));
+		return false;
+	}
+
+	uLong crc = crc32(0L, Z_NULL, 0);
+	uint64_t written = 0;
+	std::vector<unsigned char> input(static_cast<size_t>(std::min<uint64_t>(kDownloadChunk, entry.compressed + 1)));
+	std::vector<unsigned char> output(kDownloadChunk);
+
+	/* Reads up to `want` compressed bytes; false when the archive ends early. */
+	const auto refill = [&file, &input](uint64_t &left, uInt &available, unsigned char *&next) {
+		const size_t want = static_cast<size_t>(std::min<uint64_t>(left, input.size()));
+		file.read(reinterpret_cast<char *>(input.data()), static_cast<std::streamsize>(want));
+		if (file.gcount() != static_cast<std::streamsize>(want))
+			return false;
+		left -= want;
+		next = input.data();
+		available = static_cast<uInt>(want);
+		return true;
+	};
+
+	if (entry.method == 0) {
+		/* Stored: the compressed bytes are the file. */
+		uint64_t left = entry.compressed;
+		unsigned char *next = nullptr;
+		uInt available = 0;
+		while (left > 0 || available > 0) {
+			if (available == 0 && !refill(left, available, next)) {
+				failure = InvalidApp("the archive ends inside " + entry.name);
+				return false;
+			}
+			out.write(reinterpret_cast<const char *>(next), static_cast<std::streamsize>(available));
+			crc = crc32(crc, next, available);
+			written += available;
+			available = 0;
+		}
+	} else if (entry.method == 8) {
+		z_stream stream = {};
+		if (inflateInit2(&stream, -MAX_WBITS) != Z_OK) {
+			failure = InvalidApp("zlib could not start an inflate stream");
+			return false;
+		}
+
+		uint64_t left = entry.compressed;
+		bool truncated = false;
+		for (;;) {
+			if (stream.avail_in == 0) {
+				/* Nothing buffered and nothing left in the archive, with
+				 * the deflate stream not finished: the entry is cut off. */
+				if (left == 0 || !refill(left, stream.avail_in, stream.next_in)) {
+					truncated = true;
+					break;
+				}
+			}
+
+			stream.next_out = output.data();
+			stream.avail_out = static_cast<uInt>(output.size());
+			const int status = inflate(&stream, Z_NO_FLUSH);
+			if (status != Z_OK && status != Z_STREAM_END) {
+				inflateEnd(&stream);
+				failure = InvalidApp("the archive's entry " + entry.name + " does not inflate (zlib " +
+						     std::to_string(status) + ")");
+				return false;
+			}
+
+			const size_t produced = output.size() - stream.avail_out;
+			if (produced) {
+				out.write(reinterpret_cast<const char *>(output.data()),
+					  static_cast<std::streamsize>(produced));
+				crc = crc32(crc, output.data(), static_cast<uInt>(produced));
+				written += produced;
+				if (!out) {
+					inflateEnd(&stream);
+					failure = Location("cannot write " + Utf8(target));
+					return false;
+				}
+			}
+			if (status == Z_STREAM_END)
+				break;
+		}
+		inflateEnd(&stream);
+
+		if (truncated) {
+			failure = InvalidApp("the archive ends inside " + entry.name);
+			return false;
+		}
+	} else {
+		failure = InvalidApp("the archive's entry " + entry.name + " uses compression method " +
+				     std::to_string(entry.method));
+		return false;
+	}
+
+	out.close();
+	if (!out) {
+		failure = Location("cannot write " + Utf8(target));
+		return false;
+	}
+	if (written != entry.uncompressed) {
+		failure = InvalidApp("the archive's entry " + entry.name + " unpacked to " + std::to_string(written) +
+				     " of " + std::to_string(entry.uncompressed) + " bytes");
+		return false;
+	}
+	if (static_cast<uint32_t>(crc) != entry.crc) {
+		failure = InvalidApp("the archive's entry " + entry.name + " failed its CRC");
+		return false;
+	}
+	return true;
+}
+
+bool ExtractZip(const std::filesystem::path &archive, const std::filesystem::path &destination, Failure &failure)
+{
+	std::ifstream file(archive, std::ios::binary);
+	if (!file) {
+		failure = Location("cannot read the download at " + Utf8(archive));
+		return false;
+	}
+	file.seekg(0, std::ios::end);
+	const std::streamoff end = file.tellg();
+	if (end <= 0) {
+		failure = InvalidApp("the downloaded archive is empty");
+		return false;
+	}
+
+	std::vector<ZipEntry> entries;
+	if (!ReadCentralDirectory(file, static_cast<uint64_t>(end), entries, failure))
+		return false;
+	if (entries.empty()) {
+		failure = InvalidApp("the downloaded archive has no entries");
+		return false;
+	}
+
+	std::error_code ec;
+	std::filesystem::create_directories(destination, ec);
+	if (ec) {
+		failure = Location("cannot create " + Utf8(destination));
+		return false;
+	}
+
+	for (const ZipEntry &entry : entries) {
+		std::string relative;
+		if (!EntryRelativePath(entry.name, relative, failure))
+			return false;
+
+		const std::filesystem::path target = destination / EntryPath(relative, entry.utf8);
+		if (entry.name.back() == '/' || entry.name.back() == '\\') {
+			std::filesystem::create_directories(target, ec);
+			if (ec) {
+				failure = Location("cannot create " + Utf8(target));
+				return false;
+			}
+			continue;
+		}
+		std::filesystem::create_directories(target.parent_path(), ec);
+		if (ec) {
+			failure = Location("cannot create " + Utf8(target.parent_path()));
+			return false;
+		}
+		if (!ExtractEntry(file, entry, target, failure))
+			return false;
+	}
+	return true;
+}
+/* ══ END ZIP READER ══ */
+
+/* ── events (main thread only) ──────────────────────────────────────────── */
+
+/* What every update event carries (AppUpdateBridge.swift:13-20) plus the
+ * event's own fields. Merge keeps its base's value on a collision, so the
+ * event's fields go in as the base: status, version and the rest of the
+ * event win over anything added here. */
+void EmitUpdate(const nlohmann::json &fields)
+{
+	const AppInfo &app = ThisApp();
+	nlohmann::json defaults{{"event", "update"},
+				{"current", CurrentVersion()},
+				{"supported", InstallSupported(app)},
+				{"obsCurrent", app.obs}};
+	const std::string &previous = PreviousVersion();
+	if (!previous.empty())
+		defaults["previous"] = previous;
+	Emit(Merge(fields, defaults));
+}
+
+void EmitFailure(const Failure &failure)
+{
+	EmitUpdate(nlohmann::json{{"status", "failed"}, {"reason", failure.reason}, {"message", failure.message}});
+}
