diff --git a/plugins/livehime/core/win/auth/credentials.cpp b/plugins/livehime/core/win/auth/credentials.cpp
new file mode 100644
index 0000000..216d473
--- /dev/null
+++ b/plugins/livehime/core/win/auth/credentials.cpp
@@ -0,0 +1,203 @@
+#include "credentials.h"
+
+#include <windows.h>
+#include <dpapi.h>
+#include <wincred.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace livehime {
+namespace auth {
+namespace {
+
+/* Credential Manager refuses blobs over CRED_MAX_CREDENTIAL_BLOB_SIZE (2560
+ * bytes). A Bilibili session is normally a few hundred bytes, but SESSDATA is
+ * not length-bounded by anything we control and the envelope has to hold the
+ * whole cookie set, so the store has a second home rather than a hard ceiling:
+ * a DPAPI-protected file, encrypted to the current user, under %LOCALAPPDATA%.
+ *
+ * The credential is preferred when it fits because it is the Windows
+ * equivalent of the Keychain item the macOS core writes; the file is the
+ * overflow, and Load() checks both so a session written by either path is
+ * found. */
+constexpr size_t kCredentialBlobLimit = CRED_MAX_CREDENTIAL_BLOB_SIZE;
+
+std::wstring Widen(const std::string &utf8)
+{
+	if (utf8.empty())
+		return {};
+	int len = MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), nullptr, 0);
+	std::wstring out(static_cast<size_t>(len), L'\0');
+	MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), &out[0], len);
+	return out;
+}
+
+std::string Narrow(const wchar_t *wide, size_t len)
+{
+	if (!wide || !len)
+		return {};
+	int bytes = WideCharToMultiByte(CP_UTF8, 0, wide, static_cast<int>(len), nullptr, 0, nullptr, nullptr);
+	std::string out(static_cast<size_t>(bytes), '\0');
+	WideCharToMultiByte(CP_UTF8, 0, wide, static_cast<int>(len), &out[0], bytes, nullptr, nullptr);
+	return out;
+}
+
+/* Credential Manager target names are flat strings; namespacing keeps
+ * LiveHime's entry from colliding with anything else in the vault. */
+std::wstring TargetName(const std::string &service)
+{
+	return L"LiveHime/" + Widen(service);
+}
+
+/* %LOCALAPPDATA%\LiveHime\session.bin — per-user, not roamed, which is the
+ * closest Windows has to the Keychain's ThisDeviceOnly. */
+std::wstring OverflowPath()
+{
+	const char *base = std::getenv("LOCALAPPDATA");
+	std::string dir = base && *base ? base : ".";
+	dir += "\\LiveHime";
+	CreateDirectoryW(Widen(dir).c_str(), nullptr);
+	return Widen(dir + "\\session.bin");
+}
+
+bool WriteOverflow(const std::string &blob)
+{
+	DATA_BLOB plain = {};
+	plain.pbData = reinterpret_cast<BYTE *>(const_cast<char *>(blob.data()));
+	plain.cbData = static_cast<DWORD>(blob.size());
+
+	DATA_BLOB sealed = {};
+	if (!CryptProtectData(&plain, L"LiveHime session", nullptr, nullptr, nullptr, 0, &sealed))
+		return false;
+
+	std::wstring path = OverflowPath();
+	HANDLE file = CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_HIDDEN, nullptr);
+	if (file == INVALID_HANDLE_VALUE) {
+		LocalFree(sealed.pbData);
+		return false;
+	}
+	DWORD written = 0;
+	bool ok = WriteFile(file, sealed.pbData, sealed.cbData, &written, nullptr) && written == sealed.cbData;
+	CloseHandle(file);
+	LocalFree(sealed.pbData);
+	return ok;
+}
+
+bool ReadOverflow(std::string &out)
+{
+	std::wstring path = OverflowPath();
+	HANDLE file = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+				  FILE_ATTRIBUTE_NORMAL, nullptr);
+	if (file == INVALID_HANDLE_VALUE)
+		return false;
+
+	LARGE_INTEGER size = {};
+	if (!GetFileSizeEx(file, &size) || size.QuadPart <= 0 || size.QuadPart > 1024 * 1024) {
+		CloseHandle(file);
+		return false;
+	}
+
+	std::vector<BYTE> sealed_bytes(static_cast<size_t>(size.QuadPart));
+	DWORD read = 0;
+	bool ok = ReadFile(file, sealed_bytes.data(), static_cast<DWORD>(sealed_bytes.size()), &read, nullptr) &&
+		  read == sealed_bytes.size();
+	CloseHandle(file);
+	if (!ok)
+		return false;
+
+	DATA_BLOB sealed = {};
+	sealed.pbData = sealed_bytes.data();
+	sealed.cbData = static_cast<DWORD>(sealed_bytes.size());
+
+	DATA_BLOB plain = {};
+	if (!CryptUnprotectData(&sealed, nullptr, nullptr, nullptr, nullptr, 0, &plain))
+		return false;
+	out.assign(reinterpret_cast<const char *>(plain.pbData), plain.cbData);
+	LocalFree(plain.pbData);
+	return true;
+}
+
+void DeleteOverflow()
+{
+	DeleteFileW(OverflowPath().c_str());
+}
+
+} // namespace
+
+CredentialStore &CredentialStore::Instance()
+{
+	static CredentialStore store;
+	return store;
+}
+
+void CredentialStore::SetService(const std::string &service)
+{
+	service_ = service.empty() ? kDefaultService : service;
+}
+
+bool CredentialStore::Load(std::string &out) const
+{
+	const std::string service = service_.empty() ? kDefaultService : service_;
+	std::wstring target = TargetName(service);
+
+	PCREDENTIALW credential = nullptr;
+	if (CredReadW(target.c_str(), CRED_TYPE_GENERIC, 0, &credential)) {
+		bool ok = false;
+		if (credential->CredentialBlob && credential->CredentialBlobSize) {
+			out.assign(reinterpret_cast<const char *>(credential->CredentialBlob),
+				   credential->CredentialBlobSize);
+			ok = true;
+		}
+		CredFree(credential);
+		if (ok)
+			return true;
+	}
+
+	/* Either the vault had nothing or the session lives in the overflow. */
+	return ReadOverflow(out);
+}
+
+bool CredentialStore::Save(const std::string &blob) const
+{
+	const std::string service = service_.empty() ? kDefaultService : service_;
+
+	if (blob.size() <= kCredentialBlobLimit) {
+		std::wstring target = TargetName(service);
+		std::wstring comment = L"LiveHime Bilibili session (do not share)";
+
+		CREDENTIALW credential = {};
+		credential.Type = CRED_TYPE_GENERIC;
+		credential.TargetName = const_cast<LPWSTR>(target.c_str());
+		credential.Comment = const_cast<LPWSTR>(comment.c_str());
+		credential.CredentialBlobSize = static_cast<DWORD>(blob.size());
+		credential.CredentialBlob = reinterpret_cast<LPBYTE>(const_cast<char *>(blob.data()));
+		credential.Persist = CRED_PERSIST_LOCAL_MACHINE;
+
+		if (CredWriteW(&credential, 0)) {
+			/* Do not leave a stale overflow behind a fresh vault entry. */
+			DeleteOverflow();
+			return true;
+		}
+		/* Fall through: the vault refused it, so use the overflow. */
+	}
+
+	return WriteOverflow(blob);
+}
+
+bool CredentialStore::Clear() const
+{
+	const std::string service = service_.empty() ? kDefaultService : service_;
+	std::wstring target = TargetName(service);
+	DeleteOverflow();
+
+	if (CredDeleteW(target.c_str(), CRED_TYPE_GENERIC, 0))
+		return true;
+	/* Already gone counts as cleared. */
+	return GetLastError() == ERROR_NOT_FOUND;
+}
+
+} // namespace auth
+} // namespace livehime
diff --git a/plugins/livehime/core/win/auth/credentials.h b/plugins/livehime/core/win/auth/credentials.h
new file mode 100644
index 0000000..1eb7f72
--- /dev/null
+++ b/plugins/livehime/core/win/auth/credentials.h
@@ -0,0 +1,46 @@
+/* Session storage on Windows.
+ *
+ * The macOS core keeps the session in the login Keychain (CredentialStore.swift)
+ * under a service name the C interface passes in. The Windows equivalent is a
+ * generic credential in the user's vault, written with CredWriteW and read back
+ * with CredReadW.
+ *
+ * The payload is deliberately opaque here: it is whatever JSON the session
+ * layer decides to persist, so that changing the session fields never touches
+ * this file. It is never logged. */
+
+#pragma once
+
+#include <string>
+
+namespace livehime {
+namespace auth {
+
+class CredentialStore {
+public:
+	static CredentialStore &Instance();
+
+	/* Target name to store under. The C interface's `keychain_service` argument
+	 * maps here; NULL/empty selects the same default the macOS core uses. */
+	void SetService(const std::string &service);
+	const std::string &Service() const { return service_; }
+
+	/* Reads the stored blob. False when nothing is stored or the read failed. */
+	bool Load(std::string &out) const;
+
+	/* Overwrites any previous blob. */
+	bool Save(const std::string &blob) const;
+
+	/* Removes the credential; succeeds when it was already absent. */
+	bool Clear() const;
+
+private:
+	CredentialStore() = default;
+	std::string service_;
+};
+
+/* The default service name, matching CredentialStore.swift's. */
+inline constexpr const char *kDefaultService = "local.livehime.macos.session";
+
+} // namespace auth
+} // namespace livehime
diff --git a/plugins/livehime/core/win/auth/session.h b/plugins/livehime/core/win/auth/session.h
new file mode 100644
index 0000000..b06ca08
--- /dev/null
+++ b/plugins/livehime/core/win/auth/session.h
@@ -0,0 +1,83 @@
+/* Login state machine — the C++ counterpart of SessionCoordinator.swift.
+ *
+ * Publishes the {"state": ...} objects described in CONTRACT §4.1. The rule
+ * from SessionCoordinator.swift:21-25 is honoured literally: only an explicit
+ * "not logged in" from Bilibili goes back to signedOut; everything else stays
+ * failed with the credentials kept. */
+
+#pragma once
+
+#include <string>
+
+#include "live/liveclient.h"
+
+namespace livehime {
+namespace auth {
+
+/* SessionCoordinator.swift:10-18, same raw strings. */
+enum class Notice {
+	None,
+	SessionExpired,
+	LegacyNeedsLogin,
+	QrExpired,
+	NoLiveRoom,
+	Network,
+	Server,
+	Keychain,
+};
+
+const char *NoticeRaw(Notice notice);
+
+struct Account {
+	long long mid = 0;
+	std::string username;
+	live::RoomInfo room;
+};
+
+class Session {
+public:
+	static Session &Instance();
+
+	/* livehime_core_start: remembers the callback's credential service and
+	 * restores any saved session, then publishes the resulting state. */
+	void Start(const std::string &credential_service);
+
+	/* livehime_core_stop */
+	void Stop();
+
+	void StartQrLogin();
+	void CancelQrLogin();
+	void Retry();
+	void SignOut();
+
+	bool Ready() const { return ready_; }
+	const Account &Current() const { return account_; }
+	long long RoomId() const { return account_.room.room_id; }
+	long long Mid() const { return account_.mid; }
+
+	/* Re-reads the room; emitted as a fresh state object. */
+	void RefreshRoom();
+
+	/* Called by the live layer when Bilibili answers -101, so the UI can be
+	 * moved back to the login screen for the one case that warrants it. */
+	void MarkSignedOut(Notice notice);
+
+private:
+	Session() = default;
+
+	void PublishSignedOut(Notice notice);
+	void PublishFailed(Notice notice, const std::string &detail);
+	void PublishVerifying();
+	void PublishReady();
+	void PublishQr(const std::string &url, bool scanned);
+
+	void PersistSession();
+	bool RestoreSession();
+
+	bool ready_ = false;
+	Account account_;
+	std::string credential_service_;
+};
+
+} // namespace auth
+} // namespace livehime
diff --git a/plugins/livehime/core/win/core/emit.cpp b/plugins/livehime/core/win/core/emit.cpp
new file mode 100644
index 0000000..4ba7a1d
--- /dev/null
+++ b/plugins/livehime/core/win/core/emit.cpp
@@ -0,0 +1,61 @@
+#include "emit.h"
+
+#include "../platform/dispatch.h"
+
+namespace livehime {
+namespace {
+
+livehime_state_callback g_callback = nullptr;
+void *g_context = nullptr;
+
+} // namespace
+
+void SetCallback(livehime_state_callback callback, void *context)
+{
+	g_callback = callback;
+	g_context = context;
+}
+
+void Emit(const nlohmann::json &object)
+{
+	if (!g_callback)
+		return;
+
+	/* The C interface promises the UI is called on the main thread. Every
+	 * caller in this core already runs there, but Emit is the last place a
+	 * mistake could escape into the UI, so it checks rather than trusts. */
+	if (!dispatch::OnMainThread()) {
+		nlohmann::json copy = object;
+		dispatch::Post([copy]() { Emit(copy); });
+		return;
+	}
+
+	/* nlohmann::json orders object keys (std::map), which is the same
+	 * deterministic ordering JSONSerialization's .sortedKeys produced. */
+	std::string text = object.dump();
+	g_callback(text.c_str(), g_context);
+}
+
+void EmitEvent(const std::string &event, nlohmann::json fields)
+{
+	nlohmann::json object = std::move(fields);
+	if (!object.is_object())
+		object = nlohmann::json::object();
+	object["event"] = event;
+	Emit(object);
+}
+
+nlohmann::json Merge(const nlohmann::json &base, const nlohmann::json &extra)
+{
+	nlohmann::json out = base;
+	if (!extra.is_object())
+		return out;
+	for (auto it = extra.begin(); it != extra.end(); ++it) {
+		/* Swift's `merging(_:) { $1 }` keeps the receiver's value on collision. */
+		if (out.find(it.key()) == out.end())
+			out[it.key()] = it.value();
+	}
+	return out;
+}
+
+} // namespace livehime
diff --git a/plugins/livehime/core/win/core/emit.h b/plugins/livehime/core/win/core/emit.h
new file mode 100644
index 0000000..96d489d
--- /dev/null
+++ b/plugins/livehime/core/win/core/emit.h
@@ -0,0 +1,30 @@
+/* Emitting JSON to the UI.
+ *
+ * The Swift used JSONSerialization with .sortedKeys; nlohmann::json's default
+ * std::map ordering is already sorted, so plain `dump()` matches byte for byte.
+ * Everything the core sends to the C++ UI goes through Emit. */
+
+#pragma once
+
+#include <nlohmann/json.hpp>
+
+#include <string>
+
+#include "livehime-core.h"
+
+namespace livehime {
+
+/* Set by livehime_core_start; cleared by livehime_core_stop. */
+void SetCallback(livehime_state_callback callback, void *context);
+
+/* Sends one object. No-op when no callback is installed. Must run on the main
+ * thread; callers reach it through dispatch::Post. */
+void Emit(const nlohmann::json &object);
+
+/* Convenience for the common {"event": name, ...} shape. */
+void EmitEvent(const std::string &event, nlohmann::json fields = nlohmann::json::object());
+
+/* Merge helper: Swift's `a.merging(b) { $1 }` keeps a's value on collision. */
+nlohmann::json Merge(const nlohmann::json &base, const nlohmann::json &extra);
+
+} // namespace livehime
