diff --git a/plugins/livehime/core/win/net/cookies.cpp b/plugins/livehime/core/win/net/cookies.cpp
new file mode 100644
index 0000000..db3649a
--- /dev/null
+++ b/plugins/livehime/core/win/net/cookies.cpp
@@ -0,0 +1,256 @@
+#include "cookies.h"
+
+#include <algorithm>
+#include <cctype>
+#include <mutex>
+#include <sstream>
+#include <unordered_map>
+
+namespace livehime {
+namespace net {
+namespace {
+
+struct Cookie {
+	std::string name;
+	std::string value;
+	std::string domain; /* lowercase, leading dot stripped */
+	std::string path;
+	bool host_only = true;
+};
+
+std::mutex g_mutex;
+std::vector<Cookie> g_cookies;
+
+std::string Lower(std::string s)
+{
+	std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+	return s;
+}
+
+std::string Trim(const std::string &s)
+{
+	size_t b = s.find_first_not_of(" \t\r\n");
+	if (b == std::string::npos)
+		return {};
+	size_t e = s.find_last_not_of(" \t\r\n");
+	return s.substr(b, e - b + 1);
+}
+
+/* "https://api.live.bilibili.com/x/y?z=1" -> {"api.live.bilibili.com", "/x/y"} */
+bool SplitUrl(const std::string &url, std::string &host, std::string &path)
+{
+	size_t scheme = url.find("://");
+	if (scheme == std::string::npos)
+		return false;
+	size_t start = scheme + 3;
+	size_t slash = url.find('/', start);
+	host = Lower(url.substr(start, slash == std::string::npos ? std::string::npos : slash - start));
+	size_t at = host.find('@');
+	if (at != std::string::npos)
+		host = host.substr(at + 1);
+	size_t colon = host.find(':');
+	if (colon != std::string::npos)
+		host = host.substr(0, colon);
+	path = slash == std::string::npos ? "/" : url.substr(slash);
+	size_t q = path.find('?');
+	if (q != std::string::npos)
+		path = path.substr(0, q);
+	return !host.empty();
+}
+
+/* RFC 6265 §5.1.3: host-only when no Domain attribute was given. */
+bool DomainMatches(const Cookie &c, const std::string &host)
+{
+	if (c.host_only)
+		return host == c.domain;
+	if (host == c.domain)
+		return true;
+	if (host.size() > c.domain.size() && host.compare(host.size() - c.domain.size(), c.domain.size(), c.domain) == 0)
+		return host[host.size() - c.domain.size() - 1] == '.';
+	return false;
+}
+
+/* RFC 6265 §5.1.4 default-path, then prefix match. */
+bool PathMatches(const Cookie &c, const std::string &path)
+{
+	if (c.path.empty() || c.path == "/")
+		return true;
+	if (path.compare(0, c.path.size(), c.path) != 0)
+		return false;
+	if (path.size() == c.path.size())
+		return true;
+	return c.path.back() == '/' || path[c.path.size()] == '/';
+}
+
+void Store(const Cookie &c)
+{
+	for (auto &existing : g_cookies) {
+		if (existing.name == c.name && existing.domain == c.domain && existing.path == c.path) {
+			existing = c;
+			return;
+		}
+	}
+	g_cookies.push_back(c);
+}
+
+} // namespace
+
+CookieJar &CookieJar::Instance()
+{
+	static CookieJar jar;
+	return jar;
+}
+
+void CookieJar::AbsorbResponse(const std::string &request_url, const std::string &raw_headers)
+{
+	std::string host, path;
+	if (!SplitUrl(request_url, host, path))
+		return;
+
+	std::lock_guard<std::mutex> lock(g_mutex);
+
+	std::istringstream stream(raw_headers);
+	std::string line;
+	while (std::getline(stream, line)) {
+		line = Trim(line);
+		if (line.size() < 11)
+			continue;
+		std::string lowered = Lower(line);
+		if (lowered.compare(0, 11, "set-cookie:") != 0)
+			continue;
+
+		std::string value = Trim(line.substr(11));
+		size_t semi = value.find(';');
+		std::string pair = semi == std::string::npos ? value : value.substr(0, semi);
+		size_t eq = pair.find('=');
+		if (eq == std::string::npos)
+			continue;
+
+		Cookie c;
+		c.name = Trim(pair.substr(0, eq));
+		c.value = Trim(pair.substr(eq + 1));
+		c.domain = host;
+		c.path = "/";
+		c.host_only = true;
+		if (c.name.empty())
+			continue;
+
+		size_t pos = semi;
+		while (pos != std::string::npos && pos + 1 < value.size()) {
+			size_t next = value.find(';', pos + 1);
+			std::string attr = Trim(value.substr(pos + 1, next == std::string::npos ? std::string::npos : next - pos - 1));
+			size_t aeq = attr.find('=');
+			std::string key = Lower(Trim(aeq == std::string::npos ? attr : attr.substr(0, aeq)));
+			std::string aval = aeq == std::string::npos ? std::string() : Trim(attr.substr(aeq + 1));
+
+			if (key == "domain" && !aval.empty()) {
+				if (!aval.empty() && aval[0] == '.')
+					aval.erase(0, 1);
+				c.domain = Lower(aval);
+				c.host_only = false;
+			} else if (key == "path" && !aval.empty()) {
+				c.path = aval;
+			} else if (key == "max-age") {
+				/* Expiry bookkeeping is deliberately absent: every cookie we
+				 * keep is a session cookie for a live process, and Bilibili's
+				 * long-lived ones are re-issued on each nav check. A zero
+				 * max-age is an explicit delete, which we do honour. */
+				try {
+					if (std::stoll(aval) <= 0)
+						c.name.clear();
+				} catch (...) {
+				}
+			}
+			pos = next;
+		}
+		if (c.name.empty())
+			continue;
+
+		/* A host-only cookie must not be stored for a domain it does not
+		 * contain; guard against a hostile Set-Cookie for an unrelated host. */
+		if (c.domain.empty() || host.find(c.domain) == std::string::npos)
+			continue;
+
+		Store(c);
+	}
+}
+
+std::string CookieJar::HeaderFor(const std::string &url) const
+{
+	std::string host, path;
+	if (!SplitUrl(url, host, path))
+		return {};
+
+	std::lock_guard<std::mutex> lock(g_mutex);
+	std::string out;
+	for (const auto &c : g_cookies) {
+		if (!DomainMatches(c, host) || !PathMatches(c, path))
+			continue;
+		if (!out.empty())
+			out += "; ";
+		out += c.name + "=" + c.value;
+	}
+	return out;
+}
+
+void CookieJar::Set(const std::string &domain, const std::string &name, const std::string &value)
+{
+	if (name.empty())
+		return;
+	Cookie c;
+	c.name = name;
+	c.value = value;
+	c.domain = Lower(domain);
+	if (!c.domain.empty() && c.domain[0] == '.')
+		c.domain.erase(0, 1);
+	c.host_only = false;
+	c.path = "/";
+	std::lock_guard<std::mutex> lock(g_mutex);
+	Store(c);
+}
+
+std::string CookieJar::Get(const std::string &name) const
+{
+	std::lock_guard<std::mutex> lock(g_mutex);
+	for (const auto &c : g_cookies) {
+		if (c.name == name)
+			return c.value;
+	}
+	return {};
+}
+
+bool CookieJar::Has(const std::string &name) const
+{
+	return !Get(name).empty();
+}
+
+std::vector<std::pair<std::string, std::string>> CookieJar::All() const
+{
+	std::lock_guard<std::mutex> lock(g_mutex);
+	std::vector<std::pair<std::string, std::string>> out;
+	out.reserve(g_cookies.size());
+	for (const auto &c : g_cookies)
+		out.emplace_back(c.name, c.value);
+	return out;
+}
+
+std::string CookieJar::PersistString() const
+{
+	std::lock_guard<std::mutex> lock(g_mutex);
+	std::string out;
+	for (const auto &c : g_cookies) {
+		if (!out.empty())
+			out += "; ";
+		out += c.name + "=" + c.value;
+	}
+	return out;
+}
+
+void CookieJar::Clear()
+{
+	std::lock_guard<std::mutex> lock(g_mutex);
+	g_cookies.clear();
+}
+
+} // namespace net
+} // namespace livehime
diff --git a/plugins/livehime/core/win/net/cookies.h b/plugins/livehime/core/win/net/cookies.h
new file mode 100644
index 0000000..b59ba33
--- /dev/null
+++ b/plugins/livehime/core/win/net/cookies.h
@@ -0,0 +1,54 @@
+/* Cookie jar for the Windows core.
+ *
+ * The Swift core relied on URLSession's shared HTTPCookieStorage, which is
+ * process-wide and host-keyed. This is the same idea, small enough to read:
+ * domain/path matching per RFC 6265 §5.1.3-5.1.4, no public-suffix list (we
+ * only ever talk to bilibili.com hosts, and Bilibili's own cookies are set for
+ * .bilibili.com).
+ *
+ * Thread-safe: the HTTP worker threads read it, main-thread code writes it
+ * after a login. */
+
+#pragma once
+
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace livehime {
+namespace net {
+
+class CookieJar {
+public:
+	static CookieJar &Instance();
+
+	/* Parses every Set-Cookie header on the response and stores them against
+	 * `request_url`'s host. */
+	void AbsorbResponse(const std::string &request_url, const std::string &raw_headers);
+
+	/* "name=value; name2=value2" for the cookies that apply to `url`, or "" . */
+	std::string HeaderFor(const std::string &url) const;
+
+	/* Sets one cookie explicitly (the web-view login applies them this way). */
+	void Set(const std::string &domain, const std::string &name, const std::string &value);
+
+	/* Value of `name`, or "" when absent. Ignores domain matching. */
+	std::string Get(const std::string &name) const;
+
+	bool Has(const std::string &name) const;
+
+	/* Every stored cookie, for persisting the session. Never logged. */
+	std::vector<std::pair<std::string, std::string>> All() const;
+
+	/* The "cookie" field of Bilibili's OAuth token store: name=value pairs
+	 * joined with ';'. Empty when nothing is stored. */
+	std::string PersistString() const;
+
+	void Clear();
+
+private:
+	CookieJar() = default;
+};
+
+} // namespace net
+} // namespace livehime
diff --git a/plugins/livehime/core/win/net/crypto.cpp b/plugins/livehime/core/win/net/crypto.cpp
new file mode 100644
index 0000000..a1d1e4a
--- /dev/null
+++ b/plugins/livehime/core/win/net/crypto.cpp
@@ -0,0 +1,193 @@
+#include "crypto.h"
+
+#include <windows.h>
+#include <bcrypt.h>
+
+#include <cstring>
+
+#ifndef NT_SUCCESS
+#define NT_SUCCESS(Status) (((NTSTATUS)(Status)) >= 0)
+#endif
+
+namespace livehime {
+namespace crypto {
+namespace {
+
+/* Runs one BCrypt hash over `data` and returns the raw digest. */
+std::vector<uint8_t> Hash(LPCWSTR algorithm, const std::string &data)
+{
+	std::vector<uint8_t> digest;
+
+	BCRYPT_ALG_HANDLE alg = nullptr;
+	if (!NT_SUCCESS(BCryptOpenAlgorithmProvider(&alg, algorithm, nullptr, 0)))
+		return digest;
+
+	DWORD object_size = 0, digest_size = 0, produced = 0;
+	if (!NT_SUCCESS(BCryptGetProperty(alg, BCRYPT_OBJECT_LENGTH, reinterpret_cast<PUCHAR>(&object_size),
+					 sizeof(object_size), &produced, 0)) ||
+	    !NT_SUCCESS(BCryptGetProperty(alg, BCRYPT_HASH_LENGTH, reinterpret_cast<PUCHAR>(&digest_size),
+					  sizeof(digest_size), &produced, 0))) {
+		BCryptCloseAlgorithmProvider(alg, 0);
+		return digest;
+	}
+
+	std::vector<uint8_t> object(object_size);
+	BCRYPT_HASH_HANDLE hash = nullptr;
+	if (!NT_SUCCESS(BCryptCreateHash(alg, &hash, object.data(), object_size, nullptr, 0, 0))) {
+		BCryptCloseAlgorithmProvider(alg, 0);
+		return digest;
+	}
+
+	NTSTATUS status = BCryptHashData(hash, reinterpret_cast<PUCHAR>(const_cast<char *>(data.data())),
+					 static_cast<ULONG>(data.size()), 0);
+	if (NT_SUCCESS(status)) {
+		digest.resize(digest_size);
+		status = BCryptFinishHash(hash, digest.data(), digest_size, 0);
+		if (!NT_SUCCESS(status))
+			digest.clear();
+	}
+
+	BCryptDestroyHash(hash);
+	BCryptCloseAlgorithmProvider(alg, 0);
+	return digest;
+}
+
+} // namespace
+
+std::string ToHex(const uint8_t *data, size_t len)
+{
+	static const char *digits = "0123456789abcdef";
+	std::string out;
+	out.reserve(len * 2);
+	for (size_t i = 0; i < len; ++i) {
+		out += digits[data[i] >> 4];
+		out += digits[data[i] & 0x0F];
+	}
+	return out;
+}
+
+std::string Md5Hex(const std::string &data)
+{
+	std::vector<uint8_t> digest = Hash(BCRYPT_MD5_ALGORITHM, data);
+	return digest.empty() ? std::string() : ToHex(digest.data(), digest.size());
+}
+
+std::string Sha256Hex(const std::string &data)
+{
+	std::vector<uint8_t> digest = Hash(BCRYPT_SHA256_ALGORITHM, data);
+	return digest.empty() ? std::string() : ToHex(digest.data(), digest.size());
+}
+
+std::vector<uint8_t> HmacSha256(const std::vector<uint8_t> &key, const std::string &data)
+{
+	std::vector<uint8_t> mac;
+
+	BCRYPT_ALG_HANDLE alg = nullptr;
+	if (!NT_SUCCESS(BCryptOpenAlgorithmProvider(&alg, BCRYPT_SHA256_ALGORITHM, nullptr,
+						    BCRYPT_ALG_HANDLE_HMAC_FLAG)))
+		return mac;
+
+	DWORD object_size = 0, mac_size = 0, produced = 0;
+	if (!NT_SUCCESS(BCryptGetProperty(alg, BCRYPT_OBJECT_LENGTH, reinterpret_cast<PUCHAR>(&object_size),
+					 sizeof(object_size), &produced, 0)) ||
+	    !NT_SUCCESS(BCryptGetProperty(alg, BCRYPT_HASH_LENGTH, reinterpret_cast<PUCHAR>(&mac_size),
+					  sizeof(mac_size), &produced, 0))) {
+		BCryptCloseAlgorithmProvider(alg, 0);
+		return mac;
+	}
+
+	std::vector<uint8_t> object(object_size);
+	BCRYPT_HASH_HANDLE hash = nullptr;
+	if (!NT_SUCCESS(BCryptCreateHash(alg, &hash, object.data(), object_size,
+					 const_cast<PUCHAR>(key.data()), static_cast<ULONG>(key.size()), 0))) {
+		BCryptCloseAlgorithmProvider(alg, 0);
+		return mac;
+	}
+
+	NTSTATUS status = BCryptHashData(hash, reinterpret_cast<PUCHAR>(const_cast<char *>(data.data())),
+					 static_cast<ULONG>(data.size()), 0);
+	if (NT_SUCCESS(status)) {
+		mac.resize(mac_size);
+		status = BCryptFinishHash(hash, mac.data(), mac_size, 0);
+		if (!NT_SUCCESS(status))
+			mac.clear();
+	}
+
+	BCryptDestroyHash(hash);
+	BCryptCloseAlgorithmProvider(alg, 0);
+	return mac;
+}
+
+std::string Base64Encode(const uint8_t *data, size_t len)
+{
+	static const char *alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	std::string out;
+	out.reserve(((len + 2) / 3) * 4);
+	for (size_t i = 0; i < len; i += 3) {
+		uint32_t triple = static_cast<uint32_t>(data[i]) << 16;
+		if (i + 1 < len)
+			triple |= static_cast<uint32_t>(data[i + 1]) << 8;
+		if (i + 2 < len)
+			triple |= data[i + 2];
+		out += alphabet[(triple >> 18) & 0x3F];
+		out += alphabet[(triple >> 12) & 0x3F];
+		out += i + 1 < len ? alphabet[(triple >> 6) & 0x3F] : '=';
+		out += i + 2 < len ? alphabet[triple & 0x3F] : '=';
+	}
+	return out;
+}
+
+std::string Base64Encode(const std::string &data)
+{
+	return Base64Encode(reinterpret_cast<const uint8_t *>(data.data()), data.size());
+}
+
+std::vector<uint8_t> Base64Decode(const std::string &text)
+{
+	auto value_of = [](char c) -> int {
+		if (c >= 'A' && c <= 'Z')
+			return c - 'A';
+		if (c >= 'a' && c <= 'z')
+			return c - 'a' + 26;
+		if (c >= '0' && c <= '9')
+			return c - '0' + 52;
+		if (c == '+')
+			return 62;
+		if (c == '/')
+			return 63;
+		return -1;
+	};
+
+	std::vector<uint8_t> out;
+	out.reserve(text.size() * 3 / 4);
+	uint32_t buffer = 0;
+	int bits = 0;
+	for (char c : text) {
+		if (c == '=' || c == '\n' || c == '\r')
+			continue;
+		int value = value_of(c);
+		if (value < 0) {
+			out.clear();
+			return out;
+		}
+		buffer = (buffer << 6) | static_cast<uint32_t>(value);
+		bits += 6;
+		if (bits >= 8) {
+			bits -= 8;
+			out.push_back(static_cast<uint8_t>((buffer >> bits) & 0xFF));
+		}
+	}
+	return out;
+}
+
+std::vector<uint8_t> RandomBytes(size_t count)
+{
+	std::vector<uint8_t> out(count);
+	if (count && !NT_SUCCESS(BCryptGenRandom(nullptr, out.data(), static_cast<ULONG>(count),
+						BCRYPT_USE_SYSTEM_PREFERRED_RNG)))
+		out.clear();
+	return out;
+}
+
+} // namespace crypto
+} // namespace livehime
