diff --git a/plugins/livehime/core/win/core/qr/qr_png.cpp b/plugins/livehime/core/win/core/qr/qr_png.cpp
new file mode 100644
index 0000000..19ff79e
--- /dev/null
+++ b/plugins/livehime/core/win/core/qr/qr_png.cpp
@@ -0,0 +1,115 @@
+#include "qr_png.h"
+
+#include "../net/crypto.h"
+#include "qrcodegen.hpp"
+
+#include <zlib.h>
+
+#include <cstring>
+
+namespace livehime {
+namespace qr {
+namespace {
+
+void AppendBigEndian32(std::vector<uint8_t> &out, uint32_t value)
+{
+	out.push_back(static_cast<uint8_t>((value >> 24) & 0xFF));
+	out.push_back(static_cast<uint8_t>((value >> 16) & 0xFF));
+	out.push_back(static_cast<uint8_t>((value >> 8) & 0xFF));
+	out.push_back(static_cast<uint8_t>(value & 0xFF));
+}
+
+/* One PNG chunk: length, type, payload, CRC-32 over type+payload. */
+void AppendChunk(std::vector<uint8_t> &out, const char type[4], const std::vector<uint8_t> &payload)
+{
+	AppendBigEndian32(out, static_cast<uint32_t>(payload.size()));
+
+	std::vector<uint8_t> crc_input;
+	crc_input.reserve(4 + payload.size());
+	crc_input.insert(crc_input.end(), type, type + 4);
+	crc_input.insert(crc_input.end(), payload.begin(), payload.end());
+
+	out.insert(out.end(), type, type + 4);
+	out.insert(out.end(), payload.begin(), payload.end());
+	AppendBigEndian32(out, static_cast<uint32_t>(crc32(0, crc_input.data(), static_cast<uInt>(crc_input.size()))));
+}
+
+} // namespace
+
+std::vector<uint8_t> Png(const std::string &text, int pixels)
+{
+	std::vector<uint8_t> out;
+	if (text.empty() || pixels <= 0)
+		return out;
+
+	using qrcodegen::QrCode;
+	/* qrcodegen signals an over-long payload by throwing (data_too_long, a
+	 * std::length_error). A DLL must not let that cross the C ABI, so an
+	 * unencodable string is a plain empty result and the caller emits the
+	 * qrCode state without "qrPng". */
+	QrCode code;
+	try {
+		code = QrCode::encodeText(text.c_str(), QrCode::Ecc::MEDIUM);
+	} catch (...) {
+		return out;
+	}
+	if (code.getSize() <= 0)
+		return out;
+
+	/* PlatformSupport.swift:31-34: four modules of quiet zone on each side, and
+	 * a whole-number scale that keeps the result at or under the target. */
+	const int modules = code.getSize() + 8;
+	const int scale = pixels / modules;
+	if (scale <= 0)
+		return out;
+	const int side = modules * scale;
+
+	/* 8-bit greyscale scanlines, each prefixed with filter type 0 (None). */
+	std::vector<uint8_t> raw;
+	raw.reserve(static_cast<size_t>(side) * (side + 1));
+	for (int y = 0; y < side; ++y) {
+		raw.push_back(0);
+		const int module_y = y / scale - 4;
+		for (int x = 0; x < side; ++x) {
+			const int module_x = x / scale - 4;
+			bool dark = false;
+			if (module_x >= 0 && module_y >= 0 && module_x < code.getSize() && module_y < code.getSize())
+				dark = code.getModule(module_x, module_y);
+			raw.push_back(dark ? 0x00 : 0xFF);
+		}
+	}
+
+	uLongf compressed_size = compressBound(static_cast<uLong>(raw.size()));
+	std::vector<uint8_t> compressed(compressed_size);
+	if (compress2(compressed.data(), &compressed_size, raw.data(), static_cast<uLong>(raw.size()), Z_BEST_COMPRESSION) !=
+	    Z_OK)
+		return out;
+	compressed.resize(compressed_size);
+
+	out.insert(out.end(), {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A});
+
+	std::vector<uint8_t> ihdr;
+	AppendBigEndian32(ihdr, static_cast<uint32_t>(side));
+	AppendBigEndian32(ihdr, static_cast<uint32_t>(side));
+	ihdr.push_back(8); /* bit depth */
+	ihdr.push_back(0); /* colour type: greyscale */
+	ihdr.push_back(0); /* compression: deflate */
+	ihdr.push_back(0); /* filter method */
+	ihdr.push_back(0); /* interlace: none */
+	AppendChunk(out, "IHDR", ihdr);
+	AppendChunk(out, "IDAT", compressed);
+	AppendChunk(out, "IEND", {});
+
+	return out;
+}
+
+std::string PngBase64(const std::string &text, int pixels)
+{
+	std::vector<uint8_t> png = Png(text, pixels);
+	if (png.empty())
+		return {};
+	return crypto::Base64Encode(png.data(), png.size());
+}
+
+} // namespace qr
+} // namespace livehime
diff --git a/plugins/livehime/core/win/core/qr/qr_png.h b/plugins/livehime/core/win/core/qr/qr_png.h
new file mode 100644
index 0000000..7231e07
--- /dev/null
+++ b/plugins/livehime/core/win/core/qr/qr_png.h
@@ -0,0 +1,32 @@
+/* QR code rendering for the login state.
+ *
+ * The macOS core used CoreImage's CIQRCodeGenerator (PlatformSupport.swift:24-47).
+ * There is no equivalent on Windows, so this encodes with Project Nayuki's
+ * qrcodegen (vendored under core/qr, MIT — see LICENSE.txt there) and writes the
+ * PNG itself through zlib.
+ *
+ * The parameters are copied from the Swift so the two platforms produce the
+ * same picture: error correction M, a four-module quiet zone on each side, a
+ * whole-number module scale, and a 480-pixel target. The exact module pattern
+ * may differ — qrcodegen and CoreImage pick masks independently — but any
+ * reader scans either. */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace livehime {
+namespace qr {
+
+/* PNG bytes, or empty when `text` does not fit a QR code at all. */
+std::vector<uint8_t> Png(const std::string &text, int pixels = 480);
+
+/* Base64 of Png(), which is what the "qrCode" state carries. Empty on failure,
+ * in which case the state is emitted without "qrPng" rather than with a
+ * broken one. */
+std::string PngBase64(const std::string &text, int pixels = 480);
+
+} // namespace qr
+} // namespace livehime
diff --git a/plugins/livehime/core/win/core/qr/qrcodegen.cpp b/plugins/livehime/core/win/core/qr/qrcodegen.cpp
new file mode 100644
index 0000000..9aa91b4
--- /dev/null
+++ b/plugins/livehime/core/win/core/qr/qrcodegen.cpp
