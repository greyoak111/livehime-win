@@ -0,0 +1,38 @@
+/* Hashing and signing for the Windows core.
+ *
+ * Replaces CryptoKit. Everything here is BCrypt (bcrypt.dll, in every Windows
+ * since Vista), so the plugin needs no new third-party dependency: MbedTLS is
+ * only linked into obs-studio, not into livehime.dll.
+ *
+ * Inputs and outputs are UTF-8 / raw bytes; no hex parsing beyond the helpers
+ * below. */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace livehime {
+namespace crypto {
+
+std::string Md5Hex(const std::string &data);
+
+std::string Sha256Hex(const std::string &data);
+
+std::vector<uint8_t> HmacSha256(const std::vector<uint8_t> &key, const std::string &data);
+
+std::string Base64Encode(const uint8_t *data, size_t len);
+std::string Base64Encode(const std::string &data);
+/* Returns an empty vector when `text` is not valid base64. */
+std::vector<uint8_t> Base64Decode(const std::string &text);
+
+/* Cryptographically random bytes, for the QR-login device id and the OAuth
+ * state parameter. */
+std::vector<uint8_t> RandomBytes(size_t count);
+
+/* Lowercase hex, no separators. */
+std::string ToHex(const uint8_t *data, size_t len);
+
+} // namespace crypto
+} // namespace livehime
diff --git a/plugins/livehime/core/win/net/http.cpp b/plugins/livehime/core/win/net/http.cpp
new file mode 100644
index 0000000..3d8f759
--- /dev/null
+++ b/plugins/livehime/core/win/net/http.cpp
@@ -0,0 +1,414 @@
+#include "http.h"
+
+#include "cookies.h"
+#include "../platform/dispatch.h"
+
+#include <windows.h>
+#include <winhttp.h>
+
+#include <atomic>
+#include <cctype>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <cwchar>
+#include <deque>
+#include <mutex>
+#include <thread>
+
+namespace livehime {
+namespace net {
+namespace {
+
+/* ── URL pieces ─────────────────────────────────────────────────────────── */
+
+struct UrlParts {
+	std::wstring host;
+	std::wstring path; /* path + query */
+	INTERNET_PORT port = 0;
+	bool secure = false;
+	bool valid = false;
+};
+
+UrlParts ParseUrl(const std::string &utf8)
+{
+	UrlParts out;
+	int wide_len = MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), -1, nullptr, 0);
+	if (wide_len <= 1)
+		return out;
+	std::wstring wide(static_cast<size_t>(wide_len), L'\0');
+	MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), -1, &wide[0], wide_len);
+
+	URL_COMPONENTS uc = {};
+	uc.dwStructSize = sizeof(uc);
+	uc.dwSchemeLength = static_cast<DWORD>(-1);
+	uc.dwHostNameLength = static_cast<DWORD>(-1);
+	uc.dwUrlPathLength = static_cast<DWORD>(-1);
+	uc.dwExtraInfoLength = static_cast<DWORD>(-1);
+	if (!WinHttpCrackUrl(wide.c_str(), 0, 0, &uc))
+		return out;
+
+	out.host.assign(uc.lpszHostName, uc.dwHostNameLength);
+	out.path.assign(uc.lpszUrlPath, uc.dwUrlPathLength);
+	if (uc.dwExtraInfoLength)
+		out.path.append(uc.lpszExtraInfo, uc.dwExtraInfoLength);
+	out.port = uc.nPort;
+	out.secure = uc.nScheme == INTERNET_SCHEME_HTTPS;
+	out.valid = true;
+	return out;
+}
+
+std::string Narrow(const std::wstring &wide)
+{
+	if (wide.empty())
+		return {};
+	int len = WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), static_cast<int>(wide.size()), nullptr, 0, nullptr, nullptr);
+	std::string out(static_cast<size_t>(len), '\0');
+	WideCharToMultiByte(CP_UTF8, 0, wide.c_str(), static_cast<int>(wide.size()), &out[0], len, nullptr, nullptr);
+	return out;
+}
+
+std::wstring Widen(const std::string &utf8)
+{
+	if (utf8.empty())
+		return {};
+	int len = MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), nullptr, 0);
+	std::wstring out(static_cast<size_t>(len), L'\0');
+	MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), &out[0], len);
+	return out;
+}
+
+/* ── shared WinHTTP session ─────────────────────────────────────────────── */
+
+std::mutex g_session_mutex;
+HINTERNET g_session = nullptr;
+std::atomic<bool> g_shutdown{false};
+
+HINTERNET Session()
+{
+	std::lock_guard<std::mutex> lock(g_session_mutex);
+	if (g_shutdown.load())
+		return nullptr;
+	if (!g_session) {
+		g_session = WinHttpOpen(L"LiveHime/0.2 (Windows; OBS)",
+					WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
+					WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+		if (g_session) {
+			/* Connect 10s, send 15s, receive 30s: Bilibili's login endpoints
+			 * are occasionally slow but never half a minute slow. */
+			WinHttpSetTimeouts(g_session, 10000, 10000, 15000, 30000);
+		}
+	}
+	return g_session;
+}
+
+/* ── one request ────────────────────────────────────────────────────────── */
+
+Response PerformOnce(const Request &req, const UrlParts &parts)
+{
+	Response res;
+
+	HINTERNET session = Session();
+	if (!session) {
+		res.error = "http session unavailable";
+		return res;
+	}
+
+	HINTERNET connect = WinHttpConnect(session, parts.host.c_str(), parts.port, 0);
+	if (!connect) {
+		res.error = "cannot connect to " + Narrow(parts.host);
+		return res;
+	}
+
+	DWORD flags = parts.secure ? WINHTTP_FLAG_SECURE : 0;
+	std::wstring method = Widen(req.method);
+	HINTERNET request = WinHttpOpenRequest(connect, method.c_str(), parts.path.c_str(), nullptr,
+					       WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, flags);
+	if (!request) {
+		res.error = "cannot open request";
+		WinHttpCloseHandle(connect);
+		return res;
+	}
+
+	/* Let WinHTTP inflate gzip/deflate so callers always see plain JSON. */
+	{
+		DWORD decompression = WINHTTP_DECOMPRESSION_FLAG_ALL;
+		WinHttpSetOption(request, WINHTTP_OPTION_DECOMPRESSION, &decompression, sizeof(decompression));
+	}
+
+	/* Redirects are followed by hand: every hop must reach the cookie jar. */
+	{
+		DWORD policy = WINHTTP_OPTION_REDIRECT_POLICY_NEVER;
+		WinHttpSetOption(request, WINHTTP_OPTION_REDIRECT_POLICY, &policy, sizeof(policy));
+	}
+
+	std::wstring header_block;
+	for (const auto &kv : req.headers) {
+		/* Content-Type travels in the header block too; adding it twice makes
+		 * WinHTTP send two Content-Type headers. */
+		if (_stricmp(kv.first.c_str(), "content-type") == 0)
+			continue;
+		header_block += Widen(kv.first + ": " + kv.second + "\r\n");
+	}
+	std::string cookie = CookieJar::Instance().HeaderFor(req.url);
+	if (!cookie.empty())
+		header_block += Widen("Cookie: " + cookie + "\r\n");
+	if (!req.body.empty() && !req.content_type.empty())
+		header_block += Widen("Content-Type: " + req.content_type + "\r\n");
+
+	const wchar_t *headers_ptr = header_block.empty() ? WINHTTP_NO_ADDITIONAL_HEADERS : header_block.c_str();
+	DWORD headers_len = header_block.empty() ? 0 : static_cast<DWORD>(header_block.size());
+
+	BOOL sent = WinHttpSendRequest(request, headers_ptr, headers_len,
+				       req.body.empty() ? WINHTTP_NO_REQUEST_DATA : const_cast<char *>(req.body.data()),
+				       static_cast<DWORD>(req.body.size()), static_cast<DWORD>(req.body.size()), 0);
+	if (!sent) {
+		res.error = "send failed (winhttp " + std::to_string(GetLastError()) + ")";
+		WinHttpCloseHandle(request);
+		WinHttpCloseHandle(connect);
+		return res;
+	}
+
+	if (!WinHttpReceiveResponse(request, nullptr)) {
+		res.error = "receive failed (winhttp " + std::to_string(GetLastError()) + ")";
+		WinHttpCloseHandle(request);
+		WinHttpCloseHandle(connect);
+		return res;
+	}
+
+	DWORD status = 0;
+	DWORD status_size = sizeof(status);
+	if (WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+				WINHTTP_HEADER_NAME_BY_INDEX, &status, &status_size, WINHTTP_NO_HEADER_INDEX)) {
+		res.status = static_cast<long>(status);
+	}
+
+	/* Raw headers, so Set-Cookie survives with all its attributes. */
+	{
+		DWORD size = 0;
+		WinHttpQueryHeaders(request, WINHTTP_QUERY_RAW_HEADERS_CRLF, WINHTTP_HEADER_NAME_BY_INDEX, nullptr, &size,
+				    WINHTTP_NO_HEADER_INDEX);
+		if (size) {
+			std::wstring raw(size / sizeof(wchar_t), L'\0');
+			if (WinHttpQueryHeaders(request, WINHTTP_QUERY_RAW_HEADERS_CRLF, WINHTTP_HEADER_NAME_BY_INDEX,
+						&raw[0], &size, WINHTTP_NO_HEADER_INDEX)) {
+				raw.resize(wcslen(raw.c_str()));
+				std::string utf8 = Narrow(raw);
+				CookieJar::Instance().AbsorbResponse(req.url, utf8);
+
+				/* Split into the lowercased map callers read. */
+				size_t pos = 0;
+				while (pos < utf8.size()) {
+					size_t eol = utf8.find("\r\n", pos);
+					std::string line = utf8.substr(pos, eol == std::string::npos ? std::string::npos : eol - pos);
+					pos = eol == std::string::npos ? utf8.size() : eol + 2;
+					size_t colon = line.find(':');
+					if (colon == std::string::npos)
+						continue;
+					std::string name = line.substr(0, colon);
+					for (auto &ch : name)
+						ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+					std::string value = line.substr(colon + 1);
+					size_t b = value.find_first_not_of(" \t");
+					if (b != std::string::npos)
+						value = value.substr(b);
+					auto it = res.headers.find(name);
+					if (it == res.headers.end())
+						res.headers.emplace(std::move(name), std::move(value));
+					else
+						it->second += "\n" + value;
+				}
+			}
+		}
+	}
+
+	for (;;) {
+		DWORD available = 0;
+		if (!WinHttpQueryDataAvailable(request, &available) || available == 0)
+			break;
+		std::string chunk(available, '\0');
+		DWORD read = 0;
+		if (!WinHttpReadData(request, &chunk[0], available, &read) || read == 0)
+			break;
+		chunk.resize(read);
+		res.body += chunk;
+	}
+
+	WinHttpCloseHandle(request);
+	WinHttpCloseHandle(connect);
+	return res;
+}
+
+Response Perform(const Request &req)
+{
+	Response res;
+	if (req.url.empty()) {
+		res.error = "empty url";
+		return res;
+	}
+
+	UrlParts parts = ParseUrl(req.url);
+	if (!parts.valid) {
+		res.error = "invalid url";
+		return res;
+	}
+
+	Request current = req;
+	for (int hop = 0; hop <= req.max_redirects; ++hop) {
+		res = PerformOnce(current, parts);
+		if (res.status != 301 && res.status != 302 && res.status != 303 && res.status != 307 && res.status != 308)
+			return res;
+
+		std::string location = res.Header("location");
+		if (location.empty())
+			return res;
+		if (location[0] == '/') {
+			/* Relative: keep scheme and host. */
+			size_t scheme = current.url.find("://");
+			size_t host_end = current.url.find('/', scheme + 3);
+			location = current.url.substr(0, host_end) + location;
+		}
+		current.url = location;
+		/* 303 and 302 after POST become GET, per RFC 9110. */
+		if (res.status == 303 || (res.status == 302 && current.method == "POST"))
+			current.method = "GET";
+		parts = ParseUrl(current.url);
+		if (!parts.valid) {
+			res.error = "invalid redirect target";
+			return res;
+		}
+	}
+
+	res.error = "too many redirects";
+	return res;
+}
+
+/* ── worker pool ────────────────────────────────────────────────────────── */
+
+struct Job {
+	Request request;
+	ResponseFn done;
+};
+
+std::mutex g_queue_mutex;
+std::condition_variable g_queue_cv;
+std::deque<Job> g_queue;
+std::vector<std::thread> g_workers;
+bool g_stopping = false;
+
+void WorkerLoop()
+{
+	for (;;) {
+		Job job;
+		{
+			std::unique_lock<std::mutex> lock(g_queue_mutex);
+			g_queue_cv.wait(lock, [] { return g_stopping || !g_queue.empty(); });
+			if (g_queue.empty()) {
+				if (g_stopping)
+					return;
+				continue;
+			}
+			job = std::move(g_queue.front());
+			g_queue.pop_front();
+		}
+
+		Response res = Perform(job.request);
+		ResponseFn done = std::move(job.done);
+		/* Empty body with a non-2xx status is almost always WinHTTP having
+		 * already told us why; keep the error text useful. */
+		if (res.status == 0 && res.error.empty())
+			res.error = "no response";
+		if (done)
+			dispatch::Post([done, res]() mutable { done(res); });
+	}
+}
+
+void EnsureWorkers()
+{
+	std::lock_guard<std::mutex> lock(g_queue_mutex);
+	if (!g_workers.empty() || g_stopping)
+		return;
+	unsigned count = 4;
+	for (unsigned i = 0; i < count; ++i)
+		g_workers.emplace_back(WorkerLoop);
+}
+
+} // namespace
+
+std::string UrlEncode(const std::string &value)
+{
+	static const char *hex = "0123456789ABCDEF";
+	std::string out;
+	out.reserve(value.size() * 3);
+	for (unsigned char c : value) {
+		if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+		    c == '.' || c == '~') {
+			out += static_cast<char>(c);
+		} else {
+			out += '%';
+			out += hex[c >> 4];
+			out += hex[c & 0x0F];
+		}
+	}
+	return out;
+}
+
+std::string FormEncode(const std::vector<std::pair<std::string, std::string>> &fields)
+{
+	std::string out;
+	for (const auto &kv : fields) {
+		if (!out.empty())
+			out += '&';
+		out += UrlEncode(kv.first);
+		out += '=';
+		out += UrlEncode(kv.second);
+	}
+	return out;
+}
+
+void Send(const Request &req, ResponseFn done)
+{
+	EnsureWorkers();
+	{
+		std::lock_guard<std::mutex> lock(g_queue_mutex);
+		if (g_stopping) {
+			if (done) {
+				Response res;
+				res.error = "core stopped";
+				dispatch::Post([done, res]() mutable { done(res); });
+			}
+			return;
+		}
+		g_queue.push_back(Job{req, std::move(done)});
+	}
+	g_queue_cv.notify_one();
+}
+
+Response SendSync(const Request &req)
+{
+	return Perform(req);
+}
+
+void Shutdown()
+{
+	std::vector<std::thread> workers;
+	{
+		std::lock_guard<std::mutex> lock(g_queue_mutex);
+		g_stopping = true;
+		workers.swap(g_workers);
+	}
+	g_queue_cv.notify_all();
+	for (auto &worker : workers) {
+		if (worker.joinable())
+			worker.join();
+	}
+
+	std::lock_guard<std::mutex> lock(g_session_mutex);
+	if (g_session) {
+		WinHttpCloseHandle(g_session);
+		g_session = nullptr;
+	}
+}
+
+} // namespace net
+} // namespace livehime
diff --git a/plugins/livehime/core/win/net/http.h b/plugins/livehime/core/win/net/http.h
new file mode 100644
index 0000000..7127740
--- /dev/null
+++ b/plugins/livehime/core/win/net/http.h
@@ -0,0 +1,72 @@
+/* WinHTTP transport for the Windows core.
+ *
+ * Replaces URLSession. Requests run on a small worker pool; the completion
+ * always arrives on the main thread (platform/dispatch.h), which is what the
+ * C interface promises the UI.
+ *
+ * The cookie jar is applied automatically: the caller passes Bilibili's own
+ * headers, not a Cookie header. */
+
+#pragma once
+
+#include <functional>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace livehime {
+namespace net {
+
+struct Response {
+	/* HTTP status. 0 means the request never produced a response; `error`
+	 * then says why (DNS, TLS, timeout, ...). */
+	long status = 0;
+	std::string body;
+	std::string error;
+	/* Lowercased header names, concatenated when repeated (Set-Cookie). */
+	std::map<std::string, std::string> headers;
+
+	bool Ok() const { return status >= 200 && status < 300; }
+	std::string Header(const std::string &lowered_name) const
+	{
+		auto it = headers.find(lowered_name);
+		return it == headers.end() ? std::string() : it->second;
+	}
+};
+
+struct Request {
+	std::string method = "GET";
+	std::string url;
+	std::map<std::string, std::string> headers;
+	std::string body;
+	/* Applied as Content-Type when `body` is non-empty and the caller did not
+	 * already set one. */
+	std::string content_type;
+	int timeout_ms = 15000;
+	/* Bilibili answers a redirect for some endpoints; we follow up to 5 hops
+	 * by hand so the cookie jar sees every hop. */
+	int max_redirects = 5;
+};
+
+using ResponseFn = std::function<void(Response)>;
+
+/* Sends the request; `done` is invoked on the main thread, exactly once, even
+ * when the transport fails. */
+void Send(const Request &req, ResponseFn done);
+
+/* Convenience: blocks the calling thread until the response arrives. Must not
+ * be called on the main thread (it would deadlock the dispatch queue that
+ * delivers the result). Prefer Send(). */
+Response SendSync(const Request &req);
+
+/* Form-encodes `fields` as application/x-www-form-urlencoded. */
+std::string FormEncode(const std::vector<std::pair<std::string, std::string>> &fields);
+
+/* Percent-encodes everything outside unreserved characters. */
+std::string UrlEncode(const std::string &value);
+
+/* Shuts the worker pool down. Called from livehime_core_stop(). */
+void Shutdown();
+
+} // namespace net
+} // namespace livehime
diff --git a/plugins/livehime/core/win/net/signing.cpp b/plugins/livehime/core/win/net/signing.cpp
new file mode 100644
index 0000000..d9356a8
--- /dev/null
+++ b/plugins/livehime/core/win/net/signing.cpp
@@ -0,0 +1,141 @@
+#include "signing.h"
+
+#include "crypto.h"
+#include "http.h"
+
+#include <algorithm>
+#include <ctime>
+
+namespace livehime {
+namespace net {
+namespace {
+
+/* DanmakuProtocol.swift:261-263, verbatim. */
+constexpr int kMixinTable[64] = {46, 47, 18, 2,  53, 8,  23, 32, 15, 50, 10, 31, 58, 3,  45, 35,
+				 27, 43, 5,  49, 33, 9,  42, 19, 29, 28, 14, 39, 12, 38, 41, 13,
+				 37, 48, 7,  16, 24, 55, 40, 61, 26, 17, 0,  1,  60, 51, 30, 4,
+				 22, 25, 54, 21, 56, 59, 6,  63, 57, 62, 11, 36, 20, 34, 44, 52};
+
+/* Everything outside unreserved. CharacterSet.urlQueryAllowed is looser, but
+ * no field this signs contains a character the two disagree about; see
+ * signing.h. */
+std::string EncodeStrict(const std::string &value)
+{
+	static const char *hex = "0123456789ABCDEF";
+	std::string out;
+	out.reserve(value.size());
+	for (unsigned char c : value) {
+		if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+		    c == '.' || c == '~') {
+			out += static_cast<char>(c);
+		} else {
+			out += '%';
+			out += hex[c >> 4];
+			out += hex[c & 0x0F];
+		}
+	}
+	return out;
+}
+
+/* DanmakuProtocol.swift:279 — "!'()*" are dropped from values before both the
+ * digest and the final query. */
+std::string StripBangChars(const std::string &value)
+{
+	std::string out;
+	out.reserve(value.size());
+	for (char c : value) {
+		if (c == '!' || c == '\'' || c == '(' || c == ')' || c == '*')
+			continue;
+		out += c;
+	}
+	return out;
+}
+
+std::string FileStem(const std::string &url)
+{
+	size_t slash = url.find_last_of('/');
+	std::string name = slash == std::string::npos ? url : url.substr(slash + 1);
+	size_t dot = name.find('.');
+	return dot == std::string::npos ? name : name.substr(0, dot);
+}
+
+long long NowSeconds()
+{
+	return static_cast<long long>(std::time(nullptr));
+}
+
+} // namespace
+
+std::optional<WbiSigner> WbiSigner::FromNav(const std::string &img_url, const std::string &sub_url)
+{
+	std::string raw = FileStem(img_url) + FileStem(sub_url);
+	if (raw.size() < 64)
+		return std::nullopt;
+
+	WbiSigner signer;
+	signer.mixin_key_.reserve(32);
+	for (int i = 0; i < 32; ++i)
+		signer.mixin_key_ += raw[static_cast<size_t>(kMixinTable[i])];
+	return signer;
+}
+
+std::string WbiSigner::SignQuery(const std::vector<std::pair<std::string, std::string>> &params, long long timestamp) const
+{
+	std::vector<std::pair<std::string, std::string>> all = params;
+	all.emplace_back("wts", std::to_string(timestamp != 0 ? timestamp : NowSeconds()));
+
+	std::vector<std::pair<std::string, std::string>> sorted = all;
+	std::sort(sorted.begin(), sorted.end(),
+		  [](const auto &a, const auto &b) { return a.first < b.first; });
+
+	std::string query;
+	for (const auto &kv : sorted) {
+		if (!query.empty())
+			query += '&';
+		query += EncodeStrict(kv.first);
+		query += '=';
+		query += EncodeStrict(StripBangChars(kv.second));
+	}
+
+	std::string rid = crypto::Md5Hex(query + mixin_key_);
+
+	std::string out;
+	for (const auto &kv : sorted) {
+		if (!out.empty())
+			out += '&';
+		out += EncodeStrict(kv.first);
+		out += '=';
+		out += EncodeStrict(StripBangChars(kv.second));
+	}
+	out += "&w_rid=";
+	out += rid;
+	return out;
+}
+
+std::string OrderedFormString(const std::vector<std::pair<std::string, std::string>> &fields)
+{
+	std::string out;
+	for (const auto &kv : fields) {
+		if (!out.empty())
+			out += '&';
+		out += EncodeStrict(kv.first);
+		out += '=';
+		out += EncodeStrict(kv.second);
+	}
+	return out;
+}
+
+std::string PcLinkSign(const std::vector<std::pair<std::string, std::string>> &fields)
+{
+	return crypto::Md5Hex(OrderedFormString(fields) + kPcLinkAppSecret);
+}
+
+std::string AppendQuery(const std::string &url, const std::string &query)
+{
+	if (query.empty())
+		return url;
+	return url + (url.find('?') == std::string::npos ? "?" : "&") + query;
+}
+
+} // namespace net
+} // namespace livehime
diff --git a/plugins/livehime/core/win/net/signing.h b/plugins/livehime/core/win/net/signing.h
new file mode 100644
index 0000000..f2f3721
--- /dev/null
+++ b/plugins/livehime/core/win/net/signing.h
@@ -0,0 +1,61 @@
+/* Bilibili request signing, the two schemes the macOS core uses.
+ *
+ * 1. WBI (DanmakuProtocol.swift:260-285) — used by web APIs such as
+ *    getDanmuInfo. A 64-entry permutation turns nav's wbi_img keys into a
+ *    32-character mixin key; the digest is md5(sorted query + mixin key).
+ *
+ * 2. The pc_link app signature (BilibiliLiveClient.swift:263-288) — used by
+ *    Room/startLive. The unsigned string is the eight fields in their exact
+ *    insertion order, and the signature is md5(that + app secret).
+ *
+ * Both are reproduced literally; the field order in (2) is load-bearing and
+ * documented as such upstream. */
+
+#pragma once
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace livehime {
+namespace net {
+
+/* The app key/secret the official Windows client uses (bililive_secret.dll,
+ * see artifacts/current/bililive-web-host-bridge.md). */
+inline constexpr const char *kPcLinkAppKey = "aae92bc66f3edfab";
+inline constexpr const char *kPcLinkAppSecret = "af125a0d5279fd576c1b4418a3e8276d";
+
+class WbiSigner {
+public:
+	/* Both URLs come from /x/web-interface/nav's data.wbi_img; only the file
+	 * stem of each is used. Returns nullopt when the stems are too short. */
+	static std::optional<WbiSigner> FromNav(const std::string &img_url, const std::string &sub_url);
+
+	/* Returns "k=v&k2=v2&...&w_rid=..." with keys sorted and values encoded,
+	 * ready to be appended to a URL that already has a query string. `wts` is
+	 * added automatically; pass a non-zero `timestamp` to pin it in tests. */
+	std::string SignQuery(const std::vector<std::pair<std::string, std::string>> &params,
+			      long long timestamp = 0) const;
+
+	const std::string &MixinKey() const { return mixin_key_; }
+
+private:
+	std::string mixin_key_;
+};
+
+/* md5(percent_encoded_fields_joined_by_& + kPcLinkAppSecret), lowercase hex.
+ * `fields` must already be in the order the signature covers. */
+std::string PcLinkSign(const std::vector<std::pair<std::string, std::string>> &fields);
+
+/* Builds the "k=v&k2=v2" string the signature is computed over. Percent
+ * encoding matches Swift's CharacterSet.urlQueryAllowed minus "+&=", which for
+ * the field values this is used with (hex ids, digits, "pc_link", "8.6.0") is
+ * identical to encoding everything outside the RFC 3986 unreserved set. */
+std::string OrderedFormString(const std::vector<std::pair<std::string, std::string>> &fields);
+
+/* Appends "?a=b&c=d" or "&a=b&c=d" to `url`. */
+std::string AppendQuery(const std::string &url, const std::string &query);
+
+} // namespace net
+} // namespace livehime
diff --git a/plugins/livehime/core/win/platform/dispatch.cpp b/plugins/livehime/core/win/platform/dispatch.cpp
new file mode 100644
index 0000000..e14ca87
--- /dev/null
+++ b/plugins/livehime/core/win/platform/dispatch.cpp
@@ -0,0 +1,105 @@
+#include "dispatch.h"
+
+#include <windows.h>
+
+#include <mutex>
+
+namespace livehime {
+namespace dispatch {
+namespace {
+
+constexpr UINT kDispatchMessage = WM_APP + 0x51;
+
+HWND g_window = nullptr;
+DWORD g_mainThread = 0;
+std::mutex g_mutex;
+
+LRESULT CALLBACK DispatchProc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+	if (msg == kDispatchMessage) {
+		/* Owned by Post(); it hands over a heap allocation and this side
+		 * deletes it after the call, including when the call throws. */
+		std::function<void()> *fn = reinterpret_cast<std::function<void()> *>(lparam);
+		if (fn) {
+			try {
+				(*fn)();
+			} catch (...) {
+				/* A throwing callback must not take the UI thread down with
+				 * it: OBS is in the middle of its own message pump. */
+			}
+			delete fn;
+		}
+		return 0;
+	}
+	return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+} // namespace
+
+bool Init()
+{
+	std::lock_guard<std::mutex> lock(g_mutex);
+	if (g_window)
+		return true;
+
+	g_mainThread = GetCurrentThreadId();
+
+	WNDCLASSEXW wc = {};
+	wc.cbSize = sizeof(wc);
+	wc.lpfnWndProc = DispatchProc;
+	wc.hInstance = GetModuleHandleW(nullptr);
+	wc.lpszClassName = L"LiveHimeCoreDispatch";
+	/* A second livehime instance in the same process is not a thing, but a
+	 * stale registration from a previous module load is harmless. */
+	RegisterClassExW(&wc);
+
+	/* HWND_MESSAGE: never shown, never in the taskbar, still pumped. */
+	g_window = CreateWindowExW(0, wc.lpszClassName, L"", 0, 0, 0, 0, 0, HWND_MESSAGE, nullptr, wc.hInstance,
+				   nullptr);
+	if (!g_window) {
+		g_mainThread = 0;
+		return false;
+	}
+	return true;
+}
+
+bool OnMainThread()
+{
+	return g_mainThread != 0 && GetCurrentThreadId() == g_mainThread;
+}
+
+bool Post(std::function<void()> fn)
+{
+	if (!fn)
+		return false;
+
+	HWND window;
+	{
+		std::lock_guard<std::mutex> lock(g_mutex);
+		window = g_window;
+	}
+	if (!window)
+		return false;
+
+	/* On the main thread: run it now. PostMessage would also work, but running
+	 * inline keeps ordering with the caller's own state in the common case
+	 * where a cache hit answers without touching the network. */
+	if (OnMainThread()) {
+		try {
+			fn();
+		} catch (...) {
+			/* Same reason as in DispatchProc: never unwind into the UI. */
+		}
+		return true;
+	}
+
+	auto *heap = new std::function<void()>(std::move(fn));
+	if (!PostMessageW(window, kDispatchMessage, 0, reinterpret_cast<LPARAM>(heap))) {
+		delete heap;
+		return false;
+	}
+	return true;
+}
+
+} // namespace dispatch
+} // namespace livehime
diff --git a/plugins/livehime/core/win/platform/dispatch.h b/plugins/livehime/core/win/platform/dispatch.h
new file mode 100644
index 0000000..5ad8774
--- /dev/null
+++ b/plugins/livehime/core/win/platform/dispatch.h
@@ -0,0 +1,33 @@
+/* Main-thread dispatch for the Windows core.
+ *
+ * The C interface in core/include/livehime-core.h requires every callback to
+ * arrive on the main thread; the Swift core got that from DispatchQueue.main.
+ * Windows has no such queue, so the core owns a message-only window created on
+ * whichever thread calls Init() (OBS creates the dock and loads plugins on its
+ * Qt main thread, which pumps messages) and every network result is Post()ed
+ * back to it.
+ *
+ * Framework-neutral on purpose: no Qt in the core. */
+
+#pragma once
+
+#include <functional>
+
+namespace livehime {
+namespace dispatch {
+
+/* Creates the message-only window on the calling thread. Idempotent; must be
+ * called from the main thread before any Post(). Returns false when the window
+ * could not be created. */
+bool Init();
+
+/* True when the calling thread is the thread that called Init(). */
+bool OnMainThread();
+
+/* Queues `fn` onto the main thread. Safe from any thread, including before
+ * Init() — in that case the work is dropped and false is returned, because
+ * there is no queue to run it on yet. */
+bool Post(std::function<void()> fn);
+
+} // namespace dispatch
+} // namespace livehime
