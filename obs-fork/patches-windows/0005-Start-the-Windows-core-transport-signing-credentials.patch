+void livehime_core_load_shield_keywords(void)
+{
+	const long long room = CurrentRoom();
+	if (room <= 0) {
+		Emit(json{{"event", "shieldKeywords"}, {"ok", false}, {"keywords", json::array()},
+			  {"kind", "notReady"}});
+		return;
+	}
+	livehime::live::LoadShieldKeywords(room, [](livehime::live::Result<std::vector<std::string>> result) {
+		json keywords = json::array();
+		for (const auto &word : result.value)
+			keywords.push_back(word);
+		json object{{"event", "shieldKeywords"}, {"ok", result.ok}, {"keywords", keywords}};
+		if (!result.ok) {
+			object = livehime::Merge(object, result.error.fields);
+			if (result.error.logged_out)
+				Session::Instance().MarkSignedOut(Notice::SessionExpired);
+		}
+		Emit(object);
+	});
+}
+
+void livehime_core_set_shield_keyword(const char *keyword, int add)
+{
+	const long long room = CurrentRoom();
+	if (room <= 0) {
+		Emit(json{{"event", "shieldKeywords"}, {"ok", false}, {"keywords", json::array()},
+			  {"kind", "notReady"}});
+		return;
+	}
+	livehime::live::SetShieldKeyword(room, keyword ? keyword : "", add != 0,
+					 [room](bool ok, const livehime::live::ApiError &error) {
+						 if (!ok) {
+							 json object = livehime::Merge(
+								 json{{"event", "shieldKeywords"},
+								      {"ok", false},
+								      {"keywords", json::array()}},
+								 error.fields);
+							 if (error.logged_out)
+								 Session::Instance().MarkSignedOut(
+									 Notice::SessionExpired);
+							 Emit(object);
+							 return;
+						 }
+						 /* The Swift re-reads the list so the UI shows the
+						  * server's own view rather than a local guess. */
+						 livehime::live::LoadShieldKeywords(
+							 room,
+							 [](livehime::live::Result<std::vector<std::string>> result) {
+								 json keywords = json::array();
+								 for (const auto &word : result.value)
+									 keywords.push_back(word);
+								 json object{{"event", "shieldKeywords"},
+									     {"ok", result.ok},
+									     {"keywords", keywords}};
+								 if (!result.ok)
+									 object = livehime::Merge(object,
+												  result.error.fields);
+								 Emit(object);
+							 });
+					 });
+}
