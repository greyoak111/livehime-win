@@ -395,14 +395,41 @@ uint64_t os_gettime_ns(void)
 	return util_mul_div64(current_time.QuadPart, 1000000000, get_clockfreq());
 }
 
+/* LiveHime: builds that set OBS_USER_CONFIG_SUBDIR keep all per-user state in
+ * their own directory so they never share scenes, profiles or plugin settings
+ * with a separately installed OBS Studio. System-wide (%PROGRAMDATA%) paths are
+ * unchanged. Mirrors user_config_root() in libobs/util/platform-cocoa.m.
+ *
+ * Returns the subdirectory to insert under the folder for per-user paths, or
+ * NULL to use the folder as-is. */
+static const char *user_config_subdir(int folder)
+{
+#ifdef OBS_USER_CONFIG_SUBDIR
+	if (folder == CSIDL_APPDATA && OBS_USER_CONFIG_SUBDIR[0] != '\0')
+		return OBS_USER_CONFIG_SUBDIR;
+#else
+	(void)folder;
+#endif
+	return NULL;
+}
+
 /* returns [folder]\[name] on windows */
 static int os_get_path_internal(char *dst, size_t size, const char *name, int folder)
 {
 	wchar_t path_utf16[MAX_PATH];
+	const char *subdir;
 
 	SHGetFolderPathW(NULL, folder, NULL, SHGFP_TYPE_CURRENT, path_utf16);
 
 	if (os_wcs_to_utf8(path_utf16, 0, dst, size) != 0) {
+		subdir = user_config_subdir(folder);
+		if (subdir) {
+			if (strcat_s(dst, size, "\\") != 0)
+				return -1;
+			if (strcat_s(dst, size, subdir) != 0)
+				return -1;
+		}
+
 		if (!name || !*name) {
 			return (int)strlen(dst);
 		}
@@ -422,13 +449,23 @@ static char *os_get_path_ptr_internal(const char *name, int folder)
 	char *ptr;
 	wchar_t path_utf16[MAX_PATH];
 	struct dstr path;
+	const char *subdir;
 
 	SHGetFolderPathW(NULL, folder, NULL, SHGFP_TYPE_CURRENT, path_utf16);
 
 	os_wcs_to_utf8_ptr(path_utf16, 0, &ptr);
 	dstr_init_move_array(&path, ptr);
-	dstr_cat(&path, "\\");
-	dstr_cat(&path, name);
+
+	subdir = user_config_subdir(folder);
+	if (subdir) {
+		dstr_cat(&path, "\\");
+		dstr_cat(&path, subdir);
+	}
+
+	if (name && *name) {
+		dstr_cat(&path, "\\");
+		dstr_cat(&path, name);
+	}
 	return path.array;
 }
 
