+++ b/plugins/livehime/core/win/livehime-core-stub.cpp
@@ -0,0 +1,286 @@
+/* livehime-core-stub.cpp — Windows build of the LiveHime session core.
+ *
+ * The real core lives in core/Sources/LiveHimeCore/*.swift and is macOS-only:
+ * it imports WebKit, AppKit, Security, CryptoKit, AVFoundation, Speech,
+ * ImageIO, UniformTypeIdentifiers, CoreImage and Compression, with no
+ * `#if os(...)` fallback anywhere (see docs/WINDOWS_PORT.md).
+ *
+ * This file implements the entire livehime-core.h C ABI so the Qt UI compiles,
+ * links and loads on Windows, and so the port can land file by file behind it.
+ *
+ * Contract with the UI: every entry point reports
+ * {"state":"failed","event":...} / {"status":"unsupported"} through the state
+ * callback. Nothing is ever reported as success. The UI already handles these
+ * shapes — it must never show "signed in" or "live" on the strength of a stub.
+ *
+ * Replace function by function as the port proceeds; delete this file when the
+ * last one is gone.
+ */
+
+#include "livehime-core.h"
+
+#include <cstddef>
+#include <cstring>
+
+namespace {
+
+livehime_state_callback g_callback = nullptr;
+void *g_context = nullptr;
+
+/* Sends one JSON object to the UI. Safe with no callback (start not called). */
+void Emit(const char *json)
+{
+	if (g_callback && json)
+		g_callback(json, g_context);
+}
+
+/* The single message every unimplemented entry point reports. `what` names the
+ * entry point so a log or a screenshot says which one is still a stub. */
+void EmitUnsupported(const char *what)
+{
+	char buf[256];
+	std::size_t n = 0;
+	const char *pre = "{\"event\":\"unsupported\",\"status\":\"unsupported\",\"core\":\"stub\",\"what\":\"";
+	for (const char *p = pre; *p && n < sizeof(buf) - 1; ++p)
+		buf[n++] = *p;
+	for (const char *p = what; p && *p && n < sizeof(buf) - 2; ++p) {
+		/* `what` is a literal from this file: no escaping needed. */
+		buf[n++] = *p;
+	}
+	const char *post = "\"}";
+	for (const char *p = post; *p && n < sizeof(buf) - 1; ++p)
+		buf[n++] = *p;
+	buf[n] = '\0';
+	Emit(buf);
+}
+
+} // namespace
+
+extern "C" {
+
+/* ── Session ───────────────────────────────────────────────────────────── */
+
+void livehime_core_start(const char *keychain_service, livehime_state_callback callback, void *context)
+{
+	(void)keychain_service;
+	g_callback = callback;
+	g_context = context;
+	/* The UI waits for a state; report the terminal one rather than hanging. */
+	Emit("{\"state\":\"failed\",\"reason\":\"unsupported\",\"core\":\"stub\","
+	     "\"message\":\"The LiveHime session core is not ported to Windows yet.\"}");
+}
+
+void livehime_core_stop(void)
+{
+	g_callback = nullptr;
+	g_context = nullptr;
+}
+
+void livehime_core_start_qr_login(void) { EmitUnsupported("start_qr_login"); }
+void livehime_core_cancel_qr_login(void) {}
+void livehime_core_retry(void) { EmitUnsupported("retry"); }
+void livehime_core_sign_out(void) { Emit("{\"state\":\"signedOut\",\"core\":\"stub\"}"); }
+void livehime_core_start_web_login(void) { EmitUnsupported("start_web_login"); }
+
+/* ── Live room ─────────────────────────────────────────────────────────── */
+
+void livehime_core_load_areas(void)
+{
+	Emit("{\"event\":\"areas\",\"areas\":[]}");
+	EmitUnsupported("load_areas");
+}
+
+void livehime_core_start_live(long long area_id, long long parent_area_id)
+{
+	(void)area_id;
+	(void)parent_area_id;
+	Emit("{\"event\":\"liveError\",\"kind\":\"notReady\",\"core\":\"stub\","
+	     "\"message\":\"The LiveHime session core is not ported to Windows yet.\"}");
+}
+
+void livehime_core_stop_live(void) { Emit("{\"event\":\"liveStopped\",\"ok\":false,\"core\":\"stub\"}"); }
+
+void livehime_core_open_face_auth(const char *voucher)
+{
+	(void)voucher;
+	EmitUnsupported("open_face_auth");
+}
+
+void livehime_core_open_face_auth_qr(const char *url)
+{
+	(void)url;
+	EmitUnsupported("open_face_auth_qr");
+}
+
+void livehime_core_open_cover_page(void) { EmitUnsupported("open_cover_page"); }
+
+/* ── Live captions ─────────────────────────────────────────────────────── */
+
+int livehime_core_captions_supported(void)
+{
+	/* Reported as unsupported so the Captions tab disables itself instead of
+	 * offering a switch that does nothing. */
+	return 0;
+}
+
+void livehime_core_captions_start(const char *locale)
+{
+	(void)locale;
+	Emit("{\"event\":\"captions\",\"status\":\"unsupported\"}");
+}
+
+void livehime_core_captions_push(const float *samples, int count, double sample_rate)
+{
+	(void)samples;
+	(void)count;
+	(void)sample_rate;
+}
+
+void livehime_core_captions_stop(void) { Emit("{\"event\":\"captions\",\"status\":\"stopped\"}"); }
+
+/* ── Hosted-page test hooks ────────────────────────────────────────────── */
+
+void livehime_core_page_eval(const char *key, const char *script, livehime_page_result_callback done, void *context)
+{
+	(void)key;
+	(void)script;
+	if (done)
+		done("{\"error\":\"unsupported\"}", context);
+}
+
+int livehime_core_page_click(const char *key, double x, double y)
+{
+	(void)key;
+	(void)x;
+	(void)y;
+	return 0; /* no page open */
+}
+
+/* ── App updates ───────────────────────────────────────────────────────── */
+
+void livehime_core_update_check(int beta)
+{
+	(void)beta;
+	Emit("{\"event\":\"update\",\"status\":\"failed\",\"supported\":false,\"core\":\"stub\","
+	     "\"message\":\"Updates are not available in the Windows port yet.\"}");
+}
+
+void livehime_core_update_download(void)
+{
+	Emit("{\"event\":\"update\",\"status\":\"failed\",\"supported\":false,\"core\":\"stub\"}");
+}
+
+int livehime_core_update_install(int relaunch)
+{
+	(void)relaunch;
+	return 0;
+}
+
+int livehime_core_update_rollback(void)
+{
+	return 0;
+}
+
+void livehime_core_update_state(void)
+{
+	Emit("{\"event\":\"update\",\"status\":\"idle\",\"supported\":false,\"core\":\"stub\"}");
+}
+
+/* ── Interface probe ───────────────────────────────────────────────────── */
+
+void livehime_core_probe_run(long long room)
+{
+	(void)room;
+	Emit("{\"event\":\"probe\",\"status\":\"done\",\"passed\":0,\"failed\":0,\"skipped\":0,\"core\":\"stub\"}");
+	EmitUnsupported("probe_run");
+}
+
+/* ── Room activity ─────────────────────────────────────────────────────── */
+
+void livehime_core_send_danmaku(const char *text)
+{
+	(void)text;
+	Emit("{\"event\":\"danmakuSent\",\"ok\":false,\"core\":\"stub\"}");
+}
+
+void livehime_core_send_danmaku_reply(const char *text, long long reply_uid, const char *reply_danmaku_id)
+{
+	(void)text;
+	(void)reply_uid;
+	(void)reply_danmaku_id;
+	Emit("{\"event\":\"danmakuSent\",\"ok\":false,\"core\":\"stub\"}");
+}
+
+void livehime_core_send_emoticon(const char *key, long long reply_uid, const char *reply_danmaku_id)
+{
+	(void)key;
+	(void)reply_uid;
+	(void)reply_danmaku_id;
+	Emit("{\"event\":\"danmakuSent\",\"ok\":false,\"sticker\":true,\"core\":\"stub\"}");
+}
+
+void livehime_core_update_title(const char *title)
+{
+	(void)title;
+	Emit("{\"event\":\"titleUpdated\",\"ok\":false,\"core\":\"stub\"}");
+}
+
+void livehime_core_set_tts(int enabled)
+{
+	(void)enabled;
+}
+
+/* ── Emoticons ─────────────────────────────────────────────────────────── */
+
+void livehime_core_emoticons_load(void)
+{
+	Emit("{\"event\":\"emoticons\",\"ok\":false,\"core\":\"stub\","
+	     "\"message\":\"Emoticons are not ported to Windows yet.\"}");
+}
+
+void livehime_core_emoticon_image(const char *url)
+{
+	(void)url;
+	Emit("{\"event\":\"emoticonImage\",\"path\":\"\",\"core\":\"stub\"}");
+}
+
+/* ── Moderation ────────────────────────────────────────────────────────── */
+
+void livehime_core_mute_user(long long uid, int hours)
+{
+	(void)hours;
+	char buf[128];
+	/* Fixed shape; uid is numeric so no escaping is needed. */
+	std::size_t n = 0;
+	const char *pre = "{\"event\":\"userMuted\",\"ok\":false,\"uid\":";
+	for (const char *p = pre; *p && n < sizeof(buf) - 1; ++p)
+		buf[n++] = *p;
+	char num[32];
+	int i = 0;
+	long long v = uid < 0 ? 0 : uid;
+	do {
+		num[i++] = static_cast<char>('0' + (v % 10));
+		v /= 10;
+	} while (v && i < 30);
+	while (i > 0 && n < sizeof(buf) - 2)
+		buf[n++] = num[--i];
+	const char *post = ",\"core\":\"stub\"}";
+	for (const char *p = post; *p && n < sizeof(buf) - 1; ++p)
+		buf[n++] = *p;
+	buf[n] = '\0';
+	Emit(buf);
+}
+
+void livehime_core_load_shield_keywords(void)
+{
+	Emit("{\"event\":\"shieldKeywords\",\"ok\":false,\"keywords\":[],\"core\":\"stub\"}");
+}
+
+void livehime_core_set_shield_keyword(const char *keyword, int add)
+{
+	(void)keyword;
+	(void)add;
+	Emit("{\"event\":\"shieldKeywords\",\"ok\":false,\"keywords\":[],\"core\":\"stub\"}");
+}
+
+} // extern "C"
diff --git a/plugins/livehime/src/window-native.cpp b/plugins/livehime/src/window-native.cpp
new file mode 100644
index 0000000..bc02d8e
--- /dev/null
+++ b/plugins/livehime/src/window-native.cpp
@@ -0,0 +1,180 @@
+/* window-native.cpp — Windows implementation of the window behaviour declared
+ * in window-native.hpp.
+ *
+ * The macOS version (window-native.mm, 149 lines of Objective-C++) maps onto
+ * NSWindow: level, non-activating panels, collection behaviour (all Spaces,
+ * over full-screen apps) and sharingType (whether screen capture may record
+ * the window). Windows has direct counterparts for some of that and none for
+ * others; the differences are called out per function.
+ *
+ * As on macOS, the capture-exception procedure below is per-window and is what
+ * keeps OBS's own "Hide OBS" screen capture from recording the LiveHime UI
+ * while still recording the floating chat, and vice versa.
+ */
+
+#include "window-native.hpp"
+
+#include <QAction>
+#include <QMenu>
+#include <QWidget>
+#include <QtGlobal>
+
+#include <obs.h>
+
+#include <map>
+#include <mutex>
+#include <string>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
+
+namespace {
+
+#ifdef _WIN32
+
+HWND HwndOf(QWidget *window)
+{
+	if (!window)
+		return nullptr;
+	return reinterpret_cast<HWND>(static_cast<quintptr>(window->winId()));
+}
+
+#endif
+
+std::mutex exceptionsMutex;
+std::map<std::string, std::pair<unsigned int, bool>> exceptions; /* key -> (id, visible) */
+
+void exceptionProcedure(void *, calldata_t *cd)
+{
+	std::string visible, hidden;
+	{
+		std::lock_guard<std::mutex> lock(exceptionsMutex);
+		for (const auto &entry : exceptions) {
+			std::string &list = entry.second.second ? visible : hidden;
+			if (!list.empty())
+				list += ",";
+			list += std::to_string(entry.second.first);
+		}
+	}
+	calldata_set_string(cd, "window_ids", visible.c_str());
+	calldata_set_string(cd, "hidden_window_ids", hidden.c_str());
+}
+
+} // namespace
+
+/* `floating`: stay above other apps' windows and over their full-screen
+ * windows. `capturable`: whether screen capture may record this window.
+ *
+ * macOS reaches into NSWindow (level, NSPanel style, collection behaviour,
+ * sharingType). The Windows counterparts:
+ *
+ *   level        SetWindowPos(HWND_TOPMOST / HWND_NOTOPMOST). Unlike the macOS
+ *                level, this survives deactivation on its own, so the
+ *                keepFloatingWhenInactive() observer the macOS file needs has
+ *                no equivalent here.
+ *   all Spaces   No public API. A topmost window is visible over full-screen
+ *                windows on the active virtual desktop; it is not mirrored to
+ *                the other virtual desktops the way macOS does.
+ *   sharingType  SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE), Windows 10
+ *                2004 and later. On older builds the call fails and the window
+ *                stays capturable — logged once, not treated as fatal.
+ */
+void ApplyNativeWindowOptions(QWidget *window, bool floating, bool capturable)
+{
+#ifdef _WIN32
+	HWND hwnd = HwndOf(window);
+	if (!hwnd)
+		return;
+
+	SetWindowPos(hwnd, floating ? HWND_TOPMOST : HWND_NOTOPMOST, 0, 0, 0, 0,
+		     SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
+
+	if (!capturable) {
+		if (!SetWindowDisplayAffinity(hwnd, WDA_EXCLUDEFROMCAPTURE)) {
+			/* Typically ERROR_NOT_SUPPORTED on Windows 10 before 2004.
+			 * Report once per call site; the window simply remains
+			 * capturable there. */
+			blog(LOG_WARNING,
+			     "[livehime] SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE) failed (error %lu); "
+			     "this window can still be captured",
+			     static_cast<unsigned long>(GetLastError()));
+		}
+	} else {
+		SetWindowDisplayAffinity(hwnd, WDA_NONE);
+	}
+#else
+	(void)window;
+	(void)floating;
+	(void)capturable;
+#endif
+}
+
+/* Lets `menu` (and its submenus) open over another app's full-screen window,
+ * where the floating chat can sit.
+ *
+ * macOS has to rebuild each popup as a non-activating NSPanel that may join
+ * any Space. On Windows a popup is already a separate top-level window and a
+ * topmost one draws over full-screen windows, so this only raises the popup to
+ * topmost for the time it is shown. The recursion mirrors the macOS version so
+ * submenus get the same treatment.
+ */
+void AllowMenuOverFullScreen(QMenu *menu)
+{
+	if (!menu)
+		return;
+	QObject::connect(menu, &QMenu::aboutToShow, menu, [menu] {
+#ifdef _WIN32
+		HWND hwnd = HwndOf(menu);
+		if (hwnd)
+			SetWindowPos(hwnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+#endif
+		const auto actions = menu->actions();
+		for (QAction *action : actions) {
+			QMenu *sub = QMenu::menuInAction(action);
+			if (sub && !sub->property("livehime.fullScreenMenu").toBool()) {
+				sub->setProperty("livehime.fullScreenMenu", true);
+				AllowMenuOverFullScreen(sub);
+			}
+		}
+	});
+}
+
+/* An opaque per-window id used by the capture exceptions below. On macOS this
+ * is the CGWindowID; here it is the HWND. The return type is 32-bit (the
+ * header is shared with macOS), so the handle is truncated deliberately — it
+ * is only ever compared for equality within a process, never dereferenced. */
+unsigned int NativeWindowNumber(QWidget *window)
+{
+#ifdef _WIN32
+	HWND hwnd = HwndOf(window);
+	return hwnd ? static_cast<unsigned int>(reinterpret_cast<quintptr>(hwnd) & 0xffffffffu) : 0;
+#else
+	(void)window;
+	return 0;
+#endif
+}
+
+/* Registers the global procedure OBS's screen capture calls to learn which
+ * windows to keep or drop. Same name and signature as the macOS build, so the
+ * rest of the plugin (and any capture source that already speaks it) works
+ * unchanged. */
+void RegisterCaptureExceptionProcedure()
+{
+	proc_handler_add(obs_get_proc_handler(),
+			 "void hide_obs_window_exceptions(out string window_ids, out string hidden_window_ids)",
+			 exceptionProcedure, nullptr);
+}
+
+void SetCaptureException(const char *key, unsigned int id, bool visible)
+{
+	if (!key)
+		return;
+	std::lock_guard<std::mutex> lock(exceptionsMutex);
+	if (id)
+		exceptions[key] = {id, visible};
+	else
+		exceptions.erase(key);
+}
