+	net::Request req = FormPost(kShieldListUrl,
+				    {{"room_id", std::to_string(room_id)}, {"csrf", csrf}, {"csrf_token", csrf}});
+	RequestJson(req, [done](const json &root, const ApiError &error) {
+		if (Failed(error)) {
+			Deliver(done, Fail<std::vector<std::string>>(error));
+			return;
+		}
+		std::vector<std::string> found;
+		if (const json *data = FieldValue(root, {"data"}))
+			CollectKeywords(*data, found);
+		/* `seen.insert($0).inserted` — first-seen order, no repeats. */
+		std::vector<std::string> unique;
+		for (auto &word : found) {
+			if (std::find(unique.begin(), unique.end(), word) == unique.end())
+				unique.push_back(std::move(word));
+		}
+		Deliver(done, Ok(std::move(unique)));
+	});
+}
