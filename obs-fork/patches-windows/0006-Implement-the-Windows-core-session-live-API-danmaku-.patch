+/* Emoticons for the room (LiveRoomActions/Emoticons.swift). */
+void LoadEmoticons(long long room_id, JsonFn done)
+{
+	/* Emoticons.swift:98-121 (allEmoticons): the room's packs are required,
+	 * the account's main-site panel is optional (`try?`, :118), and the
+	 * picker's order is the 小黄脸 set (id 1) first, then the room's packs,
+	 * then the rest. The caller merges this object into
+	 * {"event":"emoticons","ok":true} (CBridge.swift:260). */
+	struct Shared {
+		bool reported = false;
+		bool live_done = false;
+		bool main_done = false;
+		std::vector<json> live;
+		std::vector<json> main_site;
+	};
+	auto shared = std::make_shared<Shared>();
+
+	auto finish = [shared, room_id, done]() {
+		if (shared->reported || !shared->live_done || !shared->main_done)
+			return;
+		shared->reported = true;
+		json packs = json::array();
+		for (const json &pack : shared->main_site) {
+			if (PackId(pack) == 1)
+				packs.push_back(pack);
+		}
+		for (const json &pack : shared->live)
+			packs.push_back(pack);
+		for (const json &pack : shared->main_site) {
+			if (PackId(pack) != 1)
+				packs.push_back(pack);
+		}
+		Deliver(done, Ok(json{{"room", room_id}, {"packs", packs}}));
+	};
+
+	net::Request live;
+	live.url = net::AppendQuery(kEmoticonsUrl,
+				    net::FormEncode({{"platform", "pc"}, {"room_id", std::to_string(room_id)}}));
+	ApplyLiveHeaders(live);
+	RequestJson(live, [shared, finish, done](const json &root, const ApiError &error) {
+		shared->live_done = true;
+		if (Failed(error)) {
+			/* `let live = try await emoticons(...)` throws here, without
+			 * waiting for the optional main-site request. */
+			shared->reported = true;
+			Deliver(done, Fail<json>(error));
+			return;
+		}
+		shared->live = ParseLivePacks(root);
+		finish();
+	});
+
+	net::Request main_site;
+	main_site.url = net::AppendQuery(kMainSiteEmotesUrl, net::FormEncode({{"business", "reply"}}));
+	ApplyLiveHeaders(main_site);
+	RequestJson(main_site, [shared, finish](const json &root, const ApiError &error) {
+		shared->main_done = true;
+		if (!Failed(error))
+			shared->main_site = ParseMainSitePacks(root);
+		finish();
+	});
+}
