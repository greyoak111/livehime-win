+ * literal does not depend on the compiler's source code page. It is Chinese
+ * for "the Bilibili interface returned a failure". */
+constexpr const char *kApiFailureMessage =
+	"Bilibili \xe6\x8e\xa5\xe5\x8f\xa3\xe8\xbf\x94\xe5\x9b\x9e\xe5\xa4\xb1\xe8\xb4\xa5";
+/* BilibiliControlClient.swift:75 names its own message: "身份接口返回失败". */
+constexpr const char *kIdentityFailureMessage =
+	"\xe8\xba\xab\xe4\xbb\xbd\xe6\x8e\xa5\xe5\x8f\xa3\xe8\xbf\x94\xe5\x9b\x9e\xe5\xa4\xb1\xe8\xb4\xa5";
+
+/* ── error shapes (CONTRACT §4.3) ───────────────────────────────────────── */
+
+ApiError ErrorOf(json fields, bool logged_out = false)
+{
+	ApiError error;
+	error.fields = std::move(fields);
+	error.logged_out = logged_out;
+	return error;
+}
+
+/* CBridge.swift:194-218 picks the shape. Only sessionExpired may move the
+ * session back to signedOut, so it is the only one that sets logged_out
+ * (liveclient.h:50-52). */
+ApiError SessionExpired()
+{
+	return ErrorOf(json{{"kind", "sessionExpired"}}, true);
+}
+
+ApiError NoLiveRoom()
+{
+	return ErrorOf(json{{"kind", "noLiveRoom"}});
+}
+
+ApiError ApiFailure(long long code, const std::string &message)
+{
+	return ErrorOf(json{{"kind", "api"}, {"code", code}, {"message", message}});
+}
+
+ApiError HttpFailure(long status)
+{
+	return ErrorOf(json{{"kind", "http"}, {"code", status}});
+}
+
+ApiError ServerFailure(const std::string &message)
+{
+	return ErrorOf(json{{"kind", "server"}, {"message", message}});
+}
+
+ApiError NetworkFailure(const std::string &message)
+{
+	return ErrorOf(json{{"kind", "network"}, {"message", message}});
+}
+
+/* CBridge.swift:197-199: the voucher key is present only when there is one. */
+ApiError FaceAuthRequired(const std::optional<std::string> &voucher)
+{
+	json fields{{"kind", "faceAuth"}};
+	if (voucher)
+		fields["voucher"] = *voucher;
+	return ErrorOf(std::move(fields));
+}
+
+ApiError FaceAuthQr(const std::string &url)
+{
+	return ErrorOf(json{{"kind", "faceAuthQR"}, {"qr", url}});
+}
+
+/* The Swift reports a transport failure as BilibiliLiveError.network(code:) or
+ * .transport and puts that error's description in the event. There is no
+ * URLSession here, so WinHTTP's own text takes its place — it says more than a
+ * code would. */
+ApiError TransportFailure(const net::Response &res)
+{
+	return NetworkFailure(res.error.empty() ? std::string("transport") : res.error);
+}
+
+bool Failed(const ApiError &error)
+{
+	return !error.fields.empty();
+}
+
+/* ── results and delivery ───────────────────────────────────────────────── */
+
+template <typename T> Result<T> Ok(T value)
+{
+	Result<T> result;
+	result.ok = true;
+	result.value = std::move(value);
+	return result;
+}
+
+template <typename T> Result<T> Fail(const ApiError &error)
+{
+	Result<T> result;
+	result.error = error;
+	return result;
+}
+
+/* Every public callback leaves through dispatch::Post: exactly one call, on the
+ * main thread, whatever happened. Post runs the work inline when it is already
+ * on the main thread, so this is also the cheap path. */
+template <typename T> void Deliver(const std::function<void(Result<T>)> &done, const Result<T> &result)
+{
+	if (!done)
+		return;
+	dispatch::Post([done, result]() { done(result); });
+}
+
+void DeliverSimple(const SimpleFn &done, bool ok, const ApiError &error)
+{
+	if (!done)
+		return;
+	dispatch::Post([done, ok, error]() { done(ok, error); });
+}
+
+void DeliverPath(const PathFn &done, bool ok, const std::string &path, const ApiError &error)
+{
+	if (!done)
+		return;
+	dispatch::Post([done, ok, path, error]() { done(ok, path, error); });
+}
+
+/* ── reading Swift-shaped JSON ──────────────────────────────────────────── */
+
+std::string LowerAscii(std::string text)
+{
+	for (char &c : text)
+		c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+	return text;
+}
+
+/* `int64(_:)` from BilibiliLiveClient.swift:512 / DanmakuProtocol.swift:208:
+ * any number — a JSON boolean included, because it bridges through NSNumber to
+ * 0/1 — or a decimal string; everything else is 0. */
+long long IntValue(const json &value)
+{
+	if (value.is_number()) {
+		const double number = value.get<double>();
+		if (!std::isfinite(number))
+			return 0;
+		/* Out-of-range float-to-integer conversion is undefined in C++ where
+		 * NSNumber's is not, so clamp before casting. */
+		if (number >= 9223372036854775807.0)
+			return std::numeric_limits<long long>::max();
+		if (number <= -9223372036854775808.0)
+			return std::numeric_limits<long long>::min();
+		return static_cast<long long>(number);
+	}
+	if (value.is_boolean())
+		return value.get<bool>() ? 1 : 0;
+	if (value.is_string()) {
+		const std::string &text = value.get_ref<const std::string &>();
+		if (text.empty())
+			return 0;
+		char *end = nullptr;
+		errno = 0;
+		const long long parsed = std::strtoll(text.c_str(), &end, 10);
+		if (end == text.c_str() + text.size() && errno != ERANGE)
+			return parsed;
+	}
+	return 0;
+}
+
+/* `int(_:)` from the same two places. */
+int IntValueInt(const json &value)
+{
+	return static_cast<int>(IntValue(value));
+}
+
+/* `d["a"] ?? d["b"]`: the fallback happens only when the key is absent. A
+ * present null wins the chain and reads as 0 — or as no string at all. */
+const json *FieldValue(const json &object, std::initializer_list<const char *> keys)
+{
+	if (!object.is_object())
+		return nullptr;
+	for (const char *key : keys) {
+		auto it = object.find(key);
+		if (it != object.end())
+			return &*it;
+	}
+	return nullptr;
+}
+
+long long FieldInt(const json &object, std::initializer_list<const char *> keys)
+{
+	const json *value = FieldValue(object, keys);
+	return value ? IntValue(*value) : 0;
+}
+
+int FieldIntInt(const json &object, const char *key)
+{
+	const json *value = FieldValue(object, {key});
+	return value ? IntValueInt(*value) : 0;
+}
+
+/* `d["a"] as? String ?? d["b"] as? String`: here a non-string value falls
+ * through to the next key, because the cast fails rather than the lookup. */
+std::optional<std::string> FieldString(const json &object, std::initializer_list<const char *> keys)
+{
+	if (!object.is_object())
+		return std::nullopt;
+	for (const char *key : keys) {
+		auto it = object.find(key);
+		if (it != object.end() && it->is_string())
+			return it->get<std::string>();
+	}
+	return std::nullopt;
+}
+
+bool FieldBool(const json &object, const char *key, bool &out)
+{
+	if (!object.is_object())
+		return false;
+	auto it = object.find(key);
+	if (it == object.end() || !it->is_boolean())
+		return false;
+	out = it->get<bool>();
+	return true;
+}
+
+/* `(value as? NSNumber)?.int64Value`: a number or a boolean, never a string
+ * (a Swift String does not bridge to NSNumber). */
+long long NumberField(const json &object, const char *key)
+{
+	const json *value = FieldValue(object, {key});
+	if (!value || !(value->is_number() || value->is_boolean()))
+		return 0;
+	return IntValue(*value);
+}
+
+/* `x as? [String: Any]`: an object, or nullptr. */
+const json *ObjectField(const json &object, const char *key)
+{
+	if (!object.is_object())
+		return nullptr;
+	auto it = object.find(key);
+	return it != object.end() && it->is_object() ? &*it : nullptr;
+}
+
+/* `root["data"] as? [String: Any]` — an object, or nothing. */
+json DataObject(const json &root)
+{
+	const json *data = ObjectField(root, "data");
+	return data ? *data : json();
+}
+
+/* `x as? [[String: Any]]`: an array whose items are all objects. A mixed or
+ * nested array matches neither cast and is skipped whole by the Swift. */
+const json *ObjectArrayField(const json &object, const char *key)
+{
+	if (!object.is_object())
+		return nullptr;
+	auto it = object.find(key);
+	if (it == object.end() || !it->is_array())
+		return nullptr;
+	for (const json &item : *it) {
+		if (!item.is_object())
+			return nullptr;
+	}
+	return &*it;
+}
+
+/* apiCode(_:) from BilibiliLiveClient.swift:456-461: an integral number inside
+ * Int32 that is not a JSON boolean. */
+bool IntegralValue(const json &value, long long &out)
+{
+	if (!value.is_number())
+		return false;
+	const double number = value.get<double>();
+	if (!std::isfinite(number) || number != std::floor(number) || std::abs(number) > 2147483647.0)
+		return false;
+	out = static_cast<long long>(number);
+	return true;
+}
+
+/* `Self.apiCode(root["code"])`, the check every requestJSON answer gets. */
+bool RootCode(const json &root, long long &out)
+{
+	const json *value = FieldValue(root, {"code"});
+	return value && IntegralValue(*value, out);
+}
+
+/* `apiCode(data["live_status"] ?? data["liveStatus"])`. */
+bool LiveStatusCode(const json &data, long long &out)
+{
+	const json *value = FieldValue(data, {"live_status", "liveStatus"});
+	return value && IntegralValue(*value, out);
+}
+
+/* `root["message"] as? String ?? root["msg"] as? String` and the Chinese
+ * fallback BilibiliLiveClient.swift:307,436 carries. */
+std::string ApiMessage(const json &root)
+{
+	if (auto message = FieldString(root, {"message", "msg"}))
+		return *message;
+	return kApiFailureMessage;
+}
+
+/* BilibiliLiveClient.swift:321-332. `required` forces an answer for the
+ * face-auth error codes even when the payload carries neither flag; nullopt
+ * means "this payload is not asking for face verification". */
+std::optional<ApiError> FaceAuthError(const json &data, bool required)
+{
+	bool flagged = false;
+	if (const json *value = FieldValue(data, {"need_face_auth"})) {
+		if (value->is_boolean())
+			flagged = value->get<bool>();
+		else if (value->is_number())
+			flagged = IntValueInt(*value) == 1;
+	}
+	if (auto qr = FieldString(data, {"qr"})) {
+		if (!qr->empty() && (flagged || required))
+			return FaceAuthQr(*qr);
+	}
+	std::optional<std::string> voucher;
+	if (const json *risk = ObjectField(data, "risk_extra"))
+		voucher = FieldString(*risk, {"v_voucher"});
+	if (required || flagged)
+		return FaceAuthRequired(voucher);
+	return std::nullopt;
+}
+
+/* ── HTTP plumbing ──────────────────────────────────────────────────────── */
+
+/* BilibiliLiveClient.swift:392-400: the headers requestJSON sets on top of the
+ * Cookie header the jar owns. */
+void ApplyLiveHeaders(net::Request &req)
+{
+	req.timeout_ms = kTimeoutMs;
+	req.headers["Accept"] = "application/json, text/plain, */*";
+	req.headers["Origin"] = kApiOrigin;
+	req.headers["Referer"] = kLiveReferer;
+	req.headers["User-Agent"] = kUserAgent;
+}
+
+/* A POST whose body is a form, the way `form(_:)` builds it
+ * (BilibiliLiveClient.swift:498-505, :400). */
+net::Request FormPost(const std::string &url, const std::vector<std::pair<std::string, std::string>> &fields)
+{
+	net::Request req;
+	req.method = "POST";
+	req.url = url;
+	req.body = net::FormEncode(fields);
+	req.content_type = "application/x-www-form-urlencoded; charset=UTF-8";
+	ApplyLiveHeaders(req);
+	return req;
+}
+
+using JsonHandler = std::function<void(const json &root, const ApiError &error)>;
+
+/* BilibiliLiveClient.swift:387-440, the requestJSON all the live calls go
+ * through: the HTTP status, then Bilibili's own code, then -101/60043/60024.
+ * `done` gets an empty error.fields on success. */
+void RequestJson(net::Request req, JsonHandler done)
+{
+	net::Send(req, [done](net::Response res) {
+		if (res.status == 0) {
+			done(json(), TransportFailure(res));
+			return;
+		}
+		if (!res.Ok()) {
+			done(json(), HttpFailure(res.status));
+			return;
+		}
+		json root = json::parse(res.body, nullptr, false);
+		long long code = 0;
+		if (root.is_discarded() || !RootCode(root, code)) {
+			done(json(), ServerFailure("invalidResponse"));
+			return;
+		}
+		if (code != 0) {
+			/* BilibiliLiveClient.swift:429-436. */
+			if (code == -101) {
+				done(json(), SessionExpired());
+				return;
+			}
+			if (code == 60043 || code == 60024) {
+				/* `faceAuthError(root["data"], required: true)!` — the
+				 * force-unwrap cannot fail with required set, but the
+				 * fallback keeps this honest without one. */
+				std::optional<ApiError> face = FaceAuthError(DataObject(root), true);
+				done(json(), face ? *face : ApiFailure(code, ApiMessage(root)));
+				return;
+			}
+			done(json(), ApiFailure(code, ApiMessage(root)));
+			return;
+		}
+		done(root, ApiError{});
+	});
+}
+
+/* ── WBI keys (CONTRACT §6.1) ───────────────────────────────────────────── */
+
+/* Filled by FetchIdentity's nav answer, used by FetchDanmakuInfo. Every call
+ * site is on the main thread; the lock costs nothing and keeps the helper
+ * honest if a probe ever calls it from elsewhere. */
+std::mutex g_signer_mutex;
+std::optional<net::WbiSigner> g_signer;
+
+std::optional<net::WbiSigner> CachedSigner()
+{
+	std::lock_guard<std::mutex> lock(g_signer_mutex);
+	return g_signer;
+}
+
+/* LiveRoomActions.swift:40-41: nav carries the WBI keys even when it answers
+ * -101, so they are read without the usual API-code check. */
+void StoreSignerFromNav(const json &root)
+{
+	/* A named copy: ObjectField hands back a pointer, and a pointer into a
+	 * temporary would dangle the moment the full expression ends. */
+	const json data = DataObject(root);
+	const json *wbi = ObjectField(data, "wbi_img");
+	if (!wbi)
+		return;
+	auto signer = net::WbiSigner::FromNav(FieldString(*wbi, {"img_url"}).value_or(""),
+					      FieldString(*wbi, {"sub_url"}).value_or(""));
+	if (!signer)
+		return;
+	std::lock_guard<std::mutex> lock(g_signer_mutex);
+	g_signer = signer;
+}
+
+using SignerHandler = std::function<void(std::optional<net::WbiSigner>, const ApiError &)>;
+
+/* LiveRoomActions.swift:42-57 asks nav again for the keys. The C++ keeps the
+ * copy FetchIdentity already parsed (liveclient.h:76-77) and only pays for a
+ * nav request when nothing has been cached yet. */
+void EnsureWbiSigner(SignerHandler done)
+{
+	if (auto cached = CachedSigner()) {
+		done(cached, ApiError{});
+		return;
+	}
+
+	net::Request req;
+	req.url = kNavUrl;
+	req.timeout_ms = kTimeoutMs;
+	/* :43-47: nav with the live referer and the browser UA — and, unlike the
+	 * live API calls, no Accept and no Origin. */
+	req.headers["Referer"] = kLiveReferer;
+	req.headers["User-Agent"] = kUserAgent;
+	net::Send(req, [done](net::Response res) {
+		if (res.status == 0) {
+			done(std::nullopt, TransportFailure(res));
+			return;
+		}
+		if (!res.Ok()) {
+			done(std::nullopt, HttpFailure(res.status));
+			return;
+		}
+		/* :51-56 parses the body without a code check at all. */
+		json root = json::parse(res.body, nullptr, false);
+		if (root.is_discarded() || !root.is_object()) {
+			done(std::nullopt, ServerFailure("invalidResponse"));
+			return;
+		}
+		StoreSignerFromNav(root);
+		if (auto signer = CachedSigner()) {
+			done(signer, ApiError{});
+			return;
+		}
+		done(std::nullopt, ServerFailure("invalidResponse"));
+	});
+}
+
+/* ── rooms ──────────────────────────────────────────────────────────────── */
+
+/* BilibiliLiveClient.swift:375-383, the legacy getRoomInfoOld answer:
+ * data.room_info ?? data, then roomid ?? room_id and roomname ?? title. */
+bool ParseLegacyRoom(const json &root, RoomInfo &out)
+{
+	const json data = DataObject(root);
+	if (!data.is_object())
+		return false;
+	const json *info = ObjectField(data, "room_info");
+	const json &d = info ? *info : data;
+	const long long room_id = FieldInt(d, {"room_id", "roomid"});
+	if (room_id <= 0)
+		return false;
+	out.room_id = room_id;
+	out.uid = FieldInt(d, {"uid"});
+	out.short_room_id = FieldInt(d, {"short_id"});
+	out.title = FieldString(d, {"title", "roomname"}).value_or("");
+	const json *status = FieldValue(d, {"live_status", "liveStatus"});
+	out.live_status = status ? IntValueInt(*status) : 0;
+	out.area_id = FieldInt(d, {"area_v2_id", "area_id"});
+	return true;
+}
+
+/* BilibiliLiveClient.swift:242-261: data.room_id must match the requested room
+ * and live_status must be an integral 0/1/2, or the answer is invalidResponse. */
+bool ParseCanonicalRoom(const json &root, long long room_id, RoomInfo &out)
+{
+	const json data = DataObject(root);
+	long long status = 0;
+	if (!data.is_object() || FieldInt(data, {"room_id"}) != room_id || !LiveStatusCode(data, status))
+		return false;
+	if (status != 0 && status != 1 && status != 2)
+		return false;
+	out.room_id = room_id;
+	out.uid = FieldInt(data, {"uid"});
+	out.short_room_id = FieldInt(data, {"short_id"});
+	out.title = FieldString(data, {"title"}).value_or("");
+	out.live_status = static_cast<int>(status);
+	out.area_id = FieldInt(data, {"area_v2_id", "area_id"});
+	return true;
+}
+
+/* BilibiliLiveClient.swift:109 and :375-383, the first leg of the room lookup.
+ * An answer without a room_info object, or with a non-positive room id, is
+ * BilibiliLiveError.missingRoom — which is what lets FetchRoom fall through
+ * to the other two endpoints. */
+void FetchLegacyRoom(long long mid, RoomFn done)
+{
+	net::Request req;
+	req.url = net::AppendQuery(kRoomInfoOldUrl, net::FormEncode({{"mid", std::to_string(mid)}}));
+	ApplyLiveHeaders(req);
+	RequestJson(req, [done](const json &root, const ApiError &error) {
+		if (Failed(error)) {
+			Deliver(done, Fail<RoomInfo>(error));
+			return;
+		}
+		RoomInfo room;
+		if (!ParseLegacyRoom(root, room)) {
+			Deliver(done, Fail<RoomInfo>(NoLiveRoom()));
+			return;
+		}
+		Deliver(done, Ok(room));
+	});
+}
+
+/* BilibiliLiveClient.swift:134-144. The caller wraps this in `try?`, so every
+ * failure here — transport included — means "no room id from this endpoint". */
+void ResolveRoomByUid(long long mid, std::function<void(long long)> done)
+{
+	net::Request req;
+	req.url = net::AppendQuery(kRoomByUidUrl, net::FormEncode({{"uid", std::to_string(mid)}}));
+	ApplyLiveHeaders(req);
+	RequestJson(req, [done](const json &root, const ApiError &error) {
+		if (Failed(error)) {
+			done(0);
+			return;
+		}
+		/* `int64(data?["room_id"] ?? root["room_id"])`: a present key in data
+		 * wins even when its value is null; only an absent one falls back. */
+		const json data = DataObject(root);
+		long long room_id = 0;
+		if (data.is_object() && data.contains("room_id"))
+			room_id = IntValue(*FieldValue(data, {"room_id"}));
+		else
+			room_id = FieldInt(root, {"room_id"});
+		done(room_id > 0 ? room_id : 0);
+	});
+}
+
+/* BilibiliLiveClient.swift:218-237. The last resort walks every value of every
+ * dictionary; Swift's dictionary order is unspecified and nlohmann's is
+ * sorted, so this answer is deterministic where the Swift's is not. */
+std::optional<long long> FindRoomId(const json &value)
+{
+	if (value.is_object()) {
+		/* Prefer the explicit room keys. */
+		for (const char *key : {"roomid", "room_id", "roomId"}) {
+			if (const json *id = FieldValue(value, {key})) {
+				const long long room_id = IntValue(*id);
+				if (room_id > 0)
+					return room_id;
+			}
+		}
+		for (const char *key : {"room_info", "live_info", "room", "data"}) {
+			if (const json *child = FieldValue(value, {key})) {
+				if (auto room_id = FindRoomId(*child))
+					return room_id;
+			}
+		}
+		/* `id` counts only inside a room_info/live_info object, so an area or
+		 * an unrelated object id is never read as a room id. */
+		if (!value.contains("room_id") && !value.contains("roomid") &&
+		    (value.contains("room_info") || value.contains("live_info"))) {
+			if (const json *id = FieldValue(value, {"id"})) {
+				const long long room_id = IntValue(*id);
+				if (room_id > 0)
+					return room_id;
+			}
+		}
+		for (auto it = value.begin(); it != value.end(); ++it) {
+			if (auto room_id = FindRoomId(it.value()))
+				return room_id;
+		}
+	} else if (value.is_array()) {
+		for (const json &child : value) {
+			if (auto room_id = FindRoomId(child))
+				return room_id;
+		}
+	}
+	return std::nullopt;
+}
+
+/* BilibiliLiveClient.swift:212-240, the authenticated legacy endpoint that
+ * still knows the room id when getRoomInfoOld answers with an empty
+ * room_info — which some accounts do until the live page has been opened. */
+void ResolveCurrentRoom(std::function<void(long long, const ApiError &)> done)
+{
+	net::Request req;
+	req.url = kLiveInfoUrl;
+	ApplyLiveHeaders(req);
+	RequestJson(req, [done](const json &root, const ApiError &error) {
+		if (Failed(error)) {
+			done(0, error);
+			return;
+		}
+		std::optional<long long> room_id;
+		if (const json *data = FieldValue(root, {"data"}))
+			room_id = FindRoomId(*data);
+		if (!room_id) {
+			done(0, NoLiveRoom());
+			return;
+		}
+		done(*room_id, ApiError{});
+	});
+}
+
+/* ── areas ──────────────────────────────────────────────────────────────── */
+
+/* BilibiliLiveClient.swift:146-181. Parent areas are containers; only a node
+ * with an id, a name and no child list is a leaf, and it inherits the enclosing
+ * parent when it has no parent of its own. `startLive.area_v2` needs a leaf id
+ * — a parent id earns Bilibili's generic -400. */
+struct AreaTree {
+	std::vector<json> leaves;
+
+	void Flatten(const json &value, long long parent_id, const std::string &parent_name)
+	{
+		/* `value as? [[String: Any]]`: an array of dictionaries and nothing
+		 * else, so a mixed or nested array is skipped whole. */
+		if (value.is_array()) {
+			for (const json &item : value) {
+				if (!item.is_object())
+					return;
+			}
+			for (const json &item : value)
+				Flatten(item, parent_id, parent_name);
+			return;
+		}
+		if (!value.is_object())
+			return;
+
+		std::vector<json> children;
+		for (const char *key : {"list", "area_list", "children", "areas"}) {
+			if (const json *child = FieldValue(value, {key}))
+				children.push_back(*child);
+		}
+		const long long own_id = FieldInt(value, {"id", "area_id"});
+		const std::string own_name = FieldString(value, {"name", "area_name"}).value_or("");
+
+		if (children.empty() && (value.contains("id") || value.contains("area_id")) &&
+		    (value.contains("name") || value.contains("area_name"))) {
+			json leaf = value;
+			if (!leaf.contains("parent_id") && !leaf.contains("parent_area_id") && parent_id > 0)
+				leaf["parent_id"] = parent_id;
+			if (!leaf.contains("parent_name") && !leaf.contains("parent_area_name") && !parent_name.empty())
+				leaf["parent_name"] = parent_name;
+			leaves.push_back(std::move(leaf));
+		}
+		for (const json &child : children)
+			Flatten(child, own_id > 0 ? own_id : parent_id, own_name.empty() ? parent_name : own_name);
+	}
+};
+
+/* BilibiliLiveClient.swift:184-187 turns the collected leaves into areas; a
+ * leaf without a positive id or a name is dropped. */
+std::optional<Area> ToArea(const json &leaf)
+{
+	const long long id = FieldInt(leaf, {"id", "area_id"});
+	auto name = FieldString(leaf, {"name", "area_name"});
+	if (id <= 0 || !name)
+		return std::nullopt;
+	Area area;
+	area.id = id;
+	area.parent_id = FieldInt(leaf, {"parent_id", "parent_area_id"});
+	area.name = *name;
+	area.parent_name = FieldString(leaf, {"parent_name", "parent_area_name"}).value_or("");
+	return area;
+}
+
+/* ── stream endpoints ───────────────────────────────────────────────────── */
+
+/* BilibiliLiveClient.swift:336-341: addr/server/rtmp_addr plus code/key/
+ * stream_code, both non-empty. */
+std::optional<std::pair<std::string, std::string>> StreamPair(const json &value)
+{
+	auto address = FieldString(value, {"addr", "server", "rtmp_addr"});
+	auto key = FieldString(value, {"code", "key", "stream_code"});
+	if (!address || !key || address->empty() || key->empty())
+		return std::nullopt;
+	return std::make_pair(*address, *key);
+}
+
+/* :342-349: every dictionary contributes its pair, children in sorted key
+ * order — "first match wins" must never depend on hash order. */
+void CollectStreamPairs(const json &value, std::vector<std::pair<std::string, std::string>> &out)
+{
+	if (value.is_object()) {
+		if (auto pair = StreamPair(value))
+			out.push_back(*pair);
+		for (auto it = value.begin(); it != value.end(); ++it)
+			CollectStreamPairs(it.value(), out);
+	} else if (value.is_array()) {
+		for (const json &item : value)
+			CollectStreamPairs(item, out);
+	}
+}
+
+/* :350-354: URL(string:) + an rtmp/rtmps scheme + a non-empty host. */
+std::optional<StreamConfig> UsableConfig(const std::pair<std::string, std::string> &candidate)
+{
+	const std::string &address = candidate.first;
+	/* URL(string:) refuses whitespace; the split below would not. */
+	if (address.find_first_of(" \t\r\n") != std::string::npos)
+		return std::nullopt;
+	const size_t scheme_end = address.find("://");
+	if (scheme_end == std::string::npos)
+		return std::nullopt;
+	const std::string scheme = LowerAscii(address.substr(0, scheme_end));
+	if (scheme != "rtmp" && scheme != "rtmps")
+		return std::nullopt;
+	const size_t host_start = scheme_end + 3;
+	const size_t host_end = address.find_first_of("/:?#", host_start);
+	const std::string host =
+		address.substr(host_start, host_end == std::string::npos ? std::string::npos : host_end - host_start);
+	if (host.empty())
+		return std::nullopt;
+	StreamConfig config;
+	config.server = address;
+	config.key = candidate.second;
+	return config;
+}
+
+/* BilibiliLiveClient.swift:334-365. Face verification runs before anything
+ * else, so a payload asking for it never reads as a missing endpoint. */
+Result<StreamConfig> ParseStreamConfig(const json &root)
+{
+	const json data = DataObject(root);
+	if (auto face = FaceAuthError(data, false))
+		return Fail<StreamConfig>(*face);
+
+	std::vector<std::pair<std::string, std::string>> candidates;
+	/* :357-361: the known RTMP locations first — data.rtmp, then the rtmp
+	 * entries of data.protocols — before the generic walk. */
+	if (const json *rtmp = ObjectField(data, "rtmp")) {
+		if (auto pair = StreamPair(*rtmp))
+			candidates.push_back(*pair);
+	}
+	if (const json *protocols = ObjectArrayField(data, "protocols")) {
+		for (const json &entry : *protocols) {
+			auto protocol = FieldString(entry, {"protocol"});
+			if (protocol && LowerAscii(*protocol) == "rtmp") {
+				if (auto pair = StreamPair(entry))
+					candidates.push_back(*pair);
+			}
+		}
+	}
+	CollectStreamPairs(data, candidates);
+	for (const auto &candidate : candidates) {
+		if (auto config = UsableConfig(candidate))
+			return Ok(*config);
+	}
+	/* CBridge.swift:212-213 maps this to {"kind":"server",
+	 * "message":"missingStreamConfig"}. */
+	return Fail<StreamConfig>(ServerFailure("missingStreamConfig"));
+}
+
+/* ── moderation helpers ─────────────────────────────────────────────────── */
+
+/* LiveRoomActions.swift:163-178: the list's key names are not stable across
+ * versions, so every non-empty "keyword" string (or plain string item) is
+ * taken. Swift sorts each dictionary's keys; nlohmann's map is already sorted. */
+void CollectKeywords(const json &value, std::vector<std::string> &found)
+{
+	if (value.is_object()) {
+		auto it = value.find("keyword");
+		if (it != value.end() && it->is_string() && !it->get_ref<const std::string &>().empty()) {
+			found.push_back(it->get<std::string>());
+			return;
+		}
+		for (auto child = value.begin(); child != value.end(); ++child)
+			CollectKeywords(child.value(), found);
+	} else if (value.is_array()) {
+		for (const json &item : value) {
+			if (item.is_string() && !item.get_ref<const std::string &>().empty())
+				found.push_back(item.get<std::string>());
+			else
+				CollectKeywords(item, found);
+		}
+	}
+}
+
+/* LiveRoomActions.swift:122-131: any truthy "identified"/"is_face"/"is_auth"/
+ * "face_auth" style field counts; anything else reads as "not yet". */
+bool Identified(const json &value)
+{
+	if (!value.is_object()) {
+		/* `(value as? Bool) ?? false` — a bare true, or a bare NSNumber 0/1. */
+		if (value.is_boolean())
+			return value.get<bool>();
+		if (value.is_number())
+			return IntValueInt(value) == 1;
+		return false;
+	}
+	for (auto it = value.begin(); it != value.end(); ++it) {
+		const std::string name = LowerAscii(it.key());
+		const bool relevant = name.find("identif") != std::string::npos ||
+				      name.find("is_face") != std::string::npos || name == "is_auth" ||
+				      name == "face_auth";
+		if (!relevant)
+			continue;
+		if (it->is_boolean() && it->get<bool>())
+			return true;
+		if (it->is_number() && IntValueInt(*it) == 1)
+			return true;
+	}
+	return false;
+}
+
+/* ── emoticon shapes (Emoticons.swift:35-93, :240-247) ─────────────────── */
+
+/* `text.count > 2 && text.hasPrefix("[") && text.hasSuffix("]")`
+ * (Emoticons.swift:22). Swift counts Characters; these codes are ASCII
+ * delimited, so counting UTF-8 code points gives the same number without a
+ * Unicode table. */
+bool InlineCode(const std::string &text)
+{
+	size_t characters = 0;
+	for (unsigned char byte : text) {
+		if ((byte & 0xC0) != 0x80)
+			++characters;
+	}
+	return characters > 2 && !text.empty() && text.front() == '[' && text.back() == ']';
+}
+
+/* Emoticons.swift:38-58: root.data.data[] packs with emoticons[]. Packs and
+ * items without a usable image are dropped. The JSON is already the CBridge
+ * field shape (:242-244), which is what the UI reads. */
+std::vector<json> ParseLivePacks(const json &root)
+{
+	std::vector<json> packs;
+	/* Named copies: the Object* helpers hand back pointers into their
+	 * argument, so the argument has to outlive the pointer. */
+	const json data = DataObject(root);
+	const json *list = ObjectArrayField(data, "data");
+	if (!list)
+		return packs;
+
+	for (const json &pack : *list) {
+		json items = json::array();
+		if (const json *emoticons = ObjectArrayField(pack, "emoticons")) {
+			for (const json &item : *emoticons) {
+				auto url = FieldString(item, {"url"});
+				auto unique = FieldString(item, {"emoticon_unique"});
+				if (!url || url->empty() || !unique || unique->empty())
+					continue;
+				const std::string name = FieldString(item, {"descript"}).value_or("");
+				const std::string text = FieldString(item, {"emoji"}).value_or(name);
+				/* `item["perm"].map { int($0) } ?? 1`: a present key counts
+				 * even when its value is null, so only an absent one is 1. */
+				const long long perm = item.contains("perm") ? IntValue(*FieldValue(item, {"perm"})) : 1;
+				std::string hint;
+				if (auto unlock = FieldString(item, {"unlock_show_text"})) {
+					if (!unlock->empty())
+						hint = *unlock;
+				}
+				if (hint.empty()) {
+					const int level = FieldIntInt(item, "unlock_need_level");
+					if (level > 0)
+						hint = "Lv" + std::to_string(level);
+				}
+				items.push_back(json{{"key", *unique},
+						     {"text", text.empty() ? name : text},
+						     {"name", name.empty() ? text : name},
+						     {"url", *url},
+						     {"w", FieldIntInt(item, "width")},
+						     {"h", FieldIntInt(item, "height")},
+						     {"inline", InlineCode(text)},
+						     {"usable", perm != 0},
+						     {"hint", hint}});
+			}
+		}
+		if (items.empty())
+			continue;
+		bool all_inline = true;
+		for (const json &item : items) {
+			if (!item.value("inline", false))
+				all_inline = false;
+		}
+		packs.push_back(json{{"id", FieldInt(pack, {"pkg_id"})},
+				     {"name", FieldString(pack, {"pkg_name"}).value_or("")},
+				     {"large", !all_inline},
+				     {"items", std::move(items)}});
+	}
+	return packs;
+}
+
+/* Emoticons.swift:66-84: root.data.packages[] with emote[] of "[code]" texts
+ * (the 小黄脸 set and the packs the account owns). Text-only packs are left
+ * out; the apps send these as stickers named "upower_" + code, and
+ * sentAsText: false keeps them out of the inline path (:78). */
+std::vector<json> ParseMainSitePacks(const json &root)
+{
+	std::vector<json> packs;
+	/* Named copy, for the same lifetime reason as ParseLivePacks. */
+	const json data = DataObject(root);
+	const json *list = ObjectArrayField(data, "packages");
+	if (!list)
+		return packs;
+
+	for (const json &pack : *list) {
+		json items = json::array();
+		if (const json *emotes = ObjectArrayField(pack, "emote")) {
+			for (const json &item : *emotes) {
+				auto url = FieldString(item, {"url"});
+				auto text = FieldString(item, {"text"});
+				if (!url || !text)
+					continue;
+				if (url->compare(0, 4, "http") != 0 && url->compare(0, 2, "//") != 0)
+					continue;
+				if (text->size() < 2 || text->front() != '[' || text->back() != ']')
+					continue;
+				bool no_access = false;
+				bool unlocked = false;
+				if (const json *flags = ObjectField(item, "flags")) {
+					FieldBool(*flags, "no_access", no_access);
+					FieldBool(*flags, "unlocked", unlocked);
+				}
+				const json *meta = ObjectField(item, "meta");
+				const std::string alias = meta ? FieldString(*meta, {"alias"}).value_or("") : "";
+				items.push_back(json{{"key", "upower_" + *text},
+						     {"text", *text},
+						     {"name", alias.empty() ? *text : alias},
+						     {"url", *url},
+						     {"w", 0},
+						     {"h", 0},
+						     {"inline", false},
+						     {"usable", !(no_access && !unlocked)},
+						     {"hint", ""}});
+			}
+		}
+		if (items.empty())
+			continue;
+		const json *meta = ObjectField(pack, "meta");
+		const int size = meta ? FieldIntInt(*meta, "size") : 0;
+		packs.push_back(json{{"id", FieldInt(pack, {"id"})},
+				     {"name", FieldString(pack, {"text"}).value_or("")},
+				     {"large", size == 2},
+				     {"items", std::move(items)}});
+	}
+	return packs;
+}
+
+/* The id my own pack objects carry, read back for the merge order. */
+long long PackId(const json &pack)
+{
+	auto it = pack.find("id");
+	return it != pack.end() ? IntValue(*it) : 0;
+}
