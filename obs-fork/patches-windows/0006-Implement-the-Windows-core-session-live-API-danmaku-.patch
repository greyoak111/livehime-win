+/* POST /msg/send. `reply_uid` > 0 makes it a reply; `reply_danmaku_id` may be
+ * empty. `emoticon_unique` non-empty sends a sticker instead of text. */
+void SendDanmaku(long long room_id, const std::string &text, long long reply_uid,
+		 const std::string &reply_danmaku_id, const std::string &emoticon_unique, SimpleFn done)
+{
+	/* LiveRoomActions.swift:80-94 for text, Emoticons.swift:125-139 for a
+	 * sticker: one body, with the sticker using its unique as msg and adding
+	 * dm_type/emoticonOptions. */
+	const std::string csrf = net::CookieJar::Instance().Get("bili_jct");
+	if (csrf.empty()) {
+		DeliverSimple(done, false, ServerFailure("missingCSRF"));
+		return;
+	}
+
+	const bool sticker = !emoticon_unique.empty();
+	const std::string reply_mid = reply_uid > 0 ? std::to_string(reply_uid) : "0";
+	/* The reply exists only when there is a uid to reply to, so its danmaku
+	 * id is empty otherwise (CBridge.swift:285). */
+	const std::string reply_dmid = reply_uid > 0 ? reply_danmaku_id : "";
+
+	std::vector<std::pair<std::string, std::string>> fields = {
+		{"bubble", "0"},
+		{"msg", sticker ? emoticon_unique : text},
+		{"color", "16777215"},
+		{"mode", "1"},
+		{"room_type", "0"},
+		{"jumpfrom", "0"},
+		{"reply_mid", reply_mid},
+		{"reply_attr", "0"},
+		/* The web room spells it replay_dmid (sic); LiveHime for Windows
+		 * names it reply_dmid, so both are sent (:77-79). */
+		{"replay_dmid", reply_dmid},
+		{"reply_dmid", reply_dmid},
+	};
+	if (sticker) {
+		fields.emplace_back("dm_type", "1");
+		fields.emplace_back("emoticonOptions", "[object Object]");
+	}
+	fields.emplace_back("statistics", R"({"appId":100,"platform":5})");
+	fields.emplace_back("fontsize", "25");
+	fields.emplace_back("rnd", std::to_string(static_cast<long long>(std::time(nullptr))));
+	fields.emplace_back("roomid", std::to_string(room_id));
+	fields.emplace_back("csrf", csrf);
+	fields.emplace_back("csrf_token", csrf);
+
+	RequestJson(FormPost(kSendDanmakuUrl, fields), [done](const json &, const ApiError &error) {
+		DeliverSimple(done, !Failed(error), error);
+	});
+}
