+/* QR login requests — the C++ counterpart of QRLogin.swift (the requests half).
+ *
+ * The Swift used an ephemeral URLSession with cookies disabled (QR:57,127-133)
+ * and read the login cookies by hand off the poll response: the Set-Cookie
+ * headers first, then the query items of the cross-domain `url` in the body as
+ * a fallback (QR:88-99). This does the same over net::Send, and hands the
+ * cookies back as a Credentials value instead of touching a cookie store.
+ *
+ * Note for the caller: net/http.h applies the process cookie jar to every
+ * request and there is no opt-out in its interface, so these two calls carry
+ * whatever the jar holds. session.cpp clears the jar before starting a QR
+ * round, which is what makes them cookie-less in practice, as the Swift's were
+ * (session-and-login.md §3.2 "no shared cookie jar").
+ *
+ * Every callback runs on the main thread via net::Send, exactly once. */
+
+#include "qrlogin.h"
+
+#include "../net/http.h"
+
+#include <nlohmann/json.hpp>
+
+#include <cctype>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace livehime {
+namespace auth {
+namespace {
+
+using nlohmann::json;
+
+/* QRLogin.swift:47-51. */
+constexpr const char *kGenerateUrl = "https://passport.bilibili.com/x/passport-login/web/qrcode/generate";
+constexpr const char *kPollUrl = "https://passport.bilibili.com/x/passport-login/web/qrcode/poll";
+constexpr const char *kSource = "live_pc";
+constexpr const char *kReferer = "https://live.bilibili.com/";
+/* QRLogin.swift:134 BilibiliWeb.userAgent, sent verbatim: the passport
+ * endpoints see the same client the macOS build is. CONTRACT §8.1 records this
+ * as the deliberate port decision — the whole login flow was validated against
+ * Bilibili with this UA. */
+constexpr const char *kUserAgent =
+	"Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Safari/605.1.15";
+/* QRLogin.swift:109 request.timeoutInterval = 12. */
+constexpr int kTimeoutMs = 12000;
+
+/* QRLogin.swift:8 keptCookies. */
+constexpr const char *kKeptCookies[] = {"SESSDATA", "bili_jct", "DedeUserID", "DedeUserID__ckMd5", "sid", "buvid3"};
+
+bool IsKeptCookie(const std::string &name)
+{
+	for (const char *kept : kKeptCookies) {
+		if (name == kept)
+			return true;
+	}
+	return false;
+}
+
+bool HasCookie(const std::map<std::string, std::string> &cookies, const char *name)
+{
+	return cookies.find(name) != cookies.end();
+}
+
+std::string Trim(const std::string &text)
+{
+	const size_t begin = text.find_first_not_of(" \t\r\n");
+	if (begin == std::string::npos)
+		return {};
+	const size_t end = text.find_last_not_of(" \t\r\n");
+	return text.substr(begin, end - begin + 1);
+}
+
+int HexDigit(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+std::string LowerAscii(const std::string &text)
+{
+	std::string out = text;
+	for (char &c : out)
+		c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+	return out;
+}
+
+/* True when `text` starts a fresh "name=value" pair, which is what makes a
+ * comma in a Set-Cookie line a cookie boundary. "Expires=Wed, 21 Oct …" does
+ * not: its comma is followed by " 21 Oct …", and a name that is one of the
+ * cookie attributes never starts a cookie either — the reading
+ * HTTPCookie.cookies(withResponseHeaderFields:) gave the Swift (QR:91). */
+bool StartsCookiePair(const std::string &text)
+{
+	const size_t begin = text.find_first_not_of(" \t");
+	if (begin == std::string::npos)
+		return false;
+	const size_t equals = text.find('=', begin);
+	if (equals == std::string::npos)
+		return false;
+
+	const std::string name = LowerAscii(text.substr(begin, equals - begin));
+	if (name.empty())
+		return false;
+	for (const char c : name) {
+		if (!std::isalnum(static_cast<unsigned char>(c)) && c != '_' && c != '-' && c != '.')
+			return false;
+	}
+	for (const char *attribute :
+	     {"expires", "path", "domain", "max-age", "samesite", "secure", "httponly", "comment", "version"}) {
+		if (name == attribute)
+			return false;
+	}
+	return true;
+}
+
+/* URLComponents.queryItems percent-decodes its values (QR:95). A '+' stays a
+ * '+': this is a URL query, not a form body. */
+std::string PercentDecode(const std::string &text)
+{
+	std::string out;
+	out.reserve(text.size());
+	for (size_t i = 0; i < text.size(); ++i) {
+		if (text[i] == '%' && i + 2 < text.size()) {
+			const int high = HexDigit(text[i + 1]);
+			const int low = HexDigit(text[i + 2]);
+			if (high >= 0 && low >= 0) {
+				out += static_cast<char>((high << 4) | low);
+				i += 2;
+				continue;
+			}
+		}
+		out += text[i];
+	}
+	return out;
+}
+
+/* ── error shapes ───────────────────────────────────────────────────────── */
+
+/* CONTRACT §4.3. session.cpp reads `kind` to choose the SessionNotice:
+ * "network" is a network failure, everything else a server one — the Swift's
+ * notice(for:) (SC:423-435) only distinguished those two plus missingRoom and
+ * a rejected login. */
+
+live::ApiError NetworkFailure(const std::string &message)
+{
+	live::ApiError error;
+	error.fields = json{{"kind", "network"}, {"message", message}};
+	error.logged_out = false;
+	return error;
+}
+
+live::ApiError ServerFailure(const std::string &message)
+{
+	live::ApiError error;
+	error.fields = json{{"kind", "server"}, {"message", message}};
+	error.logged_out = false;
+	return error;
+}
+
+live::ApiError HttpFailure(long status)
+{
+	live::ApiError error;
+	error.fields = json{{"kind", "http"}, {"code", status}};
+	error.logged_out = false;
+	return error;
+}
+
+live::ApiError ApiFailure(int code, const std::string &message)
+{
+	live::ApiError error;
+	error.fields = json{{"kind", "api"}, {"code", code}, {"message", message}};
+	error.logged_out = false;
+	return error;
+}
+
+/* ── response reading ───────────────────────────────────────────────────── */
+
+std::string TextField(const json &object, const char *key)
+{
+	const auto field = object.find(key);
+	if (field == object.end() || !field->is_string())
+		return {};
+	return field->get<std::string>();
+}
+
+/* QRLogin.swift:105-121 `get`, the whole ladder: transport, HTTP status, JSON
+ * envelope, then the envelope's own `code`. */
+bool ReadRoot(const net::Response &response, json &root, live::ApiError &error)
+{
+	if (response.status == 0 || !response.error.empty()) {
+		error = NetworkFailure(response.error.empty() ? "no response" : response.error);
+		return false;
+	}
+	if (!response.Ok()) {
+		error = HttpFailure(response.status);
+		return false;
+	}
+
+	/* allow_exceptions = false: malformed JSON is a discarded value, which is
+	 * the Swift's `try? JSONSerialization` branch. */
+	root = json::parse(response.body, nullptr, false);
+	if (root.is_discarded() || !root.is_object()) {
+		error = ServerFailure("invalidResponse");
+		return false;
+	}
+	const auto code = root.find("code");
+	if (code == root.end() || !code->is_number()) {
+		error = ServerFailure("invalidResponse");
+		return false;
+	}
+	const int value = code->get<int>();
+	if (value != 0) {
+		error = ApiFailure(value, TextField(root, "message"));
+		return false;
+	}
+	return true;
+}
+
+/* One Set-Cookie line per '\n' (net/http joins repeats that way); within a line
+ * only a comma that starts a new pair separates cookies, so neither the comma
+ * in "Expires=Wed, 21 Oct …" nor one inside a value ends the cookie. The value
+ * is kept verbatim: cookies are opaque bytes. */
+void AbsorbSetCookies(const std::string &header, std::map<std::string, std::string> &cookies)
+{
+	size_t line_start = 0;
+	for (;;) {
+		const size_t eol = header.find('\n', line_start);
+		const std::string line =
+			header.substr(line_start, eol == std::string::npos ? std::string::npos : eol - line_start);
+		if (!line.empty()) {
+			std::vector<std::string> fragments;
+			std::string fragment;
+			for (const char c : line) {
+				if (c == ',') {
+					fragments.push_back(fragment);
+					fragment.clear();
+				} else {
+					fragment += c;
+				}
+			}
+			fragments.push_back(fragment);
+
+			std::vector<std::string> cookies_on_line;
+			for (const auto &part : fragments) {
+				if (!cookies_on_line.empty() && !StartsCookiePair(part))
+					cookies_on_line.back() += "," + part;
+				else
+					cookies_on_line.push_back(part);
+			}
+			for (const auto &cookie : cookies_on_line) {
+				const size_t semi = cookie.find(';');
+				const std::string pair =
+					semi == std::string::npos ? cookie : cookie.substr(0, semi);
+				const size_t equals = pair.find('=');
+				if (equals == std::string::npos)
+					continue;
+				const std::string name = Trim(pair.substr(0, equals));
+				if (!name.empty())
+					cookies[name] = Trim(pair.substr(equals + 1));
+			}
+		}
+		if (eol == std::string::npos)
+			return;
+		line_start = eol + 1;
+	}
+}
+
+/* The body's cross-domain url repeats the cookies as query items; a name the
+ * headers already carried wins (QR:95-99). */
+void AbsorbCrossDomain(const std::string &url, std::map<std::string, std::string> &cookies)
+{
+	const size_t question = url.find('?');
+	if (question == std::string::npos)
+		return;
+
+	const std::string query = url.substr(question + 1);
+	size_t start = 0;
+	for (;;) {
+		const size_t amp = query.find('&', start);
+		const std::string pair = query.substr(start, amp == std::string::npos ? std::string::npos : amp - start);
+		const size_t equals = pair.find('=');
+		if (equals != std::string::npos) {
+			const std::string name = PercentDecode(pair.substr(0, equals));
+			const std::string value = PercentDecode(pair.substr(equals + 1));
+			if (!name.empty() && cookies.find(name) == cookies.end())
+				cookies[name] = value;
+		}
+		if (amp == std::string::npos)
+			return;
+		start = amp + 1;
+	}
+}
+
+/* QRLogin.swift:88-103: collect, keep the six names, require the three. */
+bool CredentialsFrom(const json &data, const net::Response &response, Credentials &out, live::ApiError &error)
+{
+	std::map<std::string, std::string> cookies;
+	AbsorbSetCookies(response.Header("set-cookie"), cookies);
+
+	const std::string cross_domain = TextField(data, "url");
+	if (!cross_domain.empty())
+		AbsorbCrossDomain(cross_domain, cookies);
+
+	Credentials credentials;
+	for (const auto &cookie : cookies) {
+		/* QRLogin.swift:15 — only keptCookies survive, and an empty value is
+		 * not a cookie. */
+		if (!cookie.second.empty() && IsKeptCookie(cookie.first))
+			credentials.cookies[cookie.first] = cookie.second;
+	}
+	credentials.refresh_token = TextField(data, "refresh_token");
+
+	if (!credentials.Complete()) {
+		error = ServerFailure("incompleteCredentials");
+		return false;
+	}
+	out = credentials;
+	return true;
+}
+
+net::Request QrRequest(const std::string &url)
+{
+	net::Request request;
+	request.method = "GET";
+	request.url = url;
+	request.headers["Referer"] = kReferer;
+	request.headers["User-Agent"] = kUserAgent;
+	request.timeout_ms = kTimeoutMs;
+	return request;
+}
+
+} // namespace
+
+bool Credentials::Complete() const
+{
+	return HasCookie(cookies, "SESSDATA") && HasCookie(cookies, "bili_jct") && HasCookie(cookies, "DedeUserID");
+}
+
+long long Credentials::Mid() const
+{
+	const auto cookie = cookies.find("DedeUserID");
+	if (cookie == cookies.end())
+		return 0;
+	try {
+		return std::stoll(cookie->second);
+	} catch (...) {
+		/* Not a number: the Swift's `Int64.init` returned nil. */
+		return 0;
+	}
+}
+
+std::string Credentials::Csrf() const
+{
+	const auto cookie = cookies.find("bili_jct");
+	return cookie == cookies.end() ? std::string() : cookie->second;
+}
+
+std::string Credentials::CookieHeader() const
+{
+	std::string header;
+	for (const auto &cookie : cookies) {
+		if (cookie.second.empty())
+			continue;
+		if (!header.empty())
+			header += "; ";
+		header += cookie.first + "=" + cookie.second;
+	}
+	return header;
+}
+
+void GenerateQr(QrGenerateFn done)
+{
+	net::Send(QrRequest(std::string(kGenerateUrl) + "?source=" + kSource), [done](net::Response response) {
+		if (!done)
+			return;
+
+		json root;
+		live::ApiError error;
+		if (!ReadRoot(response, root, error)) {
+			done(false, std::string(), std::string(), error);
+			return;
+		}
+
+		/* QRLogin.swift:63-65: both fields must be present and non-empty. */
+		const auto data = root.find("data");
+		if (data == root.end() || !data->is_object()) {
+			done(false, std::string(), std::string(), ServerFailure("invalidResponse"));
+			return;
+		}
+		const std::string url = TextField(*data, "url");
+		const std::string key = TextField(*data, "qrcode_key");
+		if (url.empty() || key.empty()) {
+			done(false, std::string(), std::string(), ServerFailure("invalidResponse"));
+			return;
+		}
+		done(true, url, key, live::ApiError{});
+	});
+}
+
+void PollQr(const std::string &key, QrPollFn done)
+{
+	const std::string url = std::string(kPollUrl) + "?qrcode_key=" + net::UrlEncode(key) + "&source=" + kSource;
+	net::Send(QrRequest(url), [done](net::Response response) {
+		if (!done)
+			return;
+
+		QrPollResult result;
+		json root;
+		if (!ReadRoot(response, root, result.error)) {
+			result.kind = QrPoll::Failed;
+			done(result);
+			return;
+		}
+
+		/* QRLogin.swift:74-82. */
+		const auto data = root.find("data");
+		if (data == root.end() || !data->is_object()) {
+			result.kind = QrPoll::Failed;
+			result.error = ServerFailure("invalidResponse");
+			done(result);
+			return;
+		}
+		const auto code = data->find("code");
+		if (code == data->end() || !code->is_number()) {
+			result.kind = QrPoll::Failed;
+			result.error = ServerFailure("invalidResponse");
+			done(result);
+			return;
+		}
+
+		const int value = code->get<int>();
+		switch (value) {
+		case 86101:
+			result.kind = QrPoll::WaitingForScan;
+			break;
+		case 86090:
+			result.kind = QrPoll::Scanned;
+			break;
+		case 86038:
+			result.kind = QrPoll::Expired;
+			break;
+		case 0:
+			/* The poll's own message is not read on success; the cookies are
+			 * the answer (QR:81). */
+			if (CredentialsFrom(*data, response, result.credentials, result.error)) {
+				result.kind = QrPoll::Succeeded;
+			} else {
+				result.kind = QrPoll::Failed;
+			}
+			break;
+		default:
+			result.kind = QrPoll::Failed;
+			result.error = ApiFailure(value, TextField(*data, "message"));
+			break;
+		}
+		done(result);
+	});
+}
+
+} // namespace auth
+} // namespace livehime
diff --git a/plugins/livehime/core/win/auth/qrlogin.h b/plugins/livehime/core/win/auth/qrlogin.h
new file mode 100644
index 0000000..03c9573
--- /dev/null
+++ b/plugins/livehime/core/win/auth/qrlogin.h
@@ -0,0 +1,72 @@
+/* QR login — the C++ counterpart of QRLogin.swift.
+ *
+ * QRLogin.swift holds two things: the two passport requests (generate/poll)
+ * and SessionCredentials, the cookie set they produce. Both live here, because
+ * session.cpp is the only caller and the state machine that owns the polling
+ * cadence, the regeneration count and the expiry notice stays there — exactly
+ * as SessionCoordinator.swift owns it on macOS. */
+
+#pragma once
+
+#include <functional>
+#include <map>
+#include <string>
+
+#include "live/liveclient.h"
+
+namespace livehime {
+namespace auth {
+
+/* QRLogin.swift:6-27. The cookie map iterates name-ascending, which is the
+ * order `cookieHeader` produces by sorting (QR:24-26); only the six names in
+ * keptCookies (QR:8) get in, because the constructor filters them (QR:15), and
+ * an empty value counts as absent. Values are secrets: never log this. */
+struct Credentials {
+	std::map<std::string, std::string> cookies;
+	std::string refresh_token;
+	/* Unix seconds. SessionCredentials.savedAt (QR:13) is never read back by
+	 * either platform; session.cpp stamps it when the blob is written. */
+	long long saved_at = 0;
+
+	/* QRLogin.swift:20 — SESSDATA, bili_jct and DedeUserID are all required. */
+	bool Complete() const;
+	/* QRLogin.swift:21-22. `Mid`/`Csrf`/`CookieHeader` are the rest of the
+	 * SessionCredentials surface the macOS tests pin (QR:24-26,
+	 * SessionCoordinatorTests.swift:131); on Windows the wire path is the
+	 * process cookie jar, which session.cpp fills from this map. */
+	long long Mid() const;
+	std::string Csrf() const;
+	/* "DedeUserID=…; SESSDATA=…; bili_jct=…" (QR:24-26). */
+	std::string CookieHeader() const;
+};
+
+/* QRLogin.swift:29-34, plus the failure arm the Swift modelled as the separate
+ * QRLoginError enum (QR:36-42). */
+enum class QrPoll {
+	WaitingForScan, /* data.code 86101 */
+	Scanned,        /* 86090 */
+	Expired,        /* 86038 */
+	Succeeded,      /* 0 */
+	Failed,         /* invalidResponse / api / incompleteCredentials / network / http */
+};
+
+struct QrPollResult {
+	QrPoll kind = QrPoll::WaitingForScan;
+	Credentials credentials; /* Succeeded only */
+	live::ApiError error;    /* Failed only, already shaped like CONTRACT §4.3 */
+};
+
+/* `ok` is false when no code could be obtained; `url` is what the QR image
+ * encodes and `key` is what the poll needs. */
+using QrGenerateFn =
+	std::function<void(bool ok, const std::string &url, const std::string &key, const live::ApiError &error)>;
+using QrPollFn = std::function<void(const QrPollResult &result)>;
+
+/* GET /x/passport-login/web/qrcode/generate?source=live_pc (QRLogin.swift:61-67). */
+void GenerateQr(QrGenerateFn done);
+/* GET /x/passport-login/web/qrcode/poll?qrcode_key=<key>&source=live_pc
+ * (QRLogin.swift:69-84). */
+void PollQr(const std::string &key, QrPollFn done);
+
+} // namespace auth
+} // namespace livehime
diff --git a/plugins/livehime/core/win/auth/session.cpp b/plugins/livehime/core/win/auth/session.cpp
new file mode 100644
index 0000000..349bddd
--- /dev/null
+++ b/plugins/livehime/core/win/auth/session.cpp
@@ -0,0 +1,840 @@
+/* Login state machine — the C++ counterpart of SessionCoordinator.swift.
+ *
+ * Two rules from the Swift shape everything below.
+ *
+ *  - Only an explicit "not logged in" from Bilibili returns to signedOut
+ *    (SC:21-25): identity answering -101, or `isLogin` false. Every other
+ *    problem — transport, HTTP status, a missing room — stays in `failed` with
+ *    the stored login kept, so an outage never throws the user back to the
+ *    login screen (SC:405-414).
+ *  - Every continuation carries a generation token instead of the Swift's
+ *    cancelled Task. Stop(), a new QR round, sign-out and MarkSignedOut all
+ *    retire the token; a continuation whose token is stale returns without
+ *    touching the state, which is the `guard !Task.isCancelled` the Swift
+ *    scattered through qrLogin/verify (SC:353, 365-369, 389, 401, 406).
+ *
+ * All of it runs on the main thread: the entry points by contract (CONTRACT
+ * §2), the continuations because net::Send and the poll tick come back through
+ * dispatch::Post. The generation is therefore plain state, not an atomic. */
+
+#include "session.h"
+
+#include "credentials.h"
+#include "qrlogin.h"
+
+#include "../core/emit.h"
+#include "../core/qr/qr_png.h"
+#include "../net/cookies.h"
+#include "../platform/dispatch.h"
+
+#include <windows.h>
+
+#include <ctime>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+
+namespace livehime {
+namespace auth {
+namespace {
+
+using nlohmann::json;
+
+/* ── constants read out of the Swift ────────────────────────────────────── */
+
+/* SessionCoordinator.swift:86-87 defaults: one poll every 1.5 s, and at most
+ * two automatic regenerations — so the third expiry gives up (SC:375-378,
+ * pinned by SessionCoordinatorTests.swift:134-141). */
+constexpr int kPollIntervalMs = 1500;
+constexpr int kMaxAutoRefresh = 2;
+
+/* Bilibili's login cookies belong to the whole domain, and CONTRACT §7 expects
+ * them on api.bilibili.com, api.live.bilibili.com and passport alike. The jar
+ * strips the leading dot and matches subdomains (net/cookies.cpp:196-210). */
+constexpr const char *kCookieDomain = ".bilibili.com";
+
+/* CredentialStore.swift:26 CredentialEnvelope.currentVersion. */
+constexpr int kEnvelopeVersion = 2;
+
+constexpr const char *kSaveFailedDetail = "the Windows credential store refused to save the login";
+constexpr const char *kRemoveFailedDetail = "the Windows credential store refused to remove the login";
+
+/* Core Foundation's reference date. Swift's JSONEncoder writes a Date as
+ * seconds since 2001-01-01 by default (session-and-login.md §5.1); nothing
+ * reads `savedAt` back on either platform, but the persisted number keeps the
+ * shape the macOS build wrote. */
+constexpr long long kReferenceDateUnix = 978307200;
+
+/* ── one delayed main-thread call ───────────────────────────────────────── */
+
+/* The Swift polled with `try await Task.sleep(for: pollInterval)`. Nothing in
+ * the foundation delays a callback, so a one-shot timer-queue timer does, and
+ * the callback only posts the tick back to the main thread. At most one tick is
+ * ever outstanding: a flow schedules the next one after the previous one ran,
+ * and Retire() drops the pending one before a new flow starts, so a stopped
+ * round can neither keep polling nor run someone else's tick. */
+std::mutex g_tick_mutex;
+std::unique_ptr<std::function<void()>> g_tick;
+HANDLE g_tick_timer = nullptr;
+
+HANDLE TimerQueue()
+{
+	static HANDLE queue = CreateTimerQueue();
+	return queue;
+}
+
+void CALLBACK TickFired(PVOID, BOOLEAN)
+{
+	std::function<void()> tick;
+	{
+		std::lock_guard<std::mutex> lock(g_tick_mutex);
+		g_tick_timer = nullptr; /* one-shot: the handle is spent either way */
+		if (!g_tick)
+			return;
+		tick = std::move(*g_tick);
+		g_tick.reset();
+	}
+	dispatch::Post([tick]() { tick(); });
+}
+
+void ScheduleTick(unsigned milliseconds, std::function<void()> tick)
+{
+	{
+		std::lock_guard<std::mutex> lock(g_tick_mutex);
+		g_tick = std::make_unique<std::function<void()>>(std::move(tick));
+	}
+
+	HANDLE timer = nullptr;
+	if (!CreateTimerQueueTimer(&timer, TimerQueue(), &TickFired, nullptr, milliseconds, 0, WT_EXECUTEONLYONCE)) {
+		std::lock_guard<std::mutex> lock(g_tick_mutex);
+		g_tick.reset();
+		return;
+	}
+
+	/* Remember the handle only while the tick is still ours: a very short
+	 * interval could have fired between the two locks, and then the handle is
+	 * already spent. */
+	std::lock_guard<std::mutex> lock(g_tick_mutex);
+	if (g_tick)
+		g_tick_timer = timer;
+}
+
+void CancelTick()
+{
+	HANDLE timer = nullptr;
+	{
+		std::lock_guard<std::mutex> lock(g_tick_mutex);
+		g_tick.reset();
+		timer = g_tick_timer;
+		g_tick_timer = nullptr;
+	}
+	/* A tick that already left the queue frees itself in TickFired; this only
+	 * stops one that has not run yet. Deleting an already-fired handle fails
+	 * harmlessly. */
+	if (timer)
+		DeleteTimerQueueTimer(TimerQueue(), timer, INVALID_HANDLE_VALUE);
+}
+
+/* ── state ──────────────────────────────────────────────────────────────── */
+
+/* Bumped by every entry point that changes what should happen next. A
+ * continuation whose token no longer matches returns without touching the
+ * state, which is the Swift's `guard !Task.isCancelled`. */
+unsigned g_generation = 0;
+
+/* Retires the running continuations, and the poll tick still waiting on the
+ * timer queue with them. */
+unsigned Retire()
+{
+	CancelTick();
+	return ++g_generation;
+}
+
+/* What the last emitted {"state": …} was, so a repeat is dropped the way the
+ * Swift's `didSet { if state != oldValue }` dropped it (SC:65-67). `known`
+ * starts false, which is what lets CBridge's unconditional first publish
+ * (CB:156) come out even though the state is already signedOut. */
+enum class Phase { SignedOut, QrCode, Verifying, Ready, Failed };
+
+Phase g_phase = Phase::SignedOut;
+Notice g_notice = Notice::None;
+std::string g_detail;
+bool g_known = false;
+
+/* The fields of the last `ready` object, for the same comparison. */
+long long g_ready_mid = 0;
+std::string g_ready_username;
+live::RoomInfo g_ready_room;
+
+/* SessionCoordinator.credentials: in-memory only. The credential blob is the
+ * durable copy, and it is never logged. */
+Credentials g_credentials;
+bool g_persist_ok = false;
+
+/* The QR code being polled, and how many times it has been replaced. */
+std::string g_qr_url;
+std::string g_qr_key;
+int g_qr_refreshes = 0;
+
+/* What the last qrCode object said, so `scanned` is reported once per code
+ * (SC:373-374 assigns the same state again; the didSet drops it). */
+std::string g_qr_published_url;
+bool g_qr_published_scanned = false;
+
+/* ── the credential blob ────────────────────────────────────────────────── */
+
+/* CredentialStore.swift:25-35: a versioned envelope around SessionCredentials.
+ * The field names are that type's Codable names, so a blob written here reads
+ * like the one macOS wrote. The blob is a secret: it is never logged, and only
+ * a save failure is reported. */
+std::string EncodeBlob(const Credentials &credentials)
+{
+	json cookies = json::object();
+	for (const auto &cookie : credentials.cookies)
+		cookies[cookie.first] = cookie.second;
+
+	const json stored{{"cookies", cookies},
+			  {"refreshToken", credentials.refresh_token},
+			  {"savedAt", credentials.saved_at}};
+	return json{{"schemaVersion", kEnvelopeVersion}, {"credentials", stored}}.dump();
+}
+
+enum class StoredKind { None, Current, Legacy };
+
+struct StoredSession {
+	StoredKind kind = StoredKind::None;
+	Credentials credentials;
+};
+
+/* CredentialStore.swift:37-51 decodeStoredCredentials, with one difference the
+ * platform forces: the legacy branch's WebKit cookie import does not exist on
+ * Windows, so a legacy record can only reach the "needs login" outcome. Its
+ * `type`/`sessdata` split is therefore not decoded. */
+StoredSession DecodeBlob(const std::string &blob)
+{
+	StoredSession stored;
+
+	const json root = json::parse(blob, nullptr, false);
+	if (root.is_discarded() || !root.is_object())
+		return stored; /* unknown data is signed out, not a crash (CS:48-50) */
+
+	const auto version = root.find("schemaVersion");
+	const auto credentials = root.find("credentials");
+	if (version != root.end() && version->is_number_integer() && version->get<int>() == kEnvelopeVersion &&
+	    credentials != root.end() && credentials->is_object()) {
+		stored.kind = StoredKind::Current;
+		const auto cookies = credentials->find("cookies");
+		if (cookies != credentials->end() && cookies->is_object()) {
+			for (auto cookie = cookies->begin(); cookie != cookies->end(); ++cookie) {
+				if (cookie.value().is_string())
+					stored.credentials.cookies[cookie.key()] = cookie.value().get<std::string>();
+			}
+		}
+		const auto token = credentials->find("refreshToken");
+		if (token != credentials->end() && token->is_string())
+			stored.credentials.refresh_token = token->get<std::string>();
+		const auto saved_at = credentials->find("savedAt");
+		if (saved_at != credentials->end() && saved_at->is_number())
+			stored.credentials.saved_at = static_cast<long long>(saved_at->get<double>());
+		return stored;
+	}
+
+	/* CredentialStore.swift:43-46: v0.1.2's {"type":…,"refreshToken":…}, where
+	 * a non-empty refreshToken is what makes it a login. */
+	const auto legacy = root.find("refreshToken");
+	if (legacy != root.end() && legacy->is_string() && !legacy->get<std::string>().empty()) {
+		stored.kind = StoredKind::Legacy;
+		stored.credentials.refresh_token = legacy->get<std::string>();
+	}
+	return stored;
+}
+
+/* CredentialStore::Load cannot tell "nothing stored" from "the read failed"
+ * (its interface returns one bool), so both arrive here as StoredKind::None.
+ * The Swift could distinguish them and reported a failed read as
+ * failed(keychain) (SC:340-342). */
+StoredSession LoadStoredSession()
+{
+	std::string blob;
+	if (!CredentialStore::Instance().Load(blob) || blob.empty())
+		return StoredSession{};
+	return DecodeBlob(blob);
+}
+
+/* ── error mapping ──────────────────────────────────────────────────────── */
+
+/* SessionCoordinator.notice(for:) (SC:423-435). The Swift's transport/network
+ * cases are the only ones that are not "server"; a rejected login is handled
+ * before this is ever consulted. */
+Notice NoticeFor(const live::ApiError &error)
+{
+	const std::string kind = error.Kind();
+	if (kind == "noLiveRoom")
+		return Notice::NoLiveRoom;
+	if (kind == "network")
+		return Notice::Network;
+	return Notice::Server;
+}
+
+/* The Swift put "\(error)" in `detail`. There is no C++ equivalent of a Swift
+ * error description, and CONTRACT §4.3 guarantees the error fields carry no
+ * cookies or tokens, so the message (or the fields themselves) is the detail. */
+std::string DetailFor(const live::ApiError &error)
+{
+	const auto message = error.fields.find("message");
+	if (message != error.fields.end() && message->is_string() && !message->get<std::string>().empty())
+		return message->get<std::string>();
+	return error.fields.dump();
+}
+
+/* ── cookies ────────────────────────────────────────────────────────────── */
+
+/* A request in the Swift carried exactly SessionCredentials.cookieHeader, so
+ * the jar is replaced rather than added to: without this, a cookie from an
+ * earlier session would ride along with the new one. */
+void ApplyCredentials(const Credentials &credentials)
+{
+	net::CookieJar &jar = net::CookieJar::Instance();
+	jar.Clear();
+	for (const auto &cookie : credentials.cookies)
+		jar.Set(kCookieDomain, cookie.first, cookie.second);
+}
+
+/* The Swift's `credentials = nil` plus `try? store.remove()`: the local login
+ * is gone either way (SC:320-324, SC:407-410). */
+void DropSession()
+{
+	g_credentials = Credentials{};
+	CredentialStore::Instance().Clear();
+	net::CookieJar::Instance().Clear();
+}
+
+/* ── the flow, shared by restore, retry and the QR success path ─────────── */
+
+/* Publish*() is private to Session, so these helpers reach it through the
+ * lambdas Session::Start installs — the counterpart of the CoreBridge that
+ * `livehime_core_start` creates before any other entry point can run
+ * (CB:144-158). Stop() clears them, which is `CoreBridge.shared = nil`. */
+struct Hooks {
+	std::function<void(const std::string &url, bool scanned)> qr;
+	std::function<void()> verifying;
+	std::function<void(long long mid, const std::string &username, const live::RoomInfo &room)> ready;
+	std::function<void(Notice notice, const std::string &detail)> failed;
+	std::function<void(Notice notice)> signed_out;
+	/* SC:380-381 saves before verifying; false means failed(keychain) is out. */
+	std::function<bool(const Credentials &credentials)> persist;
+};
+
+Hooks g_hooks;
+
+/* SessionCoordinator.verify (SC:395-415), shared by all three entry points
+ * that can end up with credentials. */
+void Verify(Credentials saved, unsigned token)
+{
+	/* CONTRACT §7's order: apply cookies, then nav, then the room. */
+	ApplyCredentials(saved);
+	g_credentials = std::move(saved);
+	g_hooks.verifying();
+
+	live::FetchIdentity([token](live::Result<live::Identity> identity) {
+		if (token != g_generation)
+			return;
+		if (!identity.ok) {
+			if (identity.error.logged_out) {
+				DropSession();
+				g_hooks.signed_out(Notice::SessionExpired);
+				return;
+			}
+			g_hooks.failed(NoticeFor(identity.error), DetailFor(identity.error));
+			return;
+		}
+		/* SC:399: `guard identity.isLogin else { throw .notLoggedIn }`. */
+		if (!identity.value.logged_in) {
+			DropSession();
+			g_hooks.signed_out(Notice::SessionExpired);
+			return;
+		}
+		/* BilibiliControlClient.swift:81-85: nav without a positive mid is
+		 * invalidResponse, which the Swift mapped to failed(server) — not to a
+		 * sign-out — and the room lookup must not be attempted with it. */
+		if (identity.value.mid <= 0) {
+			g_hooks.failed(Notice::Server, "invalidResponse: nav reported no mid");
+			return;
+		}
+
+		const long long mid = identity.value.mid;
+		const std::string username = identity.value.username;
+		live::FetchRoom(mid, [token, mid, username](live::Result<live::RoomInfo> room) {
+			if (token != g_generation)
+				return;
+			if (!room.ok) {
+				if (room.error.logged_out) {
+					DropSession();
+					g_hooks.signed_out(Notice::SessionExpired);
+					return;
+				}
+				/* SC:411-413: everything else stays failed with the login
+				 * kept — a missing room included (SC:425-426). */
+				g_hooks.failed(NoticeFor(room.error), DetailFor(room.error));
+				return;
+			}
+			/* SC:402-403: identity AND room are both known before ready. */
+			g_hooks.ready(mid, username, room.value);
+		});
+	});
+}
+
+void RequestQr(unsigned token);
+void PollOnce(unsigned token);
+
+/* SC:366-367: ask for a code, show it, then poll it. */
+void RequestQr(unsigned token)
+{
+	GenerateQr([token](bool ok, const std::string &url, const std::string &key, const live::ApiError &error) {
+		if (token != g_generation)
+			return;
+		if (!ok) {
+			g_hooks.failed(NoticeFor(error), DetailFor(error));
+			return;
+		}
+
+		g_qr_url = url;
+		g_qr_key = key;
+		g_hooks.qr(url, false);
+		ScheduleTick(kPollIntervalMs, [token]() { PollOnce(token); });
+	});
+}
+
+/* SC:368-385: the poll loop. Each answer either keeps waiting, reports the
+ * scan, replaces the code, gives up, or hands the session to verify. */
+void PollOnce(unsigned token)
+{
+	const std::string key = g_qr_key;
+	PollQr(key, [token](const QrPollResult &result) {
+		if (token != g_generation)
+			return;
+
+		switch (result.kind) {
+		case QrPoll::WaitingForScan:
+			/* SC:371-372: nothing to say yet. */
+			break;
+		case QrPoll::Scanned:
+			/* SC:373-374: the same code, now scanned once. PublishQr drops
+			 * the repeat if the server says it again. */
+			g_hooks.qr(g_qr_url, true);
+			break;
+		case QrPoll::Expired:
+			/* SC:375-378: not the first two expiries — replace the code;
+			 * after kMaxAutoRefresh of them, give up with qrExpired. */
+			if (g_qr_refreshes >= kMaxAutoRefresh) {
+				g_hooks.signed_out(Notice::QrExpired);
+				return;
+			}
+			++g_qr_refreshes;
+			RequestQr(token);
+			return;
+		case QrPoll::Succeeded:
+			/* SC:379-383: save first; a refused save is failed(keychain),
+			 * and the login is not verified. */
+			if (!g_hooks.persist(result.credentials))
+				return;
+			Verify(result.credentials, token);
+			return;
+		case QrPoll::Failed:
+			/* SC:387-392: a cancelled flow returned silently; a real error
+			 * is failed with the mapped notice. */
+			g_hooks.failed(NoticeFor(result.error), DetailFor(result.error));
+			return;
+		}
+
+		ScheduleTick(kPollIntervalMs, [token]() { PollOnce(token); });
+	});
+}
+
+/* ── state comparison ───────────────────────────────────────────────────── */
+
+bool SameRoom(const live::RoomInfo &left, const live::RoomInfo &right)
+{
+	return left.room_id == right.room_id && left.short_room_id == right.short_room_id && left.uid == right.uid &&
+	       left.title == right.title && left.live_status == right.live_status && left.area_id == right.area_id;
+}
+
+void Remember(Phase phase, Notice notice, const std::string &detail)
+{
+	g_phase = phase;
+	g_notice = notice;
+	g_detail = detail;
+	g_known = true;
+}
+
+bool SameState(Phase phase, Notice notice, const std::string &detail)
+{
+	return g_known && g_phase == phase && g_notice == notice && g_detail == detail;
+}
+
+} // namespace
+
+const char *StateRaw(State state)
+{
+	switch (state) {
+	case State::SignedOut:
+		return "signedOut";
+	case State::QrCode:
+		return "qrCode";
+	case State::Verifying:
+		return "verifying";
+	case State::Ready:
+		return "ready";
+	case State::Failed:
+		return "failed";
+	}
+	return "failed";
+}
+
+void Session::SetObserver(Observer observer)
+{
+	observer_ = std::move(observer);
+}
+
+void Session::Notify(State state)
+{
+	if (!observer_)
+		return;
+	/* Only ever called from the Publish* functions, which are on the main
+	 * thread and only after the state actually changed, so this is the same
+	 * "the session moved" signal CBridge.swift:40-52 reacts to. */
+	observer_(state, account_.room.room_id, account_.mid);
+}
+
+const char *NoticeRaw(Notice notice)
+{
+	/* SessionCoordinator.swift:10-18, emitted as the raw strings CONTRACT §4.1
+	 * lists. Notice::None is the "no notice" of signedOut(nil), which has no
+	 * failed-state spelling. */
+	switch (notice) {
+	case Notice::SessionExpired:
+		return "sessionExpired";
+	case Notice::LegacyNeedsLogin:
+		return "legacyNeedsLogin";
+	case Notice::QrExpired:
+		return "qrExpired";
+	case Notice::NoLiveRoom:
+		return "noLiveRoom";
+	case Notice::Network:
+		return "network";
+	case Notice::Server:
+		return "server";
+	case Notice::Keychain:
+		return "keychain";
+	case Notice::None:
+		break;
+	}
+	return "";
+}
+
+Session &Session::Instance()
+{
+	static Session session;
+	return session;
+}
+
+void Session::Start(const std::string &credential_service)
+{
+	credential_service_ = credential_service.empty() ? kDefaultService : credential_service;
+	CredentialStore::Instance().SetService(credential_service_);
+
+	Retire();
+	g_credentials = Credentials{};
+	g_qr_url.clear();
+	g_qr_key.clear();
+	g_qr_refreshes = 0;
+	ready_ = false;
+	account_ = Account{};
+	g_known = false; /* CB:156 publishes the initial state unconditionally */
+
+	/* The publish hooks can only be built here: Publish*() is private, and a
+	 * member function's lambda may call it (see the Hooks comment above). */
+	g_hooks = Hooks{};
+	g_hooks.qr = [this](const std::string &url, bool scanned) { PublishQr(url, scanned); };
+	g_hooks.verifying = [this]() { PublishVerifying(); };
+	g_hooks.ready = [this](long long mid, const std::string &username, const live::RoomInfo &room) {
+		account_.mid = mid;
+		account_.username = username;
+		account_.room = room;
+		PublishReady();
+	};
+	g_hooks.failed = [this](Notice notice, const std::string &detail) { PublishFailed(notice, detail); };
+	g_hooks.signed_out = [this](Notice notice) { PublishSignedOut(notice); };
+	g_hooks.persist = [this](const Credentials &credentials) {
+		g_credentials = credentials;
+		g_credentials.saved_at = static_cast<long long>(std::time(nullptr)) - kReferenceDateUnix;
+		PersistSession();
+		return g_persist_ok;
+	};
+
+	/* CB:156-157: publish, then restore. A saved login turns this into
+	 * verifying and then ready or failed; with nothing saved, signedOut is the
+	 * only state the UI ever sees. */
+	PublishSignedOut(Notice::None);
+	RestoreSession();
+}
+
+void Session::Stop()
+{
+	/* CB:163-169 clears the callback before cancelling the poll, so nothing is
+	 * published on the way out; the stored login stays in the vault and the
+	 * next Start restores it. */
+	Retire();
+	g_hooks = Hooks{};
+	g_credentials = Credentials{};
+	g_qr_url.clear();
+	g_qr_key.clear();
+	g_qr_refreshes = 0;
+	ready_ = false;
+	account_ = Account{};
+	g_phase = Phase::SignedOut;
+	g_notice = Notice::None;
+	g_detail.clear();
+	g_known = false;
+	net::CookieJar::Instance().Clear();
+}
+
+void Session::StartQrLogin()
+{
+	/* The Swift's `CoreBridge.shared?.coordinator` guard: no core has been
+	 * started, so there is no bridge to run a flow through. */
+	if (!g_hooks.qr)
+		return;
+
+	/* SC:361-362. The jar goes with the credentials, because our requests read
+	 * cookies from the jar: "credentials = nil" has to mean "no cookies", or
+	 * the QR generate/poll calls would carry an old session's — the Swift's
+	 * QR session sent none at all (QR:57,127-133). */
+	const unsigned token = Retire();
+	g_credentials = Credentials{};
+	net::CookieJar::Instance().Clear();
+	g_qr_refreshes = 0;
+	g_qr_key.clear();
+	RequestQr(token);
+}
+
+void Session::CancelQrLogin()
+{
+	/* SC:116-120: stopping the poll is not a sign-out. Only a QR code on
+	 * screen turns back into signedOut; anything else keeps its state. */
+	Retire();
+	if (g_phase == Phase::QrCode)
+		PublishSignedOut(Notice::None);
+}
+
+void Session::Retry()
+{
+	if (!g_hooks.qr)
+		return;
+
+	const unsigned token = Retire();
+	const StoredSession stored = LoadStoredSession();
+	/* SC:124-132: only the current envelope is re-verified — complete or not,
+	 * which is what `if case .current` matched — and everything else (absent,
+	 * legacy, unreadable) starts a new QR login. */
+	if (stored.kind == StoredKind::Current) {
+		Verify(stored.credentials, token);
+		return;
+	}
+	StartQrLogin();
+}
+
+void Session::SignOut()
+{
+	/* SC:134-154. */
+	Retire();
+	g_credentials = Credentials{};
+	ready_ = false;
+	account_ = Account{};
+	net::CookieJar::Instance().Clear();
+
+	if (!CredentialStore::Instance().Clear()) {
+		PublishFailed(Notice::Keychain, kRemoveFailedDetail);
+		return;
+	}
+	PublishSignedOut(Notice::None);
+
+	/* SC:148-153 also ended the login on Bilibili's side (A10,
+	 * login/exit/v2), best effort. The port has no SessionMaintenance — no
+	 * logout call exists in live/liveclient.h — so the login is removed
+	 * locally and stays valid on Bilibili's side until it expires. That is a
+	 * gap, not a success. */
+}
+
+void Session::RefreshRoom()
+{
+	/* SC:303-308: only a ready account, and a failure leaves the current
+	 * account untouched. */
+	if (!ready_ || g_phase != Phase::Ready)
+		return;
+
+	const unsigned token = g_generation;
+	const long long mid = account_.mid;
+	const long long room_id = account_.room.room_id;
+	live::FetchRoomInfo(room_id, [this, token, mid](live::Result<live::RoomInfo> room) {
+		/* The Swift re-checked the state after the await (SC:306). */
+		if (token != g_generation || !ready_ || account_.mid != mid)
+			return;
+		if (!room.ok)
+			return;
+		account_.room = room.value;
+		PublishReady();
+	});
+}
+
+void Session::MarkSignedOut(Notice notice)
+{
+	/* SC:320-324 (guarded) and SC:407-410 (verify): the live layer saw -101.
+	 * `try? store.remove()` — a failure here does not change the outcome. */
+	Retire();
+	g_credentials = Credentials{};
+	ready_ = false;
+	account_ = Account{};
+	CredentialStore::Instance().Clear();
+	net::CookieJar::Instance().Clear();
+	PublishSignedOut(notice);
+}
+
+void Session::PublishSignedOut(Notice notice)
+{
+	ready_ = false;
+	account_ = Account{};
+
+	if (SameState(Phase::SignedOut, notice, std::string()))
+		return;
+	Remember(Phase::SignedOut, notice, std::string());
+
+	json object{{"state", "signedOut"}};
+	if (notice != Notice::None)
+		object["notice"] = NoticeRaw(notice);
+	Emit(object);
+	Notify(State::SignedOut);
+}
+
+void Session::PublishFailed(Notice notice, const std::string &detail)
+{
+	ready_ = false;
+	account_ = Account{};
+
+	if (SameState(Phase::Failed, notice, detail))
+		return;
+	Remember(Phase::Failed, notice, detail);
+
+	Emit(json{{"state", "failed"}, {"notice", NoticeRaw(notice)}, {"detail", detail}});
+	Notify(State::Failed);
+}
+
+void Session::PublishVerifying()
+{
+	/* SC:396: the account is not available while the login is being checked —
+	 * `readyAccount()` throws notReady for the whole verification. */
+	ready_ = false;
+	account_ = Account{};
+
+	if (SameState(Phase::Verifying, Notice::None, std::string()))
+		return;
+	Remember(Phase::Verifying, Notice::None, std::string());
+
+	Emit(json{{"state", "verifying"}});
+	Notify(State::Verifying);
+}
+
+void Session::PublishReady()
+{
+	ready_ = true;
+	const bool unchanged = SameState(Phase::Ready, Notice::None, std::string()) && g_ready_mid == account_.mid &&
+			       g_ready_username == account_.username && SameRoom(g_ready_room, account_.room);
+	g_ready_mid = account_.mid;
+	g_ready_username = account_.username;
+	g_ready_room = account_.room;
+	Remember(Phase::Ready, Notice::None, std::string());
+
+	if (unchanged)
+		return;
+
+	/* CB:115-123, field for field. */
+	Emit(json{{"state", "ready"},
+		  {"mid", account_.mid},
+		  {"username", account_.username},
+		  {"roomId", account_.room.room_id},
+		  {"shortRoomId", account_.room.short_room_id},
+		  {"title", account_.room.title},
+		  {"liveStatus", account_.room.live_status},
+		  {"areaId", account_.room.area_id}});
+	Notify(State::Ready);
+}
+
+void Session::PublishQr(const std::string &url, bool scanned)
+{
+	ready_ = false;
+	account_ = Account{};
+
+	const bool unchanged =
+		SameState(Phase::QrCode, Notice::None, std::string()) && g_qr_published_url == url &&
+		g_qr_published_scanned == scanned;
+	g_qr_published_url = url;
+	g_qr_published_scanned = scanned;
+	Remember(Phase::QrCode, Notice::None, std::string());
+
+	if (unchanged)
+		return;
+
+	/* CB:109-112. `scanned` is always present; qrPng only when the code
+	 * encoded, because a wrong or empty image is worse than none — the UI
+	 * shows the hint text and the user is not invited to scan a blank. */
+	json object{{"state", "qrCode"}};
+	object["scanned"] = scanned;
+	const std::string png = qr::PngBase64(url);
+	if (!png.empty())
+		object["qrPng"] = png;
+	Emit(object);
+	Notify(State::QrCode);
+}
+
+void Session::PersistSession()
+{
+	/* CredentialStore.swift:83-98 through the opaque blob credentials.h
+	 * describes. A failure is the Swift's CredentialStoreError: the state
+	 * becomes failed(keychain) and the caller stops (SC:380-381). */
+	g_persist_ok = CredentialStore::Instance().Save(EncodeBlob(g_credentials));
+	if (!g_persist_ok)
+		PublishFailed(Notice::Keychain, kSaveFailedDetail);
+}
+
+bool Session::RestoreSession()
+{
+	const unsigned token = g_generation;
+
+	std::string blob;
+	if (!CredentialStore::Instance().Load(blob) || blob.empty())
+		return false; /* .none: the initial signedOut is all the UI hears */
+
+	const StoredSession stored = DecodeBlob(blob);
+	switch (stored.kind) {
+	case StoredKind::None:
+		return false; /* unknown data is treated as signed out (CS:48-50) */
+	case StoredKind::Current:
+		/* SC:347-348. The cookie jar is filled before nav. */
+		Verify(stored.credentials, token);
+		return true;
+	case StoredKind::Legacy:
+		/* SC:349-357: the v0.1.2 record held a refresh token and the rest of
+		 * the login lived in the old app's WebKit cookie store. Windows has
+		 * no such store to import from, so the import yields nothing and the
+		 * Swift's own "migration incomplete" branch is the one that runs. */
+		PublishVerifying();
+		PublishSignedOut(Notice::LegacyNeedsLogin);
+		return true;
+	}
+	return false;
+}
+
+} // namespace auth
+} // namespace livehime
