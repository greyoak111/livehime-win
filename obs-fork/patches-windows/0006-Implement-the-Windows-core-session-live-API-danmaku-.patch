+/* GET /xlive/web-room/v1/index/getDanmuInfo — WBI-signed. Fills host/port/token
+ * for the danmaku client. */
+void FetchDanmakuInfo(long long room_id, long long uid, DanmakuInfoFn done)
+{
+	/* LiveRoomActions.swift:59-75: buvid3, then the WBI keys, then the signed
+	 * request, all with the same cookies. */
+	EnsureBuvid3([room_id, uid, done](const ApiError &buvid_error) {
+		if (Failed(buvid_error)) {
+			Deliver(done, Fail<DanmakuConnectInfo>(buvid_error));
+			return;
+		}
+		EnsureWbiSigner([room_id, uid, done](std::optional<net::WbiSigner> signer,
+						     const ApiError &signer_error) {
+			if (!signer) {
+				Deliver(done, Fail<DanmakuConnectInfo>(signer_error));
+				return;
+			}
+			const std::string query = signer->SignQuery(
+				{{"id", std::to_string(room_id)}, {"type", "0"}, {"web_location", "444.8"}});
+			net::Request req;
+			req.url = net::AppendQuery(kDanmuInfoUrl, query);
+			ApplyLiveHeaders(req);
+			RequestJson(req, [room_id, uid, done](const json &root, const ApiError &error) {
+				if (Failed(error)) {
+					Deliver(done, Fail<DanmakuConnectInfo>(error));
+					return;
+				}
+				const json data = DataObject(root);
+				const json *hosts = ObjectArrayField(data, "host_list");
+				auto token = FieldString(data, {"token"});
+				if (!data.is_object() || !hosts || !token) {
+					Deliver(done, Fail<DanmakuConnectInfo>(ServerFailure("invalidResponse")));
+					return;
+				}
+				/* The Swift keeps every host (DanmakuConnectInfo.servers,
+				 * LiveRoomActions.swift:69-74) and picks one at random when
+				 * it connects (DanmakuClient.swift:58); this struct holds one,
+				 * so the first entry that names a host is reported. */
+				DanmakuConnectInfo info;
+				info.token = *token;
+				info.room_id = room_id;
+				info.uid = uid;
+				bool found = false;
+				for (const json &host : *hosts) {
+					auto name = FieldString(host, {"host"});
+					if (!name)
+						continue;
+					info.host = *name;
+					/* `(host["wss_port"] as? NSNumber)?.intValue ?? 443`:
+					 * 443 only when the field is absent or not a number. */
+					info.port = 443;
+					if (const json *port = FieldValue(host, {"wss_port"})) {
+						if (port->is_number() || port->is_boolean())
+							info.port = IntValueInt(*port);
+					}
+					found = true;
+					break;
+				}
+				if (!found) {
+					Deliver(done, Fail<DanmakuConnectInfo>(ServerFailure("invalidResponse")));
+					return;
+				}
+				Deliver(done, Ok(info));
+			});
+		});
+	});
+}
