diff --git a/plugins/livehime/core/win/live/danmaku.cpp b/plugins/livehime/core/win/live/danmaku.cpp
new file mode 100644
index 0000000..87063b4
--- /dev/null
+++ b/plugins/livehime/core/win/live/danmaku.cpp
@@ -0,0 +1,1388 @@
+/* Danmaku WebSocket client for the Windows core — the port of
+ * DanmakuClient.swift + DanmakuProtocol.swift (macOS).
+ *
+ * The wire format is the 16-byte big-endian frame of DanmakuProtocol.swift:23-35
+ * (see EncodePacket for the byte offsets), carried inside WinHTTP WebSocket
+ * messages: wss://<host>:<wss_port>/sub, one auth packet (operation 7), a
+ * heartbeat every 30 s (operation 2) and JSON commands in operation-5 frames.
+ *
+ * Where this file deliberately differs from the Swift, and why:
+ *
+ *   1. `kProtoVersion` — the auth packet asks for protover 2 (zlib) instead of
+ *      the Swift's 3 (brotli). No brotli decoder exists in this tree or in
+ *      obs-deps, so protocol-version-3 containers cannot be decoded; asking for
+ *      zlib keeps the danmaku working and the version-3 path is an explicit,
+ *      named failure. The constant's comment has the full story.
+ *   2. A danmaku frame may straddle WebSocket messages. WinHTTP hands the
+ *      application fragments, so this port keeps a byte accumulator and decodes
+ *      every complete frame, instead of decoding each message on its own and
+ *      silently discarding a truncated tail the way DanmakuProtocol.swift:41-44
+ *      does (docs/port-spec/danmaku-protocol.md §9.3 asks for the accumulator).
+ *   3. A container or frame this build cannot decode produces one
+ *      {"event":"unsupported",...} event naming the cause. The Swift's failure
+ *      path emits nothing at all (DMP:48-53,126), which is a silent feed that
+ *      claims to be connected — the fabricated success CONTRACT §9 forbids.
+ *   4. `room_id_` is the one member danmaku.h declares; the handlers, the
+ *      WinHTTP handles, the worker thread and the receive accumulator are all
+ *      file-local to this translation unit.
+ *
+ * cites: DMC = core/Sources/LiveHimeCore/DanmakuClient.swift,
+ *        DMP = core/Sources/LiveHimeCore/DanmakuProtocol.swift,
+ *        LRA = core/Sources/LiveHimeCore/LiveRoomActions.swift,
+ *        CONTRACT = docs/port-spec/CONTRACT.md,
+ *        docs/port-spec/danmaku-protocol.md = the byte-level protocol spec. */
+
+#include "danmaku.h"
+
+#include "liveclient.h"
+#include "../net/crypto.h"
+#include "../platform/dispatch.h"
+
+#include <windows.h>
+#include <winhttp.h>
+#include <zlib.h>
+
+#include <algorithm>
+#include <atomic>
+#include <charconv>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace livehime {
+namespace live {
+namespace {
+
+using nlohmann::json;
+
+/* danmaku.h nests the handler types in the class, so the file-local helpers
+ * below name them through the class once here. */
+using EventFn = DanmakuClient::EventFn;
+using StatusFn = DanmakuClient::StatusFn;
+
+
+/* ── protocol constants (DanmakuProtocol.swift) ─────────────────────────── */
+
+constexpr std::uint16_t kHeaderLength = 16; /* DMP:23 */
+/* Every packet this client sends carries version 1 (DMP:25). Received versions
+ * are only inspected by the compression branch below (DMP:48). */
+constexpr std::uint16_t kSendProtocolVersion = 1;
+/* The decoder never reads the sequence field (DMP:45-47); 1 is what the Swift
+ * writes (DMP:32). */
+constexpr std::uint32_t kSequence = 1;
+
+constexpr std::uint16_t kVersionZlib = 2;   /* DMP:48-49, RFC1950 body */
+constexpr std::uint16_t kVersionBrotli = 3; /* DMP:49, raw brotli body */
+
+/* The auth packet's protover. DanmakuClient.swift:66 hard-codes 3, and the
+ * server then answers with brotli (protocol version 3) containers. Brotli is
+ * genuinely required for that: the body is a raw brotli stream with no prefix
+ * (docs/port-spec §5.2), there is no brotli decoder anywhere in this tree, in
+ * obs-deps or in Windows itself, and the plugin links none. Rather than send 3
+ * and deliver a feed that can never decode a message, this port asks for
+ * protover 2 — zlib, the long-standing default, whose path below is implemented
+ * in full. A version-3 container that arrives anyway is reported honestly by
+ * Inflate()/ReportFailures(); it is never dropped in silence.
+ *
+ * This is the one deliberate protocol deviation in this file. Once brotli is
+ * vendored and Inflate() gains its version-3 branch, flipping this back to 3 is
+ * the only change the negotiation needs. */
+constexpr int kProtoVersion = 2;
+
+/* DMP:73 — a literal 30 s interval, no jitter. The body is the literal string
+ * "[object Object]" (DMC:72); the frame is 31 bytes. */
+constexpr char kHeartbeatBody[] = "[object Object]";
+constexpr auto kHeartbeatInterval = std::chrono::seconds(30);
+
+/* The receive timeout doubles as this loop's tick. One thread owns the socket
+ * for its whole life and WinHTTP cannot send while a receive is parked, so the
+ * receive has to return regularly for the heartbeat to go out on time: with a
+ * 5 s tick a heartbeat is at most 5 s behind its 30 s deadline and never early.
+ * Between messages a tick means "nothing arrived"; in the middle of a
+ * fragmented message it means the peer stalled, and the session ends the way
+ * any other transport failure does. */
+constexpr auto kReceiveTick = std::chrono::seconds(5);
+
+/* Reconnect backoff (DMC:37,45). The sleep after the first failed session is
+ * 4 s, not 2: the initial value is doubled before it is used
+ * (docs/port-spec §6.2's "2, 4, 8, 16, 30" is the value sequence, the code's
+ * sleeps are 4, 8, 16, 30, 30). */
+constexpr long long kBackoffInitialMs = 2000;
+constexpr long long kBackoffMaxMs = 30000;
+constexpr long long kBackoffResetAfterMs = 60000;
+
+/* Safety net for the wait on FetchDanmakuInfo's main-thread answer; see
+ * FetchConnectInfo. net::Send always answers, so this only fires when there is
+ * no dispatcher to carry the answer at all. */
+constexpr auto kInfoWaitLimit = std::chrono::seconds(30);
+
+/* A container may nest containers (docs/port-spec §5.4). The server nests one
+ * level; the cap only keeps a hostile stream from exhausting the stack. */
+constexpr std::size_t kMaxContainerDepth = 4;
+
+/* BilibiliWeb.userAgent (QRLogin.swift:134) — the string the Swift's upgrade
+ * request sends (DMC:60). Kept verbatim: this is a faithful port, and the
+ * point of the header is to look like the browser session that owns the
+ * cookies, not like the operating system the plugin runs on. */
+constexpr char kBilibiliUserAgent[] =
+	"Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Safari/605.1.15";
+
+/* Operation codes, complete set in the Swift source (DMP:10-16). */
+enum class Operation : std::uint32_t {
+	Heartbeat = 2,      /* client -> server, every 30 s */
+	HeartbeatReply = 3, /* server -> client, never handled (DMP:12) */
+	Message = 5,        /* server -> client, the only operation with events */
+	Auth = 7,           /* client -> server, once per connection */
+	AuthReply = 8,      /* server -> client, code 0 means accepted */
+};
+
+/* ── shared state ───────────────────────────────────────────────────────── */
+
+/* One connect-and-backoff run, from Start() until Stop(). Stop() cancels it:
+ * `cancelled` keeps a stopped run from reporting a status, and `websocket` is
+ * how Stop() unblocks a receive that is parked inside WinHTTP. File-local on
+ * purpose: danmaku.h keeps only `room_id_`, so WinHTTP's types stay out of every
+ * translation unit that includes it. */
+struct RunToken {
+	std::atomic<bool> cancelled{false};
+
+	/* Guards `websocket`. Stop() calls WinHttpWebSocketClose on the handle to
+	 * wake the receive; the session clears the pointer before it closes the
+	 * handle, so the handle can never be closed twice or used after closing. */
+	std::mutex socket_mutex;
+	HINTERNET websocket = nullptr;
+};
+
+struct ClientState {
+	/* Guards everything below, and is never held while a callback runs:
+	 * dispatch::Post executes inline on the main thread, and a handler is
+	 * allowed to call back into this client. */
+	std::mutex mutex;
+	EventFn on_event;
+	StatusFn on_status;
+	std::shared_ptr<RunToken> run;
+	std::thread worker;
+	/* The last status handed to dispatch::Post; Swift's `didSet` only fires the
+	 * callback when the value changes (DMC:14-16). */
+	DanmakuStatus last_status = DanmakuStatus::Stopped;
+	/* InjectForTest's byte stream: the same accumulator the socket keeps, so a
+	 * test can split a frame across two injections. */
+	std::string test_buffer;
+};
+
+ClientState g_client;
+
+/* ── delivering results on the main thread ──────────────────────────────── */
+
+/* Sends one room event (CONTRACT §4.2) through the client's handler, on the
+ * main thread. The handler is copied under the lock but invoked outside it:
+ * dispatch::Post runs the call inline when the caller is already the main
+ * thread. */
+void PostEvent(const json &event)
+{
+	EventFn handler;
+	{
+		std::lock_guard<std::mutex> lock(g_client.mutex);
+		handler = g_client.on_event;
+	}
+	if (!handler)
+		return;
+	dispatch::Post([handler, event]() { handler(event); });
+}
+
+/* Posts `status` unless the last posted status is already that value, and
+ * unless the run that asked for it has been stopped in the meantime. `token`
+ * is null only for Stop()'s own write, which is final. */
+void PostStatus(DanmakuStatus status, const std::shared_ptr<RunToken> &token)
+{
+	StatusFn handler;
+	{
+		std::lock_guard<std::mutex> lock(g_client.mutex);
+		if (token && token->cancelled.load())
+			return;
+		if (g_client.last_status == status)
+			return;
+		g_client.last_status = status;
+		handler = g_client.on_status;
+	}
+	if (!handler)
+		return;
+	dispatch::Post([handler, status, token]() {
+		/* Checked again at delivery: Stop() may have queued .stopped after
+		 * this one, and the worker's last write must never win. */
+		if (token && token->cancelled.load())
+			return;
+		handler(status);
+	});
+}
+
+/* ── the wire format (DanmakuProtocol.swift:23-57) ──────────────────────── */
+
+std::uint16_t ReadU16(const std::string &data, std::size_t offset)
+{
+	return static_cast<std::uint16_t>((static_cast<std::uint16_t>(static_cast<std::uint8_t>(data[offset])) << 8) |
+					  static_cast<std::uint8_t>(data[offset + 1]));
+}
+
+std::uint32_t ReadU32(const std::string &data, std::size_t offset)
+{
+	return (static_cast<std::uint32_t>(static_cast<std::uint8_t>(data[offset])) << 24) |
+	       (static_cast<std::uint32_t>(static_cast<std::uint8_t>(data[offset + 1])) << 16) |
+	       (static_cast<std::uint32_t>(static_cast<std::uint8_t>(data[offset + 2])) << 8) |
+	       static_cast<std::uint32_t>(static_cast<std::uint8_t>(data[offset + 3]));
+}
+
+void WriteU16(std::string &out, std::size_t offset, std::uint16_t value)
+{
+	out[offset] = static_cast<char>((value >> 8) & 0xFF);
+	out[offset + 1] = static_cast<char>(value & 0xFF);
+}
+
+void WriteU32(std::string &out, std::size_t offset, std::uint32_t value)
+{
+	out[offset] = static_cast<char>((value >> 24) & 0xFF);
+	out[offset + 1] = static_cast<char>((value >> 16) & 0xFF);
+	out[offset + 2] = static_cast<char>((value >> 8) & 0xFF);
+	out[offset + 3] = static_cast<char>(value & 0xFF);
+}
+
+/* One frame: exactly what DanmakuProtocol.swift:25-35 appends, in order. Byte
+ * offsets, all multi-byte fields big-endian:
+ *
+ *	0   4  u32  packet length   = 16 + body size          (DMP:28)
+ *	4   2  u16  header length   = 16                      (DMP:29)
+ *	6   2  u16  protocol version = 1 on send              (DMP:25,30)
+ *	8   4  u32  operation                                  (DMP:31)
+ *	12  4  u32  sequence        = 1                        (DMP:32)
+ *	16  …      body                                        (DMP:33)
+ *
+ * The body length is packet length - header length; there is no checksum and no
+ * magic number. The heartbeat frame this produces is the 31-byte vector of
+ * docs/port-spec §6.1 / §11.3. */
+std::string EncodePacket(Operation operation, const std::string &body, std::uint16_t version = kSendProtocolVersion)
+{
+	std::string frame(kHeaderLength + body.size(), '\0');
+	WriteU32(frame, 0, static_cast<std::uint32_t>(kHeaderLength + body.size()));
+	WriteU16(frame, 4, kHeaderLength);
+	WriteU16(frame, 6, version);
+	WriteU32(frame, 8, static_cast<std::uint32_t>(operation));
+	WriteU32(frame, 12, kSequence);
+	if (!body.empty())
+		std::memcpy(&frame[kHeaderLength], body.data(), body.size());
+	return frame;
+}
+
+/* A decoded frame (DMP:45-47). `version` and `operation` are kept even though
+ * only the compression branch and the event parser read them. */
+struct Frame {
+	std::uint16_t version = 0;
+	std::uint32_t operation = 0;
+	std::string body;
+};
+
+/* Something this build could not decode. `what` names the cause for the
+ * {"event":"unsupported"} report; `detail` is the human-readable sentence. */
+struct DecodeFailure {
+	std::string what;
+	std::string detail;
+};
+
+struct DecodeOutcome {
+	/* Bytes that formed complete frames and may be dropped from the front of
+	 * the caller's buffer. */
+	std::size_t consumed = 0;
+	/* Decoded frames, containers already expanded, in stream order. */
+	std::vector<Frame> frames;
+	/* One entry per container or frame that could not be decoded. */
+	std::vector<DecodeFailure> failures;
+	/* True when the bytes cannot be a frame stream at all (a length field that
+	 * cannot be honoured): the caller must drop the whole buffer, because there
+	 * is no way to find the next boundary. */
+	bool corrupt = false;
+};
+
+/* Protocol version 2: RFC1950 zlib. The body is
+ * [2-byte zlib header][raw DEFLATE][4-byte Adler-32]; the Swift strips the
+ * header and the trailer and runs a raw-deflate decoder (DMP:69-71), so this
+ * does the same and hands inflate() raw DEFLATE via windowBits -15. The
+ * grow-and-retry loop mirrors DMP:74-87: start at max(4096, 8x input), retry
+ * four times larger while the output fills the buffer, stop at 64 MiB. */
+bool InflateZlib(const std::string &body, std::string &inflated, DecodeFailure &failure)
+{
+	failure.what = "danmaku_inflate";
+
+	/* DMP:70 — bodies of six bytes or fewer never inflate. */
+	if (body.size() <= 6) {
+		failure.detail = "zlib container is too short to hold a 2-byte header and a 4-byte Adler-32 (" +
+				 std::to_string(body.size()) + " bytes)";
+		return false;
+	}
+	const std::string input = body.substr(2, body.size() - 6);
+	if (input.size() > 0xFFFFFFFFu) {
+		failure.detail = "zlib container is larger than the inflate window can address";
+		return false;
+	}
+
+	z_stream stream = {};
+	if (inflateInit2(&stream, -15) != Z_OK) {
+		failure.detail = "zlib could not start an inflate stream";
+		return false;
+	}
+
+	const std::size_t ceiling = static_cast<std::size_t>(64) << 20; /* DMP:75 */
+	std::size_t capacity = std::max<std::size_t>(4096, input.size() * 8);
+	bool ok = false;
+	for (;;) {
+		if (capacity > ceiling) {
+			failure.detail = "zlib output exceeded the 64 MiB ceiling";
+			break;
+		}
+		std::string output(capacity, '\0');
+		stream.next_in = reinterpret_cast<Bytef *>(const_cast<char *>(input.data()));
+		stream.avail_in = static_cast<uInt>(input.size());
+		stream.next_out = reinterpret_cast<Bytef *>(&output[0]);
+		stream.avail_out = static_cast<uInt>(capacity);
+
+		const int rc = inflate(&stream, Z_FINISH);
+		const std::size_t written = capacity - stream.avail_out;
+		if (rc == Z_STREAM_END) {
+			inflated.assign(output, 0, written);
+			ok = true;
+			break;
+		}
+		if (rc != Z_OK && rc != Z_BUF_ERROR) {
+			failure.detail = "zlib inflate failed (zlib " + std::to_string(rc) + ")";
+			break;
+		}
+		/* Apple's decode_buffer returns 0 for a stream that produced nothing,
+		 * and DMP:83 turns that into a failure; mirrors it here. */
+		if (written == 0) {
+			failure.detail = "zlib inflate produced no output";
+			break;
+		}
+		/* The output filled the buffer, so it may have been truncated: start
+		 * over with four times the room (DMP:85). */
+		if (inflateReset(&stream) != Z_OK) {
+			failure.detail = "zlib refused to restart the inflate stream";
+			break;
+		}
+		capacity *= 4;
+	}
+	inflateEnd(&stream);
+	return ok;
+}
+
+/* Decompresses an operation-5 container. Version 3 is brotli, for which this
+ * build has no decoder at all — no guessed decoding, no silent pass-through:
+ * the caller reports the named failure. */
+bool Inflate(std::uint16_t version, const std::string &body, std::string &inflated, DecodeFailure &failure)
+{
+	if (version == kVersionBrotli) {
+		failure.what = "danmaku_brotli";
+		failure.detail = "brotli container (protocol version 3): no brotli decoder is linked into "
+				 "this build, so this message cannot be decoded";
+		return false;
+	}
+	return InflateZlib(body, inflated, failure);
+}
+
+DecodeOutcome DecodeStream(const std::string &buffer, std::size_t depth);
+
+/* One frame's turn through the decode rules of DMP:48-53: an operation-5
+ * version-2/3 frame is a container whose inflated body is a frame stream, and
+ * everything else is a packet. A container that fails to inflate is *not*
+ * dropped: it becomes a failure the caller reports, which is where this port
+ * parts ways with the Swift's silent pass-through. */
+void Expand(const Frame &frame, std::size_t depth, DecodeOutcome &out)
+{
+	const bool container = frame.operation == static_cast<std::uint32_t>(Operation::Message) &&
+			       (frame.version == kVersionZlib || frame.version == kVersionBrotli);
+	if (!container) {
+		out.frames.push_back(frame);
+		return;
+	}
+	if (depth >= kMaxContainerDepth) {
+		out.failures.push_back({"danmaku_frame", "compressed containers nested deeper than " +
+								 std::to_string(kMaxContainerDepth) + " levels"});
+		return;
+	}
+
+	std::string inflated;
+	DecodeFailure failure;
+	if (!Inflate(frame.version, frame.body, inflated, failure)) {
+		out.failures.push_back(std::move(failure));
+		return;
+	}
+
+	/* The inflated bytes are a packet stream, not a bare JSON blob (DMP:50). */
+	DecodeOutcome inner = DecodeStream(inflated, depth + 1);
+	out.frames.insert(out.frames.end(), std::make_move_iterator(inner.frames.begin()),
+			  std::make_move_iterator(inner.frames.end()));
+	out.failures.insert(out.failures.end(), std::make_move_iterator(inner.failures.begin()),
+			    std::make_move_iterator(inner.failures.end()));
+	if (inner.corrupt)
+		out.failures.push_back({"danmaku_frame", "a decompressed container did not hold a valid frame stream"});
+}
+
+/* Walks every *complete* frame in `buffer`. The Swift walks one WebSocket
+ * message and stops at a truncated tail, dropping it (DMP:41-44); this leaves
+ * the tail in the caller's accumulator instead, so a frame split across
+ * messages still arrives (docs/port-spec §9.3). Returns what was decoded and
+ * how many bytes that consumed. */
+DecodeOutcome DecodeStream(const std::string &buffer, std::size_t depth = 0)
+{
+	DecodeOutcome out;
+	std::size_t offset = 0;
+	while (buffer.size() - offset >= kHeaderLength) {
+		const std::uint32_t length = ReadU32(buffer, offset);
+		const std::uint16_t header = ReadU16(buffer, offset + 4);
+		if (length < header || header < kHeaderLength) {
+			/* DMP:44 breaks out and drops the rest. Nothing can resynchronise
+			 * a stream with no magic number, so the caller drops the buffer —
+			 * and says so, instead of going quiet. */
+			out.corrupt = true;
+			out.failures.push_back({"danmaku_frame",
+						"frame header is impossible (packet length " + std::to_string(length) +
+							", header length " + std::to_string(header) + ")"});
+			break;
+		}
+		if (length > buffer.size() - offset)
+			break; /* incomplete: keep it for the next message */
+
+		Frame frame;
+		frame.version = ReadU16(buffer, offset + 6);
+		frame.operation = ReadU32(buffer, offset + 8);
+		frame.body.assign(buffer, offset + header, length - header);
+		Expand(frame, depth, out);
+		offset += length;
+	}
+	out.consumed = offset;
+	return out;
+}
+
+/* ── JSON reading, with the Swift's coercions ───────────────────────────── */
+
+const json &Nothing()
+{
+	static const json nothing;
+	return nothing;
+}
+
+const json &Member(const json &object, const char *key)
+{
+	if (!object.is_object())
+		return Nothing();
+	const auto it = object.find(key);
+	return it == object.end() ? Nothing() : *it;
+}
+
+/* Array element, or null when the index is out of range. */
+const json &Element(const json &array, std::size_t index)
+{
+	if (!array.is_array() || index >= array.size())
+		return Nothing();
+	return array[index];
+}
+
+/* Swift's Int(String): an optional sign and digits, the whole string, no
+ * spaces, and nothing that does not fit in Int64 (DMP:205,209). */
+std::int64_t ParseInteger(const std::string &text)
+{
+	const char *begin = text.data();
+	const char *end = text.data() + text.size();
+	if (begin != end && *begin == '+') /* Int("+5") == 5; from_chars wants no sign there */
+		++begin;
+	if (begin == end)
+		return 0;
+	std::int64_t value = 0;
+	const std::from_chars_result result = std::from_chars(begin, end, value);
+	if (result.ec != std::errc() || result.ptr != end)
+		return 0;
+	return value;
+}
+
+/* DanmakuParser.int / int64 (DMP:204-210): an NSNumber — which is what
+ * JSONSerialization makes of a JSON boolean too, so `true` is 1 — or a numeric
+ * string; anything else, including a missing field, is 0. */
+std::int64_t JsonInt(const json &value)
+{
+	if (value.is_boolean())
+		return value.get<bool>() ? 1 : 0;
+	if (value.is_number()) /* NSNumber.intValue truncates a fractional value */
+		return value.get<std::int64_t>();
+	if (value.is_string())
+		return ParseInteger(value.get_ref<const std::string &>());
+	return 0;
+}
+
+/* Swift's `as? String`; numbers, booleans and objects all fall back. */
+std::string JsonStr(const json &value)
+{
+	return value.is_string() ? value.get<std::string>() : std::string();
+}
+
+/* ── minimal protobuf reader (DMP:214-257) ──────────────────────────────── */
+
+struct ProtobufFields {
+	std::map<int, std::uint64_t> varints;
+	std::map<int, std::string> bytes;
+};
+
+bool ReadVarint(const std::vector<std::uint8_t> &data, std::size_t &index, std::uint64_t &value)
+{
+	std::uint64_t result = 0;
+	std::uint64_t shift = 0;
+	while (index < data.size() && shift < 64) {
+		const std::uint8_t byte = data[index++];
+		result |= static_cast<std::uint64_t>(byte & 0x7F) << shift;
+		if ((byte & 0x80) == 0) {
+			value = result;
+			return true;
+		}
+		shift += 7;
+	}
+	return false;
+}
+
+/* Wire types 0 (varint) and 2 (length-delimited) are kept, 1 and 5 are skipped,
+ * anything else stops the walk and returns what was collected, exactly like
+ * DMP:237-254. A repeated field keeps its last occurrence. */
+ProtobufFields ReadProtobufFields(const std::vector<std::uint8_t> &data)
+{
+	ProtobufFields fields;
+	std::size_t index = 0;
+	std::uint64_t key = 0;
+	while (index < data.size() && ReadVarint(data, index, key)) {
+		const int field = static_cast<int>(key >> 3);
+		switch (key & 7) {
+		case 0: {
+			std::uint64_t value = 0;
+			if (!ReadVarint(data, index, value))
+				return fields;
+			fields.varints[field] = value;
+			break;
+		}
+		case 2: {
+			std::uint64_t length = 0;
+			if (!ReadVarint(data, index, length))
+				return fields;
+			if (length > data.size() - index)
+				return fields;
+			fields.bytes[field] = std::string(reinterpret_cast<const char *>(data.data() + index),
+							  static_cast<std::size_t>(length));
+			index += static_cast<std::size_t>(length);
+			break;
+		}
+		case 1:
+			index += 8;
+			break;
+		case 5:
+			index += 4;
+			break;
+		default:
+			return fields;
+		}
+	}
+	return fields;
+}
+
+/* ── commands to events (DanmakuParser, DMP:130-201) ────────────────────── */
+
+/* "DANMU_MSG:4:0:2:2:2:0" dispatches as "DANMU_MSG" (DMP:133). A command with
+ * no colon is used as-is; a missing or non-string `cmd` has no name at all. */
+std::string CommandName(const json &object)
+{
+	const json &raw = Member(object, "cmd");
+	if (!raw.is_string())
+		return {};
+	const std::string &text = raw.get_ref<const std::string &>();
+	const std::size_t colon = text.find(':');
+	return colon == std::string::npos ? text : text.substr(0, colon);
+}
+
+/* InteractionKind (DMP:118-120) as the kind strings CBridge.swift:92 emits:
+ * enter stays enter, share stays share, follow/specialFollow/mutualFollow all
+ * become follow. Any other msg_type is not an event (DMP:180). */
+bool InteractionKindName(std::int64_t msg_type, std::string &kind)
+{
+	switch (msg_type) {
+	case 1:
+		kind = "enter";
+		return true;
+	case 2:
+	case 4:
+	case 5:
+		kind = "follow";
+		return true;
+	case 3:
+		kind = "share";
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* DANMU_MSG (DMP:136-165). The payload is the `info` array, not `data`. */
+bool BuildChat(const json &object, json &out)
+{
+	const json &info = Member(object, "info");
+	if (!info.is_array() || info.size() <= 2)
+		return false;
+	const json &text_value = Element(info, 1);
+	if (!text_value.is_string())
+		return false;
+	const json &user = Element(info, 2);
+	if (!user.is_array() || user.size() <= 1)
+		return false;
+
+	const std::string text = text_value.get<std::string>();
+	const std::string user_name = JsonStr(Element(user, 1));
+
+	/* medal: "<name> <int(m[0])>" only when info[3] is an array whose second
+	 * element is a non-empty string (DMP:139-142). */
+	std::string medal;
+	const json &medal_value = Element(info, 3);
+	if (medal_value.is_array() && medal_value.size() > 1 && Element(medal_value, 1).is_string() &&
+	    !Element(medal_value, 1).get_ref<const std::string &>().empty()) {
+		medal = Element(medal_value, 1).get<std::string>() + " " +
+			std::to_string(JsonInt(Element(medal_value, 0)));
+	}
+
+	/* info[0][15]["extra"] is JSON inside JSON: the danmaku id, the viewer it
+	 * replies to and its inline emoticons (DMP:147-158). */
+	const json &meta = Element(info, 0);
+	std::string dmid;
+	std::string reply_to;
+	std::map<std::string, std::string> emots;
+	if (meta.is_array() && meta.size() > 15) {
+		const json &extra = Member(Element(meta, 15), "extra");
+		if (extra.is_string()) {
+			const json fields = json::parse(extra.get_ref<const std::string &>(), nullptr, false);
+			if (!fields.is_discarded() && fields.is_object()) {
+				const std::string id = JsonStr(Member(fields, "id_str"));
+				if (!id.empty())
+					dmid = id;
+				const std::string reply_name = JsonStr(Member(fields, "reply_uname"));
+				if (!reply_name.empty())
+					reply_to = reply_name;
+				const json &codes = Member(fields, "emots");
+				if (codes.is_object()) {
+					for (auto it = codes.begin(); it != codes.end(); ++it) {
+						const std::string url = JsonStr(Member(it.value(), "url"));
+						if (!url.empty() && text.find(it.key()) != std::string::npos)
+							emots[it.key()] = url;
+					}
+				}
+			}
+		}
+	}
+
+	/* A sticker danmaku has dm_type 1 in info[0][12] and its picture in
+	 * info[0][13] (DMP:159-163). */
+	json sticker;
+	const json &meta_picture = Element(meta, 13);
+	if (meta.is_array() && meta.size() > 13 && JsonInt(Element(meta, 12)) == 1 && meta_picture.is_object()) {
+		const std::string url = JsonStr(Member(meta_picture, "url"));
+		if (!url.empty()) {
+			/* CBridge.swift:83 names these url/w/h/key. */
+			sticker = json{{"url", url},
+				       {"w", static_cast<int>(JsonInt(Member(meta_picture, "width")))},
+				       {"h", static_cast<int>(JsonInt(Member(meta_picture, "height")))},
+				       {"key", JsonStr(Member(meta_picture, "emoticon_unique"))}};
+		}
+	}
+
+	out = json{{"event", "room"},
+		   {"kind", "chat"},
+		   {"uid", JsonInt(Element(user, 0))},
+		   {"user", user_name},
+		   {"text", text}};
+	if (!medal.empty())
+		out["medal"] = medal;
+	if (!dmid.empty())
+		out["dmid"] = dmid;
+	if (!reply_to.empty())
+		out["replyTo"] = reply_to;
+	if (!emots.empty())
+		out["emots"] = emots;
+	if (!sticker.is_null())
+		out["sticker"] = sticker;
+	return true;
+}
+
+/* SEND_GIFT / SEND_GIFT_V2 (DMP:166-171). `giftName` wins over `gift_name`
+ * even when it is the empty string, because that is what `??` does. */
+json BuildGift(const json &object)
+{
+	const json &data = Member(object, "data");
+	const json &gift_name = Member(data, "giftName");
+	const std::string name = gift_name.is_string() ? gift_name.get<std::string>()
+						       : JsonStr(Member(data, "gift_name"));
+	return json{{"event", "room"},
+		    {"kind", "gift"},
+		    {"user", JsonStr(Member(data, "uname"))},
+		    {"name", name},
+		    {"count", static_cast<int>(JsonInt(Member(data, "num")))},
+		    {"paid", JsonStr(Member(data, "coin_type")) == "gold"},
+		    {"totalCoin", static_cast<int>(JsonInt(Member(data, "total_coin")))}};
+}
+
+/* SUPER_CHAT_MESSAGE (DMP:172-175); the user name is one level deeper. */
+json BuildSuperChat(const json &object)
+{
+	const json &data = Member(object, "data");
+	const json &user = Member(data, "user_info");
+	return json{{"event", "room"},
+		    {"kind", "superChat"},
+		    {"user", JsonStr(Member(user, "uname"))},
+		    {"text", JsonStr(Member(data, "message"))},
+		    {"price", static_cast<int>(JsonInt(Member(data, "price")))},
+		    {"seconds", static_cast<int>(JsonInt(Member(data, "time")))}};
+}
+
+/* GUARD_BUY (DMP:176-178); the field is `username`, not `uname`. */
+json BuildGuard(const json &object)
+{
+	const json &data = Member(object, "data");
+	return json{{"event", "room"},
+		    {"kind", "guard"},
+		    {"user", JsonStr(Member(data, "username"))},
+		    {"level", static_cast<int>(JsonInt(Member(data, "guard_level")))},
+		    {"name", JsonStr(Member(data, "gift_name"))},
+		    {"count", static_cast<int>(JsonInt(Member(data, "num")))}};
+}
+
+/* INTERACT_WORD (DMP:179-181). */
+bool BuildInteraction(const json &object, json &out)
+{
+	const json &data = Member(object, "data");
+	std::string kind;
+	if (!InteractionKindName(JsonInt(Member(data, "msg_type")), kind))
+		return false;
+	out = json{{"event", "room"}, {"kind", kind}, {"user", JsonStr(Member(data, "uname"))}};
+	return true;
+}
+
+/* INTERACT_WORD_V2 (DMP:182-186): base64 protobuf, field 5 is msg_type and
+ * field 2 is the viewer's name. */
+bool BuildInteractionV2(const json &object, json &out)
+{
+	const json &pb = Member(Member(object, "data"), "pb");
+	if (!pb.is_string())
+		return false;
+	const std::vector<std::uint8_t> bytes = crypto::Base64Decode(pb.get_ref<const std::string &>());
+	if (bytes.empty())
+		return false;
+
+	const ProtobufFields fields = ReadProtobufFields(bytes);
+	const auto kind_field = fields.varints.find(5);
+	std::string kind;
+	if (!InteractionKindName(kind_field == fields.varints.end() ? 0 : static_cast<std::int64_t>(kind_field->second),
+				 kind))
+		return false;
+
+	std::string user;
+	const auto user_field = fields.bytes.find(2);
+	if (user_field != fields.bytes.end())
+		user = user_field->second;
+	out = json{{"event", "room"}, {"kind", kind}, {"user", user}};
+	return true;
+}
+
+/* WATCHED_CHANGE / LIKE_INFO_V3_UPDATE / ONLINE_RANK_COUNT (DMP:187-192). */
+json BuildCounter(const json &object, const char *kind, const char *field)
+{
+	return json{{"event", "room"},
+		    {"kind", kind},
+		    {"value", static_cast<int>(JsonInt(Member(Member(object, "data"), field)))}};
+}
+
+/* The command table of DMP:130-201, in the Swift's order. Commands that are
+ * not in it produce nothing at all (DMP:199-200). */
+void ParseCommand(const json &object, std::vector<json> &events)
+{
+	const std::string command = CommandName(object);
+	if (command == "DANMU_MSG") {
+		json event;
+		if (BuildChat(object, event))
+			events.push_back(std::move(event));
+	} else if (command == "SEND_GIFT" || command == "SEND_GIFT_V2") {
+		events.push_back(BuildGift(object));
+	} else if (command == "SUPER_CHAT_MESSAGE") {
+		events.push_back(BuildSuperChat(object));
+	} else if (command == "GUARD_BUY") {
+		events.push_back(BuildGuard(object));
+	} else if (command == "INTERACT_WORD") {
+		json event;
+		if (BuildInteraction(object, event))
+			events.push_back(std::move(event));
+	} else if (command == "INTERACT_WORD_V2") {
+		json event;
+		if (BuildInteractionV2(object, event))
+			events.push_back(std::move(event));
+	} else if (command == "WATCHED_CHANGE") {
+		events.push_back(BuildCounter(object, "watched", "num"));
+	} else if (command == "LIKE_INFO_V3_UPDATE") {
+		events.push_back(BuildCounter(object, "likes", "click_count"));
+	} else if (command == "ONLINE_RANK_COUNT") {
+		events.push_back(BuildCounter(object, "onlineRank", "count"));
+	} else if (command == "LIVE") {
+		events.push_back(json{{"event", "room"}, {"kind", "liveStarted"}});
+	} else if (command == "PREPARING") {
+		events.push_back(json{{"event", "room"}, {"kind", "liveEnded"}});
+	} else if (command == "ROOM_CHANGE") {
+		events.push_back(json{{"event", "room"},
+				      {"kind", "roomChanged"},
+				      {"title", JsonStr(Member(Member(object, "data"), "title"))}});
+	}
+}
+
+/* DanmakuParser.events(from:) (DMP:124-128): operation 5 and a body that parses
+ * as a JSON object, otherwise no events. */
+void DispatchFrame(const Frame &frame)
+{
+	if (frame.operation != static_cast<std::uint32_t>(Operation::Message))
+		return;
+	const json object = json::parse(frame.body, nullptr, false);
+	if (object.is_discarded() || !object.is_object())
+		return;
+
+	std::vector<json> events;
+	ParseCommand(object, events);
+	for (const json &event : events)
+		PostEvent(event);
+}
+
+/* What could not be decoded is said out loud, once per container or malformed
+ * frame. CONTRACT §4.2 has no room-event kind for "undecodable" and inventing
+ * one would make the UI read a field it does not know, so the report uses the
+ * {"event":"unsupported"} shape the rest of the Windows core already uses for
+ * "this cannot be done" (livehime-core-stub.cpp), through the client's own
+ * event channel and therefore on the main thread like every other event. */
+void ReportFailures(const std::vector<DecodeFailure> &failures)
+{
+	for (const DecodeFailure &failure : failures) {
+		PostEvent(json{{"event", "unsupported"},
+			       {"status", "unsupported"},
+			       {"what", failure.what},
+			       {"detail", failure.detail}});
+	}
+}
+
+/* ── helpers the session needs ──────────────────────────────────────────── */
+
+std::wstring Widen(const std::string &utf8)
+{
+	if (utf8.empty())
+		return {};
+	const int length = MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), nullptr, 0);
+	if (length <= 0)
+		return {};
+	std::wstring wide(static_cast<std::size_t>(length), L'\0');
+	MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), static_cast<int>(utf8.size()), &wide[0], length);
+	return wide;
+}
+
+std::string Trim(const std::string &text)
+{
+	const std::size_t begin = text.find_first_not_of(" \t");
+	if (begin == std::string::npos)
+		return {};
+	const std::size_t end = text.find_last_not_of(" \t");
+	return text.substr(begin, end - begin + 1);
+}
+
+/* The auth body's `buvid` is DanmakuConnectInfo.buvid in the Swift: the buvid3
+ * cookie when there is one, otherwise the value /x/frontend/finger/spi returned
+ * (LRA:30-38,74) — which FetchDanmakuInfo puts in the jar. The cookie header
+ * rebuilt from that jar is the same one the danmaku endpoints use, so read the
+ * value back from there. Empty when the jar has none: that is what the Swift
+ * would send too, and the server's answer is the honest one (the Swift throws
+ * on it before connecting, which the Result from FetchDanmakuInfo already
+ * covers). */
+std::string BuvidFromCookies()
+{
+	const std::string header = CookieHeader();
+	std::size_t pos = 0;
+	while (pos < header.size()) {
+		const std::size_t end = header.find(';', pos);
+		const std::string pair =
+			header.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+		const std::size_t equals = pair.find('=');
+		if (equals != std::string::npos && Trim(pair.substr(0, equals)) == "buvid3")
+			return Trim(pair.substr(equals + 1));
+		if (end == std::string::npos)
+			break;
+		pos = end + 1;
+	}
+	return {};
+}
+
+/* FetchDanmakuInfo answers on the main thread (liveclient.h); the worker needs
+ * the value to carry on, so it waits on this slot. Deliberately not a
+ * std::promise: Stop() cancels the run and joins the worker, and a main thread
+ * blocked in that join can no longer run the posted callback, so the wait must
+ * be interruptible rather than tied to a future that may never be set. */
+struct InfoSlot {
+	std::mutex mutex;
+	std::condition_variable cv;
+	bool ready = false;
+	Result<DanmakuConnectInfo> value;
+};
+
+/* The token and the server list, refetched on every attempt, which is what
+ * DMC:57 does inside the session function. */
+Result<DanmakuConnectInfo> FetchConnectInfo(long long room_id, long long uid, const std::shared_ptr<RunToken> &token)
+{
+	auto slot = std::make_shared<InfoSlot>();
+	FetchDanmakuInfo(room_id, uid, [slot](Result<DanmakuConnectInfo> result) {
+		{
+			std::lock_guard<std::mutex> lock(slot->mutex);
+			slot->value = std::move(result);
+			slot->ready = true;
+		}
+		slot->cv.notify_all();
+	});
+
+	std::unique_lock<std::mutex> lock(slot->mutex);
+	const auto deadline = std::chrono::steady_clock::now() + kInfoWaitLimit;
+	while (!slot->ready && !token->cancelled.load()) {
+		if (slot->cv.wait_for(lock, std::chrono::milliseconds(100), [&slot] { return slot->ready; }))
+			break;
+		if (std::chrono::steady_clock::now() >= deadline)
+			break; /* net::Send answers exactly once, so this only fires when
+				  there is no dispatcher to answer through; a reconnect
+				  attempt must not hang on it forever. */
+	}
+	if (!slot->ready)
+		return {};
+	return slot->value;
+}
+
+/* Sends one complete WebSocket message. WinHTTP owns the framing; the
+ * *_MESSAGE_BUFFER_TYPE makes this call one whole message (docs/port-spec
+ * §9.3). */
+bool SendBinary(HINTERNET socket, const std::string &payload)
+{
+	if (!socket)
+		return false;
+	return WinHttpWebSocketSend(socket, WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE,
+				    const_cast<char *>(payload.data()),
+				    static_cast<DWORD>(payload.size())) == ERROR_SUCCESS;
+}
+
+/* The auth reply (DMC:86-91). The Swift keeps a malformed reply's session: a
+ * body that does not parse gives `reply == nil`, `int(nil) == 0`, and the guard
+ * therefore passes (docs/port-spec §2.3). Preserved on purpose — this is the
+ * Swift's behaviour, not an oversight this port may quietly fix. */
+bool AuthAccepted(const std::string &body)
+{
+	const json reply = json::parse(body, nullptr, false);
+	if (reply.is_discarded() || !reply.is_object())
+		return true;
+	return JsonInt(Member(reply, "code")) == 0;
+}
+
+/* Backoff, sliced so Stop() is never left waiting out a 30 s sleep. */
+void SleepInterruptible(std::chrono::milliseconds duration, const std::shared_ptr<RunToken> &token)
+{
+	const auto deadline = std::chrono::steady_clock::now() + duration;
+	while (!token->cancelled.load()) {
+		const auto now = std::chrono::steady_clock::now();
+		if (now >= deadline)
+			return;
+		const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now);
+		std::this_thread::sleep_for(std::min(remaining, std::chrono::milliseconds(100)));
+	}
+}
+
+/* ── one connection ─────────────────────────────────────────────────────── */
+
+/* The HTTP handles the handshake opens, closed in reverse order on every path.
+ * The WebSocket handle is not here: it is published to the run token and closed
+ * by Socket, under that token's mutex, so Stop() can never race the close. */
+struct Handshake {
+	HINTERNET session = nullptr;
+	HINTERNET connect = nullptr;
+	HINTERNET request = nullptr;
+
+	~Handshake()
+	{
+		if (request)
+			WinHttpCloseHandle(request);
+		if (connect)
+			WinHttpCloseHandle(connect);
+		if (session)
+			WinHttpCloseHandle(session);
+	}
+
+	Handshake(const Handshake &) = delete;
+	Handshake &operator=(const Handshake &) = delete;
+	Handshake() = default;
+};
+
+class Socket {
+public:
+	explicit Socket(const std::shared_ptr<RunToken> &token) : token_(token) {}
+	~Socket() { Close(); }
+
+	Socket(const Socket &) = delete;
+	Socket &operator=(const Socket &) = delete;
+
+	/* Takes ownership of the upgraded handle and publishes it, in one step, so
+	 * a Stop() that arrives between the upgrade and the first receive can still
+	 * cancel it. */
+	void Adopt(HINTERNET handle)
+	{
+		std::lock_guard<std::mutex> lock(token_->socket_mutex);
+		handle_ = handle;
+		token_->websocket = handle;
+	}
+
+	HINTERNET Get() const { return handle_; }
+
+	void Close()
+	{
+		HINTERNET handle = nullptr;
+		{
+			std::lock_guard<std::mutex> lock(token_->socket_mutex);
+			handle = handle_;
+			handle_ = nullptr;
+			token_->websocket = nullptr;
+		}
+		if (handle)
+			WinHttpCloseHandle(handle);
+	}
+
+private:
+	std::shared_ptr<RunToken> token_;
+	HINTERNET handle_ = nullptr;
+};
+
+/* One session: server list and token, upgrade, auth, then the heartbeat and
+ * receive loop. Returns how long the connection stayed authenticated, in
+ * milliseconds, which is the only thing the backoff decision reads (DMC:42-45);
+ * zero covers every failure, like the Swift's `.zero`. */
+long long RunSession(long long room_id, long long uid, const std::shared_ptr<RunToken> &token)
+{
+	const Result<DanmakuConnectInfo> info = FetchConnectInfo(room_id, uid, token);
+	if (token->cancelled.load() || !info.ok || info.value.host.empty() || info.value.port <= 0)
+		return 0;
+
+	Handshake handshake;
+	handshake.session = WinHttpOpen(L"LiveHime/0.2 (Windows; OBS)", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
+					WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+	if (!handshake.session)
+		return 0;
+	/* Resolve, connect, send, receive. The receive budget is the loop tick
+	 * (kReceiveTick): big enough for the server's 101, small enough to keep the
+	 * heartbeat on time. */
+	WinHttpSetTimeouts(handshake.session, 10000, 10000, 15000,
+			   static_cast<int>(std::chrono::duration_cast<std::chrono::milliseconds>(kReceiveTick).count()));
+
+	handshake.connect = WinHttpConnect(handshake.session, Widen(info.value.host).c_str(),
+					   static_cast<INTERNET_PORT>(info.value.port), 0);
+	if (!handshake.connect)
+		return 0;
+
+	/* wss://<host>:<wss_port>/sub (DMC:59). */
+	handshake.request = WinHttpOpenRequest(handshake.connect, L"GET", L"/sub", nullptr, WINHTTP_NO_REFERER,
+					       WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE);
+	if (!handshake.request)
+		return 0;
+	/* Required before the upgrade request goes out; Sec-WebSocket-* stays
+	 * WinHTTP's business (docs/port-spec §9.3). */
+	if (!WinHttpSetOption(handshake.request, WINHTTP_OPTION_UPGRADE_TO_WEB_SOCKET, nullptr, 0))
+		return 0;
+
+	/* DMC:60-61. No Cookie header: the handshake is not what authenticates this
+	 * socket — the operation-7 packet is (docs/port-spec §2.1). */
+	const std::wstring headers = Widen(std::string("User-Agent: ") + kBilibiliUserAgent +
+					   "\r\nOrigin: https://live.bilibili.com\r\n");
+	if (!WinHttpSendRequest(handshake.request, headers.c_str(), static_cast<DWORD>(headers.size()), nullptr, 0, 0, 0))
+		return 0;
+	if (!WinHttpReceiveResponse(handshake.request, nullptr))
+		return 0;
+
+	DWORD status = 0;
+	DWORD status_size = sizeof(status);
+	if (!WinHttpQueryHeaders(handshake.request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+				 WINHTTP_HEADER_NAME_BY_INDEX, &status, &status_size, WINHTTP_NO_HEADER_INDEX) ||
+	    status != 101)
+		return 0;
+
+	HINTERNET upgraded = WinHttpWebSocketCompleteUpgrade(handshake.request, 0);
+	if (!upgraded)
+		return 0;
+	Socket socket(token);
+	socket.Adopt(upgraded);
+	WinHttpCloseHandle(handshake.request);
+	handshake.request = nullptr;
+
+	/* The auth packet: one binary message, version 1, operation 7, sequence 1
+	 * (DMC:66-68). Key order inside the JSON is JSONSerialization's business in
+	 * the Swift and Not In Source (docs/port-spec §10.1); nlohmann writes keys
+	 * sorted, which the server accepts and which makes logs diffable. */
+	const json auth{{"uid", uid},
+			{"roomid", room_id},
+			{"protover", kProtoVersion},
+			{"buvid", BuvidFromCookies()},
+			{"platform", "web"},
+			{"type", 2},
+			{"key", info.value.token}};
+	if (!SendBinary(socket.Get(), EncodePacket(Operation::Auth, auth.dump())))
+		return 0;
+
+	/* DMC:70-76: the heartbeat starts immediately — its first frame goes out
+	 * before the first receive — and then every 30 s. The deadline advances
+	 * from the send, so the interval is never shorter than the Swift's, and the
+	 * receive tick above bounds how much later it can be. */
+	auto next_heartbeat = std::chrono::steady_clock::now();
+	std::chrono::steady_clock::time_point connected_at;
+	bool connected = false;
+
+	/* Two accumulators: one for the fragments of the WebSocket message in
+	 * flight, one for danmaku frames that a message boundary cut in half. */
+	std::string message;
+	std::string pending;
+	bool fragmented = false;
+
+	for (;;) {
+		if (token->cancelled.load())
+			break;
+
+		const auto now = std::chrono::steady_clock::now();
+		if (now >= next_heartbeat) {
+			/* A send failure is ignored on purpose: the Swift uses `try?` and
+			 * lets the receive side notice the break (DMC:72,78-97). */
+			SendBinary(socket.Get(), EncodePacket(Operation::Heartbeat, kHeartbeatBody));
+			next_heartbeat = now + kHeartbeatInterval;
+		}
+
+		char chunk[16384];
+		DWORD read = 0;
+		WINHTTP_WEB_SOCKET_BUFFER_TYPE type = WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE;
+		const DWORD result = WinHttpWebSocketReceive(socket.Get(), chunk, sizeof(chunk), &read, &type);
+
+		if (result == ERROR_WINHTTP_TIMEOUT) {
+			/* The tick. Between messages it means the room is quiet; in the
+			 * middle of a fragmented message it means the peer stalled, and
+			 * the session ends the way any transport failure does. */
+			if (fragmented)
+				break;
+			continue;
+		}
+		if (result != ERROR_SUCCESS)
+			break; /* includes ERROR_WINHTTP_OPERATION_CANCELLED, which is
+				  Stop() having closed the socket: reconnect is not wanted,
+				  the run token is cancelled and the loop above exits. */
+
+		if (type == WINHTTP_WEB_SOCKET_CLOSE_BUFFER_TYPE) {
+			/* The server closed. WinHTTP wants the close status read before
+			 * the handle goes away; the Swift discards the close reason
+			 * entirely and lets the backoff loop reconnect (DMC:95-97), so
+			 * nothing consumes it here either. */
+			USHORT close_status = 0;
+			unsigned char reason[123];
+			DWORD reason_length = 0;
+			WinHttpWebSocketQueryCloseStatus(socket.Get(), &close_status, reason, sizeof(reason),
+							 &reason_length);
+			break;
+		}
+
+		/* Binary and text messages reach the same decoder (DMC:80-84). */
+		message.append(chunk, read);
+		fragmented = type == WINHTTP_WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE ||
+			     type == WINHTTP_WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE;
+		if (fragmented)
+			continue; /* more of this message follows */
+
+		pending.append(message);
+		message.clear();
+
+		/* A WebSocket message is not a frame boundary. Complete frames are
+		 * decoded; a half frame stays in `pending` for the next message
+		 * instead of being dropped the way the Swift's per-message decode
+		 * drops it (DMP:41-44). */
+		const DecodeOutcome outcome = DecodeStream(pending);
+		if (outcome.corrupt)
+			pending.clear(); /* a stream with no magic number cannot be resynchronised */
+		else
+			pending.erase(0, outcome.consumed);
+
+		ReportFailures(outcome.failures);
+
+		bool rejected = false;
+		for (const Frame &frame : outcome.frames) {
+			if (frame.operation == static_cast<std::uint32_t>(Operation::AuthReply)) {
+				if (!AuthAccepted(frame.body)) {
+					/* DMC:88 — the session ends at once, returning zero. */
+					rejected = true;
+					break;
+				}
+				connected_at = std::chrono::steady_clock::now();
+				connected = true;
+				PostStatus(DanmakuStatus::Connected, token);
+			}
+			DispatchFrame(frame);
+		}
+		if (rejected)
+			return 0;
+	}
+
+	if (!connected)
+		return 0;
+	return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - connected_at)
+		.count();
+}
+
+/* The reconnect loop of DMC:36-49, on its own thread for the whole life of one
+ * Start(): connect, wait out the backoff, connect again, until Stop(). */
+void WorkerMain(long long room_id, long long uid, std::shared_ptr<RunToken> token)
+{
+	long long backoff_ms = kBackoffInitialMs;
+	int attempt = 0;
+	while (!token->cancelled.load()) {
+		/* `.connecting` is emitted exactly once per run: attempt never resets
+		 * (docs/port-spec §6.2). */
+		PostStatus(attempt == 0 ? DanmakuStatus::Connecting : DanmakuStatus::Reconnecting, token);
+		++attempt;
+
+		const long long connected_ms = RunSession(room_id, uid, token);
+		if (token->cancelled.load())
+			break;
+		/* DMC:45 — a session that stayed authenticated for more than a minute
+		 * starts over at 2 s; anything else doubles, capped at 30 s. */
+		backoff_ms = connected_ms > kBackoffResetAfterMs ? kBackoffInitialMs
+								 : std::min(backoff_ms * 2, kBackoffMaxMs);
+		PostStatus(DanmakuStatus::Reconnecting, token);
+		SleepInterruptible(std::chrono::milliseconds(backoff_ms), token);
+	}
+}
+
+} // namespace
+
+/* ── the frozen interface ───────────────────────────────────────────────── */
+
+const char *DanmakuStatusRaw(DanmakuStatus status)
+{
+	/* The Swift's Status raw values (DMC:9); the core emits them verbatim in
+	 * {"event":"danmakuStatus","status":...} (CBridge.swift:28). */
+	switch (status) {
+	case DanmakuStatus::Connecting:
+		return "connecting";
+	case DanmakuStatus::Connected:
+		return "connected";
+	case DanmakuStatus::Reconnecting:
+		return "reconnecting";
+	case DanmakuStatus::Stopped:
+		break;
+	}
+	return "stopped";
+}
+
+DanmakuClient &DanmakuClient::Instance()
+{
+	static DanmakuClient instance;
+	return instance;
+}
+
+void DanmakuClient::SetHandlers(EventFn on_event, StatusFn on_status)
+{
+	std::lock_guard<std::mutex> lock(g_client.mutex);
+	g_client.on_event = std::move(on_event);
+	g_client.on_status = std::move(on_status);
+}
+
+void DanmakuClient::Start(long long room_id, long long uid)
+{
+	/* The frozen header promises a no-op while the client already runs for this
+	 * room. DanmakuClient.swift:24 stops first even then; this is the one place
+	 * the header and the Swift disagree, and the header wins so that a
+	 * redundant Start cannot blink a working socket. */
+	{
+		std::lock_guard<std::mutex> lock(g_client.mutex);
+		if (g_client.run && !g_client.run->cancelled.load() && room_id_ == room_id)
+			return;
+	}
+
+	Stop();
+
+	std::shared_ptr<RunToken> token;
+	{
+		std::lock_guard<std::mutex> lock(g_client.mutex);
+		room_id_ = room_id;
+		token = std::make_shared<RunToken>();
+		g_client.run = token;
+		g_client.worker = std::thread(WorkerMain, room_id, uid, token);
+	}
+}
+
+void DanmakuClient::Stop()
+{
+	std::shared_ptr<RunToken> token;
+	std::thread worker;
+	{
+		std::lock_guard<std::mutex> lock(g_client.mutex);
+		token = g_client.run;
+		g_client.run.reset();
+		worker = std::move(g_client.worker);
+	}
+
+	if (token) {
+		token->cancelled.store(true);
+		/* Closing the socket is what unblocks a receive parked inside WinHTTP
+		 * (it returns ERROR_WINHTTP_OPERATION_CANCELLED); the close code is
+		 * .goingAway, what the Swift's `socket.cancel` sends (DMC:64). The
+		 * handle itself stays the worker's to close, under the same mutex, so
+		 * it can never be closed twice. */
+		std::lock_guard<std::mutex> lock(token->socket_mutex);
+		if (token->websocket) {
+			WinHttpWebSocketClose(token->websocket, WINHTTP_WEB_SOCKET_ENDPOINT_TERMINATED_CLOSE_STATUS,
+					      nullptr, 0);
+		}
+	}
+
+	if (worker.joinable())
+		worker.join();
+
+	room_id_ = 0;
+	/* After the join, so a status the worker had already queued can never land
+	 * after this one: its posts are dropped by the cancelled token. Safe to
+	 * call when never started or twice — there is nothing to join and the
+	 * status is already the one it would report. */
+	PostStatus(DanmakuStatus::Stopped, nullptr);
+}
+
+void DanmakuClient::InjectForTest(const std::string &bytes)
+{
+	/* The receive loop's decode path, with an accumulator of its own so a test
+	 * can split a frame across two calls. Connection state is untouched — only
+	 * the socket loop owns status — but frames, containers, event shapes and
+	 * failure reports are the same code the socket runs. */
+	DecodeOutcome outcome;
+	{
+		std::lock_guard<std::mutex> lock(g_client.mutex);
+		g_client.test_buffer.append(bytes);
+		outcome = DecodeStream(g_client.test_buffer);
+		if (outcome.corrupt)
+			g_client.test_buffer.clear();
+		else
+			g_client.test_buffer.erase(0, outcome.consumed);
+	}
+
+	ReportFailures(outcome.failures);
+	for (const Frame &frame : outcome.frames)
+		DispatchFrame(frame);
+}
+
+} // namespace live
+} // namespace livehime
