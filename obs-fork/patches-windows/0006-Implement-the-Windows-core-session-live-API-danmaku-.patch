+/* Downloads one picture and caches it as a file; returns the path, or "" . */
+void FetchEmoticonImage(const std::string &url, PathFn done)
+{
+	/* Emoticons.swift:183-200. The Swift answers nil on every failure, which
+	 * has no error shape, so the C++ names the reason; the caller reads only
+	 * the path (CBridge.swift:276-279). */
+	std::optional<std::string> allowed = AllowedImageUrl(url);
+	if (!allowed) {
+		DeliverPath(done, false, std::string(), ServerFailure("unsupportedImageHost"));
+		return;
+	}
+	std::optional<std::filesystem::path> folder = CacheFolder();
+	if (!folder) {
+		DeliverPath(done, false, std::string(), ServerFailure("cacheFolderUnavailable"));
+		return;
+	}
+	const std::filesystem::path target = CacheFile(*folder, url);
+	std::error_code ec;
+	if (std::filesystem::exists(target, ec) && !ec) {
+		DeliverPath(done, true, target.u8string(), ApiError{});
+		return;
+	}
+
+	/* :186-187: one download per address; a second caller waits for it. */
+	auto waiting = g_image_waiters.find(url);
+	if (waiting != g_image_waiters.end()) {
+		waiting->second.push_back(done);
+		return;
+	}
+	g_image_waiters[url] = {done};
+
+	net::Request req;
+	req.url = *allowed;
+	req.timeout_ms = kTimeoutMs;
+	/* :153-161: the picture session is ephemeral — no cookies and no custom
+	 * headers. net::Send still applies whatever the jar holds for the CDN
+	 * host, which is nothing: Bilibili's cookies belong to .bilibili.com.
+	 * :203-214 also re-encodes every picture to a ≤160 px PNG with ImageIO,
+	 * and :216-237 trims the folder (30 MB -> 20 MB) from a detached task;
+	 * the C++ core has no image codec and no lifetime hook for a detached
+	 * thread inside a plugin DLL, so the bytes are cached verbatim and the
+	 * folder is left to grow. */
+	net::Send(req, [url, target](net::Response res) {
+		ApiError error;
+		std::string path;
+		if (res.status == 0) {
+			error = TransportFailure(res);
+		} else if (res.status != 200) {
+			error = HttpFailure(res.status);
+		} else if (res.body.size() >= kMaxImageBytes) {
+			error = ServerFailure("imageTooLarge");
+		} else if (!LooksLikeImage(res.body)) {
+			error = ServerFailure("notAnImage");
+		} else if (!WriteCacheFile(target, res.body)) {
+			error = ServerFailure("cacheWriteFailed");
+		} else {
+			path = target.u8string();
+		}
+		DeliverImage(url, path, error);
+	});
+}
+
+/* The cookie header for the current session, rebuilt from the jar. */
+std::string CookieHeader()
+{
+	/* SessionCredentials.cookieHeader is a deterministic "k=v; k=v" string
+	 * (QRLogin.swift:24-26); PersistString() is the jar's equivalent
+	 * (CONTRACT §7). net::Send applies the jar itself, so this is for the
+	 * callers that need the text — the web-view login, the danmaku client,
+	 * tests. */
+	return net::CookieJar::Instance().PersistString();
+}
+
+/* csrf = the bili_jct cookie; empty when signed out. */
+std::string CsrfToken()
+{
+	/* QRLogin.swift:22. */
+	return net::CookieJar::Instance().Get("bili_jct");
+}
