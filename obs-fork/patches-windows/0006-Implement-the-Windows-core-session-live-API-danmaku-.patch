+void LoadShieldKeywords(long long room_id, KeywordsFn done)
+{
+	/* LiveRoomActions.swift:144-150. */
+	const std::string csrf = net::CookieJar::Instance().Get("bili_jct");
+	if (csrf.empty()) {
+		Deliver(done, Fail<std::vector<std::string>>(ServerFailure("missingCSRF")));
