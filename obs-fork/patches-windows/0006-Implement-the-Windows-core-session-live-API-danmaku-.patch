+/* ── emoticon pictures (Emoticons.swift:146-237) ───────────────────────── */
+
+/* :168-175: https only, and only Bilibili's image hosts. "//host/x" and
+ * "http://host/x" are both rewritten to https first. */
+std::optional<std::string> AllowedImageUrl(const std::string &address)
+{
+	std::string url = address;
+	if (url.compare(0, 2, "//") == 0)
+		url = "https:" + url;
+	else if (url.compare(0, 7, "http://") == 0)
+		url = "https://" + url.substr(7);
+	if (url.compare(0, 8, "https://") != 0)
+		return std::nullopt;
+
+	const size_t host_start = 8;
+	const size_t host_end = url.find_first_of("/?#:", host_start);
+	const std::string host =
+		LowerAscii(url.substr(host_start, host_end == std::string::npos ? std::string::npos : host_end - host_start));
+	for (const char *allowed : {"hdslb.com", "biliimg.com"}) {
+		if (host == allowed)
+			return url;
+		const std::string suffix = std::string(".") + allowed;
+		if (host.size() > suffix.size() &&
+		    host.compare(host.size() - suffix.size(), suffix.size(), suffix) == 0)
+			return url;
+	}
+	return std::nullopt;
+}
+
+/* :164-180: %LOCALAPPDATA%\LiveHime\emoticons\<sha256 of the address>.png —
+ * the Windows stand-in for Caches/LiveHime/emoticons. _wgetenv keeps a
+ * non-ASCII user name intact where the ANSI CRT would not. */
+std::optional<std::filesystem::path> CacheFolder()
+{
+	const wchar_t *local = _wgetenv(L"LOCALAPPDATA");
+	if (!local || !*local)
+		return std::nullopt;
+	return std::filesystem::path(local) / L"LiveHime" / L"emoticons";
+}
+
+std::filesystem::path CacheFile(const std::filesystem::path &folder, const std::string &address)
+{
+	return folder / (crypto::Sha256Hex(address) + ".png");
+}
+
+/* The Swift's acceptance test is "CGImageSourceCreateWithData decodes it"
+ * (:194). The C++ core has no image codec, so this is the cheap stand-in: the
+ * formats those hosts serve. */
+bool LooksLikeImage(const std::string &bytes)
+{
+	static const char kPng[] = "\x89PNG\r\n\x1a\n";
+	if (bytes.size() >= 8 && bytes.compare(0, 8, kPng, 8) == 0)
+		return true;
+	if (bytes.size() >= 3 && bytes.compare(0, 3, "\xff\xd8\xff", 3) == 0)
+		return true;
+	if (bytes.size() >= 4 && bytes.compare(0, 4, "GIF8", 4) == 0)
+		return true;
+	if (bytes.size() >= 12 && bytes.compare(0, 4, "RIFF", 4) == 0 && bytes.compare(8, 4, "WEBP", 4) == 0)
+		return true;
+	if (bytes.size() >= 2 && bytes.compare(0, 2, "BM", 2) == 0)
+		return true;
+	if (bytes.size() >= 12 && bytes.compare(4, 4, "ftyp", 4) == 0)
+		return true; /* HEIF/AVIF */
+	return false;
+}
+
+/* Writes the picture and reports whether the bytes really landed: a caller
+ * that gets a path back may open it immediately. */
+bool WriteCacheFile(const std::filesystem::path &path, const std::string &bytes)
+{
+	std::error_code ec;
+	std::filesystem::create_directories(path.parent_path(), ec);
+	if (ec)
+		return false;
+	std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+	if (!stream)
+		return false;
+	stream.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+	stream.close();
+	if (!stream)
+		return false;
+	return true;
+}
+
+/* Addresses being downloaded right now (Emoticons.swift:151, :186-187).
+ * Main-thread only, like every callback in this file. */
+std::map<std::string, std::vector<PathFn>> g_image_waiters;
+
+/* Hands the answer to everyone waiting on this address, exactly once. */
+void DeliverImage(const std::string &url, const std::string &path, const ApiError &error)
+{
+	std::vector<PathFn> waiters;
+	auto it = g_image_waiters.find(url);
+	if (it != g_image_waiters.end()) {
+		waiters = std::move(it->second);
+		g_image_waiters.erase(it);
+	}
+	const bool ok = !Failed(error) && !path.empty();
+	for (const PathFn &waiter : waiters)
+		DeliverPath(waiter, ok, path, error);
+}
