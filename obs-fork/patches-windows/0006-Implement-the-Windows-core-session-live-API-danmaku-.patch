+/* POST /room/v1/Room/startLive — see CONTRACT §6.2 for the signature. */
+void StartLive(long long room_id, const Area &area, StreamFn done)
+{
+	/* BilibiliLiveClient.swift:263-288. The csrf is read before anything is
+	 * requested; a missing bili_jct is a failure, not a reason to ask. */
+	const std::string csrf = net::CookieJar::Instance().Get("bili_jct");
+	if (csrf.empty()) {
+		/* CBridge.swift:214-217 maps missingCSRF to server, not to a session
+		 * that expired — only -101 is notLoggedIn in the Swift. */
+		Deliver(done, Fail<StreamConfig>(ServerFailure("missingCSRF")));
+		return;
+	}
+
+	/* Two best-effort lookups before signing, in this order: the client
+	 * version markers (:267) and the server clock (:277). */
+	FetchLiveVersionBestEffort([room_id, area_id = area.id, csrf, done](std::string version, int build) {
+		FetchServerTimestampBestEffort([room_id, area_id, csrf, version, build, done](long long timestamp) {
+			/* The eight fields in this exact insertion order; the source
+			 * calls the order load-bearing, and extra fields such as
+			 * csrf_token/backup_stream make newer accounts reject the
+			 * request (:270-273). The Swift's parentAreaID parameter is
+			 * accepted and never used — area_v2 is the leaf id alone. */
+			std::vector<std::pair<std::string, std::string>> values = {
+				{"appkey", net::kPcLinkAppKey},
+				{"area_v2", std::to_string(area_id)},
+				{"build", std::to_string(build)},
+				{"csrf", csrf},
+				{"platform", "pc_link"},
+				{"room_id", std::to_string(room_id)},
+				{"ts", std::to_string(timestamp)},
+				{"version", version},
+			};
+			std::vector<std::pair<std::string, std::string>> signed_values = values;
+			signed_values.emplace_back("sign", net::PcLinkSign(values));
+
+			/* All nine pairs travel on the query string of a POST; the body
+			 * stays empty, exactly like `body: nil` with httpMethod "POST"
+			 * (:283-286), so no Content-Type is sent either. */
+			net::Request req;
+			req.method = "POST";
+			req.url = net::AppendQuery(kStartLiveUrl, net::FormEncode(signed_values));
+			ApplyLiveHeaders(req);
+			RequestJson(req, [done](const json &root, const ApiError &error) {
+				if (Failed(error)) {
+					Deliver(done, Fail<StreamConfig>(error));
+					return;
+				}
+				Deliver(done, ParseStreamConfig(root));
+			});
+		});
+	});
+}
