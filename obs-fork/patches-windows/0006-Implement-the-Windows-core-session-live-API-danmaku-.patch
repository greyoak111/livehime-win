+			"Version/17.0 Safari/605.1.15";
+
+		livehime::net::Response response = livehime::net::SendSync(request);
+		line("");
+		line("[qrcode/generate] status=" + std::to_string(response.status) +
+		     (response.error.empty() ? std::string() : " error=" + response.error));
+		if (!response.body.empty()) {
+			nlohmann::json parsed = nlohmann::json::parse(response.body, nullptr, false);
+			if (parsed.is_discarded()) {
+				line("[qrcode/generate] body is not JSON: " + response.body.substr(0, 200));
+			} else {
