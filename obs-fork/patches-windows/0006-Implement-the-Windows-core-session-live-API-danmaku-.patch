+/* GET /x/web-interface/nav. Reads the WBI keys too; they are present even when
+ * the answer is -101. */
+void FetchIdentity(IdentityFn done)
+{
+	/* BilibiliControlClient.swift:33-88. */
+	net::Request req;
+	req.url = kNavUrl;
+	req.timeout_ms = kTimeoutMs;
+	/* :47-49: nav takes the browser UA, the www referer and the JSON Accept,
+	 * and no Origin — the live API's headers are not used here. The jar
+	 * supplies the Cookie header. */
+	req.headers["Accept"] = "application/json, text/plain, */*";
+	req.headers["Referer"] = kNavReferer;
+	req.headers["User-Agent"] = kUserAgent;
+
+	net::Send(req, [done](net::Response res) {
+		if (res.status == 0) {
+			Deliver(done, Fail<Identity>(TransportFailure(res)));
+			return;
+		}
+		if (!res.Ok()) {
+			Deliver(done, Fail<Identity>(HttpFailure(res.status)));
+			return;
+		}
+		const json root = json::parse(res.body, nullptr, false);
+		if (root.is_discarded() || !root.is_object()) {
+			Deliver(done, Fail<Identity>(ServerFailure("invalidResponse")));
+			return;
+		}
+		/* LiveRoomActions.swift:40-41: the keys are read before the code
+		 * check, because nav answers them even when signed out (-101). */
+		StoreSignerFromNav(root);
+		long long code = 0;
+		if (!RootCode(root, code)) {
+			Deliver(done, Fail<Identity>(ServerFailure("invalidResponse")));
+			return;
+		}
+		if (code != 0) {
+			if (code == -101) {
+				Deliver(done, Fail<Identity>(SessionExpired()));
+				return;
+			}
+			/* :75 names this one itself, instead of requestJSON's message. */
+			Deliver(done, Fail<Identity>(ApiFailure(code, kIdentityFailureMessage)));
+			return;
+		}
+		const json data = DataObject(root);
+		bool is_login = false;
+		if (!data.is_object() || !FieldBool(data, "isLogin", is_login)) {
+			Deliver(done, Fail<Identity>(ServerFailure("invalidResponse")));
+			return;
+		}
+		/* :80: isLogin false is the other "not logged in" answer. */
+		if (!is_login) {
+			Deliver(done, Fail<Identity>(SessionExpired()));
+			return;
+		}
+		/* :82-85: `mid` must be a positive number (a string does not count)
+		 * or the answer is invalid rather than signed in. */
+		const long long mid = NumberField(data, "mid");
+		if (mid <= 0) {
+			Deliver(done, Fail<Identity>(ServerFailure("invalidResponse")));
+			return;
+		}
+		Identity identity;
+		identity.mid = mid;
+		identity.username = FieldString(data, {"uname"}).value_or("");
+		identity.logged_in = true;
+		Deliver(done, Ok(identity));
+	});
+}
+
+/* Room for the signed-in account. Tries room_id_by_uid then getRoomInfoOld,
+ * the order BilibiliLiveClient.swift:205-260 uses. */
+void FetchRoom(long long mid, RoomFn done)
+{
+	/* BilibiliLiveClient.swift:107-132. Only a missingRoom answer falls
+	 * through to the other endpoints (`catch BilibiliLiveError.missingRoom`);
+	 * a transport or API error is the answer. */
+	FetchLegacyRoom(mid, [mid, done](Result<RoomInfo> legacy) {
+		if (!legacy.ok) {
+			if (legacy.error.Kind() != "noLiveRoom") {
+				Deliver(done, legacy);
+				return;
+			}
+			/* `if let roomID = try? await resolveRoomIDByUID(mid: mid)` —
+			 * every failure of that endpoint means "try liveinfo next". */
+			ResolveRoomByUid(mid, [done](long long room_id) {
+				if (room_id > 0) {
+					FetchRoomInfo(room_id, done);
+					return;
+				}
+				ResolveCurrentRoom([done](long long current, const ApiError &error) {
+					if (Failed(error)) {
+						Deliver(done, Fail<RoomInfo>(error));
+						return;
+					}
+					FetchRoomInfo(current, done);
+				});
+			});
+			return;
+		}
+		/* getRoomInfoOld omits the v2 child-area id. Fetch the canonical
+		 * record so startLive receives the required area_v2 value; a failure
+		 * or an area id of 0 keeps the legacy record (:112-116). */
+		if (legacy.value.area_id == 0) {
+			FetchRoomInfo(legacy.value.room_id, [legacy, done](Result<RoomInfo> canonical) {
+				if (canonical.ok && canonical.value.area_id != 0) {
+					Deliver(done, canonical);
+					return;
+				}
+				Deliver(done, legacy);
+			});
+			return;
+		}
+		Deliver(done, legacy);
+	});
+}
+
+/* GET /room/v1/Room/get_info — the shape the danmaku reconnect path reads. */
+void FetchRoomInfo(long long room_id, RoomFn done)
+{
+	/* BilibiliLiveClient.swift:242-261. */
+	net::Request req;
+	req.url = net::AppendQuery(kRoomInfoUrl, net::FormEncode({{"room_id", std::to_string(room_id)}}));
+	ApplyLiveHeaders(req);
+	RequestJson(req, [room_id, done](const json &root, const ApiError &error) {
+		if (Failed(error)) {
+			Deliver(done, Fail<RoomInfo>(error));
+			return;
+		}
+		RoomInfo room;
+		if (!ParseCanonicalRoom(root, room_id, room)) {
+			Deliver(done, Fail<RoomInfo>(ServerFailure("invalidResponse")));
+			return;
+		}
+		Deliver(done, Ok(room));
+	});
+}
