+/* BilibiliControlClient.swift:48: nav wants the site referer instead. */
+constexpr const char *kNavReferer = "https://www.bilibili.com/";
+/* requestJSON sets timeoutInterval = 12 on every request. */
+constexpr int kTimeoutMs = 12000;
+/* Emoticons.swift:193: a picture of this size or more is refused. */
+constexpr size_t kMaxImageBytes = 4000000;
+
