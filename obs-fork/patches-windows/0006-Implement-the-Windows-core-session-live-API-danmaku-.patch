+/* BilibiliLiveClient.swift:192-203. startLive keeps the known markers as a
+ * transient-network fallback (:267-269), so every failure here is swallowed
+ * and the fallback values answer instead. */
+void FetchLiveVersionBestEffort(const std::function<void(std::string, int)> &done)
+{
+	net::Request req;
+	req.url = net::AppendQuery(kLiveVersionUrl, net::FormEncode({{"system_version", "2"}}));
+	ApplyLiveHeaders(req);
+	RequestJson(req, [done](const json &root, const ApiError &error) {
+		std::string version = "8.6.0";
+		int build = 11050;
+		if (!Failed(error)) {
+			/* `root["data"] as? [String: Any] ?? root` */
+			const json *data = ObjectField(root, "data");
+			const json &source = data ? *data : root;
+			const std::string candidate = FieldString(source, {"curr_version", "version"}).value_or("");
+			const int value = FieldIntInt(source, "build");
+			/* :201: both markers must be present or it is invalidResponse. */
+			if (!candidate.empty() && value > 0) {
+				version = candidate;
+				build = value;
+			}
+		}
+		done(version, build);
+	});
+}
+
+/* BilibiliLiveClient.swift:476-488: the server clock from
+ * /x/report/click/now, or the local one when that endpoint does not answer
+ * with a positive `now` — including a Bilibili code that is not 0. */
+void FetchServerTimestampBestEffort(const std::function<void(long long)> &done)
+{
+	net::Request req;
+	req.url = kServerClockUrl;
+	ApplyLiveHeaders(req);
+	RequestJson(req, [done](const json &root, const ApiError &error) {
+		long long now = 0;
+		if (!Failed(error))
+			now = FieldInt(DataObject(root), {"now"});
+		if (now <= 0)
+			now = static_cast<long long>(std::time(nullptr));
+		done(now);
+	});
+}
+
+/* LiveRoomActions.swift:29-38: buvid3 identifies the browser to the danmaku
+ * server and QR login does not set it, so the public fingerprint endpoint
+ * supplies it. */
+void EnsureBuvid3(const std::function<void(const ApiError &)> &done)
+{
+	if (net::CookieJar::Instance().Has("buvid3")) {
+		done(ApiError{});
+		return;
+	}
+	net::Request req;
+	req.url = kFingerprintUrl;
+	ApplyLiveHeaders(req);
+	RequestJson(req, [done](const json &root, const ApiError &error) {
+		if (Failed(error)) {
+			done(error);
+			return;
+		}
+		auto value = FieldString(DataObject(root), {"b_3"});
+		if (!value || value->empty()) {
+			done(ServerFailure("invalidResponse"));
+			return;
+		}
+		/* The Swift sends the rest of this request chain with a temporary
+		 * "; buvid3=" appended to its cookie header (:61). The frozen http
+		 * layer owns the Cookie header, so the jar is the C++ equivalent —
+		 * and the danmaku client reads it back through CookieHeader(). */
+		net::CookieJar::Instance().Set(".bilibili.com", "buvid3", *value);
+		done(ApiError{});
+	});
+}
