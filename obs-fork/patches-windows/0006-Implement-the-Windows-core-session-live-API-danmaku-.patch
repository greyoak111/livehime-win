+/* GET /room/v1/Area/getList */
+void FetchAreas(AreasFn done)
+{
+	/* BilibiliLiveClient.swift:146-188; the C++ call has no parent_id, so the
+	 * query is the platform alone (:147). */
+	net::Request req;
+	req.url = net::AppendQuery(kAreaListUrl, net::FormEncode({{"platform", "pc_link"}}));
+	ApplyLiveHeaders(req);
+	RequestJson(req, [done](const json &root, const ApiError &error) {
+		if (Failed(error)) {
+			Deliver(done, Fail<std::vector<Area>>(error));
+			return;
+		}
+		/* `guard let data = root["data"]` — even a null passes it, and then
+		 * yields no leaves, which is invalidResponse (:150, :183). */
+		const json *data = FieldValue(root, {"data"});
+		if (!data) {
+			Deliver(done, Fail<std::vector<Area>>(ServerFailure("invalidResponse")));
+			return;
+		}
+		AreaTree tree;
+		tree.Flatten(*data, 0, "");
+		if (tree.leaves.empty()) {
+			Deliver(done, Fail<std::vector<Area>>(ServerFailure("invalidResponse")));
+			return;
+		}
+		std::vector<Area> areas;
+		for (const json &leaf : tree.leaves) {
+			if (auto area = ToArea(leaf))
+				areas.push_back(*area);
+		}
+		Deliver(done, Ok(std::move(areas)));
+	});
+}
