+/* SessionCoordinator.swift:271 trims before deciding whether there is anything
+ * to send. Swift's String.trimmingCharacters(in: .whitespacesAndNewlines)
+ * covers Unicode whitespace; the C ABI hands us UTF-8, so this trims the ASCII
+ * whitespace a copied-and-pasted title can carry and leaves the rest, rather
+ * than pulling in a Unicode table for a title field. */
+std::string TrimAscii(const std::string &text)
+{
+	size_t begin = text.find_first_not_of(" \t\r\n\f\v");
+	if (begin == std::string::npos)
+		return {};
+	size_t end = text.find_last_not_of(" \t\r\n\f\v");
+	return text.substr(begin, end - begin + 1);
+}
